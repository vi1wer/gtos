! GT/OS window chrome — exact match to QML titleBar (#2d2d2d / #202020)
border.width: 1
padding.width: 10
padding.height: 8
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0

! Active = QML win.isActive titleBar
window.active.border.color: #2d2d2d
window.active.client.color: #1e1e1e
window.active.title.bg: Solid flat
window.active.title.bg.color: #2d2d2d
window.active.label.text.color: #ffffff
window.active.label.text.font: shadow=n:tint=n:DejaVu Sans:size=9
window.active.handle.bg: Solid flat
window.active.handle.bg.color: #2d2d2d
window.active.grip.bg: Solid flat
window.active.grip.bg.color: #2d2d2d

window.active.button.unpressed.bg: Solid flat
window.active.button.unpressed.bg.color: #2d2d2d
window.active.button.unpressed.image.color: #ffffff
window.active.button.pressed.bg: Solid flat
window.active.button.pressed.bg.color: #202020
window.active.button.pressed.image.color: #ffffff
window.active.button.hover.bg: Solid flat
window.active.button.hover.bg.color: #3a3a3a
window.active.button.hover.image.color: #ffffff
window.active.button.disabled.bg: Solid flat
window.active.button.disabled.bg.color: #2d2d2d
window.active.button.disabled.image.color: #a0a0a0
window.active.button.toggled.unpressed.bg: Solid flat
window.active.button.toggled.unpressed.bg.color: #2d2d2d
window.active.button.toggled.unpressed.image.color: #ffffff
window.active.button.toggled.hover.bg: Solid flat
window.active.button.toggled.hover.bg.color: #3a3a3a
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.toggled.pressed.bg: Solid flat
window.active.button.toggled.pressed.bg.color: #202020
window.active.button.toggled.pressed.image.color: #ffffff

! Close — Windows caption red
window.active.button.close.unpressed.bg: Solid flat
window.active.button.close.unpressed.bg.color: #2d2d2d
window.active.button.close.unpressed.image.color: #ffffff
window.active.button.close.hover.bg: Solid flat
window.active.button.close.hover.bg.color: #c42b1c
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.pressed.bg: Solid flat
window.active.button.close.pressed.bg.color: #9a1f14
window.active.button.close.pressed.image.color: #ffffff

