        if (!clipPath.length || filesPath === "recent" || filesPath === "fav")
            return
        var dest = filesPath + "/" + clipPath.slice(clipPath.lastIndexOf("/") + 1)
        if (clipCut) {
            sys.run("mv -f " + shQuote(clipPath) + " " + shQuote(dest))
            clipPath = ""
            clipCut = false
        } else if (clipIsDir) {
            sys.run("cp -a " + shQuote(clipPath) + " " + shQuote(dest))
