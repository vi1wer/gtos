        return /\.(jpe?g|png|gif|webp|bmp|tif{1,2})$/.test(s)
    }

    function loadPhotosFavs() {
        var raw = sys.readFile("/var/lib/gtos/photo-favs").trim()
        photosFavs = raw.length ? raw.split("\n").filter(function (x) { return x.length }) : []
    }

    function savePhotosFavs() {
        sys.run("mkdir -p /var/lib/gtos")
        sys.writeFile("/var/lib/gtos/photo-favs", photosFavs.join("\n") + (photosFavs.length ? "\n" : ""))
    }

    function togglePhotoFav(path) {
        if (!path || !path.length) return
        var arr = photosFavs.slice()
        var i = arr.indexOf(path)
        if (i >= 0) arr.splice(i, 1)
        else arr.push(path)
        photosFavs = arr
        savePhotosFavs()
        refreshPhotosLibrary()
    }

    function photoIsFav(path) {
        return photosFavs.indexOf(path) >= 0
    }

    function refreshPhotosLibrary() {
        loadPhotosFavs()
        sys.run("mkdir -p " + shQuote(photosDir()))
        var cmd = "find " + shQuote(photosDir()) + " " + shQuote("/home/" + currentUser + "/Рабочий стол")
                + " -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif'"
                + " -o -iname '*.webp' -o -iname '*.bmp' \\) 2>/dev/null | head -n 400"
        var raw = (typeof sys.runTimeout === "function" ? sys.runTimeout(cmd, 2500) : sys.run(cmd)).trim()
        var lines = raw.length ? raw.split("\n") : []
        var all = []
        var albumMap = { all: 0, fav: 0 }
        for (var i = 0; i < lines.length; ++i) {
            var p = lines[i].trim()
            if (!p.length || !isImagePath(p)) continue
            var slash = p.lastIndexOf("/")
            var name = slash >= 0 ? p.slice(slash + 1) : p
            var parent = slash >= 0 ? p.slice(0, slash) : ""
            var album = "all"
            if (parent.indexOf(photosDir()) === 0) {
                var rest = parent.slice(photosDir().length).replace(/^\//, "")
                if (rest.length) album = rest.split("/")[0]
            } else if (parent.indexOf("Рабочий стол") >= 0) {
                album = "desk"
            }
            all.push({ path: p, name: name, album: album, fav: photoIsFav(p) })
            albumMap.all++
            if (photoIsFav(p)) albumMap.fav++
            if (album !== "all")
                albumMap[album] = (albumMap[album] || 0) + 1
        }
        photosList = all
        var albums = [
            { id: "all", title: "Все фото", count: albumMap.all || 0 },
            { id: "fav", title: "Избранное", count: albumMap.fav || 0 },
            { id: "desk", title: "Рабочий стол", count: albumMap.desk || 0 }
        ]
        for (var k in albumMap) {
            if (k === "all" || k === "fav" || k === "desk") continue
            albums.push({ id: k, title: k, count: albumMap[k] })
        }
        photosAlbums = albums
        if (photosIndex >= photosList.length)
            photosIndex = Math.max(0, photosList.length - 1)
    }

    function photosFiltered() {
        var out = []
        for (var i = 0; i < photosList.length; ++i) {
            var it = photosList[i]
            if (photosAlbum === "all") out.push(it)
            else if (photosAlbum === "fav" && it.fav) out.push(it)
            else if (it.album === photosAlbum) out.push(it)
        }
        return out
    }

    function refreshPhotosInfo() {
        if (!viewerPath.length) {
            photosInfo = ""
            photosFileSize = "—"
            photosImgW = 0
            photosImgH = 0
            return
        }
        var st = sys.run("stat -c '%s %y' " + shQuote(viewerPath) + " 2>/dev/null").trim()
        var parts = st.split(" ")
        var sz = parts.length ? formatSize(parseInt(parts[0], 10) || 0) : "—"
        photosFileSize = sz
        var when = parts.length > 1 ? parts.slice(1).join(" ").slice(0, 19) : "—"
        var dim = (photosImgW > 0 && photosImgH > 0) ? (photosImgW + " × " + photosImgH) : "—"
        photosInfo = "Имя · " + photosFileName()
                + "\nТип · " + photosFileExt()
                + "\nРазмер · " + sz
                + "\nРазрешение · " + dim
                + "\nИзменён · " + when
                + "\nПоворот · " + viewerRot + "°"
                + (viewerMirror ? " · отражено" : "")
    }

    function photosNext(delta) {
        var list = photosFiltered()
        if (!list.length) return
        var cur = 0
        for (var i = 0; i < list.length; ++i) {
            if (list[i].path === viewerPath) { cur = i; break }
        }
        var n = (cur + (delta || 1) + list.length * 8) % list.length
        viewerPath = list[n].path
        photosIndex = n
        photosMode = "viewer"
        photosReveal = 1
        viewerZoom = 1.0
        photosMoreOpen = false
        refreshPhotosInfo()
    }

    function weatherCodeText(code) {
