    function refreshTaskMgr() {
        cpuPct = sys.cpuUsage
        memPct = sys.memUsage
        var rows = []
        var seen = {}
        // Открытые окна — то, что видит пользователь
        for (var i = 0; i < windows.count; ++i) {
            var w = windows.get(i)
            if (w.hidden)
                continue
            var key = "win:" + w.appId
            seen[key] = true
            rows.push({
                key: key,
                group: "apps",
                name: w.title || appTitleOf(w.appId) || w.appId,
                hint: "Окно",
                icon: winIconKind(w.appId),
                pid: 0,
                cpu: Math.max(0.2, (cpuPct / Math.max(1, windows.count)) * (0.5 + Math.random() * 0.9)),
                mem: 40 + (i * 41) % 180,
                disk: Math.random() * 0.4,
                net: Math.random() * 0.2,
                status: "Выполняется",
                canKill: true,
                appId: w.appId
            })
        }
        // Только понятные пользовательские приложения из ps (не ядро / kworker / udev…)
        var raw = (typeof sys.runTimeout === "function"
            ? sys.runTimeout("busybox ps w 2>/dev/null | busybox awk 'NR>1 {print $1\"\\t\"$0}' | busybox head -n 40", 2000)
            : sys.processList())
        var lines = raw.split("\n")
        for (var j = 0; j < lines.length; ++j) {
            var line = lines[j].trim()
            if (!line.length)
                continue
            var tab = line.indexOf("\t")
            var pidStr = tab > 0 ? line.slice(0, tab) : line.split(/\s+/)[0]
            var rest = tab > 0 ? line.slice(tab + 1) : line
            var parts = rest.trim().split(/\s+/)
            var cmd = parts.length ? parts[parts.length - 1] : rest
            if (cmd.indexOf("/") >= 0)
                cmd = cmd.slice(cmd.lastIndexOf("/") + 1)
            var info = taskFriendlyApp(cmd)
            if (!info)
                continue
            // gt-shell / openbox / xorg — один раз, как «система»
            var gkey = "sys:" + info.name
            if (!info.kill) {
                if (seen[gkey])
                    continue
                seen[gkey] = true
                rows.push({
                    key: gkey,
                    group: "system",
                    name: info.name,
                    hint: "Система",
                    icon: info.icon,
                    pid: parseInt(pidStr, 10) || 0,
                    cpu: info.m === "gt-shell" ? Math.max(1, cpuPct * 0.35) : Math.random() * 0.8,
                    mem: info.m === "gt-shell" ? 120 + Math.round(memPct) : 18 + (j % 40),
                    disk: Math.random() * 0.15,
                    net: 0,
                    status: "Выполняется",
                    canKill: false,
                    appId: ""
                })
                continue
            }
            var akey = "app:" + info.name
            if (seen[akey])
                continue
            // уже есть окно с похожим названием — не дублируем
            var dup = false
            for (var d = 0; d < rows.length; ++d) {
                if (rows[d].group === "apps" && String(rows[d].name).toLowerCase().indexOf(info.name.toLowerCase()) >= 0)
                    dup = true
            }
            if (dup)
                continue
            seen[akey] = true
            rows.push({
                key: akey,
                group: "bg",
                name: info.name,
                hint: "Фон",
                icon: info.icon,
                pid: parseInt(pidStr, 10) || 0,
                cpu: 0.5 + Math.random() * 4,
                mem: 80 + (j * 17) % 240,
                disk: Math.random() * 1.2,
                net: Math.random() * 0.5,
                status: "Выполняется",
                canKill: true,
                appId: ""
            })
        }
        taskProcRows = rows
        procText = ""
        pushPerfSample()
    }

    function filteredTaskRows() {
        var q = taskMgrQuery.trim().toLowerCase()
        if (!q.length)
            return taskProcRows
        var out = []
        for (var i = 0; i < taskProcRows.length; ++i) {
            var r = taskProcRows[i]
            var hay = (r.name + " " + (r.hint || "") + " " + (r.pid || "")).toLowerCase()
            if (hay.indexOf(q) >= 0)
                out.push(r)
        }
        return out
    }

    function taskHeat(kind, value) {
        if (kind === "cpu") return value >= 15
        if (kind === "mem") return value >= 200
        if (kind === "disk") return value >= 1.0
        if (kind === "net") return value >= 1.0
        return false
    }

    function taskRowsByGroup(group) {
        var all = filteredTaskRows()
        var out = []
        for (var i = 0; i < all.length; ++i) {
            if (all[i].group === group)
                out.push(all[i])
        }
        return out
    }

    function taskRowsBackground() {
        return taskRowsByGroup("bg").concat(taskRowsByGroup("system"))
    }

    function selectedTaskRow() {
        for (var i = 0; i < taskProcRows.length; ++i) {
            if (taskProcRows[i].key === taskMgrSelKey)
                return taskProcRows[i]
        }
        return null
    }

    function killSelectedTask() {
        var r = selectedTaskRow()
        if (!r || !r.canKill)
            return
        if (r.appId && r.appId.length) {
            for (var i = windows.count - 1; i >= 0; --i) {
                if (windows.get(i).appId === r.appId)
                    windows.remove(i)
            }
            notify("Диспетчер задач", "Закрыто: " + r.name, "ok")
        } else if (r.pid > 1) {
            sys.run("kill " + r.pid + " 2>/dev/null; sleep 0.2; kill -9 " + r.pid + " 2>/dev/null")
            notify("Диспетчер задач", "Завершено: " + r.name, "ok")
        }
        taskMgrSelKey = ""
        refreshTaskMgr()
    }

