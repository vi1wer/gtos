    function daysInMonth(y, m) {
        return new Date(y, m + 1, 0).getDate()
    }

    function calCells() {
        var first = new Date(calYear, calMonth, 1).getDay()
        first = first === 0 ? 6 : first - 1
        var dim = daysInMonth(calYear, calMonth)
        if (calSelectedDay > dim)
            calSelectedDay = dim
        var cells = []
        var i
        for (i = 0; i < first; ++i)
            cells.push({ d: "", day: 0, on: false, sel: false })
        for (i = 1; i <= dim; ++i) {
            var today = now.getFullYear() === calYear && now.getMonth() === calMonth && now.getDate() === i
            cells.push({ d: "" + i, day: i, on: today, sel: calSelectedDay === i })
        }
        while (cells.length % 7 !== 0)
            cells.push({ d: "", day: 0, on: false, sel: false })
        return cells
    }

