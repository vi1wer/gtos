    function calcPress(key) {
        if (key === "C") {
            calcDisplay = "0"
            calcExpr = ""
            calcAwaitingOperand = false
            calcJustEvaluated = false
            return
        }
        if (key === "⌫" || key === "Backspace") {
            if (calcAwaitingOperand || calcJustEvaluated || calcDisplay === "ошибка")
                return
            if (calcDisplay.length <= 1)
                calcDisplay = "0"
            else
                calcDisplay = calcDisplay.slice(0, -1)
            return
        }
        if (key === "±") {
            if (calcDisplay === "0" || calcDisplay === "ошибка")
                return
            if (calcDisplay.charAt(0) === "-")
                calcDisplay = calcDisplay.slice(1)
            else
                calcDisplay = "-" + calcDisplay
            calcAwaitingOperand = false
            calcJustEvaluated = false
            return
        }
        if (key === "%") {
            var pct = parseFloat(calcDisplay)
            if (isNaN(pct))
                return
            calcDisplay = String(pct / 100)
            calcAwaitingOperand = false
            calcJustEvaluated = false
            return
        }
        if (key === "=") {
            if (calcJustEvaluated && !calcExpr.length)
                return
            var expr = (calcExpr + calcDisplay).replace(/×/g, "*").replace(/÷/g, "/").replace(/−/g, "-")
            var safe = ""
            for (var si = 0; si < expr.length; ++si) {
                var ch = expr.charAt(si)
                if ((ch >= "0" && ch <= "9") || "+-*.()/ ".indexOf(ch) >= 0)
                    safe += ch
            }
            var out = sys.run("awk 'BEGIN{printf \"%.10g\\n\", (" + safe + ")}' 2>/dev/null").trim()
            if (!out.length || out.indexOf("nan") >= 0 || out.indexOf("inf") >= 0 || out.indexOf("Inf") >= 0)
                calcDisplay = "ошибка"
            else
                calcDisplay = out
            calcExpr = ""
            calcAwaitingOperand = false
            calcJustEvaluated = true
            return
        }
        if ("+-×÷".indexOf(key) >= 0) {
            if (calcAwaitingOperand && calcExpr.length) {
                calcExpr = calcExpr.slice(0, -1) + key
                return
            }
            calcExpr += calcDisplay + key
            calcAwaitingOperand = true
            calcJustEvaluated = false
            return
        }
        if (key === ".") {
            if (calcAwaitingOperand || calcJustEvaluated || calcDisplay === "ошибка") {
                calcDisplay = "0."
                calcAwaitingOperand = false
                calcJustEvaluated = false
                return
            }
            if (calcDisplay.indexOf(".") >= 0)
                return
            calcDisplay += "."
            return
        }
        if (calcAwaitingOperand || calcJustEvaluated || calcDisplay === "0" || calcDisplay === "ошибка") {
            calcDisplay = key
            calcAwaitingOperand = false
            calcJustEvaluated = false
        } else {
            calcDisplay += key
        }
    }

    function calNoteKey(y, m, d) {
        var mm = (m < 9 ? "0" : "") + (m + 1)
        var dd = (d < 10 ? "0" : "") + d
        return y + "-" + mm + "-" + dd
    }

    function calNoteText() {
