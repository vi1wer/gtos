            return
        var tabs = fileTabs.slice()
        tabs.splice(idx, 1)
        fileTabs = tabs
        if (fileTab >= tabs.length)
            fileTab = tabs.length - 1
        else if (idx < fileTab)
            fileTab = fileTab - 1
        openPlace(fileTabs[fileTab].path)
