    function isImageName(name) {
        var n = String(name || "").toLowerCase()
        return n.indexOf(".png") > 0 || n.indexOf(".jpg") > 0 || n.indexOf(".jpeg") > 0
            || n.indexOf(".webp") > 0 || n.indexOf(".gif") > 0 || n.indexOf(".bmp") > 0
    }

    function isPdfName(name) {
        return /\.pdf$/i.test(String(name || ""))
    }

    function isKnownFileExt(name) {
        var n = String(name || "").toLowerCase()
        var dot = n.lastIndexOf(".")
        if (dot <= 0 || dot >= n.length - 1)
            return false
        var ext = n.slice(dot + 1)
        var known = {
            png:1, jpg:1, jpeg:1, webp:1, gif:1, bmp:1, svg:1,
            txt:1, md:1, log:1, conf:1, cfg:1, json:1, xml:1, csv:1, ini:1,
            qml:1, js:1, ts:1, py:1, sh:1, c:1, cpp:1, h:1, hpp:1, css:1, html:1, htm:1, rtf:1,
            mp4:1, mkv:1, avi:1, webm:1, mov:1, m4v:1,
            mp3:1, flac:1, ogg:1, wav:1, m4a:1, aac:1,
            ttf:1, otf:1, woff:1, woff2:1,
            zip:1, tar:1, gz:1, tgz:1, "7z":1, rar:1,
            pdf:1, desktop:1, lnk:1
        }
        return !!known[ext]
    }

    function fileEntryKind(name, isDir) {
        if (isDir)
            return "dir"
        var n = String(name || "").toLowerCase()
        if (n.indexOf(".desktop") > 0 || n.indexOf(".lnk") > 0)
            return "link"
        if (isPdfName(n))
            return "pdf"
        if (isImageName(n))
            return "image"
        if (/\.(txt|md|log|conf|cfg|json|xml|csv|ini|qml|js|ts|py|sh|c|cpp|h|hpp|css|html|htm|svg|rtf)$/.test(n))
            return "text"
        if (/\.(mp4|mkv|avi|webm|mov|m4v)$/.test(n))
            return "video"
        if (/\.(mp3|flac|ogg|wav|m4a|aac)$/.test(n))
            return "audio"
        if (isFontName(n))
            return "font"
        if (isArchiveName(n))
            return "archive"
        if (!isKnownFileExt(n))
            return "unknown"
        return "file"
    }

    function compactCtxItems(items) {
        var out = []
        for (var i = 0; i < (items || []).length; ++i) {
            var it = items[i]
            if (!it || it.disabled === true)
                continue
            if (it.action === "sep") {
                if (!out.length || out[out.length - 1].action === "sep")
                    continue
                out.push(it)
                continue
            }
            out.push(it)
        }
        while (out.length && out[out.length - 1].action === "sep")
            out.pop()
        return out
    }

