    function uniquePath(base, stem, ext) {
        var name = stem + ext
        var path = base + "/" + name
        var n = 1
        while (sys.run("test -e " + shQuote(path) + " && echo yes").trim() === "yes") {
            name = stem + " " + n + ext
            path = base + "/" + name
            n++
        }
        return { name: name, path: path }
    }

    function deskCreateIn(base, kind) {
        sys.run("mkdir -p " + shQuote(base))
        if (kind === "dir" || kind === "folder") {
            var d = uniquePath(base, "Новая папка", "")
            sys.run("mkdir -p " + shQuote(d.path))
            notify("Рабочий стол", "Создана папка «" + d.name + "»", "ok")
            return d.path
        }
        if (kind === "txt" || kind === "file") {
            var t = uniquePath(base, "Новый текстовый документ", ".txt")
            sys.writeFile(t.path, "")
            notify("Рабочий стол", "Создан текстовый файл", "ok")
            return t.path
        }
        if (kind === "blank" || kind === "unknown") {
            var b = uniquePath(base, "Новый файл", "")
            sys.writeFile(b.path, "")
            notify("Рабочий стол", "Создан файл неизвестного типа", "ok")
            return b.path
        }
        if (kind === "pdf") {
            var p = uniquePath(base, "Новый документ", ".pdf")
            // минимальный валидный PDF (пустая страница)
            sys.writeFile(p.path,
                "%PDF-1.1\n1 0 obj<<>>endobj\n2 0 obj<< /Length 44 >>stream\nBT /F1 24 Tf 100 700 Td (GT/OS) Tj ET\nendstream\nendobj\n"
                + "3 0 obj<< /Type /Page /Parent 4 0 R /MediaBox [0 0 612 792] /Contents 2 0 R >>endobj\n"
                + "4 0 obj<< /Type /Pages /Kids [3 0 R] /Count 1 >>endobj\n"
                + "5 0 obj<< /Type /Catalog /Pages 4 0 R >>endobj\n"
                + "xref\n0 6\n0000000000 65535 f \ntrailer<< /Size 6 /Root 5 0 R >>\nstartxref\n0\n%%EOF\n")
            notify("Рабочий стол", "Создан PDF", "ok")
            return p.path
        }
        if (kind === "lnk" || kind === "shortcut") {
            var l = uniquePath(base, "Новый ярлык", ".desktop")
            sys.writeFile(l.path, "[Desktop Entry]\nType=Application\nName=Ярлык GT/OS\nExec=gt-shell\nIcon=application\n")
            notify("Рабочий стол", "Создан ярлык", "ok")
            return l.path
        }
        if (kind === "zip") {
            var z = uniquePath(base, "Новый архив", ".zip")
            // минимальный пустой ZIP
            sys.run("printf 'PK\\x05\\x06\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00' > " + shQuote(z.path))
            notify("Рабочий стол", "Создана сжатая папка (.zip)", "ok")
            return z.path
        }
        return ""
    }

    function deskPath(di) {
        var i = (di === undefined || di === null) ? deskIndex : di
        i = Math.max(0, parseInt(i, 10) || 0)
        // основной стол — привычная папка; остальные пространства — свои каталоги
        if (i <= 0)
            return "/home/" + currentUser + "/Рабочий стол"
        return "/home/" + currentUser + "/.local/share/gtos/desktops/" + i
