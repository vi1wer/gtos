    function filteredLauncherApps() {
        var q = query.trim().toLowerCase()
        var all = allLauncherApps()
        var out = []
        for (var i = 0; i < all.length; ++i) {
            var a = all[i]
            if (q.length && a.name.toLowerCase().indexOf(q) < 0 && a.id.indexOf(q) < 0)
                continue
            out.push(a)
        }
        return out
    }

    function syncInstalledFromSystem() {
        var map = {}
        for (var k in installedApps) {
            if (installedApps[k])
                map[k] = true
        }
        // Один shell вместо десятков command -v на UI-потоке
        var c = storeCatalog()
        var checks = []
        for (var i = 0; i < c.length; ++i) {
            var a = c[i]
            if (!a || !a.id || map[a.id])
                continue
            var bins = []
            if (a.engineBins && a.engineBins.length) {
                for (var e = 0; e < a.engineBins.length; ++e)
                    bins.push(String(a.engineBins[e] || "").replace(/[^a-zA-Z0-9._+-]/g, ""))
            }
            if (a.apk)
                bins.push(String(a.apk).replace(/[^a-zA-Z0-9._+-]/g, ""))
            bins.push(String(a.id).replace(/[^a-zA-Z0-9._+-]/g, ""))
            bins = bins.filter(function (b) { return b.length })
            checks.push(a.id + "=" + bins.join("|"))
        }
        if (checks.length) {
            var script = "for spec in " + checks.map(function (s) { return shQuote(s) }).join(" ") + "; do "
                + "id=${spec%%=*}; bins=${spec#*=}; found=0; "
                + "[ -d /var/lib/gtos/apps/$id ] && found=1; "
                + "IFS='|'; for b in $bins; do [ -n \"$b\" ] && command -v \"$b\" >/dev/null 2>&1 && found=1 && break; done; "
                + "[ \"$found\" = 1 ] && echo \"$id\"; done"
            var raw = (typeof sys.runTimeout === "function" ? sys.runTimeout(script, 4000) : sys.run(script)).trim()
            if (raw.length) {
                var ids = raw.split("\n")
                for (var j = 0; j < ids.length; ++j)
                    if (ids[j].trim().length)
                        map[ids[j].trim()] = true
            }
        }
        installedApps = map
        var keys = []
        for (var id in map)
            if (map[id])
                keys.push(id)
        sys.writeFile("/var/lib/gtos/installed.json", keys.join(",") + "\n")
        refreshAppIconCache()
    }

    function frequentLauncherApps() {
        var scores = {}
        for (var k in appLaunchLog) {
            var id = String(k).split("@")[0]
            scores[id] = (scores[id] || 0) + appLaunchLog[k]
        }
        var all = allLauncherApps()
        var ranked = all.slice().sort(function (a, b) {
            return (scores[b.id] || 0) - (scores[a.id] || 0)
        })
        // всегда показывать закреплённые первыми, затем по частоте
        var out = []
        var seen = {}
        for (var p = 0; p < pinnedApps.length; ++p) {
            for (var i = 0; i < ranked.length; ++i) {
                if (ranked[i].id === pinnedApps[p] && !seen[ranked[i].id]) {
                    out.push(ranked[i]); seen[ranked[i].id] = true; break
                }
            }
        }
        for (var j = 0; j < ranked.length && out.length < 12; ++j) {
            if (!seen[ranked[j].id]) {
                out.push(ranked[j]); seen[ranked[j].id] = true
            }
        }
        return out
    }

    function recentInstalledApps() {
