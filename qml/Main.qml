                    } else if (n === "gear") {
                        S(function () {
                            ctx.arc(9, 9, 2.4, 0, Math.PI * 2)
                            for (var j = 0; j < 6; ++j) {
                                var b = j * Math.PI / 3
                                ctx.moveTo(9 + Math.cos(b) * 4.2, 9 + Math.sin(b) * 4.2)
