    function mapRuKey(event) {
        if (!event || inputLang !== "ru")
            return null
        // Если XKB уже дал кириллицу — не трогаем
        var t = event.text || ""
        if (t.length && /[А-Яа-яЁё]/.test(t))
            return null
        var lower = "qwertyuiop[]asdfghjkl;'zxcvbnm,./`"
        var ruLow = "йцукенгшщзхъфывапролджэячсмитьбю.ё"
        var upper = "QWERTYUIOP{}ASDFGHJKL:\"ZXCVBNM<>?~"
        var ruUp = "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,Ё"
        if (t.length) {
            var i = lower.indexOf(t)
            if (i >= 0)
                return ruLow.charAt(i)
            i = upper.indexOf(t)
            if (i >= 0)
                return ruUp.charAt(i)
            // Цифры/прочее с Shift на EN — не дублируем
            if (t.length === 1 && t.charCodeAt(0) < 127)
                return null
        }
        // Запасной путь по коду клавиши (когда text пустой)
        var shift = !!(event.modifiers & Qt.ShiftModifier)
        var codes = [
            Qt.Key_Q, Qt.Key_W, Qt.Key_E, Qt.Key_R, Qt.Key_T, Qt.Key_Y, Qt.Key_U, Qt.Key_I, Qt.Key_O, Qt.Key_P,
            Qt.Key_BracketLeft, Qt.Key_BracketRight,
            Qt.Key_A, Qt.Key_S, Qt.Key_D, Qt.Key_F, Qt.Key_G, Qt.Key_H, Qt.Key_J, Qt.Key_K, Qt.Key_L,
            Qt.Key_Semicolon, Qt.Key_Apostrophe,
            Qt.Key_Z, Qt.Key_X, Qt.Key_C, Qt.Key_V, Qt.Key_B, Qt.Key_N, Qt.Key_M,
            Qt.Key_Comma, Qt.Key_Period, Qt.Key_Slash, Qt.Key_QuoteLeft
        ]
        for (var k = 0; k < codes.length; ++k) {
            if (event.key === codes[k]) {
                var ch = shift ? ruUp.charAt(k) : ruLow.charAt(k)
                return ch.length ? ch : null
            }
        }
        return null
    }

    // Если выбран ENG, а XKB всё ещё отдаёт кириллицу — вернём латиницу
    function mapEnKey(event) {
        if (!event || inputLang !== "en")
            return null
        var t = event.text || ""
        var ruLow = "йцукенгшщзхъфывапролджэячсмитьбю.ё"
        var lower = "qwertyuiop[]asdfghjkl;'zxcvbnm,./`"
        var ruUp = "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,Ё"
        var upper = "QWERTYUIOP{}ASDFGHJKL:\"ZXCVBNM<>?~"
        if (t.length) {
            if (/[A-Za-z0-9]/.test(t))
                return null
            var i = ruLow.indexOf(t)
            if (i >= 0)
                return lower.charAt(i)
            i = ruUp.indexOf(t)
            if (i >= 0)
                return upper.charAt(i)
            return null
        }
        // text пустой — восстанавливаем латиницу по коду клавиши
        var shift = !!(event.modifiers & Qt.ShiftModifier)
        var codes = [
            Qt.Key_Q, Qt.Key_W, Qt.Key_E, Qt.Key_R, Qt.Key_T, Qt.Key_Y, Qt.Key_U, Qt.Key_I, Qt.Key_O, Qt.Key_P,
            Qt.Key_BracketLeft, Qt.Key_BracketRight,
            Qt.Key_A, Qt.Key_S, Qt.Key_D, Qt.Key_F, Qt.Key_G, Qt.Key_H, Qt.Key_J, Qt.Key_K, Qt.Key_L,
            Qt.Key_Semicolon, Qt.Key_Apostrophe,
            Qt.Key_Z, Qt.Key_X, Qt.Key_C, Qt.Key_V, Qt.Key_B, Qt.Key_N, Qt.Key_M,
            Qt.Key_Comma, Qt.Key_Period, Qt.Key_Slash, Qt.Key_QuoteLeft
        ]
        for (var k = 0; k < codes.length; ++k) {
            if (event.key === codes[k]) {
                var ch = shift ? upper.charAt(k) : lower.charAt(k)
                return ch.length ? ch : null
            }
        }
        return null
    }

