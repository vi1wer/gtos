        refreshMediaTimeLabel()
        sys.run("pkill -x mpg123 2>/dev/null; pkill -x ffplay 2>/dev/null; pkill -x cvlc 2>/dev/null; pkill -x vlc 2>/dev/null; true")
        notify("Медиаплеер", "Стоп", "ok")
    }

    function seekMediaPlayer(ratio) {
        musicPos = Math.max(0, Math.min(1, ratio))
        if (mediaDurationSec > 0)
            mediaElapsedSec = Math.floor(musicPos * mediaDurationSec)
        refreshMediaTimeLabel()
        if (!vlcTrackPath.length || !vlcPlaying)
            return
        var ss = mediaElapsedSec
        var vol = Math.round(mediaVolume * 100)
        sys.run(
            "pkill -x ffplay 2>/dev/null; pkill -x cvlc 2>/dev/null; pkill -x vlc 2>/dev/null; "
            + "export DISPLAY=${DISPLAY:-:0}; "
