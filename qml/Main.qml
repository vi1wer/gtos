                    ctx.fillStyle = "#f9a825"
                    ctx.beginPath(); ctx.moveTo(18, 2); ctx.lineTo(34, 32); ctx.lineTo(2, 32); ctx.closePath(); ctx.fill()
                    ctx.fillStyle = "#212121"
                    ctx.fillRect(16, 12, 4, 10)
