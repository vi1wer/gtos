                        root.clipHistOpen = false
                    }
                }
            }

            // батарея (только если есть BAT*) — заливка и цвет по заряду
            Item {
                visible: root.batteryPresent
                width: visible ? 42 : 0
                height: 34
                Canvas {
                    id: batCv
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.top: parent.top
                    anchors.topMargin: 4
                    width: 24; height: 12
                    onPaint: {
                        var ctx = getContext("2d")
                        var ink = root.batteryInk()
                        var pct = Math.max(0, Math.min(100, root.batteryPct)) / 100
                        ctx.clearRect(0, 0, width, height)
                        ctx.strokeStyle = ink
                        ctx.lineWidth = 1.5
                        ctx.beginPath()
                        ctx.rect(0.5, 1.5, 18, 9)
                        ctx.stroke()
                        ctx.beginPath()
                        ctx.moveTo(19.5, 4); ctx.lineTo(22, 4); ctx.lineTo(22, 8); ctx.lineTo(19.5, 8)
                        ctx.stroke()
                        var fw = Math.max(0, 14 * pct)
                        if (fw > 0.4) {
                            ctx.fillStyle = ink
                            ctx.fillRect(2.5, 3.5, fw, 5)
                        }
                        if (root.batteryCharging) {
                            ctx.fillStyle = "#ffffff"
                            ctx.beginPath()
                            ctx.moveTo(9, 2.5); ctx.lineTo(6.5, 6.5); ctx.lineTo(9.2, 6.5)
                            ctx.lineTo(8, 10.5); ctx.lineTo(11.5, 5.5); ctx.lineTo(8.8, 5.5)
                            ctx.closePath()
                            ctx.fill()
                        }
                    }
                    Connections {
                        target: root
                        function onBatteryPctChanged() { batCv.requestPaint() }
                        function onBatteryPresentChanged() { batCv.requestPaint() }
                        function onBatteryChargingChanged() { batCv.requestPaint() }
                    }
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.bottom: parent.bottom
                    anchors.bottomMargin: 0
                    text: root.batteryPct + "%"
                    color: root.batteryInk()
                    font.pixelSize: 8
                    font.family: root.uiFontBold
                }
            }

            // уведомления — outline bell
            Item {
                width: 28; height: 34
                Canvas {
                    id: bellCv
                    anchors.centerIn: parent
                    width: 16; height: 16
                    onPaint: {
                        var ctx = getContext("2d")
                        ctx.strokeStyle = root.notifyCenterOpen || bellHover.containsMouse ? "#ffffff" : "#e8eef2"
                        ctx.lineWidth = 1.5
                        ctx.lineJoin = "round"
                        ctx.beginPath()
                        ctx.moveTo(3, 7)
                        ctx.quadraticCurveTo(3, 3, 8, 3)
                        ctx.quadraticCurveTo(13, 3, 13, 7)
                        ctx.lineTo(13, 10)
                        ctx.lineTo(15, 12)
                        ctx.lineTo(1, 12)
                        ctx.lineTo(3, 10)
                        ctx.closePath()
                        ctx.stroke()
                        ctx.beginPath()
                        ctx.arc(8, 13.5, 1.6, 0, Math.PI, false)
                        ctx.stroke()
                    }
                }
                Rectangle {
                    visible: root.notifications.length > 0
                    anchors.right: parent.right; anchors.top: parent.top
                    anchors.rightMargin: 2; anchors.topMargin: 6
                    width: 6; height: 6; radius: 3
                    color: "#e8eef2"
                }
                MouseArea {
                    id: bellHover
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        root.notifyCenterOpen = !root.notifyCenterOpen
                        if (root.notifyCenterOpen) {
                            root.calendarOpen = false
                            root.quickOpen = false
                            root.startOpen = false
                            root.workspacesOpen = false
                        }
                        bellCv.requestPaint()
                    }
                    onContainsMouseChanged: bellCv.requestPaint()
                }
            }

            // сеть / звук — индикаторы уровня
            Item {
                id: statusCluster
                width: 64
                height: 34
                opacity: trayHover.containsMouse || root.quickOpen ? 1 : 0.92
                Row {
                    anchors.centerIn: parent
                    spacing: 10
                    layoutDirection: Qt.LeftToRight
                    Item {
                        width: root.netLink === "wifi" ? 28 : 24
                        height: 34
                        // точь-в-точь образец: монитор + штекер справа с проводом
                        Item {
                            id: ethIcon
                            visible: root.netLink === "eth"
                            anchors.centerIn: parent
                            width: 18
                            height: 16
                            readonly property color ink: "#ffffff"
                            // монитор
                            Rectangle {
                                x: 0; y: 1
                                width: 12; height: 10
                                radius: 1
                                color: "transparent"
                                border.color: ethIcon.ink
                                border.width: 1.5
                            }
                            // ножки стойки
                            Rectangle { x: 4; y: 11; width: 1.5; height: 2; color: ethIcon.ink }
                            Rectangle { x: 6.5; y: 11; width: 1.5; height: 2; color: ethIcon.ink }
                            // подставка
                            Rectangle { x: 2.5; y: 13; width: 7; height: 1.5; color: ethIcon.ink }
                            // штекер (наезжает на правый край монитора)
                            Rectangle {
                                x: 10; y: 0
                                width: 6; height: 8
                                radius: 1
                                color: "transparent"
                                border.color: ethIcon.ink
                                border.width: 1.5
                            }
                            // прорезь в штекере
                            Rectangle {
                                x: 11.5; y: 2
                                width: 3; height: 1.2
                                color: ethIcon.ink
                            }
                            // кабель вниз до уровня подставки
                            Rectangle {
                                x: 12.25; y: 8
                                width: 1.5; height: 7
                                color: ethIcon.ink
                            }
                        }
                        Canvas {
                            id: wifiCv
                            visible: root.netLink !== "eth"
                            anchors.horizontalCenter: parent.horizontalCenter
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.verticalCenterOffset: root.netLink === "wifi" ? -4 : 0
                            width: 18
                            height: 14
                            onPaint: {
                                var ctx = getContext("2d")
                                ctx.clearRect(0, 0, width, height)
                                var link = root.netLink
                                var sig = root.wifiSignal
                                var on = link !== "none"
                                var dim = "#3d4a55"
                                var ink = on ? "#e8eef2" : "#6b7785"
                                var bars = 0
                                if (sig >= 70)
                                    bars = 3
                                else if (sig >= 40)
                                    bars = 2
                                else if (sig >= 12)
                                    bars = 1
                                else if (on)
                                    bars = 0
                                function arc(r, lit) {
                                    ctx.strokeStyle = lit ? ink : dim
                                    ctx.lineWidth = lit ? 1.7 : 1.3
                                    ctx.beginPath()
                                    ctx.arc(9, 13, r, Math.PI * 1.18, Math.PI * 1.82, false)
                                    ctx.stroke()
                                }
                                arc(3.2, bars >= 0 && on)
                                arc(6.2, bars >= 2)
                                arc(9.2, bars >= 3)
                                ctx.fillStyle = on ? ink : dim
                                ctx.beginPath(); ctx.arc(9, 13, 1.4, 0, Math.PI * 2); ctx.fill()
                            }
                            Connections {
                                target: root
                                function onNetIpChanged() { wifiCv.requestPaint() }
                                function onWifiSignalChanged() { wifiCv.requestPaint() }
                                function onNetLinkChanged() { wifiCv.requestPaint() }
                            }
                        }
                        Text {
                            visible: root.netLink === "wifi" && root.wifiSignal >= 0
                            anchors.horizontalCenter: parent.horizontalCenter
                            anchors.bottom: parent.bottom
                            anchors.bottomMargin: 0
                            text: root.wifiSignal + "%"
                            color: "#c5d0d8"
                            font.pixelSize: 8
                            font.family: root.uiFontBold
                        }
                    }
                    Item {
                        width: 22; height: 34
                        Canvas {
                            id: volCv
                            anchors.centerIn: parent
                            width: 18; height: 14
                            onPaint: {
                                var ctx = getContext("2d")
                                ctx.clearRect(0, 0, width, height)
                                var muted = root.muted || root.volume < 0.02
                                var v = muted ? 0 : root.volume
                                var ink = muted ? "#6b7785" : (v > 0.7 ? "#60a5fa" : "#e8eef2")
                                var dim = "#3d4a55"
                                ctx.strokeStyle = ink
                                ctx.fillStyle = ink
                                ctx.lineWidth = 1.4
                                ctx.lineJoin = "round"
                                ctx.beginPath()
                                ctx.moveTo(1, 5); ctx.lineTo(5, 5); ctx.lineTo(9, 2); ctx.lineTo(9, 12); ctx.lineTo(5, 9); ctx.lineTo(1, 9); ctx.closePath()
                                ctx.stroke()
                                if (v > 0.08)
                                    ctx.fill()
                                if (muted) {
                                    ctx.beginPath(); ctx.moveTo(11, 4); ctx.lineTo(16, 11); ctx.moveTo(16, 4); ctx.lineTo(11, 11); ctx.stroke()
                                } else {
                                    function wave(r, lit) {
                                        ctx.strokeStyle = lit ? ink : dim
                                        ctx.lineWidth = lit ? 1.6 : 1.2
                                        ctx.beginPath(); ctx.arc(9, 7, r, -0.75, 0.75, false); ctx.stroke()
                                    }
                                    wave(3.5, v >= 0.08)
                                    wave(6.2, v >= 0.38)
                                    wave(8.8, v >= 0.72)
                                }
                            }
                            Connections {
                                target: root
                                function onVolumeChanged() { volCv.requestPaint() }
                                function onMutedChanged() { volCv.requestPaint() }
                            }
                        }
                    }
                }
                MouseArea {
                    id: trayHover
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        root.quickOpen = !root.quickOpen
                        root.notifyCenterOpen = false
                        root.workspacesOpen = false
                        if (root.quickOpen) root.startOpen = false
                    }
                }
            }
        }
