    function normalizeAppIconId(appId) {
        var id = String(appId || "")
        if (id.indexOf("pkg-") === 0)
            id = id.slice(4)
        return id
    }

    function isBuiltinShellApp(appId) {
        var id = normalizeAppIconId(appId)
        return id === "files" || id === "term" || id === "browser" || id === "mail"
            || id === "settings" || id === "store" || id === "notes" || id === "photos" || id === "weather"
            || id === "music" || id === "video" || id === "cal" || id === "draw"
            || id === "calc" || id === "monitor" || id === "control" || id === "recovery"
            || id === "power" || id === "archive" || id === "fonts" || id === "updates"
            || id === "storage" || id === "privacy" || id === "security" || id === "install"
            || id === "pkg"
    }

    function isThirdPartyApp(appId) {
        var id = normalizeAppIconId(appId)
        if (!id.length || isBuiltinShellApp(id))
            return false
        if (id.indexOf("pkg-") === 0)
            return true
        var sa = storeAppById(id)
        if (!sa)
            return !!installedApps[id]
        if (sa.store === true)
            return true
        if (sa.source === "alpine" || sa.source === "web" || sa.source === "linux" || sa.source === "windows")
            return true
        if (sa.engineBins && sa.engineBins.length)
            return true
        if (sa.apk && String(sa.apk).length)
            return true
        return false
    }

    function storePlatformOf(app) {
        if (!app)
            return "alpine"
        if (app.platform)
            return String(app.platform)
        var s = String(app.source || "")
        if (s === "linux" || s === "windows" || s === "web" || s === "alpine")
            return s
        if (app.apk)
            return "alpine"
        return "web"
    }

    function storePlatformLabel(p) {
        if (p === "linux") return "Linux"
        if (p === "windows") return "Windows"
        if (p === "web") return "Веб"
        if (p === "alpine") return "Alpine"
        return "Все"
    }

    function refreshAppIconCache() {
        var c = storeCatalog()
        var names = []
        var i
        for (i = 0; i < c.length; ++i) {
            if (!c[i] || !c[i].id)
                continue
            if (c[i].source === "alpine" || c[i].source === "web" || c[i].source === "linux"
                    || c[i].source === "windows" || (c[i].engineBins && c[i].engineBins.length))
                names.push(String(c[i].id))
        }
        for (var k in installedApps) {
            if (installedApps[k] && names.indexOf(k) < 0)
                names.push(String(k))
        }
        if (!names.length)
            return
        var script = "mkdir -p /usr/share/gtos/app-icons 2>/dev/null; "
            + "resolve(){ f=\"$1\"; [ -e \"$f\" ]||return 1; "
            + "if [ -L \"$f\" ]; then t=$(readlink \"$f\" 2>/dev/null); "
            + "case \"$t\" in /*) echo \"$t\";; *) echo \"$(dirname \"$f\")/$t\";; esac; "
            + "else echo \"$f\"; fi; }; "
            + "for id in " + names.map(function (n) { return shQuote(n) }).join(" ") + "; do "
            + "  found=; "
            + "  for f in /usr/share/gtos/app-icons/$id.png /usr/share/gtos/app-icons/$id.svg; do "
            + "    p=$(resolve \"$f\") && found=$p && break; done; "
            + "  if [ -z \"$found\" ]; then "
            + "    for n in \"$id\" \"${id%-desktop}\" \"${id%-bin}\"; do "
            + "      for s in 256 128 192 64 48 32; do "
            + "        p=$(resolve /usr/share/icons/hicolor/${s}x${s}/apps/$n.png) && found=$p && break 2; "
            + "      done; "
            + "      p=$(resolve /usr/share/icons/hicolor/scalable/apps/$n.svg) && found=$p && break; "
            + "    done; "
            + "  fi; "
            + "  if [ -z \"$found\" ] && [ \"$id\" = firefox ]; then "
            + "    for f in /usr/lib/firefox/browser/chrome/icons/default/default256.png "
            + "             /usr/lib/firefox/browser/chrome/icons/default/default128.png "
            + "             /usr/lib/firefox/browser/chrome/icons/default/default64.png; do "
            + "      p=$(resolve \"$f\") && found=$p && break; done; "
            + "  fi; "
            + "  if [ -z \"$found\" ] && [ \"$id\" = vlc ]; then "
            + "    p=$(resolve /usr/share/vlc/lua/http/images/vlc-48.png) && found=$p; "
            + "  fi; "
            + "  [ -n \"$found\" ] && echo \"$id|$found\"; "
            + "done"
        var raw = (typeof sys.runTimeout === "function" ? sys.runTimeout(script, 3500) : sys.run(script)).trim()
        var map = {}
        for (var key in appIconPaths)
            map[key] = appIconPaths[key]
        if (raw.length) {
            var lines = raw.split("\n")
            for (i = 0; i < lines.length; ++i) {
                var line = lines[i].trim()
                var pipe = line.indexOf("|")
                if (pipe <= 0)
                    continue
                map[line.slice(0, pipe)] = line.slice(pipe + 1)
            }
        }
        // статические запасные пути (если shell не успел / нет readlink)
        if (!map.firefox)
            map.firefox = "/usr/lib/firefox/browser/chrome/icons/default/default128.png"
        if (!map.vlc)
            map.vlc = "/usr/share/vlc/lua/http/images/vlc-48.png"
        appIconPaths = map
    }

    function appIconPath(appId) {
        var id = normalizeAppIconId(appId)
        if (!id.length || isBuiltinShellApp(id))
            return ""
        if (appIconPaths[id])
            return appIconPaths[id]
        var sa = storeAppById(id)
        if (sa && sa.iconFile)
            return String(sa.iconFile)
        if (id === "firefox")
            return "/usr/share/gtos/app-icons/firefox.png"
        if (id === "vlc")
            return "/usr/share/gtos/app-icons/vlc.png"
        if (id === "chromium")
            return "/usr/share/gtos/app-icons/chromium.png"
        if (id === "telegram" || id === "telegram-desktop")
            return "/usr/share/gtos/app-icons/telegram.png"
        if (id === "gimp")
            return "/usr/share/gtos/app-icons/gimp.png"
        if (id === "libreoffice")
            return "/usr/share/gtos/app-icons/libreoffice.png"
        return "/usr/share/gtos/app-icons/" + id + ".png"
    }

    function winIconKind(appId) {
        var s = String(appId || "")
        if (s.indexOf("pkg-") === 0) {
            var pkg = storeAppById(s.slice(4))
            return pkg ? (pkg.iconKind || "store") : "store"
