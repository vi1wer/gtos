    function pushClipboard(text) {
        if (!text || !text.length)
            return
        var entry = { id: Date.now(), text: text, pinned: false, time: Qt.formatTime(new Date(), "HH:mm") }
        var pinned = []
        var rest = [entry]
        for (var i = 0; i < clipHistory.length; ++i) {
            var c = clipHistory[i]
            var t = (typeof c === "string") ? c : (c.text || "")
            if (t === text)
                continue
            var obj = (typeof c === "string") ? { id: i + 1, text: c, pinned: false, time: "" } : c
            if (obj.pinned)
                pinned.push(obj)
            else
                rest.push(obj)
        }
        var arr = pinned.concat(rest)
        if (arr.length > 24)
            arr = arr.slice(0, 24)
        clipHistory = arr
        // X11 clipboard для Firefox и других приложений
        sys.writeFile("/tmp/gtos-clip.txt", text)
        sys.run("( command -v xclip >/dev/null 2>&1 && "
                + "xclip -selection clipboard < /tmp/gtos-clip.txt 2>/dev/null; "
                + "xclip -selection primary < /tmp/gtos-clip.txt 2>/dev/null; "
                + "command -v xsel >/dev/null 2>&1 && xsel --clipboard < /tmp/gtos-clip.txt 2>/dev/null; "
                + "true ) >/dev/null 2>&1 &")
    }

    function syncClipboardFromX11() {
        var t = ""
        if (typeof sys.runTimeout === "function")
            t = sys.runTimeout("xclip -selection clipboard -o 2>/dev/null | head -c 8000", 800).trim()
        else
            t = sys.run("xclip -selection clipboard -o 2>/dev/null | head -c 8000").trim()
        if (!t.length || t === "таймаут")
            return
        var top = clipHistory.length ? clipEntryText(clipHistory[0]) : ""
        if (t === top)
            return
        // только история, без повторной записи в X11
        var entry = { id: Date.now(), text: t, pinned: false, time: Qt.formatTime(new Date(), "HH:mm") }
        var arr = [entry]
        for (var i = 0; i < clipHistory.length && arr.length < 24; ++i) {
            var c = clipHistory[i]
            if (clipEntryText(c) === t)
                continue
            arr.push(typeof c === "string" ? { id: i + 1, text: c, pinned: false, time: "" } : c)
        }
        clipHistory = arr
    }

    function pollExternalNotifications() {
        var raw = sys.readFile("/var/lib/gtos/notify-inbox").trim()
        if (!raw.length)
            return
        sys.writeFile("/var/lib/gtos/notify-inbox", "")
        var lines = raw.split("\n")
        for (var i = 0; i < lines.length; ++i) {
            var L = lines[i].trim()
            if (!L.length)
                continue
            var p = L.split("|")
            var app = p.length > 1 ? p[1] : "Приложение"
            var title = p.length > 2 ? p[2] : app
            var body = p.length > 3 ? p.slice(3).join("|") : ""
            notify(title || app, body, "info")
        }
    }

    function fileExtOf(name) {
        var n = String(name || "").toLowerCase()
        var dot = n.lastIndexOf(".")
        if (dot <= 0 || dot >= n.length - 1)
            return ""
        return n.slice(dot + 1)
    }

    function loadFileAssoc() {
        var raw = sys.readFile("/var/lib/gtos/file-assoc.json").trim()
        if (!raw.length) {
            fileAssoc = {}
            return
        }
        try {
            var o = JSON.parse(raw)
            fileAssoc = (o && typeof o === "object") ? o : {}
        } catch (e) {
            fileAssoc = {}
        }
    }

    function saveFileAssoc() {
        sys.run("mkdir -p /var/lib/gtos")
        sys.writeFile("/var/lib/gtos/file-assoc.json", JSON.stringify(fileAssoc || {}))
    }

    function setFileAssoc(ext, appId) {
        ext = String(ext || "").toLowerCase().replace(/^\./, "")
        if (!ext.length || !appId)
            return
        var o = {}
        for (var k in fileAssoc)
            o[k] = fileAssoc[k]
        o[ext] = appId
        fileAssoc = o
        saveFileAssoc()
    }

    function assocAppForName(name) {
        var ext = fileExtOf(name)
        if (!ext.length)
            return ""
        return (fileAssoc && fileAssoc[ext]) ? fileAssoc[ext] : ""
    }

    function openByAssocOrAsk(path, name) {
        name = name || (path ? path.slice(path.lastIndexOf("/") + 1) : "")
        var app = assocAppForName(name)
        if (app && app.length) {
            applyOpenWith(app, path, name)
            return true
        }
        return false
    }

    function printFile(path) {
        path = String(path || "")
        if (!path.length) {
            notify("Печать", "Нет файла", "info")
            return
        }
        sys.run("mkdir -p /var/run/cups /tmp; "
                + "( command -v cupsd >/dev/null || [ -x /usr/sbin/cupsd ] ) && "
                + "pgrep -x cupsd >/dev/null || /usr/sbin/cupsd >/tmp/cupsd.log 2>&1 &")
        var out = (typeof sys.runTimeout === "function"
                   ? sys.runTimeout("lp -o fit-to-page " + shQuote(path) + " 2>&1; echo EXIT:$?", 6000)
                   : sys.run("lp -o fit-to-page " + shQuote(path) + " 2>&1; echo EXIT:$?" )).trim()
        if (out.indexOf("EXIT:0") >= 0 || /request id is/i.test(out)) {
            notify("Печать", "Задание отправлено в очередь CUPS", "ok")
            return
        }
        // нет принтера — сохранить в PDF-очередь / показать честно
        var printers = sys.run("lpstat -a 2>/dev/null | head -n 5").trim()
        if (!printers.length) {
            var dest = "/home/" + currentUser + "/Документы/печать-" + Qt.formatDateTime(new Date(), "yyyyMMdd-HHmmss") + ".log"
            sys.writeFile(dest, "Файл для печати: " + path + "\n\nlp: " + out + "\n")
            notify("Печать", "Принтер не найден. Установите CUPS-принтер или откройте файл в программе с печатью.", "info")
        } else {
            notify("Печать", "Ошибка lp: " + out.slice(0, 120), "info")
        }
    }

    function loadOsUsers() {
        var raw = sys.readFile("/var/lib/gtos/users.json").trim()
        var list = []
        if (raw.length) {
            try {
                var p = JSON.parse(raw)
                if (Array.isArray(p))
                    list = p
            } catch (e) { list = [] }
        }
        if (!list.length && currentUser.length) {
            list = [{
                user: currentUser,
                name: userFullName || currentUser,
                hash: passwordHash,
                salt: passwordSalt,
                avatar: userAvatar
            }]
        }
        osUsers = list
        return list
    }

    function saveOsUsers() {
        sys.run("mkdir -p /var/lib/gtos")
        sys.writeFile("/var/lib/gtos/users.json", JSON.stringify(osUsers || []))
    }

    function upsertCurrentOsUser() {
        var list = loadOsUsers()
        var found = false
        for (var i = 0; i < list.length; ++i) {
            if (list[i].user === currentUser) {
                list[i].name = userFullName || currentUser
                list[i].hash = passwordHash
                list[i].salt = passwordSalt
                list[i].avatar = userAvatar
                found = true
                break
            }
        }
        if (!found) {
            list.push({
                user: currentUser,
                name: userFullName || currentUser,
                hash: passwordHash,
                salt: passwordSalt,
                avatar: userAvatar
            })
        }
        osUsers = list
        saveOsUsers()
    }

    function createOsUser(name, pass) {
        name = String(name || "").trim()
        var user = name.toLowerCase().replace(/[^a-z0-9_]/g, "")
        if (!user.length) {
            notify("Учётные записи", "Введите имя", "info")
            return false
        }
        var list = loadOsUsers()
        for (var i = 0; i < list.length; ++i) {
            if (list[i].user === user) {
                notify("Учётные записи", "Пользователь уже есть", "info")
                return false
            }
        }
        var salt = String(Date.now()) + "-" + user
        sys.writeFile("/tmp/gtos-pwd-material", salt + ":" + (pass || ""))
        var h = pass && pass.length
            ? sys.run("sha256sum /tmp/gtos-pwd-material 2>/dev/null | awk '{print $1}'; rm -f /tmp/gtos-pwd-material").trim()
            : ""
        sys.run("rm -f /tmp/gtos-pwd-material")
        list.push({
            user: user,
            name: name,
            hash: h,
            salt: salt,
            avatar: "#5b8fa8"
        })
        osUsers = list
        saveOsUsers()
        sys.run("mkdir -p /home/" + user
                + "/Документы /home/" + user + "/Загрузки /home/" + user + "/Изображения "
                + "/home/" + user + "/Музыка /home/" + user + "/Видео '/home/" + user + "/Рабочий стол' "
                + "/home/" + user + "/.Корзина /var/lib/gtos/users/" + user
                + "; grep -q '^" + user + ":' /etc/passwd || echo '" + user + ":x:100" + list.length
                + ":100" + list.length + ":" + name.replace(/'/g, "") + ":/home/" + user + ":/bin/sh' >> /etc/passwd"
                + "; chown -R 1000:1000 /home/" + user + " 2>/dev/null || true")
        notify("Учётные записи", "Создан пользователь «" + name + "»", "ok")
        return true
    }

    function switchOsUser(user) {
        user = String(user || "").trim()
        if (!user.length || user === currentUser)
            return
        var list = loadOsUsers()
        var target = null
        for (var i = 0; i < list.length; ++i) {
            if (list[i].user === user) {
                target = list[i]
                break
            }
        }
        if (!target) {
            notify("Сеанс", "Пользователь не найден", "info")
            return
        }
        upsertCurrentOsUser()
        saveDesktop()
        // профиль
        sys.run("mkdir -p /var/lib/gtos/users/" + currentUser
                + "; cp -f /var/lib/gtos/desktop.conf /var/lib/gtos/users/" + currentUser + "/desktop.conf 2>/dev/null || true")
        currentUser = target.user
        userFullName = target.name || target.user
        passwordHash = target.hash || ""
        passwordSalt = target.salt || passwordSalt
        userAvatar = target.avatar || userAvatar
        userPassword = ""
        sys.writeFile("/var/lib/gtos/username", currentUser + "\n")
        sys.writeFile("/var/lib/gtos/fullname", userFullName + "\n")
        var conf = sys.readFile("/var/lib/gtos/users/" + currentUser + "/desktop.conf")
        if (conf.length)
            sys.writeFile("/var/lib/gtos/desktop.conf", conf)
        loadDesktop()
        refreshDeskIcons()
        lockPickUser = currentUser
        lockSession()
        notify("Сеанс", "Переключение на «" + userFullName + "» — введите пароль", "ok")
    }

