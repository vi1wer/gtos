        visible: root.secureDeskOpen && !root.locked && !root.booting && !root.setupOpen
        opacity: root.secureDeskOpen ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }

        Rectangle {
            anchors.fill: parent
