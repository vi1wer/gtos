    function acceptTrashDrop(drop) {
        var raw = ""
        try {
            if (drop && drop.hasText)
                raw = String(drop.text || "")
            else if (drop && drop.urls && drop.urls.length)
                raw = String(drop.urls[0] || "")
            else if (typeof drop === "string")
                raw = drop
        } catch (e) { raw = "" }
        raw = String(raw || "").trim()
        if (!raw.length)
            return false
        if (raw.indexOf("file://") === 0)
            raw = raw.slice(7)
        var name = ""
        var path = raw
        var nl = raw.indexOf("\n")
        if (nl >= 0) {
            path = raw.slice(0, nl).trim()
            name = raw.slice(nl + 1).trim()
        }
        if (path.indexOf("file://") === 0)
            path = path.slice(7)
        var br = path.indexOf("\r")
        if (br >= 0)
            path = path.slice(0, br)
        var bn = path.indexOf("\n")
        if (bn >= 0)
            path = path.slice(0, bn)
        path = path.trim()
        if (!path.length)
            return false
        var ok = movePathToTrash(path, name)
        if (drop && drop.acceptProposedAction)
            drop.acceptProposedAction()
        return ok
    }

