        if (appId === "notes") return "notes"
        if (appId === "photos") return "photos"
        if (appId === "weather") return "weather"
        if (appId === "docs") return "pdf"
        if (appId === "trash") return "trash"
        if (appId === "music") return "music"
        if (appId === "video") return "video"
        if (appId === "cal") return "cal"
        if (appId === "draw") return "draw"
        if (appId === "calc") return "calc"
        if (appId === "monitor") return "monitor"
        if (appId === "control") return "control"
