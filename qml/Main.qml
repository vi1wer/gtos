    function passwordSaltValue() {
        if (passwordSalt.length)
            return passwordSalt
        var mid = sys.readFile("/etc/machine-id").trim()
        if (!mid.length)
            mid = sys.readFile("/var/lib/gtos/hostname").trim()
        if (!mid.length)
            mid = "gtos"
        passwordSalt = mid.slice(0, 32)
        return passwordSalt
    }

    function hashPassword(plain) {
        if (!plain || !plain.length)
            return ""
        var salt = passwordSaltValue()
        sys.writeFile("/tmp/gtos-pwd-material", salt + ":" + plain)
        var h = sys.run("sha256sum /tmp/gtos-pwd-material 2>/dev/null | awk '{print $1}'; rm -f /tmp/gtos-pwd-material").trim()
        return h
    }

    function hasSessionPassword() {
        return passwordHash.length > 0 || userPassword.length > 0
    }

    function verifySessionPassword(plain) {
        if (!hasSessionPassword())
            return true
        if (passwordHash.length) {
            var h = hashPassword(plain)
            return h.length > 0 && h === passwordHash
        }
        // legacy plaintext (мигрируем при успехе)
        if (plain === userPassword) {
            passwordHash = hashPassword(plain)
            userPassword = ""
            saveDesktop()
            return true
        }
        return false
    }

