    function gtSearchResults(q) {
        q = (q || "").toLowerCase().trim()
        var out = []
        var apps = catalogApps()
        for (var i = 0; i < apps.length; ++i) {
            if (!q.length || apps[i].name.toLowerCase().indexOf(q) >= 0)
                out.push(apps[i])
        }
        var sets = catalogSettings()
        for (var s = 0; s < sets.length; ++s) {
            if (!q.length || sets[s].name.toLowerCase().indexOf(q) >= 0)
                out.push(sets[s])
        }
        if (q.length) {
            var filesRaw = sys.run("find /home/" + currentUser + " -maxdepth 2 -type f 2>/dev/null | head -n 40").trim().split("\n")
            for (var f = 0; f < filesRaw.length; ++f) {
                var p = filesRaw[f].trim()
                if (!p.length)
                    continue
                var base = p.split("/").pop()
                if (base.toLowerCase().indexOf(q) >= 0)
                    out.push({ id: p, name: base, kind: "file", path: p })
            }
        }
        return out.slice(0, 14)
    }

    function gtCommandResults(q) {
        q = (q || "").toLowerCase().trim()
        var cmds = [
            { id: "lock", name: "Заблокировать экран", kind: "cmd" },
            { id: "shot", name: "Снимок экрана", kind: "cmd" },
            { id: "mute", name: "Выключить звук", kind: "cmd" },
            { id: "night", name: "Ночной свет", kind: "cmd" },
            { id: "desk", name: "Показать рабочий стол", kind: "cmd" },
            { id: "updates", name: "Центр обновления", kind: "settings" },
            { id: "storage", name: "Память (Storage)", kind: "settings" },
            { id: "privacy", name: "Конфиденциальность", kind: "settings" },
            { id: "clip", name: "Буфер обмена", kind: "cmd" }
        ]
        var out = []
        for (var i = 0; i < cmds.length; ++i) {
            if (!q.length || cmds[i].name.toLowerCase().indexOf(q) >= 0)
                out.push(cmds[i])
        }
        var apps = catalogApps()
        for (var a = 0; a < apps.length; ++a) {
            if (!q.length || apps[a].name.toLowerCase().indexOf(q) >= 0)
                out.push({ id: apps[a].id, name: "Запустить: " + apps[a].name, kind: "app", appId: apps[a].id })
        }
        return out.slice(0, 12)
    }

    function runGtResult(item) {
        gtSearchOpen = false
        gtCommandOpen = false
        if (!item)
            return
        if (item.kind === "app" || item.appId) {
            launch(item.appId || item.id, item.name.replace(/^Запустить: /, ""))
            return
        }
        if (item.kind === "settings") {
            openSettingsSection(item.id)
            return
        }
        if (item.kind === "file") {
            launch("files", "Файлы")
            loadFiles(item.path.substring(0, item.path.lastIndexOf("/")) || ("/home/" + currentUser))
            return
        }
        if (item.kind === "cmd") {
            if (item.id === "lock") lockSession()
            else if (item.id === "shot") takeScreenshot()
            else if (item.id === "mute") toggleMute()
            else if (item.id === "night") { nightLight = !nightLight; saveDesktop() }
            else if (item.id === "desk") toggleShowDesktop()
            else if (item.id === "clip") clipHistOpen = true
        }
    }

    function applySnapLayout(layout) {
        var idx = snapTargetIndex
        if (idx < 0 || idx >= windows.count)
            idx = activeWindowIndex()
        if (idx < 0)
            return
        var top = 48
        var usableH = root.height - top - (dockEdge === "bottom" ? dockSize + 24 : 8)
        var usableW = root.width
        var x = 0, y = top, w = usableW, h = usableH
        if (layout === "left") { w = usableW / 2 }
        else if (layout === "right") { x = usableW / 2; w = usableW / 2 }
        else if (layout === "tl") { w = usableW / 2; h = usableH / 2 }
        else if (layout === "tr") { x = usableW / 2; w = usableW / 2; h = usableH / 2 }
        else if (layout === "bl") { w = usableW / 2; y = top + usableH / 2; h = usableH / 2 }
        else if (layout === "br") { x = usableW / 2; y = top + usableH / 2; w = usableW / 2; h = usableH / 2 }
        else if (layout === "thirdL") { w = usableW / 3 }
        else if (layout === "thirdC") { x = usableW / 3; w = usableW / 3 }
        else if (layout === "thirdR") { x = 2 * usableW / 3; w = usableW / 3 }
        else if (layout === "max") {
            windows.setProperty(idx, "maxed", true)
            snapLayoutOpen = false
            return
        }
        windows.setProperty(idx, "maxed", false)
        windows.setProperty(idx, "hidden", false)
        windows.setProperty(idx, "w", w)
        windows.setProperty(idx, "h", h)
        windows.setProperty(idx, "wx", x)
        windows.setProperty(idx, "wy", y)
        snapTargetIndex = idx
        snapNonce++
        snapLayoutOpen = false
        notify("Snap Layouts", "Окно размещено", "ok")
    }

    function activeWindowIndex() {
        var best = -1, bestZ = -1
        for (var i = 0; i < windows.count; ++i) {
            if (windows.get(i).hidden)
                continue
            if (windows.get(i).desk !== undefined && windows.get(i).desk !== deskIndex)
                continue
            if (windows.get(i).z > bestZ) {
                bestZ = windows.get(i).z
                best = i
            }
        }
        return best
    }

    function switchDesktop(di) {
        if (di < 0 || di >= deskNames.length)
            return
        deskIndex = di
        applyDesktopVisibility()
        saveDesktop()
        notify("Рабочий стол", deskNames[deskIndex], "ok")
    }

    function fmtStorageSize(mb) {
        var m = Math.max(0, Number(mb) || 0)
        if (m >= 1024) {
            var g = m / 1024
            var s = g >= 100 ? String(Math.round(g))
                  : (g >= 10 ? g.toFixed(1) : g.toFixed(2))
            return String(s).replace(".", ",") + " ГБ"
        }
        return Math.round(m) + " МБ"
    }

    function storageUsedLabel(mb) {
        return "Использовано " + fmtStorageSize(mb) + "/" + fmtStorageSize(storageTotalMb)
    }

