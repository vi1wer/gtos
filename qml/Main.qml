        ctxMenuX = p.x
        ctxMenuY = p.y
        filesMenuX = p.x
        filesMenuY = p.y
        ctxMenuSource = source || "desktop"
        ctxFlyout = ""
        ctxMenuOpen = true
        filesMenuOpen = true
        ctxMenuArmed = false
        ctxArmTimer.restart()
    }

