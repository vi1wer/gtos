        }
        Canvas {
            visible: kind === "video"
            anchors.fill: parent
            onPaint: {
                var ctx = getContext("2d")
                ctx.fillStyle = "#ffffff"
                ctx.beginPath()
                ctx.moveTo(8, 6); ctx.lineTo(22, 14); ctx.lineTo(8, 22); ctx.closePath(); ctx.fill()
            }
        }
        Item {
            visible: kind === "store"
            anchors.centerIn: parent
            width: 18
            height: 18
            Rectangle { anchors.bottom: parent.bottom; width: 18; height: 12; radius: 3; color: "transparent"; border.color: glyph.ink; border.width: 1.8 }
            Canvas {
                anchors.top: parent.top
                width: 18
                height: 8
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.strokeStyle = glyph.ink
                    ctx.lineWidth = 1.8
                    ctx.beginPath()
                    ctx.arc(9, 8, 5, Math.PI, 0, false)
                    ctx.stroke()
