    function folderGlyph(name) {
        if (name === "Документы") return "☰"
        if (name === "Загрузки") return "↓"
        if (name === "Изображения") return "▣"
        if (name === "Музыка" || name === "Медиаплеер") return "♪"
        if (name === "Видео") return "▶"
        if (name === "Рабочий стол") return "▭"
        if (name === "Проекты") return "{ }"
        if (name === "Архив") return "▣"
        if (name === ".Корзина" || name === "Корзина") return "🗑"
        return ""
    }

    function refreshDisk() {
        var raw = sys.run("df -Pk / 2>/dev/null").trim()
        var lines = raw.split("\n")
        var line = ""
        for (var i = lines.length - 1; i >= 0; --i) {
            if (lines[i].trim().length && lines[i].indexOf("Filesystem") !== 0 && lines[i].indexOf("1024-blocks") < 0) {
                line = lines[i].trim()
                break
            }
        }
        var parts = line.split(/\s+/)
        if (parts.length >= 4) {
            var totalKb = parseFloat(parts[1])
            var availKb = parseFloat(parts[3])
            if (!isNaN(totalKb) && totalKb > 0 && !isNaN(availKb)) {
                var freeGb = availKb / 1024 / 1024
                var totalGb = totalKb / 1024 / 1024
                diskFreeRatio = Math.max(0, Math.min(1, availKb / totalKb))
                if (freeGb >= 10)
                    diskText = "Свободно " + freeGb.toFixed(0) + " ГБ"
                else
                    diskText = "Свободно " + freeGb.toFixed(1) + " ГБ"
                filesStatus = fileEntries.length + " объект" + (fileEntries.length === 1 ? "" : (fileEntries.length > 1 && fileEntries.length < 5 ? "а" : "ов"))
                    + "  ·  " + totalGb.toFixed(1) + " ГБ всего"
                return
            }
        }
        // fallback: tmpfs/rootfs size from /proc
        var mem = sys.run("awk '/MemTotal/{print $2}' /proc/meminfo").trim()
        var memKb = parseFloat(mem)
        if (!isNaN(memKb) && memKb > 0) {
            diskFreeRatio = 0.65
            diskText = "Свободно " + (memKb / 1024 / 1024 * 0.65).toFixed(1) + " ГБ"
        } else {
            diskText = "Свободно —"
            diskFreeRatio = 0
        }
        filesStatus = fileEntries.length + " объектов"
    }

    function prettyPath(path) {
        if (path === "/home/misha")
            return "~"
        if (path.indexOf("/home/misha/") === 0)
            return "~" + path.slice("/home/misha".length)
        return path
    }

    function uptimeSeconds() {
        var raw = sys.run("awk '{printf \"%d\", $1}' /proc/uptime 2>/dev/null").trim()
        var sec = parseInt(raw, 10)
        if (!isNaN(sec) && sec >= 0)
            return sec
        raw = sys.run("cut -d. -f1 /proc/uptime 2>/dev/null").trim()
        sec = parseInt(raw, 10)
        if (!isNaN(sec) && sec >= 0)
            return sec
        // запасной путь — время с запуска оболочки
        return Math.max(0, Math.floor((Date.now() - sessionStartedAt) / 1000))
    }

    function uptimeTextShort() {
        var sec = uptimeSeconds()
        var d = Math.floor(sec / 86400)
        var h = Math.floor((sec % 86400) / 3600)
        var m = Math.floor((sec % 3600) / 60)
        var s = sec % 60
        if (d > 0)
            return d + "d " + h + "h " + m + "m"
        if (h > 0)
            return h + "h " + m + "m " + s + "s"
        if (m > 0)
            return m + "m " + s + "s"
        return s + "s"
    }

