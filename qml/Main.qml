                        Text { text: "Изготовитель:"; color: "#444"; font.pixelSize: 12; width: 120 }
                        Text { text: root.devPropsMaker; color: "#111"; font.pixelSize: 12; width: parent.parent.width - 140; wrapMode: Text.WordWrap }
                        Text { text: "Размещение:"; color: "#444"; font.pixelSize: 12; width: 120 }
                        Text { text: root.devPropsLocation; color: "#111"; font.pixelSize: 12; width: parent.parent.width - 140; wrapMode: Text.WordWrap }
                    }
                    Text { text: "Состояние устройства"; color: "#222"; font.pixelSize: 12; font.family: root.uiFontBold; topPadding: 6 }
                    Rectangle {
