                            ctx.moveTo(3, 14); ctx.lineTo(3, 11)
                            ctx.moveTo(7, 14); ctx.lineTo(7, 8)
                            ctx.moveTo(11, 14); ctx.lineTo(11, 5)
                            ctx.moveTo(15, 14); ctx.lineTo(15, 2)
                        })
                    }
                }
