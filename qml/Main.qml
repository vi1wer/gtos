    function pendingOpsCount() {
        return pendingOps && pendingOps.length ? pendingOps.length : 0
    }

    function upsertPendingOp(id, title, detail, pct, kind) {
        var arr = []
        var found = false
        for (var i = 0; i < pendingOps.length; ++i) {
            if (pendingOps[i].id === id) {
                arr.push({
                    id: id,
                    title: title || pendingOps[i].title,
                    detail: detail !== undefined ? detail : pendingOps[i].detail,
                    pct: pct !== undefined ? pct : pendingOps[i].pct,
                    kind: kind || pendingOps[i].kind || "op"
                })
                found = true
            } else {
                arr.push(pendingOps[i])
            }
        }
        if (!found)
            arr.push({ id: id, title: title || id, detail: detail || "", pct: pct || 0, kind: kind || "op" })
        pendingOps = arr
    }

    function finishPendingOp(id) {
        var arr = []
        for (var i = 0; i < pendingOps.length; ++i) {
            if (pendingOps[i].id !== id)
                arr.push(pendingOps[i])
        }
        pendingOps = arr
        if (!arr.length)
            opsFlyoutOpen = false
    }

    function runDiskCleanup() {
        upsertPendingOp("cleanup", "Очистка диска", "Временные файлы и корзина…", 10, "clean")
        var t = trashDir()
        sys.run(
            "rm -rf /tmp/gtos-* /tmp/*.tmp 2>/dev/null; "
            + "mkdir -p " + shQuote(t) + "; find " + shQuote(t) + " -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; "
            + "sync; echo ok"
        )
        upsertPendingOp("cleanup", "Очистка диска", "Готово", 100, "clean")
        finishPendingOp("cleanup")
        notify("Хранилище", "Временные файлы и корзина очищены", "ok")
        refreshDeskIcons()
        if (filesPath === t)
            loadFiles(t)
    }

    function toggleBatterySaver() {
        batterySaver = !batterySaver
        if (batterySaver) {
            brightness = Math.min(brightness, 0.55)
            volume = Math.min(volume, 0.6)
            applySystemVolume()
            notify("Экономия заряда", "Яркость и громкость снижены", "ok")
        } else {
            brightness = Math.max(brightness, 0.88)
            notify("Экономия заряда", "Обычный режим", "ok")
        }
        saveDesktop()
    }

    function setBackupSchedule(mode) {
        backupSchedule = (mode === "daily" || mode === "weekly") ? mode : "off"
        backupNextHint = backupSchedule === "daily" ? "каждый день в ~03:00"
                         : (backupSchedule === "weekly" ? "каждое воскресенье" : "не задано")
        saveDesktop()
        notify("Резервное копирование",
               backupSchedule === "off" ? "Расписание выключено" : ("Расписание: " + backupNextHint),
               "ok")
    }

    function maybeRunScheduledBackup() {
        if (backupSchedule === "off" || recoveryBusy)
            return
        var now = new Date()
        var dayKey = Qt.formatDate(now, "yyyy-MM-dd")
        if (backupLastRun === dayKey && backupSchedule === "daily")
            return
        if (backupSchedule === "weekly" && now.getDay() !== 0)
            return
        if (backupSchedule === "weekly" && backupLastRun.indexOf(dayKey) === 0)
            return
        // ночной слот 2–5 утра или ручной тик после загрузки
        var h = now.getHours()
        if (h >= 2 && h <= 5) {
            backupLastRun = dayKey
            saveDesktop()
            backupUserData()
        }
    }

    function applyFocusHours() {
        if (!focusHoursOn)
            return
        var h = (new Date()).getHours()
        var inFocus = false
        if (focusStartHour > focusEndHour)
            inFocus = (h >= focusStartHour || h < focusEndHour)
        else
            inFocus = (h >= focusStartHour && h < focusEndHour)
        if (inFocus && !dndMode) {
            dndMode = true
            notify("Фокус", "Тихие часы — уведомления скрыты", "info")
        } else if (!inFocus && dndMode && focusHoursOn) {
            // не снимаем DND, если пользователь включил вручную вне расписания — только при выходе из окна
        }
    }

