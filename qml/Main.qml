    function notify(title, body, kind) {
        if (dndMode && kind !== "ok")
            return
        var id = ++notifySeq
        var stamp = Qt.formatTime(new Date(), "HH:mm")
        var entry = { id: id, title: title, body: body || "", kind: kind || "info", time: stamp }
        var items = notifications.slice()
        items.unshift(entry)
        if (items.length > 8)
            items = items.slice(0, 8)
        notifications = items
        var hist = notifyHistory.slice()
        hist.unshift(entry)
        if (hist.length > 40)
            hist = hist.slice(0, 40)
        notifyHistory = hist
        if (!notifyCenterOpen) {
            notifyKiller.interval = 4800
            notifyKiller.restart()
        }
    }

    function dismissNotify(id) {
        var items = []
        for (var i = 0; i < notifications.length; ++i) {
            if (notifications[i].id !== id)
                items.push(notifications[i])
        }
        notifications = items
    }

    function clearNotifyHistory() {
        notifications = []
        notifyHistory = []
    }

    function trackAppLaunch(appId) {
        if (!appId || appId === "monitor")
            return
        var hour = new Date().getHours()
        var key = appId + "@" + hour
        var log = {}
        for (var k in appLaunchLog)
            log[k] = appLaunchLog[k]
        log[key] = (log[key] || 0) + 1
        appLaunchLog = log
        saveDesktop()
        // умный док: если часто открывают незакреплённое в этот час
        if (pinnedApps.indexOf(appId) < 0 && log[key] >= 3 && !dockSuggestVisible) {
            var names = { files: "Файлы", browser: "Браузер", notes: "Заметки", term: "Терминал", settings: "Параметры", mail: "Почту", store: "Магазин", calc: "Калькулятор" }
            dockSuggestApp = appId
            dockSuggest = "Вы часто открываете «" + (names[appId] || appId) + "» около " + hour + ":00 — закрепить в доке?"
            dockSuggestVisible = true
        }
    }

