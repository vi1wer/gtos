    Item {
        id: deskLayer
        z: 6
        anchors.fill: parent
        anchors.topMargin: 48
        anchors.bottomMargin: root.dockSize + 20
        anchors.leftMargin: 0
        anchors.rightMargin: 0
        visible: root.deskShowIcons
        clip: true

        Repeater {
            model: root.deskIconList
            delegate: Item {
                id: deskIcon
                x: root.deskIconX(modelData.id, index)
                y: root.deskIconY(modelData.id, index)
                width: root.deskIconMetrics().cellW
                height: root.deskIconMetrics().cellH
                z: iconHover.drag.active ? 40 : 1
                property bool hot: iconHover.containsMouse || iconHover.drag.active
                opacity: 1
                scale: iconHover.drag.active ? 1.06 : 1
                transformOrigin: Item.Center
                Behavior on scale { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }

                Rectangle {
                    anchors.fill: parent
                    anchors.margins: 1
                    radius: 4
                    color: deskIcon.hot ? "#3d8fd855" : "transparent"
                    border.width: deskIcon.hot ? 1 : 0
                    border.color: deskIcon.hot ? "#7ec1ff" : "transparent"
                    Behavior on color { ColorAnimation { duration: 120 } }
                }

                DeskIconArt {
                    id: iconBadge
                    anchors.horizontalCenter: parent.horizontalCenter
                    y: 8
                    width: root.deskIconMetrics().art
                    height: root.deskIconMetrics().art
                    kind: modelData.kind
                    scale: deskIcon.hot ? 1.06 : 1.0
                    Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                }

                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.top: iconBadge.bottom
                    anchors.topMargin: 4
                    width: parent.width - 6
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.Wrap
                    maximumLineCount: 2
                    text: modelData.label
                    color: "#ffffff"
                    font.pixelSize: root.deskIconMetrics().font
                    font.family: root.uiFont
                    style: Text.Outline
                    styleColor: "#000000cc"
                }

                MouseArea {
                    id: iconHover
                    anchors.fill: parent
                    hoverEnabled: true
                    acceptedButtons: Qt.LeftButton | Qt.RightButton
                    cursorShape: drag.active ? Qt.ClosedHandCursor : Qt.PointingHandCursor
                    drag.target: (modelData.id === "system:trash" || modelData.path === "trash") ? null : deskIcon
                    drag.axis: Drag.XAndYAxis
                    drag.threshold: 6
                    drag.minimumX: 4
                    drag.maximumX: Math.max(4, deskLayer.width - deskIcon.width - 4)
                    drag.minimumY: 4
                    drag.maximumY: Math.max(4, deskLayer.height - deskIcon.height - 4)
                    onDoubleClicked: root.deskOpenItem(modelData)
                    onClicked: {
                        if (mouse.button === Qt.RightButton)
                            root.openCtxMenuAt(this, mouse.x, mouse.y, root.deskFileCtxItems(modelData), "desktop")
                    }
                    onReleased: {
                        if (mouse.button !== Qt.LeftButton)
                            return
                        // перетащили файл/папку на корзину
                        if (modelData.id !== "system:trash" && modelData.path !== "trash"
                                && modelData.type !== "system" && modelData.type !== "app"
                                && modelData.path && modelData.path.length
                                && root.deskTrashHit(deskIcon.x + deskIcon.width / 2, deskIcon.y + deskIcon.height / 2)) {
                            root.movePathToTrash(modelData.path, modelData.label)
                            deskIcon.x = root.deskIconX(modelData.id, index)
                            deskIcon.y = root.deskIconY(modelData.id, index)
                            return
                        }
                        root.deskCommitPos(modelData.id, deskIcon.x, deskIcon.y)
                    }
                }
                // приём перетаскивания из Проводника на значок корзины
                DropArea {
                    anchors.fill: parent
                    keys: ["text/plain", "text/uri-list"]
                    enabled: modelData.id === "system:trash" || modelData.path === "trash"
                    visible: enabled
                    onEntered: deskIcon.hot = true
                    onExited: deskIcon.hot = false
                    onDropped: function (drop) {
                        deskIcon.hot = false
                        root.acceptTrashDrop(drop)
                    }
                }
            }
        }
    }

    // Яркость экрана (затемнение поверх стола)
    Rectangle {
        anchors.fill: parent
        z: 7
        color: "#000000"
        opacity: Math.max(0, Math.min(0.72, 1.0 - root.brightness))
        visible: opacity > 0.01
        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
    }

    // Night light warm filter
    Rectangle {
        anchors.fill: parent
        z: 8
        visible: root.nightLight || opacity > 0.01
        color: "#44ff8c3a"
        opacity: root.nightLight ? 0.22 : 0
        Behavior on opacity { NumberAnimation { duration: 480; easing.type: Easing.InOutCubic } }
    }

    Shortcut { sequence: "Alt+Tab"; onActivated: root.openAltTab() }
    Shortcut { sequence: "Alt+Backtab"; onActivated: root.openAltTab() }
    Shortcut { sequence: "Meta+D"; onActivated: root.toggleShowDesktop() }
    Shortcut { sequence: "Ctrl+Meta+D"; onActivated: root.toggleShowDesktop() }
    Shortcut { sequence: "Meta+L"; onActivated: root.lockSession() }
    Shortcut { sequence: "Meta+E"; onActivated: root.launch("files", "Файлы") }
    Shortcut { sequence: "Meta+I"; onActivated: { root.settingsSection = "home"; root.launch("settings", "Параметры") } }
    Shortcut { sequence: "Meta+V"; onActivated: { root.clipHistOpen = !root.clipHistOpen; root.quickOpen = false } }
    Shortcut { sequence: "Meta+S"; onActivated: root.openGtSearch() }
    Shortcut { sequence: "Alt+Space"; onActivated: root.openGtCommand() }
    Shortcut { sequence: "Meta+Ctrl+Left"; onActivated: root.switchDesktop(Math.max(0, root.deskIndex - 1)) }
    Shortcut { sequence: "Meta+Ctrl+Right"; onActivated: root.switchDesktop(Math.min(root.deskNames.length - 1, root.deskIndex + 1)) }
    Shortcut { sequence: "Print"; onActivated: root.takeScreenshot() }
    Shortcut { sequence: "Meta+Shift+S"; onActivated: root.takeScreenshot() }
    // Ctrl+Alt+Delete часто перехватывает хост — End/Backspace как запас в QEMU
    Shortcut { sequence: "Ctrl+Alt+Delete"; onActivated: root.openSecureDesk() }
    Shortcut { sequence: "Ctrl+Alt+End"; onActivated: root.openSecureDesk() }
    Shortcut { sequence: "Ctrl+Alt+Backspace"; onActivated: root.openSecureDesk() }
    Shortcut { sequence: "Meta+N"; onActivated: root.openQuickNote() }
    Shortcut { sequence: "Esc"; onActivated: {
            if (root.secureDeskOpen) { root.closeSecureDesk(); return }
            if (root.quickNoteOpen) { root.quickNoteOpen = false; return }
            if (root.opsFlyoutOpen) { root.opsFlyoutOpen = false; return }
            root.altTabOpen = false
            root.clipHistOpen = false
            root.calendarOpen = false
            root.gtSearchOpen = false
            root.gtCommandOpen = false
            root.snapLayoutOpen = false
            root.workspacesOpen = false
            root.wsRenameIndex = -1
            root.closeCtxMenu()
            if (root.startOpen) root.startOpen = false
        } }

    Timer {
        id: autoLockTimer
        interval: 20000
        running: !root.locked && !root.booting && !root.setupOpen && root.autoLockMinutes > 0
        repeat: true
        onTriggered: {
            root.applyFocusHours()
            if (root.autoLockMinutes > 0 && (Date.now() - root.lastInputAt) >= root.autoLockMinutes * 60000)
                root.lockSession()
        }
    }
    Timer {
        id: scheduledBackupTimer
        interval: 600000
        running: true
        repeat: true
        onTriggered: root.maybeRunScheduledBackup()
    }
    Timer {
        id: scheduledBackupBoot
        interval: 12000
        running: true
        repeat: false
        onTriggered: root.maybeRunScheduledBackup()
    }

    Timer {
        id: updateCheckTimer
        interval: 2500
        onTriggered: {
            var done = sys.readFile("/tmp/gtos-upd-done").trim()
            if (done !== "done") {
                updateCheckTimer.interval = 1500
                updateCheckTimer.restart()
                return
            }
            root.updateChecking = false
            root.updateLastCheck = Qt.formatDateTime(new Date(), "dd.MM.yyyy HH:mm")
            var sim = sys.readFile("/tmp/gtos-upd-sim.txt")
            var lines = sim.split("\n").filter(function (l) { return l.indexOf("Upgrading") >= 0 || l.indexOf("Installing") >= 0 })
            var shellAvail = sys.readFile("/tmp/gtos-shell-upd-check.log").indexOf("GTOS_SHELL_UPDATE_AVAILABLE") >= 0
            if (lines.length || shellAvail) {
                root.updateStatus = (lines.length ? ("Пакетов: " + lines.length) : "Пакеты ок")
                                 + (shellAvail ? " · доступно обновление оболочки с носителя" : "")
                root.notify("GT Update Engine", root.updateStatus, "ok")
            } else {
                root.updateStatus = "GT/OS " + root.osVersion + " · пакеты и оболочка актуальны"
                root.notify("GT Update Engine", "Система актуальна", "ok")
            }
            root.checkUpdateDependencies()
            sys.run("rm -f /tmp/gtos-upd-done")
        }
    }

    Timer {
        id: updateApplyTimer
        interval: 2000
        onTriggered: {
            var done = sys.readFile("/tmp/gtos-upd-apply-done").trim()
            if (done !== "done") {
                updateApplyTimer.interval = 1500
                updateApplyTimer.restart()
                return
            }
            root.updateApplying = false
            root.finishPendingOp("update")
            var rc = sys.readFile("/tmp/gtos-upd-apply-rc").trim()
            if (rc === "0" || rc === "") {
                var shellLog = sys.readFile("/tmp/gtos-upd-apply.log")
                var shellOk = shellLog.indexOf("GTOS_SHELL_UPDATE_DONE") >= 0
                root.updateStatus = shellOk
                    ? ("Пакеты и оболочка " + root.osVersion + " обновлены")
                    : "Пакеты обновлены · оболочка: носитель не найден (ISO/USB)"
                root.notify("GT Update Engine", root.updateStatus, "ok")
                if (root.updateNeedsReboot) {
                    root.updateNeedsReboot = false
                    root.notify("Обновление", "Перезагрузка для применения…", "ok")
                    root.powerAction("reboot")
                    return
                }
            } else {
                root.updateNeedsReboot = false
                root.updateStatus = "Установка завершилась с кодом " + rc
                root.notify("GT Update Engine", "Ошибка установки — можно откатить по снимку", "info")
            }
            sys.run("rm -f /tmp/gtos-upd-apply-done")
            root.checkUpdates()
        }
    }

    Timer {
        id: resumePollTimer
        interval: 2000
        repeat: true
        running: false
        onTriggered: {
            if (!root.resumePending) {
                resumePollTimer.stop()
                return
            }
            var done = sys.readFile("/tmp/gtos-resume").trim()
            if (done === "done") {
                resumePollTimer.stop()
                root.onResumeFromSleep()
            }
        }
    }

    Timer {
        id: updateRollbackTimer
        interval: 2000
        onTriggered: {
            var done = sys.readFile("/tmp/gtos-upd-rollback-done").trim()
            if (done !== "done") {
                updateRollbackTimer.interval = 1500
                updateRollbackTimer.restart()
                return
            }
            root.updateRollingBack = false
            root.updateRollbackStatus = "Откат завершён (зависимости из снимка)"
            root.updateStatus = root.updateRollbackStatus
            root.notify("GT Update Engine", root.updateRollbackStatus, "ok")
            sys.run("rm -f /tmp/gtos-upd-rollback-done")
        }
    }

    Timer {
        id: musicTick
        interval: 1000
        repeat: true
        running: false
        onTriggered: {
            if (!root.musicPlaying && !root.vlcPlaying)
                return
            root.mediaElapsedSec += 1
            if (root.mediaDurationSec > 0) {
                root.musicPos = Math.min(1, root.mediaElapsedSec / root.mediaDurationSec)
                root.refreshMediaTimeLabel()
                if (root.mediaElapsedSec >= root.mediaDurationSec) {
                    if (root.musicPlaying)
                        root.musicNext()
                    else
                        root.stopMediaPlayer()
                }
            } else {
                root.musicPos = Math.min(1, root.musicPos + 0.02)
                if (root.musicPos >= 1 && root.musicPlaying)
                    root.musicNext()
            }
        }
    }

    // GT Search (Win+S) + GT Command (Alt+Space)
    Rectangle {
        anchors.fill: parent
        z: 930
        visible: root.gtSearchOpen || root.gtCommandOpen || opacity > 0.02
        color: "#99000000"
        opacity: (root.gtSearchOpen || root.gtCommandOpen) ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        MouseArea { anchors.fill: parent; onClicked: { root.gtSearchOpen = false; root.gtCommandOpen = false } }
        Rectangle {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: root.height * 0.18
            width: Math.min(640, root.width - 80)
            height: Math.min(480, searchCol.height + 28)
            radius: 18
            color: "#121a20"
            border.width: 1
            border.color: "#2a3842"
            opacity: (root.gtSearchOpen || root.gtCommandOpen) ? 1 : 0
            scale: (root.gtSearchOpen || root.gtCommandOpen) ? 1 : 0.92
            transformOrigin: Item.Top
            Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
            Behavior on scale { NumberAnimation { duration: 280; easing.type: Easing.OutBack } }
            transform: Translate {
                y: (root.gtSearchOpen || root.gtCommandOpen) ? 0 : -24
                Behavior on y { NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            }
            Column {
                id: searchCol
                width: parent.width
                anchors.top: parent.top
                anchors.margins: 14
                spacing: 12
                Text {
                    text: root.gtCommandOpen ? "GT Command" : "GT Search"
                    color: "#f4f7f8"; font.bold: true; font.pixelSize: 16
                }
                Text {
                    text: root.gtCommandOpen ? "Alt+Space · приложения, настройки и команды" : "Win+S · приложения, файлы и параметры"
                    color: "#9aa7b2"; font.pixelSize: 12
                }
                Rectangle {
                    width: parent.width; height: 44; radius: 12; color: "#1c262e"
                    border.width: 1; border.color: root.accentColor
                    TextInput {
                        id: gtQueryInput
                        anchors.fill: parent; anchors.margins: 12
                        color: "#f4f7f8"; font.pixelSize: 15; font.family: root.uiFont
                        text: root.gtCommandOpen ? root.gtCommandQuery : root.gtSearchQuery
                        selectByMouse: true
                        onTextChanged: {
                            if (root.gtCommandOpen) root.gtCommandQuery = text
                            else root.gtSearchQuery = text
                        }
                        Keys.onReturnPressed: {
                            var list = root.gtCommandOpen ? root.gtCommandResults(root.gtCommandQuery) : root.gtSearchResults(root.gtSearchQuery)
                            if (list.length) root.runGtResult(list[0])
                        }
                        Keys.onEscapePressed: { root.gtSearchOpen = false; root.gtCommandOpen = false }
                        Component.onCompleted: forceActiveFocus()
                    }
                }
                Repeater {
                    model: root.gtCommandOpen ? root.gtCommandResults(root.gtCommandQuery) : root.gtSearchResults(root.gtSearchQuery)
                    delegate: Rectangle {
                        width: searchCol.width; height: 44; radius: 10
                        color: sHover.containsMouse ? "#1c262e" : "transparent"
                        Row {
                            anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12; spacing: 12
                            DeskIconArt {
                                width: 28; height: 28
                                anchors.verticalCenter: parent.verticalCenter
                                kind: modelData.kind === "settings" ? "settings"
                                      : (modelData.kind === "file" ? "files"
                                      : (modelData.kind === "cmd" ? "term"
                                      : root.winIconKind(modelData.appId || modelData.id)))
                            }
                            Column {
                                anchors.verticalCenter: parent.verticalCenter
                                spacing: 1
                                Text { text: modelData.name; color: "#e8eef2"; font.pixelSize: 13 }
                                Text {
                                    text: modelData.kind === "app" ? "Приложение" : (modelData.kind === "settings" ? "Параметры" : (modelData.kind === "file" ? "Файл" : "Команда"))
                                    color: "#6b7785"; font.pixelSize: 10
                                }
                            }
                        }
                        MouseArea {
                            id: sHover
                            anchors.fill: parent
                            hoverEnabled: true
                            onClicked: root.runGtResult(modelData)
                        }
                    }
                }
            }
            onVisibleChanged: if (visible) gtQueryInput.forceActiveFocus()
        }
    }

    // Alt+Tab switcher
    Rectangle {
        anchors.fill: parent
        z: 920
        visible: root.altTabOpen || opacity > 0.02
        color: "#99000000"
        opacity: root.altTabOpen ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
        MouseArea { anchors.fill: parent; onClicked: root.altTabOpen = false }
        Row {
            anchors.centerIn: parent
            spacing: 14
            scale: root.altTabOpen ? 1 : 0.9
            Behavior on scale { NumberAnimation { duration: 220; easing.type: Easing.OutBack } }
            Repeater {
                model: root.runningAppIds()
                delegate: Rectangle {
                    width: 120; height: 100; radius: 12
                    color: index === root.altTabIndex ? "#2a3842" : "#1a2126"
                    border.width: index === root.altTabIndex ? 2 : 1
                    border.color: index === root.altTabIndex ? root.accentColor : "#2c3840"
                    scale: index === root.altTabIndex ? 1.08 : 1
                    Behavior on scale { NumberAnimation { duration: 160; easing.type: Easing.OutBack } }
                    Behavior on color { ColorAnimation { duration: 140 } }
                    Behavior on border.color { ColorAnimation { duration: 140 } }
                    Column {
                        anchors.centerIn: parent; spacing: 8
                        DeskIconArt {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 40; height: 40
                            kind: root.winIconKind(modelData)
                        }
                        Text { anchors.horizontalCenter: parent.horizontalCenter; text: root.appTitleOf(modelData); color: "#e8eef2"; font.pixelSize: 12 }
                    }
                    MouseArea {
                        anchors.fill: parent
                        onClicked: { root.altTabIndex = index; root.confirmAltTab() }
                    }
                }
            }
        }
        Timer {
            interval: 40; running: root.altTabOpen; repeat: true
            onTriggered: {
                // cycle while Alt held is hard in QML; click or Enter confirms
            }
        }
        Keys.onPressed: function (e) {
            if (e.key === Qt.Key_Tab) {
                var n = root.runningAppIds().length
                if (n > 0) root.altTabIndex = (root.altTabIndex + 1) % n
                e.accepted = true
            } else if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter) {
                root.confirmAltTab(); e.accepted = true
            }
        }
        Component.onCompleted: forceActiveFocus()
        onVisibleChanged: if (visible) forceActiveFocus()
    }

    // Clipboard history 2.0
    Rectangle {
        z: 96
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.rightMargin: 18
        anchors.bottomMargin: root.dockSize + 28
        width: 380
        height: 460
        radius: 20
        color: "#0e1816"
        border.color: "#1e3a32"; border.width: 1
        opacity: root.clipHistOpen ? 1 : 0
        scale: root.clipHistOpen ? 1 : 0.94
        transformOrigin: Item.BottomRight
        visible: root.clipHistOpen || opacity > 0.02
        Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        Behavior on scale { NumberAnimation { duration: 280; easing.type: Easing.OutBack } }
        transform: Translate {
            y: root.clipHistOpen ? 0 : 28
            Behavior on y { NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
        }
        Column {
            anchors.fill: parent; anchors.margins: 16; spacing: 12
            Row {
                width: parent.width
                Column {
                    spacing: 2
                    Text { text: "Буфер обмена"; color: "#f4f7f8"; font.family: root.uiFontBold; font.pixelSize: 16 }
                    Text { text: "Win+V · закрепление и поиск"; color: "#6b7785"; font.pixelSize: 11; font.family: root.uiFont }
                }
                Item { width: parent.width - 220; height: 1 }
                Text {
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Очистить"
                    color: root.accentColor; font.pixelSize: 12; font.family: root.uiFont
                    MouseArea {
                        anchors.fill: parent; anchors.margins: -4
                        onClicked: { root.clipHistory = []; root.notify("Буфер", "История очищена", "ok") }
                    }
                }
            }
            Rectangle {
                width: parent.width; height: 38; radius: 12; color: "#121a18"
                border.width: 1; border.color: "#243038"
                TextInput {
                    anchors.fill: parent; anchors.leftMargin: 12; anchors.rightMargin: 12
                    verticalAlignment: Text.AlignVCenter
                    color: "#e8eef2"; font.pixelSize: 13; font.family: root.uiFont
                    text: root.clipSearchQuery
                    onTextChanged: root.clipSearchQuery = text
                    Keys.onPressed: function (e) {
                        var ch = root.mapLangKey(e)
                        if (ch !== null) { insert(ch); e.accepted = true }
                    }
                    Text {
                        anchors.fill: parent; verticalAlignment: Text.AlignVCenter
                        text: "Поиск по истории…"; color: "#6b7785"; font.pixelSize: 13; font.family: root.uiFont
                        visible: !parent.text.length && !parent.activeFocus
                    }
                }
            }
            Flickable {
                width: parent.width; height: parent.height - 100
                contentHeight: clipCol.height; clip: true
                Column {
                    id: clipCol; width: parent.width; spacing: 8
                    Repeater {
                        model: root.filteredClipHistory()
                        delegate: Rectangle {
                            width: parent.width; height: 64; radius: 12
                            color: (modelData.item && modelData.item.pinned) ? "#16352e" : "#121a18"
                            border.width: 1
                            border.color: (modelData.item && modelData.item.pinned) ? "#2a4a3c" : "#1e2a28"
                            Row {
                                anchors.fill: parent; anchors.margins: 12; spacing: 10
                                Rectangle {
                                    width: 36; height: 36; radius: 10
                                    anchors.verticalCenter: parent.verticalCenter
                                    color: "#1a2420"
                                    Text { anchors.centerIn: parent; text: "T"; color: root.accentColor; font.pixelSize: 14; font.family: root.uiFontBold }
                                }
                                Text {
                                    width: parent.width - 80; height: parent.height
                                    text: modelData.text
                                    color: "#e8eef2"; font.pixelSize: 12; font.family: root.uiFont
                                    elide: Text.ElideRight; wrapMode: Text.Wrap; maximumLineCount: 2
                                    verticalAlignment: Text.AlignVCenter
                                }
                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: (modelData.item && modelData.item.pinned) ? "★" : "☆"
                                    color: root.accentColor; font.pixelSize: 14
                                    MouseArea {
                                        anchors.fill: parent; anchors.margins: -6
                                        onClicked: root.toggleClipPin(modelData.idx)
                                    }
                                }
                            }
                            MouseArea {
                                anchors.fill: parent
                                anchors.rightMargin: 36
                                onClicked: {
                                    root.clipPath = ""
                                    root.pushClipboard(modelData.text)
                                    root.notify("Буфер", "Скопировано снова", "ok")
                                    root.clipHistOpen = false
                                }
                            }
                        }
                    }
                    Text {
                        visible: root.clipHistory.length === 0
                        text: "Пока пусто — скопируйте текст или файл"
                        color: "#6b7785"; font.pixelSize: 12; font.family: root.uiFont
                        width: parent.width; wrapMode: Text.Wrap
                    }
                }
            }
        }
    }

    // Calendar flyout (alongside notify)
    Rectangle {
        z: 96
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.rightMargin: 18
        anchors.topMargin: 56
        width: 280
        height: 220
        radius: 16
        color: "#121a20"
        border.color: "#2a3842"; border.width: 1
        opacity: root.calendarOpen ? 1 : 0
        scale: root.calendarOpen ? 1 : 0.94
        transformOrigin: Item.TopRight
        visible: root.calendarOpen || opacity > 0.02
        Behavior on opacity { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
        Behavior on scale { NumberAnimation { duration: 260; easing.type: Easing.OutBack } }
        transform: Translate {
            y: root.calendarOpen ? 0 : -14
            Behavior on y { NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }
        }
        Column {
            anchors.fill: parent; anchors.margins: 16; spacing: 10
            Text { text: Qt.formatTime(root.now, "HH:mm"); color: "#fff"; font.pixelSize: 42; font.bold: true }
            Text { text: root.dateLine(); color: "#9aa7b2"; font.pixelSize: 14 }
            Rectangle { width: parent.width; height: 1; color: "#243038" }
            Text { text: "Календарь GT/OS " + root.osVersion; color: "#d5dde3"; font.pixelSize: 13 }
            Rectangle {
                width: parent.width; height: 36; radius: 8; color: "#1c262e"
                Text { anchors.centerIn: parent; text: "Открыть календарь"; color: "#e8eef2"; font.pixelSize: 12 }
                MouseArea { anchors.fill: parent; onClicked: { root.calendarOpen = false; root.launch("cal", "Календарь") } }
            }
        }
    }

    // Global context menu — Windows 10 classic light style
    Item {
        id: ctxLayer
        anchors.fill: parent
        z: 850

        MouseArea {
            anchors.fill: parent
            visible: root.ctxMenuOpen
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onPressed: {
                // ПКМ при открытом меню — переоткрыть в новой точке, не закрывать
                if (mouse.button === Qt.RightButton) {
                    var items = root.ctxMenuSource === "files" ? root.filesCtxItems() : root.desktopCtxItems()
                    root.openCtxMenuAt(ctxLayer, mouse.x, mouse.y, items, root.ctxMenuSource)
                    return
                }
                if (root.ctxMenuArmed)
                    root.closeCtxMenu()
            }
        }

        // Drop shadow
        Rectangle {
            visible: root.ctxMenuOpen || win10Menu.opacity > 0.02
            x: Math.min(Math.max(8, root.ctxMenuX), ctxLayer.width - win10Menu.width - 8) + 3
            y: Math.min(Math.max(8, root.ctxMenuY), ctxLayer.height - win10Menu.height - 8) + 3
            z: 1
            width: win10Menu.width
            height: win10Menu.height
            color: "#66000000"
            opacity: win10Menu.opacity * 0.85
        }

        // Windows 10 dark context menu
        Rectangle {
            id: win10Menu
            visible: root.ctxMenuOpen || opacity > 0.02
            opacity: root.ctxMenuOpen ? 1 : 0
            scale: root.ctxMenuOpen ? 1 : 0.94
            transformOrigin: Item.TopLeft
            Behavior on opacity { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }
            Behavior on scale { NumberAnimation { duration: 160; easing.type: Easing.OutBack } }
            x: Math.min(Math.max(8, root.ctxMenuX), ctxLayer.width - width - 8)
            y: Math.min(Math.max(8, root.ctxMenuY), ctxLayer.height - height - 8)
            z: 2
            width: root.ctxMenuSource === "dock" ? 280 : 300
            height: root.ctxMenuHeight(root.ctxMenuItems)
            radius: 8
            color: "#2b2b2b"
            border.width: 1
            border.color: "#1f1f1f"

            Column {
                id: win10Col
                anchors.fill: parent
                anchors.topMargin: 4
                anchors.bottomMargin: 4
                spacing: 0
                Repeater {
                    model: root.ctxMenuItems
                    delegate: Item {
                        width: parent.width
                        height: modelData.action === "sep" ? 9 : (modelData.action === "header" ? 36 : 30)
                        property bool isSep: modelData.action === "sep"
                        property bool isHeader: modelData.action === "header"
                        property bool isOff: modelData.disabled === true
                        property bool hasFly: modelData.flyout !== undefined && modelData.flyout.length
                        property bool flyHot: hasFly && root.ctxFlyout === modelData.flyout

                        Rectangle {
                            visible: isSep
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.leftMargin: 12
                            anchors.rightMargin: 12
                            height: 1
                            color: "#404040"
                        }

                        Rectangle {
                            visible: !isSep
                            anchors.fill: parent
                            color: (!isOff && !isHeader && (cmHover.containsMouse || flyHot)) ? "#404040" : "transparent"
                            DeskIconArt {
                                visible: isHeader && (modelData.icon || "").length > 0
                                anchors.left: parent.left
                                anchors.leftMargin: 10
                                anchors.verticalCenter: parent.verticalCenter
                                width: 22; height: 22
                                kind: modelData.icon || "files"
                            }
                            CtxGlyph {
                                visible: !isHeader
                                anchors.left: parent.left
                                anchors.leftMargin: 12
                                anchors.verticalCenter: parent.verticalCenter
                                kind: modelData.icon || ""
                                opacity: isOff ? 0.35 : 1
                            }
                            Text {
                                anchors.left: parent.left
                                anchors.leftMargin: isHeader ? 40 : 36
                                anchors.right: shortcutLab.visible ? shortcutLab.left : arrowLab.left
                                anchors.rightMargin: 8
                                anchors.verticalCenter: parent.verticalCenter
                                text: modelData.label
                                color: isOff ? "#6d6d6d" : "#ffffff"
                                font.pixelSize: isHeader ? 13 : 12
                                font.family: modelData.bold === true ? root.uiFontBold : root.uiFont
                                elide: Text.ElideRight
                            }
                            Text {
                                id: shortcutLab
                                visible: modelData.shortcut !== undefined && modelData.shortcut.length
                                anchors.right: parent.right
                                anchors.rightMargin: modelData.arrow ? 28 : 14
                                anchors.verticalCenter: parent.verticalCenter
                                text: modelData.shortcut || ""
                                color: isOff ? "#6d6d6d" : "#c8c8c8"
                                font.pixelSize: 11
                                font.family: root.uiFont
                            }
                            Text {
                                id: arrowLab
                                visible: modelData.arrow === true
                                anchors.right: parent.right
                                anchors.rightMargin: 12
                                anchors.verticalCenter: parent.verticalCenter
                                text: "›"
                                color: isOff ? "#6d6d6d" : "#ffffff"
                                font.pixelSize: 14
                            }
                            MouseArea {
                                id: cmHover
                                anchors.fill: parent
                                hoverEnabled: true
                                enabled: !isOff && !isHeader
                                onEntered: {
                                    if (hasFly)
                                        root.openCtxFlyout(modelData.flyout, parent.parent.y)
                                    else
                                        root.ctxFlyout = ""
                                }
                                onClicked: {
                                    if (hasFly)
                                        root.openCtxFlyout(modelData.flyout, parent.parent.y)
                                    else
                                        root.runCtxAction(modelData.action)
                                }
                            }
                        }
                    }
                }
            }
        }

        // Подменю (Вид / Сортировка / Создать)
        Rectangle {
            id: win10Flyout
            visible: root.ctxMenuOpen && root.ctxFlyout.length > 0
            z: 3
            width: 240
            height: root.ctxMenuHeight(root.ctxFlyoutItems(root.ctxFlyout))
            radius: 8
            x: {
                var left = win10Menu.x + win10Menu.width - 2
                if (left + width > ctxLayer.width - 8)
                    return Math.max(8, win10Menu.x - width + 2)
                return left
            }
            y: {
                var top = win10Menu.y + 4 + root.ctxFlyoutAnchorY
                return Math.min(Math.max(8, top), ctxLayer.height - height - 8)
            }
            color: "#2b2b2b"
            border.width: 1
            border.color: "#1f1f1f"

            // тень
            Rectangle {
                z: -1
                anchors.fill: parent
                anchors.margins: -2
                color: "#55000000"
            }

            Column {
                anchors.fill: parent
                anchors.topMargin: 4
                anchors.bottomMargin: 4
                spacing: 0
                Repeater {
                    model: root.ctxFlyoutItems(root.ctxFlyout)
                    delegate: Item {
                        width: parent.width
                        height: modelData.action === "sep" ? 9 : 30
                        property bool isSep: modelData.action === "sep"
                        Rectangle {
                            visible: isSep
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.leftMargin: 12
                            anchors.rightMargin: 12
                            height: 1
                            color: "#404040"
                        }
                        Rectangle {
                            visible: !isSep
                            anchors.fill: parent
                            color: flyHover.containsMouse ? "#404040" : "transparent"
                            Rectangle {
                                visible: modelData.check === true
                                anchors.left: parent.left
                                anchors.leftMargin: 12
                                anchors.verticalCenter: parent.verticalCenter
                                width: 8; height: 8; radius: 4
                                color: root.accentColor
                            }
                            CtxGlyph {
                                anchors.left: parent.left
                                anchors.leftMargin: 32
                                anchors.verticalCenter: parent.verticalCenter
                                kind: modelData.icon || ""
                            }
                            Text {
                                anchors.left: parent.left
                                anchors.leftMargin: modelData.icon ? 54 : 32
                                anchors.right: parent.right
                                anchors.rightMargin: 12
                                anchors.verticalCenter: parent.verticalCenter
                                text: modelData.label
                                color: "#ffffff"
                                font.pixelSize: 12
                                font.family: root.uiFont
                                elide: Text.ElideRight
                            }
                            MouseArea {
                                id: flyHover
                                anchors.fill: parent
                                hoverEnabled: true
                                onClicked: root.runCtxAction(modelData.action)
                            }
                        }
                    }
                }
            }
        }
    }

    // Цветные глифы для контекстного меню (Win10-style)
    component CtxGlyph: Item {
        property string kind: ""
        width: 16
        height: 16
        opacity: kind.length ? 1 : 0

        // refresh — синие стрелки
        Item {
            visible: kind === "refresh"
            anchors.fill: parent
            Rectangle {
                anchors.centerIn: parent
                width: 12; height: 12; radius: 6
                color: "transparent"
                border.width: 2; border.color: "#4fc3f7"
            }
            Rectangle {
                x: 10; y: 1; width: 5; height: 5; radius: 1; rotation: 45
                color: "#4fc3f7"
            }
        }
        // terminal
        Item {
            visible: kind === "term"
            anchors.fill: parent
            Rectangle {
                anchors.fill: parent; radius: 2
                color: "#1b1b1b"
                border.width: 1; border.color: "#555"
            }
            Text {
                anchors.left: parent.left; anchors.leftMargin: 2
                anchors.verticalCenter: parent.verticalCenter
                text: ">_"; color: "#3be182"; font.pixelSize: 9; font.bold: true
            }
        }
        // paste / clipboard
        Item {
            visible: kind === "paste"
            anchors.fill: parent
            Rectangle {
                x: 3; y: 1; width: 10; height: 14; radius: 1
                color: "#fff59d"; border.color: "#f9a825"; border.width: 1
            }
            Rectangle {
                x: 5; y: 0; width: 6; height: 3; radius: 1; color: "#ffcc80"
            }
            Rectangle {
                x: 5; y: 6; width: 6; height: 1.5; color: "#f9a825"
            }
            Rectangle {
                x: 5; y: 9; width: 6; height: 1.5; color: "#f9a825"
            }
        }
        // undo
        Item {
            visible: kind === "undo"
            anchors.fill: parent
            Text {
                anchors.centerIn: parent
                text: "↶"; color: "#90caf9"; font.pixelSize: 14; font.bold: true
            }
        }
        // wallpaper / nextwall
        Item {
            visible: kind === "wallpaper"
            anchors.fill: parent
            Rectangle {
                anchors.fill: parent; radius: 2
                gradient: Gradient {
                    GradientStop { position: 0; color: "#81d4fa" }
                    GradientStop { position: 1; color: "#43a047" }
                }
            }
            Rectangle {
                x: 2; y: 8; width: 6; height: 5; radius: 1; rotation: 20; color: "#2e7d32"
            }
            Rectangle {
                x: 9; y: 3; width: 4; height: 4; radius: 2; color: "#fff59d"
            }
        }
        // create / +
        Item {
            visible: kind === "create" || kind === "folder"
            anchors.fill: parent
            Rectangle {
                x: 1; y: 3; width: 6; height: 4; radius: 1; color: "#ffe082"
            }
            Rectangle {
                x: 0; y: 6; width: 14; height: 9; radius: 2
                color: "#ffc107"
            }
            Text {
                visible: kind === "create"
                anchors.right: parent.right; anchors.bottom: parent.bottom
                anchors.margins: -1
                text: "+"; color: "#43a047"; font.pixelSize: 11; font.bold: true
            }
        }
        // display / monitor
        Item {
            visible: kind === "display"
            anchors.fill: parent
            Rectangle {
                anchors.horizontalCenter: parent.horizontalCenter
                y: 1; width: 14; height: 10; radius: 1
                color: "#90a4ae"
                Rectangle {
                    anchors.fill: parent; anchors.margins: 1.5; radius: 1
                    color: "#1565c0"
                }
            }
            Rectangle {
                anchors.horizontalCenter: parent.horizontalCenter
                y: 11; width: 4; height: 2; color: "#78909c"
            }
            Rectangle {
                anchors.horizontalCenter: parent.horizontalCenter
                y: 13; width: 8; height: 2; radius: 1; color: "#b0bec5"
            }
        }
        // paint / personalize
        Item {
            visible: kind === "paint"
