        s = s.replace(/<h2(\s|>)/gi, "<h2 style='color:#202124;font-size:22px;font-weight:700;margin:14px 0 8px 0;font-family:Syne,Sora,sans-serif;'$1")
        s = s.replace(/<h3(\s|>)/gi, "<h3 style='color:#1a0dab;font-size:18px;font-weight:600;margin:12px 0 6px 0;'$1")
        s = s.replace(/<p(\s|>)/gi, "<p style='margin:0 0 12px 0;line-height:1.6;'$1")
        s = s.replace(/<a href=/gi, "<a style='color:#1a0dab;text-decoration:none;' href=")
        s = s.replace(/<code(\s|>)/gi, "<code style='background:#f1f3f4;padding:1px 6px;border-radius:4px;font-family:Cascadia Mono,monospace;font-size:13px;'$1")
        s = s.replace(/<pre(\s|>)/gi, "<pre style='background:#f8f9fa;border:1px solid #dadce0;border-radius:8px;padding:12px;overflow:auto;font-family:Cascadia Mono,monospace;font-size:13px;'$1")
        s = s.replace(/<blockquote(\s|>)/gi, "<blockquote style='border-left:4px solid #dadce0;margin:12px 0;padding:4px 14px;color:#5f6368;'$1")
        s = s.replace(/<hr\s*\/?>/gi, "<hr style='border:none;border-top:1px solid #dadce0;margin:18px 0;'/>")
        return s
