                                text: "ЦП за минуту"
                                color: root.accentColor; font.pixelSize: 13; font.family: root.uiFontBold
                            }
                            Canvas {
                                id: cpuGraph
                                anchors.fill: parent
                                anchors.margins: 14
                                anchors.topMargin: 40
                                onPaint: {
                                    var ctx = getContext("2d")
                                    ctx.clearRect(0, 0, width, height)
                                    var data = root.cpuHistory
                                    ctx.fillStyle = "#1a1a1a"
                                    ctx.fillRect(0, 0, width, height)
                                    if (!data.length) return
                                    ctx.beginPath()
                                    for (var i = 0; i < data.length; ++i) {
                                        var x = (i / Math.max(1, data.length - 1)) * width
                                        var y = height - (data[i] / 100) * height
                                        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y)
                                    }
                                    ctx.strokeStyle = "#3be182"
                                    ctx.lineWidth = 2
                                    ctx.stroke()
                                    ctx.lineTo(width, height); ctx.lineTo(0, height); ctx.closePath()
                                    ctx.fillStyle = "#3be18228"
                                    ctx.fill()
                                }
                                Connections {
                                    target: root
                                    function onCpuHistoryChanged() { cpuGraph.requestPaint() }
                                    function onCpuPctChanged() { cpuGraph.requestPaint() }
                                }
                            }
