    function selectWeatherCity(city) {
        if (!city) return
        weatherCity = city.name
        weatherLat = Number(city.lat)
        weatherLon = Number(city.lon)
        var found = false
        var arr = weatherCities.slice()
        for (var i = 0; i < arr.length; ++i) {
            if (arr[i].name === city.name) { found = true; break }
        }
        if (!found) {
            arr.unshift({ name: city.name, lat: weatherLat, lon: weatherLon })
            if (arr.length > 8) arr = arr.slice(0, 8)
            weatherCities = arr
            saveWeatherCities()
        }
        refreshWeather()
    }

    function searchWeatherCities(q) {
        weatherQuery = q
        if (!q || q.trim().length < 2) {
            weatherSearchResults = []
            return
        }
        var url = "https://geocoding-api.open-meteo.com/v1/search?name="
                + encodeURIComponent(q.trim()) + "&count=6&language=ru&format=json"
        var raw = (typeof sys.runTimeout === "function"
                   ? sys.runTimeout("curl -fsSL --max-time 8 " + shQuote(url), 10000)
                   : sys.run("curl -fsSL --max-time 8 " + shQuote(url))).trim()
        try {
            var data = JSON.parse(raw)
            var res = data.results || []
            var out = []
            for (var i = 0; i < res.length; ++i) {
                out.push({
                    name: res[i].name + (res[i].country ? (", " + res[i].country) : ""),
                    lat: res[i].latitude,
                    lon: res[i].longitude
                })
            }
            weatherSearchResults = out
        } catch (e) {
            weatherSearchResults = []
        }
    }

    function refreshWeather() {
        weatherLoading = true
        weatherDesc = "Обновление…"
        var url = "https://api.open-meteo.com/v1/forecast?latitude=" + weatherLat
                + "&longitude=" + weatherLon
                + "&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,surface_pressure"
                + "&hourly=temperature_2m,weather_code,precipitation_probability"
                + "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max"
                + "&timezone=auto&forecast_days=7"
        var raw = (typeof sys.runTimeout === "function"
                   ? sys.runTimeout("curl -fsSL --max-time 10 " + shQuote(url), 12000)
                   : sys.run("curl -fsSL --max-time 10 " + shQuote(url))).trim()
        weatherLoading = false
        if (!raw.length || raw.charAt(0) !== "{") {
            weatherDesc = "Нет сети или API недоступен"
            return
        }
        try {
            var data = JSON.parse(raw)
            var cur = data.current || {}
            weatherTemp = (cur.temperature_2m !== undefined) ? (Math.round(cur.temperature_2m) + "°") : "—"
            weatherCode = cur.weather_code || 0
            weatherDesc = weatherCodeText(weatherCode)
            weatherHumidity = (cur.relative_humidity_2m !== undefined) ? (cur.relative_humidity_2m + "%") : "—"
            weatherWind = (cur.wind_speed_10m !== undefined) ? (Math.round(cur.wind_speed_10m) + " км/ч") : "—"
            weatherPressure = (cur.surface_pressure !== undefined) ? (Math.round(cur.surface_pressure) + " гПа") : "—"
            var hourly = []
            var ht = (data.hourly && data.hourly.time) ? data.hourly.time : []
            var htemp = (data.hourly && data.hourly.temperature_2m) ? data.hourly.temperature_2m : []
            var hcode = (data.hourly && data.hourly.weather_code) ? data.hourly.weather_code : []
            var nowH = Qt.formatDateTime(new Date(), "yyyy-MM-ddTHH")
            var start = 0
            for (var i = 0; i < ht.length; ++i) {
                if (String(ht[i]).indexOf(nowH) === 0) { start = i; break }
            }
            for (var j = start; j < Math.min(start + 24, ht.length); ++j) {
                hourly.push({
                    time: String(ht[j]).slice(11, 16),
                    temp: Math.round(htemp[j]) + "°",
                    code: hcode[j] || 0,
                    label: weatherCodeText(hcode[j] || 0)
                })
            }
            weatherHourly = hourly
            var daily = []
            var dt = (data.daily && data.daily.time) ? data.daily.time : []
            var dmax = (data.daily && data.daily.temperature_2m_max) ? data.daily.temperature_2m_max : []
            var dmin = (data.daily && data.daily.temperature_2m_min) ? data.daily.temperature_2m_min : []
            var dcode = (data.daily && data.daily.weather_code) ? data.daily.weather_code : []
            var days = ["Вс", "Пн", "Вт", "Ср", "Чт", "Пт", "Сб"]
            for (var d = 0; d < dt.length; ++d) {
                var dateObj = new Date(String(dt[d]) + "T12:00:00")
                daily.push({
                    day: d === 0 ? "Сегодня" : days[dateObj.getDay()],
                    max: Math.round(dmax[d]) + "°",
                    min: Math.round(dmin[d]) + "°",
                    code: dcode[d] || 0,
                    label: weatherCodeText(dcode[d] || 0)
                })
            }
            weatherDaily = daily
            weatherUpdated = Qt.formatTime(new Date(), "HH:mm")
        } catch (e) {
            weatherDesc = "Ошибка разбора ответа"
        }
    }

