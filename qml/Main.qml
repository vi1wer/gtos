                Column {
                    anchors.fill: parent; anchors.margins: 14; spacing: 10
                    visible: root.devPropsTab === "details"
                    Text { text: "Свойство"; color: "#111"; font.pixelSize: 13; font.family: root.uiFontBold }
                    Text {
                        width: parent.width
