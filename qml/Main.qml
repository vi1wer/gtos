    // Клевер GT — логотип акцентным цветом
    component CloverMark: Item {
        id: clover
        property color ink: root.accentColor
        width: 36
        height: 36
        Canvas {
            id: cloverCanvas
            anchors.fill: parent
            onPaint: {
                var ctx = getContext("2d")
                ctx.clearRect(0, 0, width, height)
                var cx = width * 0.5
                var cy = height * 0.46
                var r = Math.min(width, height) * 0.22
                ctx.fillStyle = clover.ink.toString()
                function leaf(lx, ly) {
                    ctx.beginPath()
                    ctx.arc(lx, ly, r, 0, Math.PI * 2)
                    ctx.fill()
                }
                // четыре листа без стебля
                var cy2 = height * 0.5
                leaf(cx, cy2 - r * 0.95)
                leaf(cx - r * 0.95, cy2)
                leaf(cx + r * 0.95, cy2)
                leaf(cx, cy2 + r * 0.95)
                // центр
                ctx.beginPath()
                ctx.arc(cx, cy2, r * 0.28, 0, Math.PI * 2)
                ctx.fill()
            }
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()
            Connections {
                target: clover
                function onInkChanged() { cloverCanvas.requestPaint() }
            }
            Component.onCompleted: requestPaint()
        }
    }

