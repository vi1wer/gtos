                    color: "#9aa7b2"; font.pixelSize: 13
                }
                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: 240; height: 40; radius: 10; color: root.accentColor
                    Text { anchors.centerIn: parent; text: "Открыть раздел"; color: "#06210f"; font.pixelSize: 13; font.bold: true }
                    MouseArea { anchors.fill: parent; onClicked: root.openControlTab("recovery") }
                }
            }
        }
    }

    Component {
        id: powerPage
        Item {
            property string appTitle: ""
            // GT Power Manager живёт в Параметрах → Питание
            Component.onCompleted: root.openSettingsSection("power")
            Rectangle { anchors.fill: parent; color: "#0e1519" }
            Column {
                anchors.centerIn: parent; spacing: 12
                Text { text: "GT Power Manager"; color: "#fff"; font.pixelSize: 22; font.family: root.uiFontBold; horizontalAlignment: Text.AlignHCenter; width: 360 }
                Text {
                    width: 360; horizontalAlignment: Text.AlignHCenter; wrapMode: Text.WordWrap
                    text: "Открывается в Параметры → Питание"
                    color: "#9aa7b2"; font.pixelSize: 13
                }
                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: 220; height: 40; radius: 10; color: root.accentColor
                    Text { anchors.centerIn: parent; text: "Открыть раздел"; color: "#06210f"; font.pixelSize: 13; font.bold: true }
                    MouseArea { anchors.fill: parent; onClicked: root.openSettingsSection("power") }
                }
            }
        }
    }

    Component {
        id: archivePage
        Item {
            property string appTitle: ""
            Rectangle { anchors.fill: parent; color: "#0e1519" }
            Column {
                anchors.fill: parent; anchors.margins: 22; spacing: 14
                Text { text: "GT Archive Manager"; color: "#fff"; font.pixelSize: 26; font.family: root.uiFontBold }
                Text {
                    text: root.archiveStatus
                    color: "#9aa7b2"; font.pixelSize: 13; width: parent.width; wrapMode: Text.WordWrap
                }
                Row {
                    spacing: 10
                    Repeater {
                        model: [
                            { id: "zip", name: "ZIP" },
                            { id: "tar", name: "TAR" },
                            { id: "gzip", name: "GZIP" },
                            { id: "7z", name: "7Z" }
                        ]
                        delegate: Rectangle {
