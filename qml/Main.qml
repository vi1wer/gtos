    // Экран блокировки (Win11-стиль) с анимациями.
    // Обои JPEG не анимируем (opacity/scale картинки на TCG = зависание);
    // плавность — у часов, логина, оверлея и появления экрана.
    Item {
        id: lockScreen
        anchors.fill: parent
        z: 980
        visible: (root.locked || root.lockUnlocking) && !root.booting && !root.setupOpen
        property real appear: 1
        opacity: root.lockUnlocking ? 0 : appear
        scale: root.lockUnlocking ? 1.04 : (0.985 + 0.015 * appear)
        Behavior on opacity { NumberAnimation { duration: 380; easing.type: Easing.OutCubic } }
        Behavior on scale { NumberAnimation { duration: 400; easing.type: Easing.OutCubic } }

        NumberAnimation {
            id: lockEnter
            target: lockScreen
            property: "appear"
            from: 0; to: 1; duration: 520
            easing.type: Easing.OutCubic
        }

        Image {
            id: lockWall
            anchors.fill: parent
            source: root.lockWallpaperSource()
            fillMode: Image.PreserveAspectCrop
            cache: true
            // статичные обои — без Behavior
        }
        Rectangle {
            anchors.fill: parent
            visible: root.lockWallpaperIndex > 0
            color: root.lockWallpaperIndex === 1 ? "#00000000" : "#33002244"
        }

        // затемнение отдельным слоем (дешевле, чем opacity у JPEG)
        Rectangle {
            id: lockDim
            anchors.fill: parent
            color: "#000000"
            opacity: root.lockReveal ? 0.55 : 0.18
            Behavior on opacity { NumberAnimation { duration: 360; easing.type: Easing.OutCubic } }
        }

        Column {
            id: lockClockCol
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: parent.height * 0.18
            spacing: 6
            property real slideY: root.lockReveal ? -36 : 0
            opacity: root.lockReveal ? 0 : 1
            scale: root.lockReveal ? 0.94 : 1
            transformOrigin: Item.Top
            transform: Translate { y: lockClockCol.slideY }
            Behavior on opacity { NumberAnimation { duration: 300; easing.type: Easing.InCubic } }
            Behavior on scale { NumberAnimation { duration: 340; easing.type: Easing.InCubic } }
            Behavior on slideY { NumberAnimation { duration: 380; easing.type: Easing.InOutCubic } }
            visible: opacity > 0.02

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: Qt.formatTime(root.now, "HH:mm")
                color: "#ffffff"
                font.pixelSize: 96
                font.weight: Font.Light
                font.family: root.uiFont
                style: Text.Outline
                styleColor: "#66000000"
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: root.dateLine()
                color: "#f0f4f8"
                font.pixelSize: 22
                font.family: root.uiFont
                style: Text.Outline
                styleColor: "#55000000"
            }
            Text {
                id: lockHint
                anchors.horizontalCenter: parent.horizontalCenter
                text: "Нажмите в любом месте, чтобы войти"
                color: "#d0d8e0"
                font.pixelSize: 14
                font.family: root.uiFont
                opacity: 0.55
                SequentialAnimation on opacity {
                    running: lockScreen.visible && !root.lockReveal
                    loops: Animation.Infinite
                    NumberAnimation { from: 0.4; to: 0.95; duration: 1200; easing.type: Easing.InOutSine }
                    NumberAnimation { from: 0.95; to: 0.4; duration: 1200; easing.type: Easing.InOutSine }
                }
            }
        }

        Column {
            id: lockLoginCol
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.verticalCenter
            anchors.verticalCenterOffset: 28
            spacing: 14
            property real slideY: root.lockReveal ? 0 : 48
            opacity: root.lockReveal ? 1 : 0
            scale: root.lockReveal ? 1 : 0.92
            transformOrigin: Item.Center
            transform: Translate { y: lockLoginCol.slideY }
            Behavior on opacity { NumberAnimation { duration: 380; easing.type: Easing.OutCubic } }
            Behavior on scale { NumberAnimation { duration: 420; easing.type: Easing.OutBack } }
            Behavior on slideY { NumberAnimation { duration: 450; easing.type: Easing.OutBack } }
            visible: opacity > 0.02
            enabled: root.lockReveal

            Item {
                id: lockAvatar
                width: 104; height: 104
                anchors.horizontalCenter: parent.horizontalCenter
                scale: root.lockReveal ? 1 : 0.55
                Behavior on scale { NumberAnimation { duration: 480; easing.type: Easing.OutBack } }
                Rectangle {
                    id: lockRing
                    anchors.fill: parent
                    radius: width / 2
                    color: "transparent"
                    border.width: 3
                    border.color: "#66ffffff"
                    opacity: 0.85
                    SequentialAnimation on scale {
                        running: root.lockReveal && lockScreen.visible
                        loops: Animation.Infinite
                        NumberAnimation { from: 1.0; to: 1.06; duration: 1400; easing.type: Easing.InOutSine }
                        NumberAnimation { from: 1.06; to: 1.0; duration: 1400; easing.type: Easing.InOutSine }
                    }
                }
                Rectangle {
                    anchors.centerIn: parent
                    width: 92; height: 92; radius: 46
                    color: root.userAvatar
                    Text {
                        anchors.centerIn: parent
                        text: (root.userFullName.length ? root.userFullName : root.currentUser).charAt(0).toUpperCase()
                        color: "#fff"; font.pixelSize: 40; font.bold: true
                        font.family: root.uiFont
                    }
                }
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: root.userFullName.length ? root.userFullName : root.currentUser
                color: "#ffffff"
                font.pixelSize: 28
                font.family: root.uiFont
                style: Text.Outline
                styleColor: "#66000000"
                opacity: root.lockReveal ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: root.currentUser
                color: "#c8d0d8"
                font.pixelSize: 13
                font.family: root.uiFont
                visible: root.userFullName.length > 0 && root.userFullName !== root.currentUser
            }

            Flow {
                anchors.horizontalCenter: parent.horizontalCenter
                width: 320
                spacing: 8
                visible: root.lockReveal && root.osUsers.length > 1
                Repeater {
                    model: root.osUsers
                    delegate: Rectangle {
                        width: Math.min(110, lockULab.implicitWidth + 20)
                        height: 28; radius: 14
                        color: root.currentUser === modelData.user ? "#3be182" : "#44ffffff"
                        Text {
                            id: lockULab
                            anchors.centerIn: parent
                            text: modelData.name || modelData.user
                            color: root.currentUser === modelData.user ? "#06210f" : "#fff"
                            font.pixelSize: 11
                        }
                        MouseArea {
                            anchors.fill: parent
                            onClicked: {
                                if (modelData.user !== root.currentUser)
                                    root.switchOsUser(modelData.user)
                            }
                        }
                    }
                }
            }

            Item {
                width: 300; height: 44
                anchors.horizontalCenter: parent.horizontalCenter
                transform: Translate {
                    x: root.lockShake ? lockShakeAnim.x : 0
                }
                SequentialAnimation {
                    id: lockShakeAnim
                    property real x: 0
                    running: root.lockShake
                    NumberAnimation { target: lockShakeAnim; property: "x"; to: 12; duration: 50 }
                    NumberAnimation { target: lockShakeAnim; property: "x"; to: -12; duration: 50 }
                    NumberAnimation { target: lockShakeAnim; property: "x"; to: 8; duration: 50 }
                    NumberAnimation { target: lockShakeAnim; property: "x"; to: -8; duration: 50 }
                    NumberAnimation { target: lockShakeAnim; property: "x"; to: 0; duration: 50 }
                }
                Rectangle {
                    anchors.fill: parent
                    radius: 8
                    color: "#cc1a1f26"
                    border.width: 1
                    border.color: root.lockError.length ? "#ff8a80" : (lockField.activeFocus ? "#a0ffffff" : "#55ffffff")
                    Behavior on border.color { ColorAnimation { duration: 180 } }
                    TextInput {
                        id: lockField
                        anchors.fill: parent
                        anchors.leftMargin: 14
                        anchors.rightMargin: 44
                        anchors.topMargin: 11
                        anchors.bottomMargin: 11
                        color: "#ffffff"
                        font.pixelSize: 15
                        font.family: root.uiFont
                        echoMode: root.hasSessionPassword() ? TextInput.Password : TextInput.Normal
                        text: root.lockInput
                        onTextChanged: root.lockInput = text
                        Keys.onReturnPressed: root.unlockSession()
                        Keys.onEnterPressed: root.unlockSession()
                        Keys.onEscapePressed: root.lockReveal = false
                        Text {
                            anchors.fill: parent
                            verticalAlignment: Text.AlignVCenter
                            visible: !lockField.text.length
                            text: root.hasSessionPassword() ? "Пароль" : "Нажмите Enter"
                            color: "#99a0a8"; font.pixelSize: 14
                        }
                    }
                    Rectangle {
                        anchors.right: parent.right
                        anchors.verticalCenter: parent.verticalCenter
                        anchors.rightMargin: 4
                        width: 36; height: 36; radius: 6
                        color: goHover.containsMouse ? "#33ffffff" : "transparent"
                        scale: goHover.containsMouse ? 1.08 : 1
                        Behavior on scale { NumberAnimation { duration: 120 } }
                        Text {
                            anchors.centerIn: parent
                            text: "➜"
                            color: "#ffffff"; font.pixelSize: 16
                        }
                        MouseArea {
                            id: goHover
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: root.unlockSession()
                        }
                    }
                }
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                visible: root.lockError.length > 0
                text: root.lockError
                color: "#ff8a80"; font.pixelSize: 13
                font.family: root.uiFont
                opacity: root.lockError.length ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: 200 } }
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                visible: !root.hasSessionPassword() && root.lockReveal
                text: "Пароль не задан — Enter для входа"
                color: "#aab4be"; font.pixelSize: 12
            }
        }

        Timer {
            id: lockFocusTimer
            interval: 80
            onTriggered: {
                if (root.lockReveal && lockScreen.visible)
                    lockField.forceActiveFocus()
            }
        }

        MouseArea {
            anchors.fill: parent
            z: -1
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onClicked: {
                if (!root.lockReveal && !root.lockUnlocking) {
                    root.lockReveal = true
                    lockFocusTimer.restart()
                }
            }
        }

        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 28
            opacity: root.lockReveal ? 0 : 0.7
            text: "GT/OS " + root.osVersion
            color: "#88ffffff"
            font.pixelSize: 12
            font.family: root.uiFont
            Behavior on opacity { NumberAnimation { duration: 280 } }
        }

        onVisibleChanged: {
            if (visible && root.locked && !root.lockUnlocking) {
                root.lockReveal = false
                root.lockInput = ""
                root.lockError = ""
                root.lockShake = false
                lockEnter.start()
            }
        }
        Keys.onPressed: {
            if (!root.lockReveal && !root.lockUnlocking) {
                root.lockReveal = true
                lockFocusTimer.restart()
            }
        }
        focus: visible
    }
}
