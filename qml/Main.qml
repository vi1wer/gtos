        }
        if (fileBack.length === 0)
            return
        var prev = fileBack[fileBack.length - 1]
        fileBack = fileBack.slice(0, fileBack.length - 1)
        if (filesPath !== "recent" && filesPath !== "fav")
            fileFwd = [filesPath].concat(fileFwd)
        loadFiles(prev)
    }

    function filesForward() {
        if (fileFwd.length === 0)
            return
        var next = fileFwd[0]
        fileFwd = fileFwd.slice(1)
        if (filesPath !== "recent" && filesPath !== "fav")
            fileBack = fileBack.concat([filesPath])
        loadFiles(next)
    }

    function filesUp() {
        if (filesPath === "recent" || filesPath === "fav" || filesPath === "thispc" || filesPath === "/" || filesPath === "/home/misha" || filesPath === "/home/" + currentUser)
            return
        var slash = filesPath.lastIndexOf("/")
        var parent = slash <= 0 ? "/" : filesPath.slice(0, slash)
        if (parent.length === 0)
            parent = "/"
        navigateTo(parent, false)
    }

    function filesRefresh() {
        if (filesPath === "recent")
            openPlace("recent")
        else if (filesPath === "fav")
            openPlace("fav")
        else if (filesPath === "thispc")
            openPlace("thispc")
        else
            loadFiles(filesPath)
    }

    function filesTitle() {
        if (filesPath === "/home/misha" || filesPath === "/home/" + currentUser)
            return "Главная"
        if (filesPath === "recent")
            return "Недавние"
        if (filesPath === "fav")
            return "Быстрый доступ"
        if (filesPath === "thispc")
            return "Этот компьютер"
        if (filesPath === "/")
            return "Локальный диск (C:)"
        var name = filesPath.slice(filesPath.lastIndexOf("/") + 1)
        return name === ".Корзина" ? "Корзина" : name
    }

    function filesPathLabel() {
        if (filesPath === "/home/misha" || filesPath === "/home/" + currentUser)
            return "Домашняя папка"
        if (filesPath === "recent" || filesPath === "fav" || filesPath === "thispc")
            return filesTitle()
        if (filesPath === "/")
            return "C:\\"
        return prettyPath(filesPath)
    }

    function isPlaceActive(path) {
        if (path === "recent" || path === "fav" || path === "thispc")
            return filesPath === path
        if (path === "/home/misha" || path === "/home/" + currentUser)
            return filesPath === path
        if (path === "/")
            return filesPath === "/"
        return filesPath === path || filesPath.indexOf(path + "/") === 0
    }

    function filteredFiles() {
        if (!fileQuery.length)
            return fileEntries
        var q = fileQuery.toLowerCase()
        var out = []
        for (var i = 0; i < fileEntries.length; ++i) {
            if (fileEntries[i].name.toLowerCase().indexOf(q) !== -1)
                out.push(fileEntries[i])
        }
        return out
    }

    Timer {
        id: notifyKiller
        interval: 4200
        repeat: false
        onTriggered: {
            if (notifications.length)
                notifications = notifications.slice(0, notifications.length - 1)
            if (notifications.length)
                restart()
        }
    }

    Timer {
        id: bootNotify
        interval: 800
        running: false
        repeat: false
        onTriggered: {
            if (!setupOpen && !locked) {
                notify("GT/OS " + osVersion + " готов", persistOk ? "Постоянный том активен" : "Рабочий стол запущен", "ok")
                refreshNetwork()
                notify("Сеть", netStatus, "wifi")
                runStartupApps()
            }
        }
    }

    function finishBootVisual() {
        bootAnim.stop()
        bootSweepAnim.stop()
        bootFadeOut.start()
    }

    function revealAfterBoot() {
        booting = false
        bootLogoOpacity = 0
        bootBarOpacity = 0
        if (setupOpen) {
            locked = false
        } else {
            locked = true
            lockReveal = false
            lockScreen.appear = 0
            lockEnter.start()
        }
        // тяжёлая инициализация — после экрана загрузки, кусками
        postBootInit.phase = 0
        postBootInit.start()
    }

    function runPostBootPhase(phase) {
        if (phase === 0) {
            ensureHome()
            return
        }
        if (phase === 1) {
            refreshNetwork()
            refreshBattery()
            return
        }
        if (phase === 2) {
            refreshDeskIcons()
            termCwd = "/home/" + currentUser
            notePath = "/home/" + currentUser + "/Документы/заметка.txt"
            refreshPrompt()
            return
        }
        if (phase === 3) {
            termLog = neoFetch() + "\n"
            loadFiles("/home/" + currentUser)
            loadRecent()
            return
        }
        if (phase === 4) {
            var inst = sys.readFile("/var/lib/gtos/installed.json").trim()
            if (inst.length) {
                var map = {}
                var parts = inst.split(",")
                for (var i = 0; i < parts.length; ++i) {
                    var id = parts[i].trim()
                    if (id.length)
                        map[id] = true
                }
                installedApps = map
            }
            syncInstalledFromSystem()
            refreshAppIconCache()
            bootHeavyDone = true
        }
    }

    Timer {
        id: bootAnim
        interval: 50
        running: false
        repeat: true
        property int step: 0
        onTriggered: {
            step += 1
            bootProgress = Math.min(1, step / 70)
            // минимум ~3.5 с визуала; не обрываем, пока intro/sweep живы
            if (bootProgress >= 1)
                root.finishBootVisual()
        }
    }

    Timer {
        id: postBootInit
        interval: 350
        running: false
        repeat: true
        property int phase: 0
        onTriggered: {
            root.runPostBootPhase(phase)
            phase += 1
            if (phase > 4)
                stop()
        }
    }

    NumberAnimation {
        id: bootFadeOut
        target: root
        property: "bootFade"
        to: 0
        duration: 520
        easing.type: Easing.InOutCubic
        onStopped: root.revealAfterBoot()
    }

    SequentialAnimation {
        id: bootIntro
        running: false
        ParallelAnimation {
            NumberAnimation {
                target: root; property: "bootLogoOpacity"; from: 0; to: 1
                duration: 950; easing.type: Easing.OutCubic
            }
            NumberAnimation {
                target: root; property: "bootLogoScale"; from: 0.86; to: 1
                duration: 1100; easing.type: Easing.OutBack
            }
            NumberAnimation {
                target: root; property: "bootLogoOffset"; from: 32; to: 0
                duration: 950; easing.type: Easing.OutCubic
            }
        }
        PauseAnimation { duration: 180 }
        NumberAnimation {
            target: root; property: "bootBarOpacity"; from: 0; to: 1
            duration: 420; easing.type: Easing.OutCubic
        }
        ScriptAction { script: bootSweepAnim.restart() }
    }

    SequentialAnimation {
        id: bootSweepAnim
