    function checkUpdates() {
        updateChecking = true
        updateStatus = "Проверка репозиториев и оболочки…"
        updateDepsStatus = "Сверяем зависимости…"
        var diskVer = sys.readFile("/var/lib/gtos/version").trim()
        if (!diskVer.length)
            diskVer = sys.readFile("/usr/share/gtos/version").trim()
        if (diskVer.length && diskVer !== osVersion)
            updateStatus = "Оболочка на диске: " + diskVer + " · UI: " + osVersion
        sys.run(
            "mkdir -p /var/lib/gtos/apk-cache /var/lib/gtos/update-snapshots; "
            + "( apk update --cache-dir /var/lib/gtos/apk-cache >/tmp/gtos-upd.log 2>&1; "
            + "apk upgrade -s --cache-dir /var/lib/gtos/apk-cache 2>/tmp/gtos-upd-sim.txt; "
            + "apk policy 2>/dev/null | head -n 40 >/tmp/gtos-upd-deps.txt; "
            + "/usr/bin/gtos-shell-update --check >/tmp/gtos-shell-upd-check.log 2>&1 || true; "
            + "/usr/bin/gtos-shell-update --check --network >>/tmp/gtos-shell-upd-check.log 2>&1 || true; "
            + "echo done >/tmp/gtos-upd-done ) &"
        )
        updateCheckTimer.restart()
    }

    function checkUpdateDependencies() {
        var sim = sys.readFile("/tmp/gtos-upd-sim.txt").trim()
        var lines = sim.length ? sim.split("\n") : []
        var pkgs = []
        for (var i = 0; i < lines.length; ++i) {
            var L = lines[i].trim()
            if (!L.length || L.indexOf("OK:") === 0 || L.indexOf("WARNING:") === 0)
                continue
            if (L.indexOf("Upgrading") >= 0 || L.indexOf("Installing") >= 0 || L.indexOf("(") >= 0)
                pkgs.push(L)
        }
        updatePendingPkgs = pkgs.slice(0, 24)
        if (!pkgs.length) {
            updateDepsStatus = "Конфликтов нет · зависимости согласованы"
            notify("GT Update Engine", "Зависимости в порядке", "ok")
        } else {
            updateDepsStatus = "Затронуто пакетов: " + pkgs.length + " · снимок перед установкой обязателен"
            notify("GT Update Engine", updateDepsStatus, "info")
        }
    }

    function applySystemUpdates(rebootAfter) {
        if (updateApplying)
            return
        checkUpdateDependencies()
        updateApplying = true
        updateNeedsReboot = !!rebootAfter
        upsertPendingOp("update", "Обновление системы", "Снимок и установка…", 8, "update")
        updateStatus = "Создаём снимок перед обновлением…"
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd-HHmmss")
        sys.run(
            "mkdir -p /var/lib/gtos/update-snapshots/" + stamp + "; "
            + "apk info -v 2>/dev/null | sort > /var/lib/gtos/update-snapshots/" + stamp + "/apk-before.txt; "
            + "printf '%s\\n' " + shQuote(osVersion) + " > /var/lib/gtos/update-snapshots/" + stamp + "/os-version.txt; "
            + "cp -f /tmp/gtos-upd-sim.txt /var/lib/gtos/update-snapshots/" + stamp + "/planned.txt 2>/dev/null; "
            + "echo " + stamp + " > /var/lib/gtos/update-snapshots/latest; "
            + "( apk upgrade --cache-dir /var/lib/gtos/apk-cache >/tmp/gtos-upd-apply.log 2>&1; "
            + "echo $? > /tmp/gtos-upd-apply-rc; "
            + "GTOS_VERSION=" + osVersion + " /usr/bin/gtos-shell-update >>/tmp/gtos-upd-apply.log 2>&1 || true; "
            + "GTOS_VERSION=" + osVersion + " /usr/bin/gtos-shell-update --network >>/tmp/gtos-upd-apply.log 2>&1 || true; "
            + "printf '%s\\n' " + shQuote(osVersion) + " > /var/lib/gtos/version; "
            + "printf '%s\\n' " + shQuote(osVersion) + " > /usr/share/gtos/version; "
            + "echo done >/tmp/gtos-upd-apply-done ) &"
        )
        updateApplyTimer.restart()
    }

    function applySystemUpdatesAndReboot() {
        applySystemUpdates(true)
    }

    function rollbackLastUpdate() {
        if (updateRollingBack)
            return
        var snap = sys.run("cat /var/lib/gtos/update-snapshots/latest 2>/dev/null").trim()
        if (!snap.length) {
            updateRollbackStatus = "Нет снимка для безопасного отката"
            notify("GT Update Engine", updateRollbackStatus, "info")
            return
        }
        updateRollingBack = true
        updateRollbackStatus = "Откат с учётом зависимостей из снимка " + snap + "…"
        // Безопасный откат: фиксируем список «до», не сносим пакеты вслепую —
        // восстанавливаем только те, что изменились, через apk add конкретной версии из манифеста.
        sys.run(
            "SNAP=/var/lib/gtos/update-snapshots/" + snap + "; "
            + "mkdir -p /var/lib/gtos/update-snapshots/rollback-log; "
            + "( echo \"rollback $SNAP $(date)\" >/tmp/gtos-upd-rollback.log; "
            + "if [ -f \"$SNAP/apk-before.txt\" ]; then "
            + "  apk info -v 2>/dev/null | sort > /tmp/gtos-apk-now.txt; "
            + "  comm -13 \"$SNAP/apk-before.txt\" /tmp/gtos-apk-now.txt > /tmp/gtos-apk-new.txt; "
            + "  while read -r line; do "
            + "    pkg=$(echo \"$line\" | sed 's/-[0-9].*//'); "
            + "    old=$(grep -E \"^${pkg}-[0-9]\" \"$SNAP/apk-before.txt\" | head -n1); "
            + "    if [ -n \"$old\" ]; then apk add --cache-dir /var/lib/gtos/apk-cache \"$old\" >>/tmp/gtos-upd-rollback.log 2>&1 || true; fi; "
            + "  done < /tmp/gtos-apk-new.txt; "
            + "else echo 'no manifest' >>/tmp/gtos-upd-rollback.log; fi; "
            + "echo done >/tmp/gtos-upd-rollback-done ) &"
        )
        updateRollbackTimer.restart()
    }

    function _ccLines(cmd) {
        var raw = (typeof sys.runTimeout === "function" ? sys.runTimeout(cmd, 2500) : sys.run(cmd)).trim()
        if (!raw.length || raw === "таймаут") return []
        return raw.split("\n")
    }

    function _ccItemsFromLines(lines, maxN) {
        var out = []
        var lim = maxN || 24
        for (var i = 0; i < lines.length && out.length < lim; ++i) {
            var s = lines[i].replace(/\s+/g, " ").trim()
            if (!s.length) continue
            var warn = /unknown|fail|error|descriptor|неизв/i.test(s)
            out.push({
                name: s.length > 90 ? s.slice(0, 87) + "…" : s,
                detail: "",
                state: warn ? "Внимание" : "ОК",
                warn: warn
            })
        }
        return out
    }

