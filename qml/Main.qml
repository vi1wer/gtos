        NumberAnimation {
            target: root; property: "bootSweep"; from: 0; to: 1
            duration: 1150; easing.type: Easing.InOutSine
        }
        NumberAnimation {
            target: root; property: "bootSweep"; from: 1; to: 0
            duration: 1150; easing.type: Easing.InOutSine
        }
    }

    Component.onCompleted: {
        // только лёгкое: кто пользователь и настройки для экрана входа
        var cmd = sys.readFile("/proc/cmdline")
        safeMode = (sys.run("test -f /run/gtos-safemode -o -f /var/lib/gtos/safemode && echo yes").trim() === "yes")
                || (cmd.indexOf("gtos.safemode") >= 0)
        var saved = sys.run("cat /var/lib/gtos/username 2>/dev/null").trim()
        var full = sys.run("cat /var/lib/gtos/fullname 2>/dev/null").trim()
        if (saved.length)
            currentUser = saved
        if (full.length)
            userFullName = full
        var done = sys.run("test -f /var/lib/gtos/setup-done && echo yes").trim()
        setupOpen = (done !== "yes") || !saved.length
        if (setupOpen) {
            setupName = full.length ? full : ""
            setupPassword = ""
            setupPassword2 = ""
        }
        refreshDeskWallpaper()
        loadDesktop()
        loadFileAssoc()
        loadOsUsers()
        loadUpdateChannel()
        loadCalNotes()
        loadInputLang()
        applySystemVolume()
        lidPollTimer.start()
        loadWeatherCities()
        loadPhotosFavs()
        if (!safeMode) {
            x11ClipTimer.start()
            extNotifyTimer.start()
            Qt.callLater(function () {
                root.refreshWeather()
                root.autoConnectWifi()
            })
        }
        locked = !setupOpen
        lockReveal = false
        lockPickUser = currentUser
        booting = true
        bootFade = 1
        bootLogoOpacity = 0
        bootBarOpacity = 0
        bootSweep = 0
        bootAnim.step = 0
        bootIntro.start()
        bootAnim.start()
        if (safeMode) {
            Qt.callLater(function () {
                root.notify("Безопасный режим", "Минимум служб · сеть и печать не поднимаются автоматически", "info")
            })
        }
    }

