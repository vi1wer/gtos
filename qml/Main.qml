    function toggleClipPin(idx) {
        var arr = clipHistory.slice()
        if (idx < 0 || idx >= arr.length)
            return
        var c = arr[idx]
        if (typeof c === "string")
            c = { id: Date.now(), text: c, pinned: true, time: "" }
        else
            c = { id: c.id, text: c.text, pinned: !c.pinned, time: c.time || "" }
        arr.splice(idx, 1)
        if (c.pinned)
            arr.unshift(c)
        else
            arr.push(c)
        clipHistory = arr
    }

