                { id: "system:files", label: "Файлы", app: "files", path: "", kind: "files", type: "folder", size: 3, date: 3, dir: true },
                { id: "system:trash", label: "Корзина", app: "files", path: "trash", kind: "trash", type: "system", size: 2, date: 2, dir: true },
                { id: "system:settings", label: "Параметры", app: "settings", path: "", kind: "settings", type: "app", size: 1, date: 1, dir: false }
            )
        }
        var desk = deskPath()
        sys.run("mkdir -p " + shQuote(desk))
        var raw = sys.listDir(desk)
        if (raw && raw.length) {
            var lines = raw.split("\n")
            for (var i = 0; i < lines.length; ++i) {
                var line = lines[i]
                if (!line || !line.length)
                    continue
                var isDir = line.indexOf("[dir] ") === 0
                var isFile = line.indexOf("[file] ") === 0
                if (!isDir && !isFile)
                    continue
                var name = isDir ? line.slice(6) : line.slice(7)
                if (!name.length || name.indexOf(".") === 0)
                    continue
                var path = desk + "/" + name
                items.push({
                    id: "file:" + path,
                    label: name,
                    app: "files",
                    path: path,
                    kind: deskIconKindFor(name, isDir),
                    type: isDir ? "folder" : "file",
                    size: isDir ? 2 : 1,
                    date: Date.now() / 1000,
                    dir: isDir
                })
            }
        }
        var key = deskSortBy
        var sysItems = []
        var fileItems = []
        for (var s = 0; s < items.length; ++s) {
            if (items[s].type === "system" || items[s].type === "app")
                sysItems.push(items[s])
            else
                fileItems.push(items[s])
        }
        fileItems.sort(function (a, b) {
            if (key === "size") return b.size - a.size
            if (key === "type") return a.type < b.type ? -1 : (a.type > b.type ? 1 : 0)
            if (key === "date") return b.date - a.date
            return a.label.localeCompare(b.label)
        })
        var next = sysItems.concat(fileItems)
        var same = deskIconList.length === next.length
        if (same) {
            for (var ci = 0; ci < next.length; ++ci) {
                if (deskIconList[ci].id !== next[ci].id || deskIconList[ci].label !== next[ci].label
                        || deskIconList[ci].kind !== next[ci].kind) {
                    same = false
                    break
                }
            }
        }
        if (!same) {
            deskIconList = next
            deskRev = deskRev + 1
        }
    }

    function deskIconX(id, index) {
        var saved = deskPositions[deskPosKey(id)]
        if (!saved || typeof saved.x !== "number")
            saved = deskPositions[id]
        if (!deskAutoArrange && saved && typeof saved.x === "number")
            return saved.x
        return deskLayoutSlot(index).x
    }

    function deskIconY(id, index) {
        var saved = deskPositions[deskPosKey(id)]
        if (!saved || typeof saved.y !== "number")
            saved = deskPositions[id]
        if (!deskAutoArrange && saved && typeof saved.y === "number")
            return saved.y
        return deskLayoutSlot(index).y
    }

    function deskCreate(kind) {
        var desk = deskPath()
        deskCreateIn(desk, kind)
        refreshDeskIcons()
    }

    function deskIconKindFor(name, isDir) {
        return fileIconKind(name, isDir)
    }

    function fileIconKind(name, isDir) {
        if (isDir)
            return "files"
        var kind = fileEntryKind(name, false)
        if (kind === "image") return "photos"
        if (kind === "text") return "notes"
        if (kind === "video") return "video"
        if (kind === "audio") return "music"
        if (kind === "font") return "font"
        if (kind === "archive") return "zip"
        if (kind === "pdf") return "pdf"
        if (kind === "unknown") return "unknown"
        if (kind === "link") return "link"
        return "doc"
    }

    function deskLayoutSlot(index) {
        var m = deskIconMetrics()
        var top = 16
        var left = 22
        var usableH = Math.max(200, root.height - 48 - dockSize - 48)
        var rows = Math.max(1, Math.floor(usableH / (m.cellH + m.gap)))
        var col = Math.floor(index / rows)
        var row = index % rows
        return {
            x: left + col * (m.cellW + m.gap),
            y: top + row * (m.cellH + m.gap)
        }
    }

    function deskSnapPos(x, y) {
        if (!deskAlignGrid)
            return { x: Math.max(8, x), y: Math.max(8, y) }
        var m = deskIconMetrics()
        var left = 22
        var top = 16
        var col = Math.round((x - left) / (m.cellW + m.gap))
        var row = Math.round((y - top) / (m.cellH + m.gap))
        if (col < 0) col = 0
        if (row < 0) row = 0
        return {
            x: left + col * (m.cellW + m.gap),
            y: top + row * (m.cellH + m.gap)
        }
    }

    function deskCommitPos(id, x, y) {
        if (!id || !id.length)
            return
        var snapped = deskSnapPos(x, y)
        var pos = {}
        for (var k in deskPositions)
            pos[k] = deskPositions[k]
        pos[deskPosKey(id)] = { x: snapped.x, y: snapped.y }
        deskPositions = pos
        deskAutoArrange = false
        // не трогаем deskIconList — иначе Repeater мигает
        saveDesktop()
    }

    function deskOpenItem(item) {
        if (!item)
            return
        if (item.app === "settings") {
            launch("settings", "Параметры")
            return
        }
        if (item.path === "thispc") {
            launch("files", "Файлы"); loadFiles("thispc"); return
        }
        if (item.path === "trash") {
            launch("files", "Файлы"); loadFiles("/home/" + currentUser + "/.Корзина"); return
        }
        if (item.path === "" && item.app === "files") {
            launch("files", "Файлы"); loadFiles(deskPath()); return
        }
        if (item.dir) {
            launch("files", "Файлы"); loadFiles(item.path); return
        }
        var lower = String(item.label || "").toLowerCase()
        if (openByAssocOrAsk(item.path, item.label))
            return
        if (isPdfName(item.label) && item.path) {
            openDocumentViewer(item.path)
            return
        }
        if (isImageName(item.label)) {
            openImageViewer(item.path)
            return
        }
        if (lower.indexOf(".txt") > 0 || lower.indexOf(".md") > 0 || lower.indexOf(".log") > 0) {
            launch("notes", "Блокнот")
            openNote(item.path)
            return
        }
        if (isMediaName(item.label) && item.path) {
            openMediaFile(item.path)
            return
        }
        if (fileEntryKind(item.label, false) === "unknown") {
            openOpenWithDialog(item.path, item.label, "Этот тип файла системе неизвестен. Выберите программу:")
            return
        }
        launch("files", "Файлы")
        loadFiles(deskPath())
        selectedName = item.label
        fileView = sys.readFile(item.path)
        filesMode = "preview"
    }

    function trashDir() {
        return "/home/" + currentUser + "/.Корзина"
    }

    function isTrashPath(path) {
        var t = trashDir()
        var p = String(path || "")
        return p === "trash" || p === t || p.indexOf(t + "/") === 0
    }

    function movePathToTrash(path, name) {
        path = String(path || "")
        name = String(name || "")
        if (!path.length || isTrashPath(path) || path === "thispc" || path === "fav" || path === "recent")
            return false
        if (!name.length) {
            var slash = path.lastIndexOf("/")
            name = slash >= 0 ? path.slice(slash + 1) : path
        }
        if (!name.length || name === "." || name === "..")
            return false
        var destBase = trashDir()
        sys.run("mkdir -p " + shQuote(destBase))
        var dest = destBase + "/" + name
        // уникальное имя, если уже есть
        var n = 1
        while (sys.run("test -e " + shQuote(dest) + " && echo yes").trim() === "yes") {
            var dot = name.lastIndexOf(".")
            if (dot > 0 && name.indexOf(".") !== 0)
                dest = destBase + "/" + name.slice(0, dot) + " (" + n + ")" + name.slice(dot)
            else
                dest = destBase + "/" + name + " (" + n + ")"
            n++
            if (n > 200)
                break
        }
        sys.run("mv -f " + shQuote(path) + " " + shQuote(dest))
        var pos = {}
        for (var pk in deskPositions) {
            if (pk === ("file:" + path))
                continue
            pos[pk] = deskPositions[pk]
        }
        deskPositions = pos
        refreshDeskIcons()
        if (filesPath === destBase || filesPath === path
                || filesPath === deskPath()
                || String(filesPath).indexOf("/Рабочий стол") >= 0
                || (path.length && String(filesPath).indexOf(path) === 0))
            loadFiles(filesPath === path ? destBase : filesPath)
        notify("Корзина", "«" + name + "» перемещено в корзину", "ok")
        saveDesktop()
        return true
    }

    function emptyTrash() {
        var t = trashDir()
        sys.run("mkdir -p " + shQuote(t)
                + "; find " + shQuote(t) + " -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null")
        notify("Корзина", "Корзина очищена", "ok")
        if (filesPath === t || filesPath.indexOf(t) === 0)
            loadFiles(t)
        refreshDeskIcons()
    }

    function deskTrashHit(cx, cy) {
        var list = deskIconList
        var m = deskIconMetrics()
        for (var i = 0; i < list.length; ++i) {
            if (list[i].id !== "system:trash" && list[i].path !== "trash")
                continue
            var tx = deskIconX(list[i].id, i)
            var ty = deskIconY(list[i].id, i)
            if (cx >= tx && cx <= tx + m.cellW && cy >= ty && cy <= ty + m.cellH)
                return true
        }
        return false
    }

    function trashCtxItems() {
        var t = trashDir()
        var favOn = false
        for (var i = 0; i < fileFavorites.length; ++i) {
            if (fileFavorites[i].path === t) {
                favOn = true
                break
            }
        }
        var pinned = pinnedApps.indexOf("trash") >= 0
        return compactCtxItems([
            { label: "Открыть", action: "deskopen:system:trash", icon: "open", bold: true },
            { label: favOn ? "Открепить от панели быстрого доступа" : "Закрепить на панели быстрого доступа", action: "trash:fav", icon: "fav" },
            { label: "Очистить корзину", action: "trash:empty", icon: "trash" },
            { label: pinned ? "Открепить от меню «Пуск»" : "Закрепить в меню «Пуск»", action: "trash:pinstart", icon: "pin" },
            { label: "-", action: "sep" },
            { label: "Создать ярлык", action: "trash:shortcut", icon: "link" },
            { label: "Переименовать", action: "trash:rename", icon: "rename" },
            { label: "-", action: "sep" },
            { label: "Свойства", action: "trash:props", icon: "props" }
        ])
    }

    function deskDeleteItem(item) {
        if (!item || item.type === "system" || item.type === "app" || !item.path)
            return
        movePathToTrash(item.path, item.label)
    }

    function deskPaste() {
        if (!clipPath.length)
            return
        var desk = deskPath()
        sys.run("mkdir -p " + shQuote(desk))
        var name = clipPath.slice(clipPath.lastIndexOf("/") + 1)
        if (!name.length)
            return
        var dest = desk + "/" + name
        if (clipCut) {
            sys.run("mv -f " + shQuote(clipPath) + " " + shQuote(dest))
            clipPath = ""
            clipCut = false
        } else if (clipIsDir) {
            sys.run("cp -a " + shQuote(clipPath) + " " + shQuote(dest))
        } else {
            sys.run("cp -f " + shQuote(clipPath) + " " + shQuote(dest))
        }
        refreshDeskIcons()
        notify("Рабочий стол", "Вставлено: " + name, "ok")
    }

    function openRenameDialog(path, currentName) {
        renameTargetPath = path
        renameValue = currentName
        renameDialogOpen = true
    }

    function applyRename() {
        if (!renameTargetPath.length || !renameValue.trim().length) {
            renameDialogOpen = false
            return
        }
        var neu = renameValue.trim().replace(/\//g, "")
        var parent = renameTargetPath.slice(0, renameTargetPath.lastIndexOf("/"))
        if (!parent.length)
            parent = "/"
        var dst = (parent === "/" ? "/" : parent + "/") + neu
        sys.run("mv -f " + shQuote(renameTargetPath) + " " + shQuote(dst))
        renameDialogOpen = false
        refreshDeskIcons()
        if (filesPath === parent || filesPath === deskPath())
            loadFiles(filesPath === "recent" ? filesPath : parent)
        notify("Проводник", "Переименовано в «" + neu + "»", "ok")
    }

    function formatPropsBytes(n) {
        n = Number(n)
        if (!n || n < 0)
            return "0 байт"
        var s = String(Math.floor(n))
        var out = ""
        while (s.length > 3) {
            out = " " + s.slice(-3) + out
            s = s.slice(0, -3)
        }
        return s + out + " байт"
    }

    function formatPropsDate(epoch) {
        var e = parseInt(epoch, 10)
        if (!e || e < 0 || isNaN(e))
            return "—"
        var d = new Date(e * 1000)
        if (isNaN(d.getTime()))
            return "—"
        return Qt.formatDateTime(d, "d MMMM yyyy, HH:mm:ss")
    }

    function propsTypeLabel(name, isDir) {
        if (isDir)
            return "Папка с файлами"
        var kind = fileEntryKind(name, false)
        if (kind === "image") return "Изображение"
        if (kind === "text") return "Текстовый документ"
        if (kind === "video") return "Видео"
        if (kind === "audio") return "Аудио"
        if (kind === "font") return "Шрифт"
        if (kind === "archive") return "Архив"
        if (kind === "pdf") return "Документ PDF"
        if (kind === "link") return "Ярлык"
        if (kind === "unknown") return "Неизвестный тип файла"
        var n = String(name || "")
        var dot = n.lastIndexOf(".")
        if (dot > 0 && dot < n.length - 1)
            return "Файл «" + n.slice(dot + 1).toUpperCase() + "»"
        return "Файл"
    }

    function propsIconFor(name, isDir) {
        return fileIconKind(name, isDir)
    }

    function showDeviceProps(group, item) {
        if (!group || !item)
            return
        var gname = group.name || "Устройства"
        var gid = group.id || ""
        devPropsName = item.name || "Устройство"
        devPropsType = gname
        devPropsDetail = item.detail || ""
        devPropsLocation = item.detail || "—"
        devPropsStatus = item.warn
                ? ("Устройство сообщает о проблеме.\n\n" + (item.state || "Внимание"))
                : "Устройство работает нормально."
        if (gid === "usb") {
            devPropsMaker = "(Стандартный USB хост-контроллер)"
            devPropsIcon = "usb"
        } else if (gid === "gpu") {
            devPropsMaker = "Производитель видеоадаптера"
            devPropsIcon = "monitor"
        } else if (gid === "disk") {
            devPropsMaker = "Накопитель"
            devPropsIcon = "drive"
        } else if (gid === "net") {
            devPropsMaker = "Сетевой адаптер"
            devPropsIcon = "network"
        } else if (gid === "audio") {
            devPropsMaker = "Аудиоустройство"
            devPropsIcon = "music"
        } else if (gid === "cpu") {
            devPropsMaker = "Процессор"
            devPropsIcon = "cpu"
        } else if (gid === "kbd" || gid === "mouse" || gid === "hid") {
            devPropsMaker = "Устройство ввода"
            devPropsIcon = "usb"
        } else if (gid === "mon") {
            devPropsMaker = "Монитор"
            devPropsIcon = "monitor"
        } else {
            devPropsMaker = "GT/OS"
            devPropsIcon = group.icon || "system"
        }
        if (!devPropsLocation.length)
            devPropsLocation = "—"
        devPropsWarn = !!item.warn
        devPropsTab = "general"
        devPropsOpen = true
    }

    function openOpenWithDialog(path, name, hint) {
        openWithPath = String(path || "")
        openWithName = String(name || "")
        if (!openWithName.length && openWithPath.length) {
            var slash = openWithPath.lastIndexOf("/")
            openWithName = slash >= 0 ? openWithPath.slice(slash + 1) : openWithPath
        }
        openWithHint = hint || "Выберите программу, которой открыть этот файл"
        openWithOpen = true
    }

    function closeOpenWithDialog() {
        openWithOpen = false
    }

    function openWithChosenApp(appId) {
        var op = openWithPath
        var name = openWithName
        var remember = openWithRemember
        closeOpenWithDialog()
        if (!appId || !appId.length)
            return
        if (remember) {
            var ext = fileExtOf(name)
            if (ext.length)
                setFileAssoc(ext, appId)
        }
        applyOpenWith(appId, op, name)
    }

    function applyOpenWith(ow, op, name) {
        op = String(op || "")
        name = String(name || (op.length ? op.slice(op.lastIndexOf("/") + 1) : ""))
        if (ow === "notes" && op.length) { launch("notes", "Блокнот"); openNote(op); return }
        if (ow === "photos" && op.length) { openImageViewer(op); return }
        if (ow === "docs" && op.length) { openDocumentViewer(op); return }
        if (ow === "draw") { launch("draw", "Графика"); if (op.length) notify("Графика", "Файл: " + name, "ok"); return }
        if (ow === "term") { launch("term", "Терминал"); return }
        if (ow === "files" && op.length) {
            launch("files", "Файлы")
            loadFiles(op.slice(0, op.lastIndexOf("/")) || "/")
            selectedName = name
            return
        }
        if (ow === "music" && op.length) { openMediaFile(op); return }
        if (ow === "video" && op.length) { openMediaFile(op); return }
        if (ow === "vlc") {
            var va = storeAppById("vlc")
            if (va) openStoreApp(va)
            else launch("vlc", "VLC")
            if (op.length) notify("VLC", "Файл: " + name, "ok")
            return
        }
        if (ow === "firefox" || ow === "browser") {
            var ff = storeAppById("firefox")
            if (ff) openStoreApp(ff)
            else launch("browser", "Браузер")
            if (op.length) {
                browserUrl = "file://" + op
                browseGo(true)
            }
            return
        }
        if (ow === "archive" && op.length) { openArchiveManager(op); return }
        if (ow === "fonts" && op.length) { openFontManager(op); return }
        if (ow === "calc") { launch("calc", "Калькулятор"); return }
        if (ow === "cal") { launch("cal", "Календарь"); return }
        if (ow === "mail") { launch("mail", "Почта"); return }
        if (ow === "weather") { launch("weather", "Погода"); return }
        if (ow === "settings") { launch("settings", "Параметры"); return }
        if (ow === "control") { launch("control", "Контрольный центр"); return }
        if (ow === "monitor") { launch("monitor", "Диспетчер"); return }
        if (ow === "store") { launch("store", "Магазин"); return }
        // стороннее / пакет
        var sa = storeAppById(ow)
        if (sa) {
            openStoreApp(sa)
            if (op.length) notify(sa.name || ow, "Файл: " + name, "ok")
            return
        }
        launch(ow, name.length ? name : ow)
        if (op.length) notify("Открыть с помощью", "Файл: " + name, "ok")
    }

    function openDocumentViewer(path) {
        if (!path || !path.length)
            return
        docsPath = path
        docsTitle = path.slice(path.lastIndexOf("/") + 1)
        docsPage = 1
        docsPageCount = 1
        docsPageImage = ""
        docsStatus = "Подготовка…"
        docsBusy = true
        launch("docs", "GT Document Viewer")
        renderDocsPage()
    }

    function ensurePdfTools() {
        var has = sys.run("command -v pdftoppm 2>/dev/null || command -v pdftocairo 2>/dev/null || command -v gs 2>/dev/null").trim()
        if (has.length)
            return true
        sys.run(
            "( apk update --cache-dir /var/lib/gtos/apk-cache >/tmp/gtos-pdf-apk.log 2>&1; "
            + "apk add --no-progress --cache-dir /var/lib/gtos/apk-cache poppler-utils ghostscript >>/tmp/gtos-pdf-apk.log 2>&1 "
            + ") || true"
        )
        has = sys.run("command -v pdftoppm 2>/dev/null || command -v pdftocairo 2>/dev/null || command -v gs 2>/dev/null").trim()
        return has.length > 0
    }

    function renderDocsPage() {
        if (!docsPath.length) {
            docsBusy = false
            docsStatus = "Файл не выбран"
            return
        }
        docsBusy = true
        docsStatus = "Рендер страницы " + docsPage + "…"
        var run = function (cmd, ms) {
            if (typeof sys.runTimeout === "function")
                return sys.runTimeout(cmd, ms || 8000).trim()
            return sys.run(cmd).trim()
        }
        ensurePdfTools()
        var info = run("pdfinfo " + shQuote(docsPath) + " 2>/dev/null | awk -F: '/Pages/{gsub(/ /,\"\",$2); print $2}'", 4000)
        var pc = parseInt(info, 10)
        if (!pc || pc < 1) {
            // запасной подсчёт через pdftoppm dry / grep
            var alt = run("grep -a -o '/Count *[0-9]\\+' " + shQuote(docsPath) + " 2>/dev/null | head -n1 | grep -o '[0-9]\\+'", 2000)
            pc = parseInt(alt, 10) || docsPageCount || 1
        }
        docsPageCount = Math.max(1, pc)
        if (docsPage > docsPageCount)
            docsPage = docsPageCount
        if (docsPage < 1)
            docsPage = 1
        sys.run("mkdir -p /tmp/gtos-docs && rm -f /tmp/gtos-docs/page-*.png /tmp/gtos-docs/page.png")
        var outBase = "/tmp/gtos-docs/page"
        var ok = run(
            "if command -v pdftoppm >/dev/null 2>&1; then "
            + "pdftoppm -png -r 110 -f " + docsPage + " -l " + docsPage + " " + shQuote(docsPath) + " " + outBase + " && "
            + "mv -f " + outBase + "-*.png /tmp/gtos-docs/page.png 2>/dev/null || mv -f " + outBase + "-" + docsPage + ".png /tmp/gtos-docs/page.png; "
            + "elif command -v pdftocairo >/dev/null 2>&1; then "
            + "pdftocairo -png -r 110 -f " + docsPage + " -l " + docsPage + " " + shQuote(docsPath) + " " + outBase + " && "
            + "mv -f " + outBase + "-*.png /tmp/gtos-docs/page.png 2>/dev/null || true; "
            + "elif command -v gs >/dev/null 2>&1; then "
            + "gs -dSAFER -dBATCH -dNOPAUSE -sDEVICE=png16m -r110 -dFirstPage=" + docsPage
            + " -dLastPage=" + docsPage + " -sOutputFile=/tmp/gtos-docs/page.png " + shQuote(docsPath) + "; "
            + "else echo FAIL; fi",
            12000
        )
        var exists = run("test -s /tmp/gtos-docs/page.png && echo OK", 800)
        docsBusy = false
        if (exists.indexOf("OK") >= 0) {
            docsPageImage = "file:///tmp/gtos-docs/page.png?" + Date.now()
            docsStatus = "Стр. " + docsPage + " из " + docsPageCount
        } else {
            docsPageImage = ""
            docsStatus = "Не удалось показать PDF. Установите poppler-utils или откройте файл другой программой.\n" + (ok || "")
        }
    }

    function docsNextPage(delta) {
        var n = docsPage + (delta || 1)
        if (n < 1) n = 1
        if (n > docsPageCount) n = docsPageCount
        if (n === docsPage && docsPageImage.length)
            return
        docsPage = n
        renderDocsPage()
    }

    function showPropsFor(path, name, isDir) {
        path = String(path || "")
        name = String(name || "")
        if (!name.length && path.length) {
            var slash = path.lastIndexOf("/")
            name = slash >= 0 ? path.slice(slash + 1) : path
        }
        if (!name.length)
            name = "Объект"

        propsTitle = name
        propsName = name
        propsNameEdit = name
        propsPath = path
        propsIsDir = !!isDir
        propsTab = "general"
        propsDirty = false
        propsBusy = false
        propsHidden = name.charAt(0) === "."
        propsReadonly = false
        propsIconKind = propsIconFor(name, isDir)
        propsType = propsTypeLabel(name, isDir)
        propsLocation = "—"
        propsSizeText = "—"
        propsDiskText = "—"
        propsContains = ""
        propsCreated = "—"
        propsModified = "—"
        propsPerms = "—"
        propsBody = ""
        propsDialogOpen = true

        if (!path.length || path === "thispc" || path === "recent" || path === "fav") {
            propsType = path === "thispc" ? "Системный объект" : propsType
            propsLocation = "GT/OS"
            propsSizeText = "Не применимо"
            propsDiskText = "Не применимо"
            propsCreated = "—"
            propsModified = "—"
            propsPerms = "Системный"
            return
        }

        var locSlash = path.lastIndexOf("/")
        propsLocation = locSlash <= 0 ? "/" : path.slice(0, locSlash)

        var run = function (cmd, ms) {
            if (typeof sys.runTimeout === "function")
                return sys.runTimeout(cmd, ms || 1500).trim()
            return sys.run(cmd).trim()
        }

        var st = run("stat -c '%s|%W|%Y|%a' " + shQuote(path) + " 2>/dev/null", 1200)
        var sizeBytes = 0
        if (st.length) {
            var p = st.split("|")
            sizeBytes = parseInt(p[0], 10) || 0
            propsCreated = formatPropsDate(p[1])
            propsModified = formatPropsDate(p[2])
            var mode = p[3] || ""
            propsPerms = mode.length ? ("Права: " + mode) : "—"
            // нет бита записи для владельца → «только чтение»
            if (mode.length >= 3) {
                var owner = parseInt(mode.charAt(mode.length - 3), 10)
                propsReadonly = isNaN(owner) ? false : ((owner & 2) === 0)
            }
        }

        if (isDir) {
            propsSizeText = "Подсчёт…"
            propsDiskText = "Подсчёт…"
            var du = run("du -sb " + shQuote(path) + " 2>/dev/null | awk '{print $1}'", 2800)
            sizeBytes = parseInt(du, 10) || sizeBytes
            if (sizeBytes > 0) {
                propsSizeText = formatSize(sizeBytes) + " (" + formatPropsBytes(sizeBytes) + ")"
                // оценка «на диске» — блоки по 4 КБ
                var onDisk = Math.ceil(sizeBytes / 4096) * 4096
                propsDiskText = formatSize(onDisk) + " (" + formatPropsBytes(onDisk) + ")"
            } else {
                propsSizeText = "0 байт (0 байт)"
                propsDiskText = propsSizeText
            }
            var fc = run("find " + shQuote(path) + " -type f 2>/dev/null | wc -l", 2200)
            var dc = run("find " + shQuote(path) + " -mindepth 1 -type d 2>/dev/null | wc -l", 2200)
            propsContains = "Файлов: " + (parseInt(fc, 10) || 0) + "; папок: " + (parseInt(dc, 10) || 0)
        } else {
            if (sizeBytes <= 0) {
                var fs = run("wc -c < " + shQuote(path) + " 2>/dev/null", 800)
                sizeBytes = parseInt(fs, 10) || 0
            }
            propsSizeText = formatSize(sizeBytes) + " (" + formatPropsBytes(sizeBytes) + ")"
            var onDiskF = Math.ceil(Math.max(sizeBytes, 1) / 4096) * 4096
            if (sizeBytes === 0)
                onDiskF = 0
            propsDiskText = formatSize(onDiskF) + " (" + formatPropsBytes(onDiskF) + ")"
            propsContains = ""
        }
    }

    function applyPropsDialog() {
        if (!propsDirty || !propsPath.length)
            return
        propsBusy = true
        var changed = false
        var neu = String(propsNameEdit || "").trim()
        if (neu.length && neu !== propsName) {
            var slash = propsPath.lastIndexOf("/")
            var parent = slash <= 0 ? "/" : propsPath.slice(0, slash)
            var dst = (parent === "/" ? "/" : parent + "/") + neu
            var mv = (typeof sys.runTimeout === "function"
                      ? sys.runTimeout("mv -f " + shQuote(propsPath) + " " + shQuote(dst) + " && echo OK", 2000)
                      : sys.run("mv -f " + shQuote(propsPath) + " " + shQuote(dst) + " && echo OK")).trim()
            if (mv.indexOf("OK") >= 0) {
                propsPath = dst
                propsName = neu
                propsTitle = neu
                changed = true
                refreshDeskIcons()
                if (filesPath === parent || filesPath === deskPath())
                    loadFiles(filesPath === "recent" ? filesPath : parent)
            } else {
                notify("Свойства", "Не удалось переименовать", "info")
                propsBusy = false
                return
            }
        }
        if (propsPath.length && propsPath !== "thispc") {
            if (propsReadonly)
                sys.run("chmod a-w " + shQuote(propsPath) + " 2>/dev/null")
            else
                sys.run("chmod u+w " + shQuote(propsPath) + " 2>/dev/null")
            changed = true
        }
        propsDirty = false
        propsBusy = false
        if (changed)
            notify("Свойства", "Изменения сохранены", "ok")
    }

