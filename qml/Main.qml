            function storeList() {
                catalog = root.storeCatalog()
                var q = (root.storeQuery || "").toLowerCase()
                var out = []
                for (var i = 0; i < catalog.length; ++i) {
                    var a = catalog[i]
                    if (storeCat !== "all" && a.cat !== storeCat)
                        continue
                    if (storePlatform !== "all" && root.storePlatformOf(a) !== storePlatform)
                        continue
                    if (q.length && (a.name + " " + a.id + " " + a.desc + " " + a.cat + " " + (a.pub || "") + " " + root.storePlatformOf(a)).toLowerCase().indexOf(q) < 0)
                        continue
                    out.push(a)
                    if (out.length >= root.storeListLimit)
                        break
                }
                return out
            }

            function storeMatchCount() {
                catalog = root.storeCatalog()
                var q = (root.storeQuery || "").toLowerCase()
                var n = 0
                for (var i = 0; i < catalog.length; ++i) {
                    var a = catalog[i]
                    if (storeCat !== "all" && a.cat !== storeCat)
                        continue
                    if (storePlatform !== "all" && root.storePlatformOf(a) !== storePlatform)
                        continue
                    if (q.length && (a.name + " " + a.id + " " + a.desc + " " + a.cat + " " + (a.pub || "")).toLowerCase().indexOf(q) < 0)
                        continue
                    n++
                }
                return n
