    function playMusic(on) {

        if (on === undefined)
            on = !musicPlaying
        musicPlaying = !!on
        if (musicPlaying) {
            if (musicTrackPath.length)
                probeMediaDuration(musicTrackPath, false)
            applyMediaVolume()
            musicTick.restart()
            if (musicTrackPath.length) {
                var vol = Math.round(mediaVolume * 100)
                var ss = mediaElapsedSec > 0 ? ("-ss " + mediaElapsedSec + " ") : ""
                sys.run("pkill -x mpg123 2>/dev/null; pkill -x ffplay 2>/dev/null; "
                        + "ffplay -nodisp -autoexit -loglevel quiet " + ss + "-volume " + vol + " "
                        + shQuote(musicTrackPath) + " >/dev/null 2>&1 &")
            }
            notify("Медиаплеер", "▶ " + musicTrack + (musicFormat ? " · " + musicFormat : ""), "ok")
        } else {
            musicTick.stop()
            sys.run("pkill -x mpg123 2>/dev/null; pkill -x ffplay 2>/dev/null; true")
            notify("Медиаплеер", "Пауза", "ok")
        }
    }

    function scanVlcLibrary() {
        var vids = "/home/" + currentUser + "/Видео"
        var music = "/home/" + currentUser + "/Музыка"
        sys.run("mkdir -p " + shQuote(vids) + " " + shQuote(music))
        var raw = sys.run(
            "find " + shQuote(vids) + " " + shQuote(music)
            + " -type f \\( -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.avi' -o -iname '*.webm'"
            + " -o -iname '*.mov' -o -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg'"
            + " -o -iname '*.wav' -o -iname '*.m4a' \\) 2>/dev/null | head -n 300"
        ).trim()
        var lines = raw.length ? raw.split("\n") : []
        var lib = []
        for (var i = 0; i < lines.length; ++i) {
            var p = lines[i].trim()
            if (!p.length) continue
            var name = p.split("/").pop()
            var title = name.replace(/\.(mp4|mkv|avi|webm|mov|mp3|flac|ogg|wav|m4a)$/i, "")
            var ext = name.indexOf(".") >= 0 ? name.split(".").pop().toUpperCase() : ""
            lib.push({ id: p, path: p, title: title, name: name, format: ext })
        }
        vlcLibrary = lib
        vlcEngine = mediaEngineVersion({ id: "vlc" })
        if (vlcIndex < 0 && lib.length)
            selectVlcTrack(0, false)
        else if (!lib.length) {
            vlcIndex = -1
            vlcTrack = "Нет файлов — положите ролики в «Видео»"
            vlcTrackPath = ""
        }
    }

    function selectVlcTrack(idx, autoPlay) {
        if (idx < 0 || idx >= vlcLibrary.length)
            return
        vlcIndex = idx
        var t = vlcLibrary[idx]
        vlcTrack = t.title
        vlcTrackPath = t.path || ""
        if (autoPlay !== false)
            playVlc(true)
    }

    function playVlc(on) {
        if (on === undefined)
            on = !vlcPlaying
        vlcPlaying = !!on
        if (!vlcPlaying) {
            sys.run("pkill -x ffplay 2>/dev/null; pkill -x cvlc 2>/dev/null; pkill -x vlc 2>/dev/null; true")
            notify("VLC", "Стоп", "ok")
            return
        }
        if (!vlcTrackPath.length) {
            vlcPlaying = false
            notify("VLC", "Сначала выберите файл", "info")
            return
        }
        probeMediaDuration(vlcTrackPath, false)
        applyMediaVolume()
        musicTick.restart()
        var vol = Math.round(mediaVolume * 100)
        var ss = mediaElapsedSec > 0 ? ("-ss " + mediaElapsedSec + " ") : ""
        // настоящий движок: VLC → cvlc → ffplay
        sys.run(
            "pkill -x ffplay 2>/dev/null; pkill -x cvlc 2>/dev/null; pkill -x vlc 2>/dev/null; "
            + "export DISPLAY=${DISPLAY:-:0}; "
            + "FILE=" + shQuote(vlcTrackPath) + "; "
            + "if [ -x /var/lib/gtos/apps/vlc/bin/vlc-launch ]; then "
            + "/var/lib/gtos/apps/vlc/bin/vlc-launch \"$FILE\" >/dev/null 2>&1 & "
            + "elif command -v cvlc >/dev/null 2>&1; then "
            + "cvlc --play-and-exit \"$FILE\" >/dev/null 2>&1 & "
            + "elif command -v vlc >/dev/null 2>&1; then "
            + "vlc --started-from-file \"$FILE\" >/dev/null 2>&1 & "
            + "elif command -v ffplay >/dev/null 2>&1; then "
            + "ffplay -autoexit -loglevel quiet " + ss + "-volume " + vol + " \"$FILE\" >/dev/null 2>&1 & "
            + "else echo missing; fi"
        )
        notify("Медиаплеер", "▶ " + vlcTrack, "ok")
    }

