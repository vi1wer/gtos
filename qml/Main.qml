                                        root.createRestorePoint("Ручная точка восстановления")
                                    } else if (modelData.id === "backup") {
                                        root.backupUserData()
                                    }
                                }
                            }
                        }
                    }
                    Item { width: 1; height: 14 }
                    Text {
                        width: parent.width
                        visible: root.controlTab === "devices"
                        text: root.controlHealth
                        color: "#8b98a3"
                        font.pixelSize: 11
                        wrapMode: Text.WordWrap
                    }
                }
            }

            // —— центр ——
            Item {
                anchors.left: ccNav.right
                anchors.right: ccAct.left
                anchors.top: parent.top
                anchors.bottom: parent.bottom

                Rectangle {
                    id: ccTool
                    height: 32
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: parent.top
                    color: "#232323"
                    Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: 1; color: "#2e2e2e" }
                    Row {
                        anchors.verticalCenter: parent.verticalCenter
                        anchors.left: parent.left
                        anchors.leftMargin: 10
                        spacing: 14
                        Text {
                            text: {
                                for (var i = 0; i < sections.length; ++i)
                                    if (sections[i].id === root.controlTab) return sections[i].name
                                return "Контрольный центр"
                            }
                            color: "#f0f0f0"
                            font.pixelSize: 13
                            font.family: root.uiFontBold
                        }
                        Text {
                            visible: root.controlTab === "diag" && root.diagStatus.length > 0
                            text: root.diagStatus
                            color: "#8b98a3"
                            font.pixelSize: 12
                        }
                    }
                }

                Flickable {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: ccTool.bottom
                    anchors.bottom: parent.bottom
                    clip: true
                    contentWidth: width
                    contentHeight: ccMainCol.height
                    boundsBehavior: Flickable.StopAtBounds

                    Column {
                        id: ccMainCol
                        width: parent.width
                        spacing: 0

                        // ===== УСТРОЙСТВА: плотное дерево =====
                        Column {
                            width: parent.width
                            visible: root.controlTab === "devices"
                            spacing: 0

                            Rectangle {
                                width: ccMainCol.width
                                height: 22
                                color: (selectedDevGroup < 0 && selectedDevItem < 0)
                                       ? "#2a3a30"
                                       : (rootH.containsMouse ? "#252525" : "transparent")
                                Row {
                                    anchors.fill: parent
                                    anchors.leftMargin: 6
                                    spacing: 4
                                    Text {
                                        width: 12
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: root.controlDevicesRootOpen ? "▾" : "▸"
                                        color: "#9aa7b2"
                                        font.pixelSize: 11
                                    }
                                    DeskIconArt {
                                        width: 16; height: 16
                                        anchors.verticalCenter: parent.verticalCenter
                                        kind: "pc"
                                    }
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: root.aboutHost
                                        color: "#f0f0f0"
                                        font.pixelSize: 12
                                        font.family: root.uiFont
                                    }
                                }
                                MouseArea {
                                    id: rootH
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    onClicked: {
                                        selectedDevGroup = -1
                                        selectedDevItem = -1
                                        root.controlDevicesRootOpen = !root.controlDevicesRootOpen
                                    }
                                }
                            }

                            Repeater {
                                model: root.controlDevicesRootOpen ? root.controlDeviceTree : []
                                delegate: Column {
                                    id: grpCol
                                    width: ccMainCol.width
                                    spacing: 0
                                    property var group: modelData
                                    property int gIndex: index

                                    Rectangle {
                                        width: parent.width
                                        height: 22
                                        color: {
                                            if (selectedDevGroup === grpCol.gIndex && selectedDevItem < 0)
                                                return "#2a3a30"
                                            return catH.containsMouse ? "#252525" : "transparent"
                                        }
                                        Row {
                                            anchors.fill: parent
                                            anchors.leftMargin: 22
                                            spacing: 4
                                            Text {
                                                width: 12
                                                anchors.verticalCenter: parent.verticalCenter
                                                text: grpCol.group.open ? "▾" : "▸"
                                                color: "#9aa7b2"
                                                font.pixelSize: 11
                                            }
                                            DeskIconArt {
                                                width: 16; height: 16
                                                anchors.verticalCenter: parent.verticalCenter
                                                kind: grpCol.group.icon || "pc"
                                            }
                                            Text {
                                                anchors.verticalCenter: parent.verticalCenter
                                                width: parent.width - 40
                                                text: grpCol.group.name
                                                color: "#f0f0f0"
                                                font.pixelSize: 12
                                                font.family: root.uiFont
                                                elide: Text.ElideRight
                                            }
                                        }
                                        MouseArea {
                                            id: catH
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            onClicked: {
                                                selectedDevGroup = grpCol.gIndex
                                                selectedDevItem = -1
                                                root.toggleControlGroup(grpCol.group.id)
                                            }
                                        }
                                    }

                                    Repeater {
                                        model: grpCol.group.open ? grpCol.group.items : []
                                        delegate: Rectangle {
                                            width: ccMainCol.width
                                            height: 22
                                            color: {
                                                if (selectedDevGroup === grpCol.gIndex && selectedDevItem === index)
                                                    return "#2a3a30"
                                                return itemH.containsMouse ? "#252525" : "transparent"
                                            }
                                            Row {
                                                anchors.fill: parent
                                                anchors.leftMargin: 52
                                                spacing: 4
                                                Rectangle {
                                                    width: 6; height: 6; radius: 3
                                                    anchors.verticalCenter: parent.verticalCenter
                                                    color: modelData.warn ? "#fbbf24" : root.accentColor
                                                }
                                                Text {
                                                    anchors.verticalCenter: parent.verticalCenter
                                                    width: Math.max(60, parent.width - 100)
                                                    text: modelData.name
                                                    color: modelData.warn ? "#fbbf24" : "#e8e8e8"
                                                    font.pixelSize: 12
                                                    font.family: root.uiFont
                                                    elide: Text.ElideRight
                                                }
                                                Text {
                                                    anchors.verticalCenter: parent.verticalCenter
                                                    text: modelData.state || ""
                                                    color: modelData.warn ? "#fbbf24" : root.accentColor
                                                    font.pixelSize: 11
                                                    visible: (modelData.state || "").length > 0
                                                }
                                            }
                                            MouseArea {
                                                id: itemH
                                                anchors.fill: parent
                                                hoverEnabled: true
                                                cursorShape: Qt.PointingHandCursor
                                                onClicked: {
                                                    selectedDevGroup = grpCol.gIndex
                                                    selectedDevItem = index
                                                }
                                                onDoubleClicked: {
                                                    selectedDevGroup = grpCol.gIndex
                                                    selectedDevItem = index
                                                    root.showDeviceProps(root.controlDeviceTree[grpCol.gIndex], modelData)
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                visible: root.controlDeviceTree.length === 0
                                text: "  Устройства ещё не загружены — нажмите «Обновить»."
                                color: "#6b7785"
                                font.pixelSize: 12
                                topPadding: 12
                                leftPadding: 8
                            }
                        }

                        // ===== СПИСКИ =====
                        Column {
                            width: parent.width
                            visible: root.controlTab === "services"
                                  || root.controlTab === "drivers"
                                  || root.controlTab === "bg"
                                  || root.controlTab === "diag"
                            spacing: 0

                            Rectangle {
                                width: parent.width
                                height: 22
                                color: "#232323"
                                Row {
                                    anchors.fill: parent
                                    anchors.leftMargin: 10
                                    spacing: 24
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: parent.width * 0.48
                                        text: root.controlTab === "diag" ? "Проверка" : "Имя"
                                        color: "#8b98a3"
                                        font.pixelSize: 11
                                        font.family: root.uiFontBold
                                    }
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: root.controlTab === "diag" ? "Результат" : "Состояние"
                                        color: "#8b98a3"
                                        font.pixelSize: 11
                                        font.family: root.uiFontBold
                                    }
                                }
                                Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: 1; color: "#2e2e2e" }
                            }

                            Repeater {
                                model: root.controlTab === "services" ? root.controlServices
                                     : (root.controlTab === "drivers" ? root.controlDrivers
                                     : (root.controlTab === "bg" ? root.controlBgProcs
                                     : root.diagResults))
                                delegate: Rectangle {
                                    width: ccMainCol.width
                                    height: Math.max(22, listRowCol.height + 6)
                                    color: listH.containsMouse ? "#252525" : (index % 2 ? "#1c1c1c" : "#1e1e1e")
                                    Row {
                                        id: listRowCol
                                        anchors.left: parent.left
                                        anchors.right: parent.right
                                        anchors.verticalCenter: parent.verticalCenter
                                        anchors.leftMargin: 10
                                        anchors.rightMargin: 10
                                        spacing: 16
                                        Column {
                                            width: parent.width * 0.48
                                            spacing: 1
                                            Text {
                                                width: parent.width
                                                text: modelData.name || modelData.title || ""
                                                color: "#f0f0f0"
                                                font.pixelSize: 12
                                                elide: Text.ElideRight
                                            }
                                            Text {
                                                width: parent.width
                                                visible: ((modelData.detail || modelData.body || "").length > 0)
                                                text: modelData.detail || modelData.body || ""
                                                color: "#8b98a3"
                                                font.pixelSize: 11
                                                wrapMode: Text.WordWrap
                                            }
                                        }
                                        Text {
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.state !== undefined ? modelData.state
                                                : (modelData.ok === false ? "Внимание" : (root.controlTab === "diag" ? "ОК" : ""))
                                            color: (modelData.ok === false
                                                || (modelData.state && (String(modelData.state).indexOf("Мало") >= 0
                                                    || String(modelData.state).indexOf("Нет") >= 0
                                                    || String(modelData.state).indexOf("Внимание") >= 0)))
                                                ? "#fbbf24" : root.accentColor
                                            font.pixelSize: 12
                                        }
                                    }
                                    MouseArea { id: listH; anchors.fill: parent; hoverEnabled: true }
                                }
                            }

                            Text {
                                visible: root.controlTab === "diag" && root.diagResults.length === 0
                                text: "  Нажмите «Запустить диагностику» справа."
                                color: "#6b7785"
                                font.pixelSize: 12
                                topPadding: 12
                                leftPadding: 8
                            }
                        }

                        // ===== СОСТОЯНИЕ =====
                        Column {
                            width: parent.width
                            visible: root.controlTab === "health"
                            spacing: 0
                            Repeater {
                                model: root.controlDevices
                                delegate: Rectangle {
                                    width: ccMainCol.width
                                    height: 22
                                    color: hH.containsMouse ? "#252525" : (index % 2 ? "#1c1c1c" : "#1e1e1e")
                                    Row {
                                        anchors.fill: parent
                                        anchors.leftMargin: 10
                                        anchors.rightMargin: 10
                                        spacing: 16
                                        Text {
                                            width: 150
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.name
                                            color: "#f0f0f0"
                                            font.pixelSize: 12
                                        }
                                        Text {
                                            width: 80
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.state
                                            color: (String(modelData.state).indexOf("Мало") >= 0
                                                    || String(modelData.state).indexOf("Нет") >= 0)
                                                   ? "#fbbf24" : root.accentColor
                                            font.pixelSize: 12
                                        }
                                        Text {
                                            width: parent.width - 260
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.detail
                                            color: "#8b98a3"
                                            font.pixelSize: 12
                                            elide: Text.ElideRight
                                        }
                                    }
                                    MouseArea { id: hH; anchors.fill: parent; hoverEnabled: true }
                                }
                            }
                        }

                        // ===== БЭКАПЫ =====
                        Column {
                            width: parent.width
                            visible: root.controlTab === "backups"
                            spacing: 12
                            topPadding: 8
                            leftPadding: 8
                            rightPadding: 8

                            Text {
                                text: "Резервные копии пользовательских данных"
                                color: "#f4f7f8"; font.pixelSize: 16; font.bold: true; font.family: root.uiFont
                            }
                            Text {
                                width: parent.width - 16
                                text: "Документы, Загрузки, Рабочий стол и настройки рабочего стола. " + root.recoveryStatus
                                color: "#9aa7b2"; font.pixelSize: 12; wrapMode: Text.WordWrap
                            }
                            Text {
                                width: parent.width - 16
                                text: "Расписание: " + (root.backupSchedule === "off" ? "выключено" : root.backupNextHint)
                                      + (root.backupLastRun.length ? (" · последний запуск " + root.backupLastRun) : "")
                                color: "#c5d0d8"; font.pixelSize: 12; wrapMode: Text.WordWrap
                            }
                            Row {
                                spacing: 8
                                Repeater {
                                    model: [
                                        { id: "off", label: "Выкл" },
                                        { id: "daily", label: "Ежедневно" },
                                        { id: "weekly", label: "Еженедельно" }
                                    ]
                                    delegate: Rectangle {
                                        width: 110; height: 32; radius: 8
                                        color: root.backupSchedule === modelData.id ? root.accentColor : "#2a2a2a"
                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData.label
                                            color: root.backupSchedule === modelData.id ? "#06210f" : "#e8e8e8"
                                            font.pixelSize: 12; font.bold: root.backupSchedule === modelData.id
                                        }
                                        MouseArea {
                                            anchors.fill: parent
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: root.setBackupSchedule(modelData.id)
                                        }
                                    }
                                }
                            }
                            Row {
                                spacing: 8
                                Rectangle {
                                    width: 180; height: 36; radius: 8
                                    color: root.recoveryBusy ? "#2a2a2a" : root.accentColor
                                    Text {
                                        anchors.centerIn: parent
                                        text: root.recoveryBusy ? "Копирование…" : "Создать бэкап"
                                        color: root.recoveryBusy ? "#6b7785" : "#06210f"
                                        font.pixelSize: 12; font.bold: true
                                    }
                                    MouseArea {
                                        anchors.fill: parent; enabled: !root.recoveryBusy
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.backupUserData()
                                    }
                                }
                                Rectangle {
                                    width: 120; height: 36; radius: 8; color: "#2a2a2a"
                                    Text { anchors.centerIn: parent; text: "Обновить"; color: "#e8e8e8"; font.pixelSize: 12 }
                                    MouseArea {
                                        anchors.fill: parent
                                        onClicked: root.refreshRecovery()
                                    }
                                }
                                Rectangle {
                                    width: 140; height: 36; radius: 8; color: "#1a2a24"
                                    Text { anchors.centerIn: parent; text: "Очистить диск"; color: root.accentColor; font.pixelSize: 12; font.bold: true }
                                    MouseArea {
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.runDiskCleanup()
                                    }
                                }
                            }
                            Text {
                                visible: root.recoveryBackups.length === 0
                                text: "Копий пока нет — создайте первую."
                                color: "#6b7785"; font.pixelSize: 12
                            }
                            Repeater {
                                model: root.recoveryBackups
                                delegate: Rectangle {
                                    width: ccMainCol.width - 16; height: 64; radius: 8; color: "#232323"
                                    Row {
                                        anchors.fill: parent; anchors.margins: 10; spacing: 10
                                        Column {
                                            width: parent.width - 160
                                            anchors.verticalCenter: parent.verticalCenter; spacing: 2
                                            Text { text: modelData.title; color: "#f0f0f0"; font.pixelSize: 13; font.family: root.uiFontBold }
                                            Text { text: "Размер: " + modelData.size; color: "#8b98a3"; font.pixelSize: 11 }
                                        }
                                        Rectangle {
                                            width: 140; height: 32; radius: 6
                                            anchors.verticalCenter: parent.verticalCenter
                                            color: "#1a2a24"
                                            Text { anchors.centerIn: parent; text: "Восстановить"; color: root.accentColor; font.pixelSize: 12; font.bold: true }
                                            MouseArea {
                                                anchors.fill: parent; enabled: !root.recoveryBusy
                                                cursorShape: Qt.PointingHandCursor
                                                onClicked: root.restoreUserBackup(modelData.id)
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ===== GT RECOVERY =====
                        Column {
                            width: parent.width
                            visible: root.controlTab === "recovery"
                            spacing: 12
                            topPadding: 8
                            leftPadding: 8
                            rightPadding: 8

                            Text {
                                text: root.recoveryStatus
                                color: "#9aa7b2"; font.pixelSize: 13; font.family: root.uiFont
                            }
                            Row {
                                spacing: 8
                                Rectangle {
                                    width: 168; height: 34; radius: 6
                                    color: root.recoveryBusy ? "#2a2a2a" : root.accentColor
                                    Text {
                                        anchors.centerIn: parent
                                        text: "Создать точку"
                                        color: root.recoveryBusy ? "#6b7785" : "#06210f"
                                        font.pixelSize: 12; font.bold: true
                                    }
                                    MouseArea {
                                        anchors.fill: parent
                                        enabled: !root.recoveryBusy
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.createRestorePoint("Ручная точка восстановления")
                                    }
                                }
                                Rectangle {
                                    width: 200; height: 34; radius: 6; color: "#2a2a2a"
                                    Text { anchors.centerIn: parent; text: "Копия данных пользователя"; color: "#e8e8e8"; font.pixelSize: 12 }
                                    MouseArea {
                                        anchors.fill: parent
                                        enabled: !root.recoveryBusy
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.backupUserData()
                                    }
                                }
                            }

                            Text {
                                text: "Точки восстановления"
                                color: "#fbbf24"; font.pixelSize: 12; font.family: root.uiFontBold; topPadding: 4
                            }
                            Text {
                                visible: root.restorePoints.length === 0
                                text: "Пока нет точек — создайте первую перед обновлением."
                                color: "#6b7785"; font.pixelSize: 12
                            }
                            Repeater {
                                model: root.restorePoints
                                delegate: Rectangle {
                                    width: ccMainCol.width - 16; height: 56; radius: 8
                                    color: "#232323"
                                    Row {
                                        anchors.fill: parent; anchors.margins: 10; spacing: 10
                                        Column {
                                            width: parent.width - 140
                                            anchors.verticalCenter: parent.verticalCenter; spacing: 2
                                            Text { text: modelData.title; color: "#f0f0f0"; font.pixelSize: 13; font.family: root.uiFontBold }
                                            Text { text: modelData.when; color: "#8b98a3"; font.pixelSize: 11 }
                                        }
                                        Rectangle {
                                            width: 120; height: 30; radius: 6
                                            anchors.verticalCenter: parent.verticalCenter
                                            color: "#3f2a15"
                                            Text { anchors.centerIn: parent; text: "Восстановить"; color: "#fde68a"; font.pixelSize: 11; font.bold: true }
                                            MouseArea {
                                                anchors.fill: parent
                                                enabled: !root.recoveryBusy
                                                cursorShape: Qt.PointingHandCursor
                                                onClicked: root.restoreFromPoint(modelData.id)
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Резервные копии"
                                color: "#60a5fa"; font.pixelSize: 12; font.family: root.uiFontBold; topPadding: 6
                            }
                            Text {
                                visible: root.recoveryBackups.length === 0
                                text: "Копий пока нет."
                                color: "#6b7785"; font.pixelSize: 12
                            }
                            Repeater {
                                model: root.recoveryBackups
                                delegate: Rectangle {
                                    width: ccMainCol.width - 16; height: 44; radius: 8
                                    color: "#232323"
                                    Row {
                                        anchors.fill: parent; anchors.margins: 10
                                        Text {
                                            width: parent.width - 70
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.title; color: "#e8e8e8"; font.pixelSize: 12
                                            elide: Text.ElideRight
                                        }
                                        Text {
                                            anchors.verticalCenter: parent.verticalCenter
                                            text: modelData.size; color: "#8b98a3"; font.pixelSize: 11
                                        }
                                    }
                                }
                            }
                            Text {
                                width: parent.width - 16
                                text: "После неудачного обновления используйте точку восстановления или откат в Параметры → Центр обновления."
                                color: "#6b7785"; font.pixelSize: 12; wrapMode: Text.WordWrap
                            }
                        }
                    }
                }
            }
        }
    }

    Component {
        id: recoveryPage
        Item {
            property string appTitle: ""
            Component.onCompleted: root.openControlTab("recovery")
            Rectangle { anchors.fill: parent; color: "#1e1e1e" }
            Column {
                anchors.centerIn: parent; spacing: 12
                Text {
                    width: 360; horizontalAlignment: Text.AlignHCenter
                    text: "GT Recovery"; color: "#fff"; font.pixelSize: 22; font.family: root.uiFontBold
                }
                Text {
                    width: 360; horizontalAlignment: Text.AlignHCenter; wrapMode: Text.WordWrap
