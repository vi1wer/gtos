    }

    function saveUserPassword() {
        if (pwdDraft !== pwdDraft2) {
            notify("Учётная запись", "Пароли не совпадают", "info")
            return
        }
        if (!pwdDraft.length) {
            passwordHash = ""
            userPassword = ""
        } else {
            passwordHash = hashPassword(pwdDraft)
            userPassword = ""
        }
        pwdDraft = ""
        pwdDraft2 = ""
        saveDesktop()
        upsertCurrentOsUser()
        notify("Учётная запись", passwordHash.length ? "Пароль сохранён" : "Пароль снят", "ok")
    }

    function applySystemVolume() {
        var v = muted ? 0 : Math.max(0, Math.min(100, Math.round(volume * 100)))
        sys.run("amixer -q set Master " + v + "% " + (muted || v === 0 ? "mute" : "unmute")
                + " 2>/dev/null; amixer -q sset Master " + v + "% 2>/dev/null; "
                + "amixer -q set PCM " + v + "% 2>/dev/null; true")
    }

    function enterSleep() {
        lockSession()
        resumePending = true
        sys.run("mkdir -p /tmp; rm -f /tmp/gtos-resume; touch /tmp/gtos-was-asleep; sync")
        notify("Питание", "Переход в сон…", "info")
        // после пробуждения ядро возвращает управление — пишем флаг для оболочки
        sys.run(
            "( sleep 0.5; "
            + "echo mem >/sys/power/state 2>/dev/null || echo freeze >/sys/power/state 2>/dev/null || true; "
            + "echo done >/tmp/gtos-resume; sync ) &"
        )
        resumePollTimer.restart()
    }

    function handleLidEvent(closed) {
        if (!closed)
            return
        if (lidCloseAction === "nothing")
            return
        if (lidCloseAction === "sleep")
            enterSleep()
        else
            lockSession()
    }

    function pollLidState() {
        var st = sys.run(
            "for f in /proc/acpi/button/lid/*/state /sys/class/power_supply/*/online; do "
            + "[ -f \"$f\" ] || continue; "
            + "case \"$f\" in */state) cat \"$f\" 2>/dev/null; exit 0;; esac; "
            + "done; "
            + "cat /proc/acpi/button/lid/LID/state 2>/dev/null; true"
        ).trim().toLowerCase()
        if (!st.length)
            return
        var closed = st.indexOf("closed") >= 0
        var open = st.indexOf("open") >= 0
        if (!closed && !open)
            return
        var now = closed ? "closed" : "open"
        if (lidLastState === "open" && now === "closed")
            handleLidEvent(true)
        lidLastState = now
    }

    function browseGo(addHist) {
        var url = browserUrl.trim()
        if (!url.length)
            return
        if (url.indexOf("http://") !== 0 && url.indexOf("https://") !== 0)
            url = "https://" + url
        browserUrl = url
        browserBusy = true
        browserProgress = 0.18
        browserBody = "<p style='color:#666;font-family:Sora,Montserrat,sans-serif;'>Загрузка <b style='color:#0b57d0;'>" + url + "</b>…</p>"
        commitBrowserTab()
        browseFetchTimer.addHist = (addHist !== false)
        browseFetchTimer.url = url
        browseFetchTimer.start()
    }

    function browseBack() {
        if (browserHistIndex <= 0)
            return
        browserHistIndex--
        browserUrl = browserHistory[browserHistIndex]
        browseGo(false)
    }

    function browseForward() {
        if (browserHistIndex < 0 || browserHistIndex >= browserHistory.length - 1)
            return
        browserHistIndex++
        browserUrl = browserHistory[browserHistIndex]
        browseGo(false)
    }

    function browseReload() {
        if (browserUrl.trim().length)
            browseGo(false)
    }

    function appTitleOf(appId) {
        var s = String(appId || "")
        if (s.indexOf("pkg-") === 0) {
            var pkg = storeAppById(s.slice(4))
            if (pkg)
                return pkg.name
        }
        var sa = storeAppById(s)
        if (sa)
            return sa.name
        var map = {
            files: "Файлы", browser: "Браузер", mail: "Почта", notes: "Блокнот",
            term: "Терминал", settings: "Параметры", store: "Магазин", monitor: "Диспетчер задач",
            calc: "Калькулятор", cal: "Календарь", draw: "Графика", music: "Медиаплеер",
            video: "Медиаплеер", photos: "Галерея", weather: "Погода", docs: "GT Document Viewer",
            install: "Установка GT/OS", updates: "Центр обновлений",
            storage: "GT Storage", privacy: "Конфиденциальность",
            control: "Контрольный центр", recovery: "GT Recovery", security: "Безопасность",
            trash: "Корзина"
        }
        return map[appId] || appId
    }

    function focusOrToggleApp(appId) {
        if (appId === "trash") {
            launch("trash", "Корзина")
            return
        }
        var target = appId
        var sa = storeAppById(appId)
        if (sa)
            target = "pkg-" + sa.id
        for (var i = 0; i < windows.count; ++i) {
            if (windows.get(i).appId !== target)
                continue
            if (!windows.get(i).hidden && windows.get(i).z === zseq && windowDesk(i) === deskIndex) {
                windows.setProperty(i, "hidden", true)
                return
            }
            windows.setProperty(i, "desk", deskIndex)
            windows.setProperty(i, "hidden", false)
            windows.setProperty(i, "z", ++zseq)
            showDesktopActive = false
            return
        }
        if (sa) {
            openStoreApp(sa)
            return
        }
        if (String(appId).indexOf("pkg-") === 0) {
            var pkg = storeAppById(String(appId).slice(4))
            if (pkg) {
                openStoreApp(pkg)
                return
            }
        }
        launch(appId, appTitleOf(appId))
    }

    function runningAppIds() {
        var out = []
        for (var i = 0; i < windows.count; ++i) {
            var id = windows.get(i).appId
            if (out.indexOf(id) < 0)
                out.push(id)
        }
        return out
    }

    function dockAppList() {
        var seen = {}
        var out = []
        var i
        for (i = 0; i < pinnedApps.length; ++i) {
            out.push(pinnedApps[i])
            seen[pinnedApps[i]] = true
        }
        var run = runningAppIds()
        for (i = 0; i < run.length; ++i) {
            if (!seen[run[i]])
                out.push(run[i])
        }
        return out
    }

    function isAppRunning(appId) {
        for (var i = 0; i < windows.count; ++i)
            if (windows.get(i).appId === appId && !windows.get(i).hidden)
                return true
        for (var j = 0; j < windows.count; ++j)
            if (windows.get(j).appId === appId)
                return true
        return false
    }

    function isAppActive(appId) {
        var topZ = -1
        var topId = ""
        for (var i = 0; i < windows.count; ++i) {
            var w = windows.get(i)
            if (!w.hidden && w.z > topZ) {
                topZ = w.z
                topId = w.appId
            }
        }
        return topId === appId
    }

