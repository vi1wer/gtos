    Component {
        id: calcPage
        Item {
            property string appTitle: ""
            property var padKeys: ["%", "±", "⌫", "C", "7", "8", "9", "÷", "4", "5", "6", "×", "1", "2", "3", "−", "0", ".", "=", "+"]
            focus: true
            Keys.onPressed: function (e) {
                var k = e.text
                if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter) { root.calcPress("="); e.accepted = true; return }
                if (e.key === Qt.Key_Escape) { root.calcPress("C"); e.accepted = true; return }
                if (e.key === Qt.Key_Backspace) { root.calcPress("⌫"); e.accepted = true; return }
                if (e.key === Qt.Key_Asterisk || k === "*") { root.calcPress("×"); e.accepted = true; return }
                if (e.key === Qt.Key_Slash || k === "/") { root.calcPress("÷"); e.accepted = true; return }
                if (k === "-" || e.key === Qt.Key_Minus) { root.calcPress("−"); e.accepted = true; return }
                if (k === "+" || e.key === Qt.Key_Plus) { root.calcPress("+"); e.accepted = true; return }
                if (k === "=") { root.calcPress("="); e.accepted = true; return }
                if (k === "." || k === ",") { root.calcPress("."); e.accepted = true; return }
                if (k === "%") { root.calcPress("%"); e.accepted = true; return }
                if (k.length === 1 && k >= "0" && k <= "9") { root.calcPress(k); e.accepted = true; return }
            }
            Component.onCompleted: forceActiveFocus()
            Rectangle {
                anchors.fill: parent
                color: "#12161a"
                Column {
                    anchors.fill: parent
                    anchors.margins: 16
                    spacing: 12
                    Rectangle {
                        width: parent.width
                        height: 96
                        radius: 12
                        color: "#1a1f24"
                        Column {
                            anchors.fill: parent
                            anchors.margins: 14
                            spacing: 4
                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignRight
                                text: root.calcExpr.length ? (root.calcExpr + (root.calcAwaitingOperand ? "" : "")) : " "
                                color: "#8b97a3"
                                font.pixelSize: 14
                                font.family: root.monoFont
                                elide: Text.ElideLeft
                            }
                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignRight
                                text: root.calcDisplay
                                color: "#f4f7f8"
                                font.pixelSize: root.calcDisplay.length > 12 ? 28 : 36
                                font.bold: true
                                font.family: root.monoFont
                                elide: Text.ElideLeft
                            }
                        }
                    }
                    Grid {
                        id: calcGrid
                        columns: 4
                        spacing: 8
                        width: parent.width
                        Repeater {
                            model: padKeys
                            delegate: Rectangle {
                                property bool isOp: "+−×÷".indexOf(modelData) >= 0
                                property bool isEq: modelData === "="
                                property bool isClear: modelData === "C" || modelData === "⌫"
                                width: (calcGrid.width - 24) / 4
                                height: Math.max(48, (calcGrid.parent.height - 96 - 12 - 32) / 5 - 2)
                                radius: 10
                                color: {
                                    if (btnMa.pressed) return isEq ? Qt.darker(root.accentColor, 1.15) : "#2a333c"
                                    if (btnMa.containsMouse) return isEq ? Qt.lighter(root.accentColor, 1.12) : (isOp ? "#243038" : "#252d36")
                                    if (isEq) return root.accentColor
                                    if (isOp) return "#1e282f"
                                    if (isClear) return "#2a2226"
                                    return "#1c232a"
                                }
                                Text {
                                    anchors.centerIn: parent
                                    text: modelData
                                    color: isEq ? "#06210f" : "#f4f7f8"
                                    font.pixelSize: 18
                                    font.bold: true
                                    font.family: root.uiFont
                                }
                                MouseArea {
                                    id: btnMa
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.calcPress(modelData)
                                }
                            }
                        }
                    }
                }
            }
        }
    }

