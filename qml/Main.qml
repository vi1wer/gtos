            // Тонкие иконки панели просмотрщика (Fluent-line), не эмодзи
            component PhotoGlyph: Item {
                id: glyph
                property string name: "fit"
                property color stroke: "#e8eef2"
                width: 18; height: 18
                Canvas {
                    anchors.fill: parent
                    onPaint: {
                        var ctx = getContext("2d")
                        ctx.reset()
                        ctx.strokeStyle = glyph.stroke
                        ctx.fillStyle = glyph.stroke
                        ctx.lineWidth = 1.6
                        ctx.lineCap = "round"
                        ctx.lineJoin = "round"
                        var n = glyph.name
                        function strokePath(fn) { ctx.beginPath(); fn(); ctx.stroke() }
                        if (n === "back") {
                            strokePath(function () { ctx.moveTo(11, 3); ctx.lineTo(5, 9); ctx.lineTo(11, 15) })
                        } else if (n === "edit") {
                            strokePath(function () {
                                ctx.rect(3, 4, 10, 10)
                                ctx.moveTo(11, 3); ctx.lineTo(15, 7); ctx.lineTo(8, 14); ctx.lineTo(4, 14); ctx.lineTo(4, 10); ctx.closePath()
                            })
                        } else if (n === "fit") {
                            strokePath(function () {
                                ctx.moveTo(3, 7); ctx.lineTo(3, 3); ctx.lineTo(7, 3)
                                ctx.moveTo(11, 3); ctx.lineTo(15, 3); ctx.lineTo(15, 7)
                                ctx.moveTo(15, 11); ctx.lineTo(15, 15); ctx.lineTo(11, 15)
                                ctx.moveTo(7, 15); ctx.lineTo(3, 15); ctx.lineTo(3, 11)
                            })
                        } else if (n === "trash") {
                            strokePath(function () {
                                ctx.moveTo(4, 5); ctx.lineTo(14, 5)
                                ctx.moveTo(6, 5); ctx.lineTo(7, 3); ctx.lineTo(11, 3); ctx.lineTo(12, 5)
                                ctx.moveTo(5.5, 5); ctx.lineTo(6.2, 15); ctx.lineTo(11.8, 15); ctx.lineTo(12.5, 5)
                            })
                        } else if (n === "heart") {
                            strokePath(function () {
                                ctx.moveTo(9, 14)
                                ctx.bezierCurveTo(3, 10, 2, 6, 5.5, 4)
                                ctx.bezierCurveTo(7.5, 3, 9, 4.5, 9, 6)
                                ctx.bezierCurveTo(9, 4.5, 10.5, 3, 12.5, 4)
                                ctx.bezierCurveTo(16, 6, 15, 10, 9, 14)
                            })
                        } else if (n === "heartfill") {
                            ctx.beginPath()
                            ctx.moveTo(9, 14)
                            ctx.bezierCurveTo(3, 10, 2, 6, 5.5, 4)
                            ctx.bezierCurveTo(7.5, 3, 9, 4.5, 9, 6)
                            ctx.bezierCurveTo(9, 4.5, 10.5, 3, 12.5, 4)
                            ctx.bezierCurveTo(16, 6, 15, 10, 9, 14)
                            ctx.fill()
                        } else if (n === "rotate") {
                            strokePath(function () {
                                ctx.rect(4, 6, 8, 8)
                                ctx.moveTo(12, 5); ctx.quadraticCurveTo(15, 5, 15, 9)
                                ctx.moveTo(15, 9); ctx.lineTo(13, 7)
                                ctx.moveTo(15, 9); ctx.lineTo(17, 7)
                            })
                        } else if (n === "copy") {
                            strokePath(function () {
                                ctx.rect(6, 5, 8, 10)
                                ctx.moveTo(4, 12); ctx.lineTo(4, 3); ctx.lineTo(12, 3)
                            })
                        } else if (n === "more") {
                            ctx.beginPath(); ctx.arc(4, 9, 1.3, 0, Math.PI * 2); ctx.fill()
                            ctx.beginPath(); ctx.arc(9, 9, 1.3, 0, Math.PI * 2); ctx.fill()
                            ctx.beginPath(); ctx.arc(14, 9, 1.3, 0, Math.PI * 2); ctx.fill()
                        } else if (n === "chev") {
                            strokePath(function () { ctx.moveTo(6, 5); ctx.lineTo(11, 9); ctx.lineTo(6, 13) })
                        } else if (n === "info") {
                            strokePath(function () {
                                ctx.arc(9, 9, 6.5, 0, Math.PI * 2)
                                ctx.moveTo(9, 8); ctx.lineTo(9, 13)
                            })
                            ctx.beginPath(); ctx.arc(9, 5.8, 1.1, 0, Math.PI * 2); ctx.fill()
                        } else if (n === "full") {
                            strokePath(function () {
                                ctx.moveTo(3, 7); ctx.lineTo(3, 3); ctx.lineTo(7, 3)
                                ctx.moveTo(11, 3); ctx.lineTo(15, 3); ctx.lineTo(15, 7)
                                ctx.moveTo(15, 11); ctx.lineTo(15, 15); ctx.lineTo(11, 15)
                                ctx.moveTo(7, 15); ctx.lineTo(3, 15); ctx.lineTo(3, 11)
                            })
                        } else if (n === "minus") {
                            strokePath(function () { ctx.moveTo(4, 9); ctx.lineTo(14, 9) })
                        } else if (n === "plus") {
                            strokePath(function () {
                                ctx.moveTo(4, 9); ctx.lineTo(14, 9)
                                ctx.moveTo(9, 4); ctx.lineTo(9, 14)
                            })
                        } else if (n === "fill") {
                            strokePath(function () {
                                ctx.rect(3, 3, 12, 12)
                                ctx.moveTo(6, 9); ctx.lineTo(12, 9)
                                ctx.moveTo(9, 6); ctx.lineTo(9, 12)
                            })
                        } else if (n === "prev") {
                            strokePath(function () { ctx.moveTo(11, 4); ctx.lineTo(5, 9); ctx.lineTo(11, 14) })
                        } else if (n === "next") {
                            strokePath(function () { ctx.moveTo(7, 4); ctx.lineTo(13, 9); ctx.lineTo(7, 14) })
                        } else if (n === "flip") {
                            strokePath(function () {
                                ctx.moveTo(3, 9); ctx.lineTo(7, 5); ctx.moveTo(3, 9); ctx.lineTo(7, 13); ctx.moveTo(3, 9); ctx.lineTo(8, 9)
                                ctx.moveTo(15, 9); ctx.lineTo(11, 5); ctx.moveTo(15, 9); ctx.lineTo(11, 13); ctx.moveTo(15, 9); ctx.lineTo(10, 9)
                            })
                        } else if (n === "slide") {
                            strokePath(function () {
                                ctx.moveTo(5, 4); ctx.lineTo(14, 9); ctx.lineTo(5, 14); ctx.closePath()
                            })
                        } else if (n === "wall") {
                            strokePath(function () {
                                ctx.rect(3, 4, 12, 10)
                                ctx.moveTo(3, 11); ctx.lineTo(7, 7); ctx.lineTo(10, 10); ctx.lineTo(12, 8); ctx.lineTo(15, 11)
                                ctx.moveTo(12, 6); ctx.arc(12, 6, 1.2, 0, Math.PI * 2)
                            })
                        }
                    }
                    Connections {
                        target: glyph
                        function onNameChanged() { parent.requestPaint() }
                        function onStrokeChanged() { parent.requestPaint() }
                    }
                    Component.onCompleted: requestPaint()
                }
            }

