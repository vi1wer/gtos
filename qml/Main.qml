                        // Image stage — clip + Flickable, чтобы зум не вылезал из окна
                        Item {
                            id: imgStage
                            width: parent.width
                            height: parent.height - viewerTop.height - viewerBottom.height
                            clip: true
                            Rectangle { anchors.fill: parent; color: "#0b0b0b" }

                            readonly property real fitW: Math.max(40, width - 56)
                            readonly property real fitH: Math.max(40, height - 40)

                            function centerFlick() {
                                Qt.callLater(function () {
                                    imgFlick.contentX = Math.max(0, (imgFlick.contentWidth - imgFlick.width) / 2)
                                    imgFlick.contentY = Math.max(0, (imgFlick.contentHeight - imgFlick.height) / 2)
                                })
                            }

                            Connections {
                                target: root
                                function onViewerZoomChanged() { imgStage.centerFlick() }
                                function onViewerPathChanged() {
                                    imgFlick.contentX = 0
                                    imgFlick.contentY = 0
                                    imgStage.centerFlick()
                                }
                            }

                            Flickable {
                                id: imgFlick
                                anchors.fill: parent
                                clip: true
                                boundsBehavior: Flickable.StopAtBounds
                                interactive: root.viewerZoom > 1.01
                                contentWidth: Math.max(width, imgStage.fitW * root.viewerZoom)
                                contentHeight: Math.max(height, imgStage.fitH * root.viewerZoom)

                                Item {
                                    width: imgFlick.contentWidth
                                    height: imgFlick.contentHeight
                                    Image {
                                        id: viewerImg
                                        anchors.centerIn: parent
                                        width: imgStage.fitW * root.viewerZoom
                                        height: imgStage.fitH * root.viewerZoom
                                        fillMode: Image.PreserveAspectFit
                                        asynchronous: true
                                        cache: true
                                        opacity: 1
                                        source: "file://" + root.viewerPath
                                        rotation: root.viewerRot
                                        mirror: root.viewerMirror
