        }
        Canvas {
            visible: kind === "draw"
            anchors.fill: parent
            onPaint: {
                var ctx = getContext("2d")
                ctx.fillStyle = "#ffffff"
                ctx.beginPath()
                ctx.moveTo(4, 22); ctx.lineTo(12, 10); ctx.lineTo(18, 18); ctx.lineTo(24, 8); ctx.lineTo(24, 22); ctx.closePath(); ctx.fill()
