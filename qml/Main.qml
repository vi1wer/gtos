    Component {
        id: settingsPage
        Item {
            property string appTitle: ""
            property string settingsQuery: ""
            property string accountsFocus: ""
            property string appsQuery: ""
            property string appsFilter: "all"
            property var sections: [
                { id: "system", name: "Система", desc: "Экран, звук, уведомления и сведения о ПК", iconKind: "pc" },
                { id: "power", name: "Питание", desc: "GT Power Manager: режимы, крышка и батарея", iconKind: "monitor" },
                { id: "bluetooth", name: "Bluetooth и устройства", desc: "Мышь, клавиатура и беспроводные устройства", iconKind: "settings" },
                { id: "network", name: "Сеть и Интернет", desc: "Wi‑Fi, кабель и состояние подключения", iconKind: "browser" },
                { id: "personalize", name: "Персонализация", desc: "Фон, цвета, панель задач и окна", iconKind: "draw" },
                { id: "apps", name: "Приложения", desc: "Установленные программы и панель задач", iconKind: "store" },
                { id: "accounts", name: "Учётные записи", desc: "Ваш профиль и вход в систему", iconKind: "mail" },
                { id: "storage", name: "Память", desc: "Что занимает место и очистка диска", iconKind: "files" },
                { id: "privacy", name: "Конфиденциальность", desc: "Разрешения, камера, микрофон и файлы", iconKind: "settings" },
                { id: "security", name: "Безопасность", desc: "GT Security: права, автозапуск и аудит", iconKind: "settings" },
                { id: "updates", name: "Центр обновления", desc: "GT Update Engine: проверка, установка и откат", iconKind: "store" },
                { id: "about", name: "О системе", desc: "Железо, выпуск GT/OS и сведения об устройстве", iconKind: "monitor" }
            ]

            function sectionTitle() {
                if (root.settingsSection === "home")
                    return "Главная"
                for (var i = 0; i < sections.length; ++i)
                    if (sections[i].id === root.settingsSection)
                        return sections[i].name
                return "Параметры"
            }

            function matchesQuery(sec) {
                if (!settingsQuery || settingsQuery.length === 0)
                    return true
                var q = settingsQuery.toLowerCase()
                return (sec.name + " " + sec.desc).toLowerCase().indexOf(q) >= 0
            }

            function installedCount() {
                var n = 0
                for (var k in root.installedApps)
                    if (root.installedApps[k])
                        n++
                return n
            }

            function accentLabel() {
                var c = String(root.accentColor).toLowerCase()
                if (c.indexOf("3be182") >= 0) return "Клевер"
                if (c.indexOf("60cdff") >= 0) return "Лёд"
                if (c.indexOf("0078d4") >= 0) return "Синий"
                if (c.indexOf("a855f7") >= 0) return "Фиолет"
                if (c.indexOf("f43f5e") >= 0) return "Алый"
                if (c.indexOf("f59e0b") >= 0) return "Янтарь"
                return "Свой"
            }

            function memLine() {
                var pct = Math.round(root.memPct)
                return pct + "% занято · ядро " + (typeof sys !== "undefined" && sys.kernel ? sys.kernel : "linux")
            }

            function localAccounts() {
                var out = []
                var seen = {}
                root.loadOsUsers()
                for (var ui = 0; ui < root.osUsers.length; ++ui) {
                    var ou = root.osUsers[ui]
                    if (!ou || !ou.user || seen[ou.user])
                        continue
                    seen[ou.user] = true
                    out.push({
                        id: ou.user,
                        name: ou.name || ou.user,
                        avatar: ou.avatar || "#4a5560",
                        role: ou.user === root.currentUser ? "Администратор" : "Локальная учётная запись",
                        current: ou.user === root.currentUser
                    })
                }
                if (!seen[root.currentUser]) {
                    out.unshift({
                        id: root.currentUser,
                        name: root.userFullName.length ? root.userFullName : root.currentUser,
                        avatar: root.userAvatar.length ? root.userAvatar : "#3be182",
                        role: "Администратор",
                        current: true
                    })
                    seen[root.currentUser] = true
                }
                var raw = sys.run("ls -1 /home 2>/dev/null").trim()
                if (raw.length) {
                    var lines = raw.split("\n")
                    for (var i = 0; i < lines.length; ++i) {
                        var u = lines[i].trim()
                        if (!u.length || u === "lost+found" || seen[u])
                            continue
                        seen[u] = true
                        out.push({
                            id: u,
                            name: u,
                            avatar: "#4a5560",
                            role: "Локальная учётная запись",
                            current: false
                        })
                    }
                }
                return out
            }

            function settingsAppList() {
                var out = []
                var seen = {}
                var all = root.allLauncherApps()
                for (var i = 0; i < all.length; ++i) {
                    var a = all[i]
                    if (!a || !a.id || seen[a.id])
                        continue
                    seen[a.id] = true
                    var third = root.isThirdPartyApp(a.id) || !!a.store
                    var sa = root.storeAppById(a.id)
                    var src = "Приложение GT/OS"
                    if (third) {
                        if (sa && sa.source === "windows")
                            src = "Стороннее · Windows"
                        else if (sa && sa.source === "linux")
                            src = "Стороннее · Linux"
                        else if (sa && sa.source === "alpine")
                            src = "Стороннее · Alpine"
                        else if (sa && sa.source === "web")
                            src = "Стороннее · веб"
                        else if (sa)
                            src = "Стороннее · магазин"
                        else
                            src = "Стороннее приложение"
                    }
                    out.push({
                        id: a.id,
                        name: a.name,
                        kind: a.kind || a.id,
                        third: third,
                        source: src
                    })
                }
                for (var k in root.installedApps) {
                    if (!root.installedApps[k] || seen[k])
                        continue
                    seen[k] = true
                    var sb = root.storeAppById(k)
                    var srcLabel = "Стороннее приложение"
                    if (sb) {
                        if (sb.source === "windows")
                            srcLabel = "Стороннее · Windows"
                        else if (sb.source === "linux")
                            srcLabel = "Стороннее · Linux"
                        else if (sb.source === "alpine")
                            srcLabel = "Стороннее · Alpine"
                        else if (sb.source === "web")
                            srcLabel = "Стороннее · веб"
                        else
                            srcLabel = "Стороннее · магазин"
                    }
                    out.push({
                        id: k,
                        name: sb ? sb.name : k,
                        kind: sb ? (sb.iconKind || "store") : root.winIconKind(k),
                        third: true,
                        source: srcLabel
                    })
                }
                var q = String(appsQuery || "").trim().toLowerCase()
                var filt = appsFilter || "all"
                var filtered = []
                for (var j = 0; j < out.length; ++j) {
                    var it = out[j]
                    if (filt === "gtos" && it.third)
                        continue
                    if (filt === "third" && !it.third)
                        continue
                    if (q.length) {
                        var hay = (it.name + " " + it.id + " " + it.source).toLowerCase()
                        if (hay.indexOf(q) < 0)
                            continue
                    }
                    filtered.push(it)
                }
                return filtered
            }

            function accountById(id) {
                var list = localAccounts()
                for (var i = 0; i < list.length; ++i)
                    if (list[i].id === id)
                        return list[i]
                return null
            }

