                                        kind: modelData.icon || "store"
                                        appId: modelData.id || ""
                                    }
                                    Column {
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: parent.width - 160
                                        opacity: modelData.enabled ? 1 : 0.55
                                        spacing: 2
                                        Text { text: modelData.name; color: "#fff"; font.pixelSize: 14; font.family: root.uiFontBold }
                                        Text {
                                            text: modelData.publisher + " · влияние: " + modelData.impact
