    function takeScreenshot() {
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd_HHmmss")
        var dir = "/home/" + currentUser + "/Изображения"
        sys.run("mkdir -p " + shQuote(dir))
        var path = dir + "/Снимок_" + stamp + ".png"
        var w = Math.max(640, Math.round(root.width))
        var h = Math.max(480, Math.round(root.height))
        var display = sys.run("printf '%s' \"${DISPLAY:-:0}\"").trim() || ":0"
        // 1) grab окна оболочки
        if (root.contentItem && root.contentItem.grabToImage) {
