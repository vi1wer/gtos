    function submitTerm(line) {
        var cmd = line.trim()
        termLog += prompt + line + "\n"
        if (cmd.length === 0) {
            refreshPrompt()
            return
        }
        if (cmd === "neofetch") {
            termLog += neoFetch()
            refreshPrompt()
            return
        }
        if (cmd === "cd" || cmd.indexOf("cd ") === 0) {
            var next = sys.run("cd " + shQuote(termCwd) + " && " + cmd + " && pwd").trim()
            if (next.indexOf("/") === 0)
                termCwd = next.split("\n")[0]
            refreshPrompt()
            return
        }
        var out = sys.run("cd " + shQuote(termCwd) + " && " + cmd)
        termLog += out
        if (out.length && !out.endsWith("\n"))
            termLog += "\n"
        refreshPrompt()
    }

    function loadFiles(path, keepHistory) {
        filesMode = "dir"
        filesPath = path
        selectedName = ""
        fileQuery = ""
        if (path === "thispc") {
            fileEntries = []
            filesStatus = "1 диск"
            filesCanBack = fileBack.length > 0
            filesCanFwd = fileFwd.length > 0
            refreshDisk()
            return
        }
        var raw = sys.listDirDetailed(path)
        if (!raw.length)
            raw = sys.listDir(path)
        var lines = raw.length ? raw.split("\n") : []
        var items = []
        for (var i = 0; i < lines.length; ++i) {
            var line = lines[i]
            if (!line.trim().length)
                continue
            if (line.indexOf("\t") >= 0) {
                var p = line.split("\t")
                var kind = p[0]
                var name = p[1] || ""
                if (!name.length)
                    continue
                if (name.indexOf(".") === 0 && path.indexOf(".Корзина") < 0)
                    continue
                items.push({
                    name: name,
                    dir: kind === "dir",
                    path: path === "/" ? "/" + name : path + "/" + name,
                    glyph: kind === "dir" ? folderGlyph(name) : "≡",
                    size: parseInt(p[2] || "0", 10) || 0,
                    mtime: p[3] || "",
                    type: p[4] || (kind === "dir" ? "Папка с файлами" : "Файл")
                })
                continue
            }
            var isDir = line.indexOf("[dir] ") === 0
            var isFile = line.indexOf("[file] ") === 0
            if (!isDir && !isFile)
                continue
            var name2 = isDir ? line.slice(6) : line.slice(7)
            if (name2.indexOf(".") === 0 && path.indexOf(".Корзина") < 0)
                continue
            items.push({
                name: name2,
                dir: isDir,
                path: path === "/" ? "/" + name2 : path + "/" + name2,
                glyph: isDir ? folderGlyph(name2) : "≡",
                size: 0,
                mtime: "",
                type: isDir ? "Папка с файлами" : "Файл"
            })
        }
        fileEntries = items
        filesCanBack = fileBack.length > 0
        filesCanFwd = fileFwd.length > 0
        refreshDisk()
        filesStatus = items.length + (items.length === 1 ? " элемент" : (items.length > 1 && items.length < 5 ? " элемента" : " элементов"))
        syncFileTabPath()
    }

    function navigateTo(path, fromHistory) {
