    function refreshControlCenter() {
        refreshAboutInfo(false)
        controlDevices = [
            { name: "Процессор", detail: aboutCpu + (aboutCpuHz.length ? " · " + aboutCpuHz : ""), state: "ОК" },
            { name: "Оперативная память", detail: aboutMemTotal + " · свободно " + aboutMemUsable, state: "ОК" },
            { name: "Накопитель", detail: aboutDiskUsed + " из " + aboutDiskTotal, state: storageFreeMb < 200 ? "Мало места" : "ОК" },
            { name: "Графика", detail: aboutGpu, state: "ОК" },
            { name: "Сеть", detail: netStatus, state: netIp && netIp !== "нет адреса" ? "ОК" : "Нет связи" }
        ]

        var openMap = {}
        for (var oi = 0; oi < controlDeviceTree.length; ++oi)
            openMap[controlDeviceTree[oi].id] = !!controlDeviceTree[oi].open

        var groups = []
        function addGroup(id, name, icon, items, defaultOpen) {
            if (!items || !items.length) return
            var isOpen = openMap.hasOwnProperty(id) ? openMap[id] : !!defaultOpen
            groups.push({ id: id, name: name, icon: icon, open: isOpen, count: items.length, items: items })
        }

        // Процессоры — из /proc, без shell
        var cpuItems = []
        var cpuModel = aboutCpu
        var cpuHz = aboutCpuHz
        cpuItems.push({
            name: String(cpuModel).replace(/\s+/g, " ").trim(),
            detail: cpuHz.length ? cpuHz : "",
            state: "ОК", warn: false
        })
        addGroup("cpu", "Процессоры", "cpu", cpuItems, true)

        // Диски
        var diskItems = _ccItemsFromLines(_ccLines(
            "lsblk -dn -o NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3==\"disk\"{print}'"
        ), 16)
        if (!diskItems.length) {
            diskItems = [{
                name: "Системный накопитель",
                detail: aboutDiskUsed + " из " + aboutDiskTotal,
                state: storageFreeMb < 200 ? "Мало места" : "ОК",
                warn: storageFreeMb < 200
            }]
        } else {
            for (var di = 0; di < diskItems.length; ++di) {
                diskItems[di].detail = "Блочное устройство"
                diskItems[di].state = "ОК"
                diskItems[di].warn = false
            }
        }
        addGroup("disk", "Дисковые устройства", "files", diskItems, true)

        // Видео
        var gpuItems = _ccItemsFromLines(_ccLines(
            "lspci 2>/dev/null | grep -iE 'vga|3d|display' | sed 's/^[^ ]* //'"
        ), 8)
        if (!gpuItems.length)
            gpuItems = [{ name: aboutGpu.length ? aboutGpu : "Виртуальная / встроенная графика", detail: aboutGpuRam, state: "ОК", warn: false }]
        else
            for (var gi = 0; gi < gpuItems.length; ++gi) {
                gpuItems[gi].detail = "Видеоадаптер"
                gpuItems[gi].state = "ОК"
                gpuItems[gi].warn = false
            }
        addGroup("gpu", "Видеоадаптеры", "monitor", gpuItems, false)

        // Сеть
        var netItems = _ccItemsFromLines(_ccLines(
            "lspci 2>/dev/null | grep -iE 'network|ethernet|wireless' | sed 's/^[^ ]* //'; "
            + "ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | awk '{print $1}' | grep -v '^lo$'"
        ), 20)
        if (!netItems.length)
            netItems = [{ name: netStatus, detail: netIp, state: netIp && netIp !== "—" ? "ОК" : "Нет связи", warn: !(netIp && netIp !== "—") }]
        else {
            for (var ni = 0; ni < netItems.length; ++ni) {
                if (!netItems[ni].detail.length)
                    netItems[ni].detail = (netItems[ni].name === "eth0" || netItems[ni].name.indexOf("en") === 0) ? ("Интерфейс · " + netIp) : "Сетевой адаптер"
                netItems[ni].state = "ОК"
                netItems[ni].warn = false
            }
        }
        addGroup("net", "Сетевые адаптеры", "network", netItems, true)

        // USB
        var usbRaw = _ccLines("lsusb 2>/dev/null")
        var usbItems = []
        for (var u = 0; u < usbRaw.length && usbItems.length < 24; ++u) {
            var ul = usbRaw[u].replace(/\s+/g, " ").trim()
            if (!ul.length) continue
            var uname = ul.replace(/^Bus [0-9a-fA-F]+ Device [0-9a-fA-F]+: ID [0-9a-fA-F:]+ /, "")
            if (!uname.length) uname = ul
            var uwarn = /unknown|descriptor|fail|error/i.test(ul)
            usbItems.push({
                name: uname.length > 88 ? uname.slice(0, 85) + "…" : uname,
                detail: ul.match(/^Bus [0-9a-fA-F]+ Device [0-9a-fA-F]+/) ? ul.match(/^Bus [0-9a-fA-F]+ Device [0-9a-fA-F]+/)[0] : "USB",
                state: uwarn ? "Внимание" : "ОК",
                warn: uwarn
            })
        }
        var usbHosts = _ccItemsFromLines(_ccLines(
            "lspci 2>/dev/null | grep -i usb | sed 's/^[^ ]* //'"
        ), 8)
        for (var uh = 0; uh < usbHosts.length; ++uh) {
            usbHosts[uh].detail = "Хост-контроллер USB"
            usbHosts[uh].state = "ОК"
            usbHosts[uh].warn = false
            usbItems.push(usbHosts[uh])
        }
        if (!usbItems.length)
            usbItems = [{ name: "USB-контроллер (встроенный)", detail: "Нет данных lsusb", state: "ОК", warn: false }]
        addGroup("usb", "Контроллеры USB", "usb", usbItems, true)

        // Звук
        var audioItems = _ccItemsFromLines(_ccLines(
            "awk -F: '/^ *[0-9]+/{gsub(/^ +| +$/,\"\",$2); print $2}' /proc/asound/cards 2>/dev/null"
        ), 8)
        if (!audioItems.length)
            audioItems = _ccItemsFromLines(_ccLines("lspci 2>/dev/null | grep -i audio | sed 's/^[^ ]* //'"), 6)
        for (var ai = 0; ai < audioItems.length; ++ai) {
            audioItems[ai].detail = "Аудиоустройство"
            audioItems[ai].state = "ОК"
            audioItems[ai].warn = false
        }
        if (audioItems.length)
            addGroup("audio", "Аудиовходы и аудиовыходы", "music", audioItems, false)

        // Клавиатуры / мыши / HID
        var inputNames = _ccLines("grep -E '^N: Name=' /proc/bus/input/devices 2>/dev/null | sed 's/^N: Name=//; s/\"//g'")
        var kbdItems = [], mouseItems = [], hidItems = []
        for (var ii = 0; ii < inputNames.length; ++ii) {
            var iname = inputNames[ii].trim()
            if (!iname.length) continue
            var item = { name: iname, detail: "Устройство ввода", state: "ОК", warn: false }
            var low = iname.toLowerCase()
            if (low.indexOf("keyboard") >= 0 || low.indexOf("kbd") >= 0)
                kbdItems.push(item)
            else if (low.indexOf("mouse") >= 0 || low.indexOf("touchpad") >= 0)
                mouseItems.push(item)
            else if (hidItems.length < 10)
                hidItems.push(item)
        }
        if (!kbdItems.length)
            kbdItems = [{ name: "Клавиатура AT/OS", detail: "Ввод", state: "ОК", warn: false }]
        addGroup("kbd", "Клавиатуры", "notes", kbdItems, false)
        if (mouseItems.length)
            addGroup("mouse", "Мыши и другие указывающие устройства", "draw", mouseItems, false)
        if (hidItems.length)
            addGroup("hid", "Устройства HID", "store", hidItems, false)

        // Мониторы
        var monItems = _ccItemsFromLines(_ccLines(
            "ls /sys/class/drm 2>/dev/null | grep -E '^card[0-9]+-' | sed 's/^card[0-9]-//'"
        ), 8)
        if (!monItems.length)
            monItems = [{ name: "Основной дисплей", detail: "1920×1080 · виртуальный / локальный", state: "ОК", warn: false }]
        else
            for (var mi = 0; mi < monItems.length; ++mi) {
                monItems[mi].detail = "Подключённый выход"
                monItems[mi].state = "ОК"
                monItems[mi].warn = false
            }
        addGroup("mon", "Мониторы", "pc", monItems, false)

        // Системные (чипсет / bridge)
        var sysItems = _ccItemsFromLines(_ccLines(
            "lspci 2>/dev/null | grep -iE 'bridge|host bridge|isa|smbus|system peripheral' | sed 's/^[^ ]* //' | head -n 12"
        ), 12)
        for (var si = 0; si < sysItems.length; ++si) {
            sysItems[si].detail = "Системное устройство"
            sysItems[si].state = "ОК"
            sysItems[si].warn = false
        }
        if (sysItems.length)
            addGroup("sysdev", "Системные устройства", "system", sysItems, false)

        controlDeviceTree = groups

        var svcRaw = sys.run("rc-status -a 2>/dev/null | head -n 40; ls /etc/init.d 2>/dev/null | head -n 20").trim()
        var svcLines = svcRaw.length ? svcRaw.split("\n") : []
        var svcs = []
        for (var i = 0; i < svcLines.length && svcs.length < 12; ++i) {
            var s = svcLines[i].trim()
            if (!s.length) continue
            svcs.push({ name: s.replace(/\s+/g, " ").slice(0, 64), state: s.indexOf("started") >= 0 || s.indexOf("[") < 0 ? "Работает" : "Стоп" })
        }
        if (!svcs.length)
            svcs = [
                { name: "networking", state: "Работает" },
                { name: "hostname", state: "Работает" },
                { name: "gt-shell", state: "Работает" }
            ]
        controlServices = svcs
        var mods = sys.run("lsmod 2>/dev/null | awk 'NR>1{print $1}' | head -n 16").trim().split("\n")
        var drv = []
        for (var m = 0; m < mods.length; ++m) {
            if (!mods[m].trim().length) continue
            drv.push({ name: mods[m].trim(), state: "Загружен" })
        }
        if (!drv.length)
            drv = [{ name: "virtio_net", state: "Загружен" }, { name: "virtio_blk", state: "Загружен" }]
        controlDrivers = drv
        var bg = []
        for (var w = 0; w < windows.count; ++w) {
            var win = windows.get(w)
            if (win.hidden) continue
            bg.push({ name: win.title || win.appId, detail: "Окно · " + win.appId, state: "Активно" })
        }
        bg.push({ name: "Рабочий стол GT/OS", detail: "gt-shell", state: "Активно" })
        controlBgProcs = bg
        var nDev = 0
        for (var gi2 = 0; gi2 < groups.length; ++gi2)
            nDev += groups[gi2].count
        controlHealth = (storageFreeMb < 200 ? "Внимание: мало места на диске. " : "")
                       + "ЦП " + Math.round(cpuPct) + "% · ОЗУ " + Math.round(memPct) + "% · "
                       + nDev + " устройств · " + controlDrivers.length + " модулей"
    }

    function runDiagnostics() {
        if (diagRunning) return
        diagRunning = true
        diagStatus = "Идёт диагностика…"
        diagResults = []
        var out = []
        var fs = sys.run("df -h / 2>/dev/null | awk 'NR==2{print $5\" used, \"$4\" free\"}'").trim()
        out.push({ title: "Диск и ФС", body: fs.length ? fs : "не удалось прочитать df", ok: true })
        var fsck = sys.run("touch /tmp/gtos-fs-probe && rm -f /tmp/gtos-fs-probe && echo ok").trim()
        out.push({ title: "Проверка записи", body: fsck === "ok" ? "Файловая система отвечает" : "Ошибка записи", ok: fsck === "ok" })
        var mem = sys.run("awk '/MemTotal|MemAvailable/{print}' /proc/meminfo 2>/dev/null").trim()
        out.push({ title: "Оперативная память", body: mem.length ? mem.replace(/\n/g, " · ") : aboutMemTotal, ok: true })
        var dmesg = sys.run("dmesg 2>/dev/null | grep -iE 'error|fail|fault' | tail -n 5").trim()
        out.push({ title: "Журнал ошибок", body: dmesg.length ? dmesg : "Критических записей не найдено", ok: !dmesg.length })
        var drvBad = sys.run("lsmod 2>/dev/null | awk 'NR==1{next} {c++} END{print c+0}'").trim()
        out.push({ title: "Драйверы / модули", body: "Загружено модулей: " + (drvBad || "0"), ok: true })
        out.push({
            title: "Отчёт об оборудовании",
            body: aboutCpu + " · " + aboutMemTotal + " · " + aboutGpu + " · диск " + aboutDiskTotal,
            ok: true
        })
        // Wi‑Fi / звук / GPU / BT / USB
        var reportPath = "/home/" + currentUser + "/Документы/проверка-железа.txt"
        sys.run("mkdir -p " + shQuote("/home/" + currentUser + "/Документы")
                + "; /usr/bin/gtos-hwcheck " + shQuote(reportPath) + " >/tmp/gtos-hwcheck.out 2>&1")
        var hw = sys.readFile("/tmp/gtos-hwcheck.out").trim()
        if (!hw.length)
            hw = sys.readFile(reportPath).trim()
        function hwSection(name, key) {
            var block = ""
            var lines = hw.split("\n")
            var grab = false
            for (var i = 0; i < lines.length; ++i) {
                if (lines[i].indexOf("==== " + key) === 0) { grab = true; continue }
                if (grab && lines[i].indexOf("====") === 0) break
                if (grab) block += (block.length ? " · " : "") + lines[i]
            }
            var ok = block.indexOf("OK") >= 0 || block.indexOf("yes") >= 0
            var warn = block.indexOf("WARN") >= 0
            out.push({ title: name, body: block.length ? block : "нет данных", ok: ok || !warn })
        }
        hwSection("Wi‑Fi", "Wi-Fi")
        hwSection("Звук (ALSA)", "Sound")
        hwSection("Графика", "GPU")
        hwSection("Bluetooth", "Bluetooth")
        hwSection("USB / носитель", "USB / install media")
        var efi = sys.run("test -d /sys/firmware/efi && echo UEFI || echo BIOS/Legacy").trim()
        out.push({ title: "Режим прошивки", body: efi + " · установщик: auto/GPT+UEFI или MBR", ok: true })
        diagResults = out
        diagStatus = "Диагностика завершена · " + Qt.formatTime(new Date(), "HH:mm")
        diagRunning = false
        controlTab = "diag"
        notify("Контрольный центр", "Отчёт также в Документах/проверка-железа.txt", "ok")
    }

    function refreshRecovery() {
        sys.run("mkdir -p /var/lib/gtos/restore-points /var/lib/gtos/backups")
        var pts = sys.run("ls -1 /var/lib/gtos/restore-points 2>/dev/null").trim().split("\n")
        var list = []
        for (var i = 0; i < pts.length; ++i) {
            var id = pts[i].trim()
            if (!id.length) continue
            var note = sys.run("cat /var/lib/gtos/restore-points/" + id + "/note.txt 2>/dev/null").trim()
            list.push({ id: id, title: note.length ? note : ("Точка " + id), when: id })
        }
        restorePoints = list
        var bks = sys.run("ls -1 /var/lib/gtos/backups 2>/dev/null").trim().split("\n")
        var bl = []
        for (var j = 0; j < bks.length; ++j) {
            var b = bks[j].trim()
            if (!b.length) continue
            var sz = sys.run("du -sh /var/lib/gtos/backups/" + b + " 2>/dev/null | awk '{print $1}'").trim()
            bl.push({ id: b, title: b, size: sz.length ? sz : "—" })
        }
        recoveryBackups = bl
        recoveryStatus = restorePoints.length + " точек · " + recoveryBackups.length + " копий"
    }

    function createRestorePoint(note) {
        if (recoveryBusy) return
        recoveryBusy = true
        recoveryStatus = "Создание точки восстановления…"
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd-HHmmss")
        var n = note && note.length ? note : ("Снимок GT/OS " + osVersion)
        sys.run(
            "DIR=/var/lib/gtos/restore-points/" + stamp + "; mkdir -p \"$DIR\"; "
            + "printf '%s\\n' " + shQuote(n) + " > \"$DIR/note.txt\"; "
            + "printf '%s\\n' " + shQuote(osVersion) + " > \"$DIR/os-version.txt\"; "
            + "apk info -v 2>/dev/null | sort > \"$DIR/apk-manifest.txt\"; "
            + "cp -a /var/lib/gtos/desktop.conf \"$DIR/\" 2>/dev/null; "
            + "cp -a /var/lib/gtos/hostname \"$DIR/\" 2>/dev/null; "
            + "echo ok"
        )
        refreshRecovery()
        recoveryBusy = false
        recoveryStatus = "Точка создана: " + stamp
        notify("GT Recovery", recoveryStatus, "ok")
    }

    function restoreFromPoint(id) {
        if (!id || recoveryBusy) return
        recoveryBusy = true
        recoveryStatus = "Восстановление из " + id + "…"
        // безопасное восстановление конфигов + манифест пакетов (без слепого удаления)
        sys.run(
            "DIR=/var/lib/gtos/restore-points/" + id + "; "
            + "cp -f \"$DIR/desktop.conf\" /var/lib/gtos/desktop.conf 2>/dev/null; "
            + "cp -f \"$DIR/hostname\" /var/lib/gtos/hostname 2>/dev/null; "
            + "if [ -f \"$DIR/apk-manifest.txt\" ]; then "
            + "  apk info -v 2>/dev/null | sort > /tmp/gtos-apk-now.txt; "
            + "  comm -13 \"$DIR/apk-manifest.txt\" /tmp/gtos-apk-now.txt > /tmp/gtos-apk-extra.txt; "
            + "  while read -r line; do pkg=$(echo \"$line\" | sed 's/-[0-9].*//'); "
            + "    old=$(grep -E \"^${pkg}-[0-9]\" \"$DIR/apk-manifest.txt\" | head -n1); "
            + "    [ -n \"$old\" ] && apk add --cache-dir /var/lib/gtos/apk-cache \"$old\" 2>/dev/null || true; "
            + "  done < /tmp/gtos-apk-extra.txt; fi; echo done"
        )
        loadDesktop()
        refreshRecovery()
        recoveryBusy = false
        recoveryStatus = "Восстановление завершено"
        notify("GT Recovery", "Система возвращена к точке " + id, "ok")
    }

    function backupUserData() {
        if (recoveryBusy) return
        recoveryBusy = true
        recoveryStatus = "Резервное копирование…"
        upsertPendingOp("backup", "Резервное копирование", "Документы и рабочий стол…", 15, "backup")
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd-HHmmss")
        sys.run(
            "DIR=/var/lib/gtos/backups/user-" + stamp + "; mkdir -p \"$DIR\"; "
            + "cp -a /home/" + currentUser + "/Документы \"$DIR/\" 2>/dev/null; "
            + "cp -a /home/" + currentUser + "/Загрузки \"$DIR/\" 2>/dev/null; "
            + "cp -a '/home/" + currentUser + "/Рабочий стол' \"$DIR/\" 2>/dev/null; "
            + "cp -a /var/lib/gtos/desktop.conf \"$DIR/\" 2>/dev/null; echo ok"
        )
        upsertPendingOp("backup", "Резервное копирование", "Готово", 100, "backup")
        finishPendingOp("backup")
        backupLastRun = Qt.formatDate(new Date(), "yyyy-MM-dd")
        refreshRecovery()
        recoveryBusy = false
        recoveryStatus = "Копия user-" + stamp + " готова"
        saveDesktop()
        notify("GT Recovery", recoveryStatus, "ok")
    }

    function refreshSecurityAudit() {
        var ev = []
        ev.push({ time: Qt.formatTime(new Date(), "HH:mm"), title: "Вход в систему", body: "Пользователь " + currentUser, level: "info" })
        if (persistOk)
            ev.push({ time: Qt.formatTime(new Date(), "HH:mm"), title: "Постоянный том", body: "Данные сохраняются между сеансами", level: "ok" })
        for (var i = 0; i < startupApps.length; ++i) {
            if (startupApps[i].enabled)
                ev.push({ time: "авто", title: "Автозапуск", body: startupApps[i].name + " включён", level: "warn" })
        }
        for (var p = 0; p < privacyPerms.length; ++p) {
            var a = privacyPerms[p]
            if (a.cam || a.mic || a.loc)
                ev.push({ time: "права", title: a.app, body: "Расширенные разрешения", level: "warn" })
        }
        if (securityLockdown)
            ev.push({ time: Qt.formatTime(new Date(), "HH:mm"), title: "Жёсткий режим", body: "Ограничен доступ к системным ресурсам", level: "ok" })
        securityAudit = ev
        securityLastScan = Qt.formatDateTime(new Date(), "dd.MM.yyyy HH:mm")
    }

    function musicExt(path) {
        var n = (path || "").toLowerCase()
        if (n.endsWith(".flac")) return "FLAC"
        if (n.endsWith(".mp3")) return "MP3"
        if (n.endsWith(".ogg")) return "OGG"
        if (n.endsWith(".wav")) return "WAV"
        if (n.endsWith(".m4a")) return "M4A"
        return "AUDIO"
    }

    function scanMusicLibrary() {
        var base = "/home/" + currentUser + "/Музыка"
        sys.run("mkdir -p " + shQuote(base))
        var raw = sys.run("find " + shQuote(base) + " -type f \\( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.wav' -o -iname '*.m4a' \\) 2>/dev/null | head -n 200").trim()
        var lines = raw.length ? raw.split("\n") : []
        var lib = []
        for (var i = 0; i < lines.length; ++i) {
            var p = lines[i].trim()
            if (!p.length) continue
            var name = p.split("/").pop()
            var title = name.replace(/\.(mp3|flac|ogg|wav|m4a)$/i, "")
            lib.push({ id: p, path: p, title: title, name: name, format: musicExt(p), demo: false })
        }
        if (!lib.length) {
            // демо-библиотека, пока пользователь не положит файлы
            lib = [
                { id: "demo1", path: "", title: "Morning Pulse", name: "Morning Pulse.mp3", format: "MP3", demo: true },
                { id: "demo2", path: "", title: "Night Circuit", name: "Night Circuit.flac", format: "FLAC", demo: true },
                { id: "demo3", path: "", title: "Code Flow", name: "Code Flow.mp3", format: "MP3", demo: true },
                { id: "demo4", path: "", title: "Soft Rain", name: "Soft Rain.flac", format: "FLAC", demo: true },
                { id: "demo5", path: "", title: "GT Theme", name: "GT Theme.mp3", format: "MP3", demo: true }
            ]
        }
        musicLibrary = lib
        if (musicIndex < 0 && lib.length)
            selectMusicTrack(0, false)
    }

    function musicTracksForPlaylist(pid) {
        var ids = null
        if (pid === "fav") ids = musicFavIds
        else if (pid === "focus") ids = musicFocusIds
        else if (pid === "evening") ids = musicEveningIds
        if (!ids) return musicLibrary
        var out = []
        for (var i = 0; i < musicLibrary.length; ++i) {
            if (ids.indexOf(musicLibrary[i].id) >= 0)
                out.push(musicLibrary[i])
        }
        return out
    }

    function currentMusicList() {
        return musicTracksForPlaylist(musicPlaylistId)
    }

    function selectMusicTrack(idx, autoPlay) {
        var list = currentMusicList()
        if (idx < 0 || idx >= list.length)
            return
        musicIndex = idx
        var t = list[idx]
        musicTrack = t.title
        musicTrackPath = t.path || ""
        musicFormat = t.format
        musicPos = 0
        mediaElapsedSec = 0
        if (musicTrackPath.length)
            probeMediaDuration(musicTrackPath, true)
        if (autoPlay !== false)
            playMusic(true)
    }

    function formatMediaTime(sec) {
        sec = Math.max(0, Math.floor(sec || 0))
        var m = Math.floor(sec / 60)
        var s = sec % 60
        return m + ":" + (s < 10 ? "0" : "") + s
    }

    function refreshMediaTimeLabel() {
        mediaTimeLabel = formatMediaTime(mediaElapsedSec) + " / " + formatMediaTime(mediaDurationSec)
    }

    function probeMediaDuration(path, resetElapsed) {
        if (!path || !path.length) {
            mediaDurationSec = 0
            if (resetElapsed !== false)
                mediaElapsedSec = 0
            refreshMediaTimeLabel()
            return
        }
        var raw = sys.run("ffprobe -v error -show_entries format=duration -of default=nk=1:nw=1 " + shQuote(path) + " 2>/dev/null").trim()
        var n = parseFloat(raw)
        mediaDurationSec = (!isNaN(n) && n > 0) ? Math.floor(n) : 0
        if (resetElapsed !== false)
            mediaElapsedSec = 0
        refreshMediaTimeLabel()
    }

    function applyMediaVolume() {
        var v = Math.max(0, Math.min(100, Math.round(mediaVolume * 100)))
        sys.run("amixer -q set Master " + v + "% 2>/dev/null; amixer -q sset Master " + v + "% 2>/dev/null; true")
    }

    function stopMusic() {
        musicPlaying = false
        musicTick.stop()
        mediaElapsedSec = 0
        musicPos = 0
        refreshMediaTimeLabel()
        sys.run("pkill -x mpg123 2>/dev/null; pkill -x ffplay 2>/dev/null; true")
        notify("Медиаплеер", "Стоп", "ok")
    }

    function seekMusic(ratio) {
        musicPos = Math.max(0, Math.min(1, ratio))
        if (mediaDurationSec > 0)
            mediaElapsedSec = Math.floor(musicPos * mediaDurationSec)
        refreshMediaTimeLabel()
        if (!musicTrackPath.length || !musicPlaying)
            return
        var ss = mediaElapsedSec
        sys.run("pkill -x mpg123 2>/dev/null; pkill -x ffplay 2>/dev/null; "
                + "ffplay -nodisp -autoexit -loglevel quiet -ss " + ss + " -volume " + Math.round(mediaVolume * 100) + " "
                + shQuote(musicTrackPath) + " >/dev/null 2>&1 &")
    }

    function isMediaName(name) {
        var n = String(name || "").toLowerCase()
        return n.indexOf(".mp3") > 0 || n.indexOf(".flac") > 0 || n.indexOf(".wav") > 0
            || n.indexOf(".ogg") > 0 || n.indexOf(".m4a") > 0 || n.indexOf(".mp4") > 0
            || n.indexOf(".mkv") > 0 || n.indexOf(".avi") > 0 || n.indexOf(".webm") > 0
            || n.indexOf(".mov") > 0
    }

    function isVideoName(name) {
        var n = String(name || "").toLowerCase()
        return n.indexOf(".mp4") > 0 || n.indexOf(".mkv") > 0 || n.indexOf(".avi") > 0
            || n.indexOf(".webm") > 0 || n.indexOf(".mov") > 0
    }

    function openMediaFile(path) {
        if (!path || !path.length)
            return
        var name = path.split("/").pop()
        if (isVideoName(name)) {
            launch("video", "Медиаплеер")
            // inject into library and play
            var title = name.replace(/\.(mp4|mkv|avi|webm|mov)$/i, "")
            var ext = name.indexOf(".") >= 0 ? name.split(".").pop().toUpperCase() : ""
            var lib = vlcLibrary.slice()
            var found = -1
            for (var i = 0; i < lib.length; ++i) {
                if (lib[i].path === path) { found = i; break }
            }
            if (found < 0) {
                lib.unshift({ id: path, path: path, title: title, name: name, format: ext })
                vlcLibrary = lib
                found = 0
            }
            probeMediaDuration(path)
            selectVlcTrack(found, true)
            return
        }
        launch("music", "Медиаплеер")
        scanMusicLibrary()
        var list = currentMusicList()
        for (var j = 0; j < list.length; ++j) {
            if (list[j].path === path) {
                selectMusicTrack(j, true)
                return
            }
        }
        // not in library yet — play directly
        musicTrack = name.replace(/\.(mp3|flac|ogg|wav|m4a)$/i, "")
        musicTrackPath = path
        musicFormat = musicExt(path)
        musicIndex = -1
        probeMediaDuration(path)
        playMusic(true)
    }

