    function saveQuickNote() {
        var text = String(quickNoteDraft || "").trim()
        if (!text.length) {
            quickNoteOpen = false
            return
        }
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd_HHmm")
        var path = "/home/" + currentUser + "/Документы/заметка_" + stamp + ".txt"
        sys.run("mkdir -p " + shQuote("/home/" + currentUser + "/Документы"))
        if (sys.writeFile(path, text + "\n")) {
            notify("Заметка", "Сохранено в Документы", "ok")
            refreshDeskIcons()
        } else {
            notify("Заметка", "Не удалось сохранить", "info")
        }
        quickNoteOpen = false
        quickNoteDraft = ""
    }

