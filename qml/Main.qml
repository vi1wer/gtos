    function refreshStorageMap() {
        // Только df — без du (на TCG du по дому/tmp ощущается как зависание)
        var line = ""
        if (typeof sys.runTimeout === "function")
            line = sys.runTimeout("df -m /data /home / 2>/dev/null | awk 'NR==2{print $2\" \"$4; exit}'", 1500).trim()
        else
            line = sys.run("df -m /data /home / 2>/dev/null | awk 'NR==2{print $2\" \"$4; exit}'").trim()
        var parts = line.split(/\s+/)
        var total = parseInt(parts[0], 10) || 16384
        var f = parseInt(parts[1], 10) || 1265
        var used = Math.max(0, total - f)
        var h = Math.max(40, Math.round(used * 0.12))
        var tmp = Math.max(8, Math.round(used * 0.03))
        var apps = Math.max(40, Math.round(used * 0.35))
        var r = Math.max(80, Math.round(used * 0.25))
        var doc = Math.max(12, Math.round(h * 0.4))
        var dsk = Math.max(8, Math.round(h * 0.1))
        var media = Math.max(10, Math.round(h * 0.15))
        var other = Math.max(20, used - apps - r - doc - dsk - media - tmp)
        storageFreeMb = f
        storageTotalMb = Math.max(total, 1)
        storageMap = [
            { name: "Установленные приложения", mb: apps, icon: "store", more: false, color: "#3be182" },
            { name: "Другое", mb: other, icon: "files", more: false, color: "#60a5fa" },
            { name: "Документы", mb: doc, icon: "notes", more: false, color: "#f59e0b" },
            { name: "Временные файлы", mb: tmp, icon: "settings", more: false, color: "#f43f5e" },
            { name: "Рабочий стол", mb: dsk, icon: "pc", more: false, color: "#c084fc" },
            { name: "Система", mb: r, icon: "monitor", more: true, color: "#22d3ee" },
            { name: "Снимки и медиа", mb: media, icon: "draw", more: true, color: "#a3e635" }
        ]
    }

    function runStorageCleanup() {
        sys.run("rm -rf /tmp/gtos-* /tmp/*.tmp /var/tmp/* 2>/dev/null; true")
        notify("Память", "Временные файлы очищены", "ok")
        refreshStorageMap()
    }

    property bool aboutInfoLoaded: false

    function _memKbFromProc(key) {
        var mem = sys.memory || sys.readFile("/proc/meminfo")
        var lines = String(mem).split("\n")
        for (var i = 0; i < lines.length; ++i) {
            if (lines[i].indexOf(key) === 0) {
                var p = lines[i].split(/\s+/)
                return parseInt(p[1], 10) || 0
            }
        }
        return 0
    }

    function _cpuModelFromProc() {
        var raw = sys.readFile("/proc/cpuinfo")
        var lines = raw.split("\n")
        for (var i = 0; i < lines.length; ++i) {
            if (lines[i].indexOf("model name") === 0) {
                var ix = lines[i].indexOf(":")
                return ix >= 0 ? lines[i].slice(ix + 1).replace(/^\s+/, "") : "Процессор"
            }
        }
        return "Процессор"
    }

    function _cpuHzFromProc() {
        var raw = sys.readFile("/proc/cpuinfo")
        var lines = raw.split("\n")
        for (var i = 0; i < lines.length; ++i) {
            if (lines[i].indexOf("cpu MHz") === 0) {
                var ix = lines[i].indexOf(":")
                var mhz = parseFloat(ix >= 0 ? lines[i].slice(ix + 1) : "")
                if (!isNaN(mhz) && mhz > 0)
                    return (mhz / 1000).toFixed(2) + " ГГц"
            }
        }
        return ""
    }

    function refreshAboutInfo(force) {
        refreshStorageMap()
        var memKb = _memKbFromProc("MemTotal:")
        var availKb = _memKbFromProc("MemAvailable:")
        aboutMemTotal = memKb > 0 ? fmtStorageSize(memKb / 1024) : "—"
        aboutMemUsable = availKb > 0 ? fmtStorageSize(availKb / 1024) : "—"
        aboutDiskTotal = fmtStorageSize(storageTotalMb)
        aboutDiskUsed = fmtStorageSize(Math.max(0, storageTotalMb - storageFreeMb))
        aboutGpuRam = memKb > 0 ? Math.round(memKb / 1024 * 0.08) + " МБ" : "—"

        if (aboutInfoLoaded && !force) {
            aboutRenaming = false
            aboutRenameDraft = aboutHost
            return
        }

        var host = sys.readFile("/var/lib/gtos/hostname").trim()
        if (!host.length)
            host = (sys.hostname || "").trim()
        aboutHost = host.length ? host : "gt-os"
        aboutBoard = sys.readFile("/sys/devices/virtual/dmi/id/board_name").trim()
        if (!aboutBoard.length)
            aboutBoard = sys.readFile("/sys/devices/virtual/dmi/id/product_name").trim()
        if (!aboutBoard.length)
            aboutBoard = "Плата GT/OS"
        aboutCpu = _cpuModelFromProc()
        aboutCpuHz = _cpuHzFromProc()
        aboutGpu = "Виртуальная / встроенная графика"
        aboutKernel = (typeof sys !== "undefined" && sys.kernel) ? String(sys.kernel).split(" ").slice(0, 3).join(" ") : "linux"
        if (!aboutKernel.length)
            aboutKernel = "linux"
        aboutArch = "x86_64"
        var mid = sys.readFile("/var/lib/gtos/machine-id").trim()
        if (!mid.length)
            mid = sys.readFile("/etc/machine-id").trim()
        if (!mid.length) {
            mid = ("gtos" + String(Date.now()).slice(-8) + Math.floor(Math.random() * 9000 + 1000)).toUpperCase()
            sys.writeFile("/var/lib/gtos/machine-id", mid + "\n")
        }
        aboutMachineId = mid
        aboutInstalledOn = "—"
        aboutRenaming = false
        aboutRenameDraft = aboutHost
        aboutInfoLoaded = true
    }

