    function _screenshotFallback(path, w, h, display) {
        var cmd = "ffmpeg -y -f x11grab -video_size " + w + "x" + h
                + " -i " + display + ".0 -frames:v 1 "
                + shQuote(path) + " >/tmp/gtos-shot.log 2>&1 && echo OK"
        var ok = sys.run(cmd).trim() === "OK"
        if (!ok) {
            ok = sys.run(
                "import -window root " + shQuote(path) + " >/tmp/gtos-shot.log 2>&1 && echo OK"
            ).trim() === "OK"
        }
        if (ok)
            notify("Снимок экрана", "PNG сохранён в Изображения", "ok")
        else
            notify("Снимок экрана", "Не удалось сохранить PNG", "info")
    }

