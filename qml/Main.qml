    function storeCatalog() {
        var curated = storeCuratedApps()
        if (!storeRemoteApps.length)
            return curated
        var seen = {}
        var out = []
        for (var i = 0; i < curated.length; ++i) {
            seen[curated[i].id] = true
            out.push(curated[i])
        }
        for (var j = 0; j < storeRemoteApps.length; ++j) {
            var a = storeRemoteApps[j]
            if (!a || !a.id || seen[a.id])
                continue
            seen[a.id] = true
            out.push(a)
        }
        return out
    }

    function parseStoreCatalogJson(raw) {
        if (!raw || raw.indexOf("{") < 0)
            return null
        try {
            return JSON.parse(raw)
        } catch (e) {
            return null
        }
    }

    function applyStoreCatalogPayload(data, source) {
        if (!data || !data.apps || !data.apps.length)
            return false
        storeRemoteApps = data.apps
        storeNetSource = source || ""
        if (data.alpine)
            storeAlpineBranch = data.alpine
        sys.writeFile("/var/lib/gtos/alpine-branch", storeAlpineBranch + "\n")
        if (data.categories && data.categories.length) {
            var cats = [{ id: "all", name: "Все" }]
            for (var i = 0; i < data.categories.length; ++i) {
                var c = data.categories[i]
                if (!c || c === "all")
                    continue
                cats.push({ id: c, name: c })
            }
            storeCategoryList = cats
        }
        storeCatalogStatus = "Каталог: " + data.apps.length + " приложений · " + (source || "локально")
        return true
    }

    function fetchStoreCatalogNetwork(forceNotify) {
        storeCatalogStatus = "Каталог: загрузка из сети…"
        var urls = [
            "http://10.0.2.2:5050/api/store/catalog?limit=2000",
            "http://10.0.2.2:5050/static/store/catalog.json",
            "http://127.0.0.1:5050/api/store/catalog?limit=2000"
        ]
        for (var i = 0; i < urls.length; ++i) {
            var raw = sys.run("curl -fsSL --max-time 25 " + shQuote(urls[i]) + " 2>/dev/null").trim()
            var data = parseStoreCatalogJson(raw)
            if (applyStoreCatalogPayload(data, urls[i])) {
                if (forceNotify)
                    notify("Магазин GT", "Загружено " + storeRemoteApps.length + " приложений из сети", "ok")
                Qt.callLater(function () { root.queueDefaultStoreDownloads() })
                return true
            }
        }
        // cat — без лимита 64 КБ у sys.readFile
        var local = sys.run("cat /usr/share/gtos/store-catalog.json 2>/dev/null").trim()
        var localData = parseStoreCatalogJson(local)
        if (applyStoreCatalogPayload(localData, "офлайн-копия")) {
            if (forceNotify)
                notify("Магазин GT", "Сеть недоступна — офлайн-каталог (" + storeRemoteApps.length + ")", "info")
            Qt.callLater(function () { root.queueDefaultStoreDownloads() })
            return true
        }
        storeRemoteApps = []
        storeCatalogStatus = "Каталог: только избранное (сеть недоступна)"
        if (forceNotify)
            notify("Магазин GT", "Не удалось загрузить сетевой каталог", "info")
        return false
    }

    function queueDefaultStoreDownloads() {
        if (safeMode || locked || setupOpen || booting)
            return
        if (defaultDownloadBusy || storeInstallingId.length)
            return
        if (sys.readFile("/var/lib/gtos/default-apps-done").trim() === "yes")
            return
        var ids = defaultDownloadIds || []
        for (var i = 0; i < ids.length; ++i) {
            var id = ids[i]
            if (installedApps[id])
                continue
            var app = storeAppById(id)
            if (!app || !app.id) {
                // fallback Cursor, если каталог ещё без записи
                if (id === "cursor-linux") {
                    app = {
                        id: "cursor-linux", name: "Cursor", pub: "Anysphere",
                        source: "linux", platform: "linux", format: "appimage",
                        url: "https://downloads.cursor.com/production/306d153d51d714882ab7b1bc49649cab624e8a31/linux/x64/Cursor-3.29.9-x86_64.AppImage",
                        bin: "cursor", version: "3.29.9", launchId: "pkg", iconKind: "term"
                    }
                } else {
                    continue
                }
            }
            defaultDownloadBusy = true
            sys.run("mkdir -p /var/lib/gtos; echo pending >/var/lib/gtos/default-apps-done")
            notify("Предустановки", "Скачиваем Cursor — IDE по умолчанию для GT/OS…", "ok")
            installStoreApp(app)
            return
        }
        sys.run("mkdir -p /var/lib/gtos; echo yes >/var/lib/gtos/default-apps-done")
    }

    function storeAppById(id) {
        var c = storeCatalog()
        for (var i = 0; i < c.length; ++i)
            if (c[i].id === id)
                return c[i]
        return null
    }

    function resolveHostAppId(appId) {
        var s = String(appId || "")
        if (s.indexOf("pkg-") === 0) {
            var a = storeAppById(s.slice(4))
            if (!a)
                return "pkg"
            var lid = a.launchId || "pkg"
            if (lid === "telegram" || lid === "maps")
                return "browser"
            if (lid === "paint")
                return "draw"
            if (lid === "player")
                return "music"
            if (lid === "mailplus")
                return "mail"
            if (lid === "notespro")
                return "notes"
            if (lid === "vlc")
                return "vlc"
            if (lid === "video")
                return "video"
            if (lid === "pkg" || lid === a.id || a.source === "alpine"
                    || a.source === "linux" || a.source === "windows")
                return "pkg"
            return lid
        }
        return s
    }

    function isChromeApp(appId) {
        var host = resolveHostAppId(appId)
        return host === "term" || host === "files" || host === "settings" || host === "store"
            || host === "notes" || host === "photos" || host === "weather" || host === "docs" || host === "monitor" || host === "browser"
            || host === "mail" || host === "calc" || host === "cal" || host === "draw"
            || host === "music" || host === "video" || host === "vlc" || host === "pkg"
            || host === "install" || host === "updates" || host === "storage" || host === "privacy"
            || host === "control" || host === "recovery"
            || host === "power" || host === "archive" || host === "fonts"
    }

    function componentForApp(appId) {
        var host = resolveHostAppId(appId)
        if (host === "term") return termPage
        if (host === "files") return filesPage
        if (host === "settings") return settingsPage
        if (host === "store") return storePage
        if (host === "notes") return notesPage
        if (host === "photos") return photosPage
        if (host === "weather") return weatherPage
        if (host === "docs") return docsPage
        if (host === "monitor") return monitorPage
        if (host === "browser") return browserPage
        if (host === "mail") return mailPage
        if (host === "calc") return calcPage
        if (host === "cal") return calPage
        if (host === "draw") return drawPage
        if (host === "music") return musicPage
        if (host === "video") return videoPage
        if (host === "vlc") return vlcPage
        if (host === "pkg") return pkgPage
        if (host === "install") return installPage
        if (host === "updates") return updatesPage
        if (host === "storage") return storagePage
        if (host === "privacy") return privacyPage
        if (host === "control") return controlPage
        if (host === "recovery") return recoveryPage
        if (host === "power") return powerPage
        if (host === "archive") return archivePage
        if (host === "fonts") return fontPage
        return infoPage
    }

    function mediaEnginePresent(app) {
        var bins = (app && app.engineBins) ? app.engineBins : []
        if (!bins.length)
            return true
        for (var i = 0; i < bins.length; ++i) {
            var found = sys.run("command -v " + bins[i] + " 2>/dev/null").trim()
            if (found.length)
                return true
        }
        return false
    }

    function mediaEngineVersion(app) {
        if (!app)
            return ""
        if (app.id === "vlc") {
            var v = sys.run("vlc --version 2>/dev/null | head -n 1").trim()
            if (v.length)
                return v
            v = sys.run("ffplay -version 2>/dev/null | head -n 1").trim()
            if (v.length)
                return v
            return sys.run("ffmpeg -version 2>/dev/null | head -n 1").trim()
        }
        return ""
    }

    function installStoreApp(app) {
        if (!app || !app.id)
            return
        if (installedApps[app.id]) {
            openStoreApp(app)
            return
        }
        if (storeInstallingId.length) {
            notify("Магазин GT", "Дождитесь окончания текущей загрузки", "info")
            return
        }
        storePendingApp = app
        storeInstallingId = app.id
        storeInstallPct = 2
        var plat = storePlatformOf(app)
        var src = String(app.source || (app.apk ? "alpine" : "web"))
        upsertPendingOp("store-" + app.id, "Загрузка «" + app.name + "»", storePlatformLabel(plat), 2, "download")
        notify("Магазин GT", "Установка «" + app.name + "» (" + storePlatformLabel(plat) + ")…", "ok")
        // web-only
        if (src === "web" || (!app.apk && !app.url && app.homeUrl)) {
            storeInstallPct = 100
            finishStoreInstall(true)
            return
        }
        var pkg = String(app.apk || app.id).replace(/[^a-zA-Z0-9._+-]/g, "")
        var fmt = String(app.format || "")
        var bin = String(app.bin || "")
        var exe = String(app.exe || "")
        var portable = (app.portable === true || fmt === "portable") ? "1" : "0"
        var url = String(app.url || "")
        sys.writeFile("/tmp/gtos-store-url.txt", url + "\n")
        sys.writeFile("/tmp/gtos-store-job.env",
                      "ID='" + String(app.id).replace(/'/g, "") + "'\n"
                      + "SOURCE='" + src.replace(/'/g, "") + "'\n"
                      + "APK='" + pkg + "'\n"
                      + "NAME='" + String(app.name || app.id).replace(/'/g, "") + "'\n"
                      + "FORMAT='" + fmt.replace(/'/g, "") + "'\n"
                      + "BIN='" + bin.replace(/'/g, "") + "'\n"
                      + "EXE='" + exe.replace(/'/g, "") + "'\n"
                      + "PORTABLE='" + portable + "'\n"
                      + "BRANCH='" + storeAlpineBranch + "'\n"
                      + "GTOS_USER='" + desktopUserName() + "'\n")
        sys.run(
            "mkdir -p /var/lib/gtos/apk-cache /var/lib/gtos/apps /home/" + currentUser + "/Загрузки; "
            + "rm -f /tmp/gtos-apk-done /tmp/gtos-apk-rc /tmp/gtos-store-done /tmp/gtos-store-rc; "
            + "export GTOS_USER=" + shQuote(desktopUserName()) + "; "
            + "( /usr/bin/gtos-store-install /tmp/gtos-store-job.env "
            + "|| ( echo 1 >/tmp/gtos-store-rc; echo 1 >/tmp/gtos-apk-rc; echo done >/tmp/gtos-store-done; echo done >/tmp/gtos-apk-done ); "
            + "cp -f /tmp/gtos-apk-log /home/" + currentUser + "/Загрузки/" + pkg + "-install.log 2>/dev/null ) &"
        )
        storeInstallTimer.start()
    }

    function finishStoreInstall(okForced) {
        var app = storePendingApp
        storeInstallTimer.stop()
        storeInstallingId = ""
        storeInstallPct = 100
        storePendingApp = null
        if (!app || !app.id)
            return
        var opId = "store-" + app.id
        var rc = sys.readFile("/tmp/gtos-store-rc").trim()
        if (!rc.length)
            rc = sys.readFile("/tmp/gtos-apk-rc").trim()
        var src = String(app.source || "")
        var ok = okForced === true || rc === "0"
        if (!okForced && src !== "web" && rc !== "0") {
            if (rc === "") {
                var still = sys.run("test -f /tmp/gtos-store-done -o -f /tmp/gtos-apk-done && echo yes").trim()
                var hasLaunch = sys.run("test -x /var/lib/gtos/apps/" + app.id + "/bin/launch && echo yes").trim()
                var hasBinEarly = sys.run("command -v " + String(app.apk || app.id) + " 2>/dev/null").trim()
                if (still === "yes" && !hasLaunch.length && !hasBinEarly.length) {
                    storeAutoOpenApp = null
                    finishPendingOp(opId)
                    if (defaultDownloadIds && defaultDownloadIds.indexOf(app.id) >= 0)
                        defaultDownloadBusy = false
                    notify("Установка не удалась", "«" + app.name + "»: нет кода возврата. Лог — в Загрузках.", "info")
                    return
                }
                if (hasLaunch === "yes" || hasBinEarly.length)
                    ok = true
            } else {
                var logTail = sys.run("tail -n 10 /tmp/gtos-apk-log 2>/dev/null").trim()
                storeAutoOpenApp = null
                finishPendingOp(opId)
                if (defaultDownloadIds && defaultDownloadIds.indexOf(app.id) >= 0)
                    defaultDownloadBusy = false
                notify("Установка не удалась", "«" + app.name + "»: код " + rc + (logTail ? ("\n" + logTail) : ""), "info")
                return
            }
        }
        if (!okForced && app.engineBins && app.engineBins.length && mediaEnginePresent(app))
            ok = true
        if (!okForced && !ok) {
            var hasBin = sys.run("command -v " + String(app.apk || app.id) + " 2>/dev/null").trim()
            var hasL = sys.run("test -x /var/lib/gtos/apps/" + app.id + "/bin/launch && echo yes").trim()
            if (hasBin.length || hasL === "yes")
                ok = true
        }
        if (!ok && src !== "web") {
            storeAutoOpenApp = null
            finishPendingOp(opId)
            if (defaultDownloadIds && defaultDownloadIds.indexOf(app.id) >= 0)
                defaultDownloadBusy = false
            notify("Установка не удалась", "«" + app.name + "» не установилось. Проверьте сеть и лог.", "info")
            return
        }
        var safeName = String(app.name || app.id).replace(/[^\w\u0400-\u04FF.-]+/g, "_")
        var ver = app.version || mediaEngineVersion(app) || "network"
        sys.run("mkdir -p /var/lib/gtos/apps/" + app.id + "/bin /home/" + currentUser + "/Загрузки")
        if (app.id === "vlc" || app.apk === "vlc") {
            var launcher = "#!/bin/sh\n"
                + "export DISPLAY=${DISPLAY:-:0}\n"
                + "if command -v vlc >/dev/null 2>&1; then exec vlc \"$@\"; fi\n"
                + "if command -v cvlc >/dev/null 2>&1; then exec cvlc \"$@\"; fi\n"
                + "if command -v ffplay >/dev/null 2>&1; then exec ffplay -autoexit \"$@\"; fi\n"
                + "echo 'VLC/FFmpeg not found' >&2; exit 1\n"
            sys.writeFile("/var/lib/gtos/apps/vlc/bin/vlc-launch", launcher)
            sys.run("chmod 755 /var/lib/gtos/apps/vlc/bin/vlc-launch 2>/dev/null")
        }
        sys.writeFile("/var/lib/gtos/apps/" + app.id + "/manifest.json",
                      "{\"id\":\"" + app.id + "\",\"apk\":\"" + String(app.apk || "").replace(/"/g, "")
                      + "\",\"name\":\"" + String(app.name || "").replace(/"/g, "")
                      + "\",\"pub\":\"" + String(app.pub || "").replace(/"/g, "")
                      + "\",\"version\":\"" + String(ver).replace(/"/g, "")
                      + "\",\"source\":\"" + String(src || "network").replace(/"/g, "")
                      + "\",\"platform\":\"" + storePlatformOf(app).replace(/"/g, "") + "\"}\n")
        sys.writeFile("/home/" + currentUser + "/Загрузки/" + safeName + ".gtpkg",
                      "GTPKG\nid=" + app.id + "\nsource=" + (src || "network")
                      + "\nplatform=" + storePlatformOf(app)
                      + "\nname=" + (app.name || app.id) + "\nversion=" + ver + "\n")
        var map = {}
        for (var k in installedApps)
            map[k] = installedApps[k]
        map[app.id] = true
        installedApps = map
        var keys = []
        for (var id in map)
            if (map[id])
                keys.push(id)
        sys.writeFile("/var/lib/gtos/installed.json", keys.join(",") + "\n")
        saveDesktop()
        refreshAppIconCache()
        finishPendingOp(opId)
        if (app.id === "cursor-linux" || (defaultDownloadIds && defaultDownloadIds.indexOf(app.id) >= 0)) {
            defaultDownloadBusy = false
            sys.run("mkdir -p /var/lib/gtos; echo yes >/var/lib/gtos/default-apps-done")
            if (pinnedApps.indexOf("pkg-" + app.id) < 0 && pinnedApps.indexOf(app.id) < 0) {
                var pins = pinnedApps.slice()
                pins.push("pkg-" + app.id)
                pinnedApps = pins
                saveDesktop()
            }
            notify("Cursor", "IDE установлена и закреплена в панели задач", "ok")
        }
        if (storeAutoOpenApp && storeAutoOpenApp.id === app.id) {
            var toOpen = storeAutoOpenApp
            storeAutoOpenApp = null
            notify("Магазин GT", "«" + app.name + "» готово, открываю…", "ok")
            openStoreApp(toOpen)
            return
        }
        notify("Установка завершена", "«" + app.name + "» (" + storePlatformLabel(storePlatformOf(app)) + ") установлено.", "ok")
    }

    function openStoreApp(app) {
        if (!app || !app.id)
            return
        var wid = "pkg-" + app.id
        var title = app.name || app.id
        var host = resolveHostAppId(wid)

        // Настоящие GUI (Alpine / Linux AppImage / Windows+Wine) — без окна-заглушки GT
        if (host === "pkg" && (app.source === "alpine" || app.source === "linux" || app.source === "windows")) {
            storeActivePkgId = app.id
            launchPkgBinary(app)
            trackAppLaunch(wid)
            return
        }

        for (var i = 0; i < windows.count; ++i) {
            if (windows.get(i).appId === wid) {
                windows.setProperty(i, "hidden", false)
                windows.setProperty(i, "z", ++zseq)
                windows.setProperty(i, "title", title)
                if (host === "browser" && app.homeUrl) {
                    browserUrl = app.homeUrl
                    browseGo(true)
                }
                return
            }
        }
        var ww = 720, hh = 480
        if (host === "files") { ww = 1120; hh = 720 }
        else if (host === "settings") { ww = 1180; hh = 760 }
        else if (host === "notes") { ww = 860; hh = 580 }
        else if (host === "monitor") { ww = 1080; hh = 720 }
        else if (host === "control") { ww = 1120; hh = 740 }
        else if (host === "recovery") { ww = 980; hh = 640 }
        else if (host === "term") { ww = 920; hh = 560 }
        else if (host === "browser") { ww = 980; hh = 640 }
        else if (host === "mail") { ww = 820; hh = 560 }
        else if (host === "draw") { ww = 900; hh = 600 }
        else if (host === "music") { ww = 980; hh = 640 }
        else if (host === "video") { ww = 720; hh = 420 }
        else if (host === "vlc") { ww = 980; hh = 640 }
        else if (host === "pkg") { ww = 720; hh = 480 }
        windows.append({
            appId: wid,
            title: title,
            wx: 280 + windows.count * 28,
            wy: 72 + windows.count * 24,
            z: ++zseq,
            w: ww,
            h: hh,
            maxed: false,
            hidden: false,
            desk: deskIndex,
            rw: 0, rh: 0, rx: 0, ry: 0
        })
        if (host === "music")
            scanMusicLibrary()
        if (host === "vlc")
            scanVlcLibrary()
        if (host === "files") {
            fileBack = []; fileFwd = []
            fileTabs = [{ title: "Главная", path: "/home/" + currentUser }]
            fileTab = 0
            loadFiles("/home/" + currentUser)
        }
        if (host === "notes") {
            if (!noteTabs.length)
                openNote(notePath)
            else {
                notePath = noteTabs[noteTabIndex].path
                noteText = noteTabs[noteTabIndex].text
            }
        }
        if (host === "monitor")
            refreshTaskMgr()
        if (host === "control")
            refreshControlCenter()
        if (host === "recovery")
            refreshRecovery()
        if (host === "browser") {
            if (app.homeUrl) {
                browserUrl = app.homeUrl
                browserBody = "<p>Загрузка <b>" + title + "</b>…</p>"
                browseGo(true)
            } else {
                browserBody = "<p><b>" + title + "</b> готов к работе. Введите адрес и нажмите «Открыть».</p>"
            }
        }
        if (host === "mail" && !mailBody.length)
            mailBody = "Здравствуйте,\n\n"
        if ((host === "draw" || host === "browser" || host === "mail" || host === "term" || host === "music")
                && app.source === "alpine" && (app.apk || app.id)) {
            var bin = String(app.apk || app.id).replace(/[^a-zA-Z0-9._+-]/g, "")
            var exists = bin.length ? sys.run("command -v " + bin + " 2>/dev/null").trim() : ""
            if (exists.length)
                runAsDesktopUser(bin, "/tmp/gtos-pkg-" + app.id + ".log")
        }
        trackAppLaunch(wid)
    }

    function desktopUserName() {
        var u = String(currentUser || "misha").replace(/[^a-zA-Z0-9._-]/g, "")
        return u.length ? u : "misha"
    }

    // Внешние GUI: от пользователя через gtos-runuser (Firefox не любит root).
    function runAsDesktopUser(cmd, logFile) {
        var log = logFile || "/tmp/gtos-user-app.log"
        var u = desktopUserName()
        var parts = String(cmd || "").trim().split(/\s+/).filter(function (x) { return x.length })
        if (!parts.length)
            return ""
        var quoted = ""
        for (var i = 0; i < parts.length; ++i)
            quoted += (i ? " " : "") + shQuote(parts[i])
        var binName = parts[0].split("/").pop()
        // Без sleep/tail: sys.run блокирует UI-поток (в QEMU это выглядит как зависание).
        // Отвязка процесса устойчива к отсутствию setsid (setsid → nohup → подоболочка).
        var inner = "if [ -x /usr/bin/gtos-runuser ]; then "
            + "/usr/bin/gtos-runuser " + shQuote(u) + " " + shQuote(log) + " -- " + quoted + " >/dev/null 2>&1; "
            + "else "
            + "env HOME=/home/" + u + " USER=" + u + " LOGNAME=" + u + " DISPLAY=${DISPLAY:-:0} "
            + quoted + " >" + shQuote(log) + " 2>&1; "
            + "fi"
        return sys.run(
            "export DISPLAY=${DISPLAY:-:0}; "
            + "rm -f " + shQuote(log) + "; "
            + "pkill -x " + shQuote(binName) + " 2>/dev/null; "
            + "xhost +SI:localuser:" + shQuote(u) + " >/dev/null 2>&1 || xhost +local: >/dev/null 2>&1 || true; "
            + "echo 'GTOS_PKG_LAUNCH " + binName + "' > /dev/ttyS0 2>/dev/null || true; "
            + "RUN=" + shQuote(inner) + "; "
            + "if command -v setsid >/dev/null 2>&1; then setsid sh -c \"$RUN\" </dev/null >/dev/null 2>&1 & "
            + "elif command -v nohup >/dev/null 2>&1; then nohup sh -c \"$RUN\" </dev/null >/dev/null 2>&1 & "
            + "else ( sh -c \"$RUN\" </dev/null >/dev/null 2>&1 & ) ; fi; "
            + "echo STARTED"
        )
    }

    function launchPkgBinary(app) {
        if (!app)
            return
        storeActivePkgId = app.id
        var launchSh = "/var/lib/gtos/apps/" + app.id + "/bin/launch"
        if (sys.run("test -x " + shQuote(launchSh) + " && echo yes").trim() === "yes") {
            var logL = "/tmp/gtos-pkg-" + app.id + ".log"
            runAsDesktopUser(launchSh, logL)
            notify("Магазин GT", "Запуск «" + (app.name || app.id) + "»…", "ok")
            return
        }
        var bins = []
        if (app.engineBins && app.engineBins.length) {
            for (var e = 0; e < app.engineBins.length; ++e)
                bins.push(String(app.engineBins[e]))
        }
        bins.push(String(app.bin || ""))
        bins.push(String(app.apk || ""))
        bins.push(String(app.id || ""))
        var path = ""
        var bin = ""
        for (var i = 0; i < bins.length; ++i) {
            bin = String(bins[i] || "").replace(/[^a-zA-Z0-9._+-]/g, "")
            if (!bin.length)
                continue
            path = sys.run("command -v " + bin + " 2>/dev/null").trim()
            if (path.length)
                break
        }
        if (!bin.length || !path.length) {
            // Пакет был установлен, но его файлы пропали (корень в tmpfs после
            // перезагрузки). Не ругаемся, а тихо переустанавливаем и открываем.
            if (installedApps[app.id] && storeInstallingId.length === 0) {
                var m = {}
                for (var mk in installedApps)
                    if (mk !== app.id) m[mk] = installedApps[mk]
                installedApps = m
                storeAutoOpenApp = app
                notify("Магазин GT", "«" + (app.name || app.id) + "» догружается из сети…", "ok")
                installStoreApp(app)
                return
            }
            storePkgLog = "Пакет не найден в PATH. Установите его из магазина."
            notify("Магазин GT", storePkgLog, "info")
            return
        }
        var log = "/tmp/gtos-pkg-" + app.id + ".log"
        var u = desktopUserName()
        if (bin === "firefox" || bin.indexOf("firefox") >= 0) {
            // Старт в фоне; не pkill каждый раз — иначе гонка со стартом на TCG.
            // Отвязываем процесс устойчиво: setsid → nohup → подоболочка,
            // иначе на образе без setsid Firefox молча не запускался.
            var ffRun = "/usr/bin/gtos-firefox"
            var ffInline = "/sbin/su-exec " + shQuote(u)
                + " env DISPLAY=:0 HOME=/home/" + u + " USER=" + u
                + " LIBGL_ALWAYS_SOFTWARE=1 GDK_BACKEND=x11 MOZ_WEBRENDER=0"
                + " MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_ALLOW_DOWNGRADE=1"
                + " /usr/bin/firefox -no-remote --allow-downgrade"
            storePkgLog = sys.run(
                "export DISPLAY=${DISPLAY:-:0}; "
                + "mkdir -p /tmp /var/lib/gtos /dev/shm; chmod 1777 /tmp /dev/shm 2>/dev/null; "
                + "xhost + >/dev/null 2>&1 || true; "
                + "echo 'GTOS_PKG_LAUNCH firefox' > /dev/ttyS0 2>/dev/null || true; "
                + "if pgrep -x firefox >/dev/null 2>&1 || pgrep -x firefox-bin >/dev/null 2>&1 || pgrep -f '[/]usr/lib/firefox/firefox' >/dev/null 2>&1; then "
                + "  echo ALREADY; exit 0; "
                + "fi; "
                + ": > /tmp/gtos-firefox.log; : > " + shQuote(log) + "; "
                + "if [ -x /usr/bin/gtos-firefox ]; then RUN=" + shQuote(ffRun) + "; "
                + "else RUN=" + shQuote(ffInline) + "; fi; "
                + "echo \"GTOS_FF_DIAG setsid=$(command -v setsid || echo none) gx=$([ -x /usr/bin/gtos-firefox ] && echo y || echo n) ttyS0=$([ -c /dev/ttyS0 ] && echo y || echo n)\" > /dev/ttyS0 2>/dev/null || true; "
                + "if command -v setsid >/dev/null 2>&1; then "
                + "  setsid sh -c \"$RUN >>" + shQuote(log) + " 2>&1 < /dev/null\" & "
                + "elif command -v nohup >/dev/null 2>&1; then "
                + "  nohup sh -c \"$RUN >>" + shQuote(log) + " 2>&1 < /dev/null\" >/dev/null 2>&1 & "
                + "else "
                + "  ( sh -c \"$RUN >>" + shQuote(log) + " 2>&1 < /dev/null\" & ) ; "
                + "fi; "
                + "echo STARTED"
            )
        } else if (bin === "chromium" || bin === "chrome") {
            var cdir = "/home/" + u + "/.config/gtos-" + bin
            storePkgLog = runAsDesktopUser(
                path + " --no-sandbox --user-data-dir=" + cdir, log)
        } else {
            storePkgLog = runAsDesktopUser(path, log)
        }
        // Не ждём процесс здесь — проверка через таймер, иначе UI снова встанет
        // Оболочка на нижнем слое, но на всякий случай ещё раз опускаем её
        root.lower()
        notify(app.name || bin, "Запускается…", "ok")
        storeLaunchCheckBin = bin
        storeLaunchCheckLog = log
        storeLaunchCheckName = app.name || bin
        storeLaunchCheckTries = (bin === "firefox" || bin.indexOf("firefox") >= 0) ? 8 : 2
        storeLaunchCheck.interval = (bin === "firefox" || bin.indexOf("firefox") >= 0) ? 3500 : 2500
        storeLaunchCheck.restart()
    }

    property string storeLaunchCheckBin: ""
    property string storeLaunchCheckLog: ""
    property string storeLaunchCheckName: ""
    property int storeLaunchCheckTries: 2
    Timer {
        id: storeLaunchCheck
        interval: 3500
        repeat: false
        onTriggered: {
            var bin = root.storeLaunchCheckBin
            if (!bin.length)
                return
            var alive = sys.run(
                "pgrep -x firefox >/dev/null && echo y; "
                + "pgrep -x firefox-bin >/dev/null && echo y; "
                + "pgrep -f '[/]usr/lib/firefox/firefox' >/dev/null && echo y; "
                + "pgrep -x " + bin + " >/dev/null && echo y"
            ).trim()
            if (alive.indexOf("y") >= 0) {
                root.notify(root.storeLaunchCheckName, "Запущен", "ok")
                return
            }
            root.storeLaunchCheckTries -= 1
            if (root.storeLaunchCheckTries > 0) {
                // Firefox на TCG поднимается 10–25 с — не орём раньше времени
                storeLaunchCheck.restart()
                return
            }
            var tip = sys.run(
                "tail -n 12 /tmp/gtos-firefox.log 2>/dev/null; "
                + "echo ---; "
                + "tail -n 8 /var/lib/gtos/firefox-last.log 2>/dev/null; "
                + "echo ---; "
                + "tail -n 6 " + shQuote(root.storeLaunchCheckLog) + " 2>/dev/null"
            ).trim()
            if (tip.length > 280)
                tip = tip.slice(-280)
            root.notify(root.storeLaunchCheckName,
                        tip.length ? ("Не удалось запустить:\n" + tip) : "Не удалось запустить",
                        "info")
            // дублируем хвост в serial для отладки
            sys.run("echo GTOS_FIREFOX_UI_FAIL >/dev/ttyS0 2>/dev/null; "
                    + "tail -n 40 /tmp/gtos-firefox.log >/dev/ttyS0 2>/dev/null")
        }
    }

    function saveDesktop() {
        var cfg = [
            "theme=" + themeName,
            "powerMode=" + powerMode,
            "lidClose=" + lidCloseAction,
            "accent=" + accentColor.toString(),
            "opacity=" + windowOpacity,
            "dockSize=" + dockSize,
            "dockEdge=" + dockEdge,
            "tileMode=" + tileMode,
            "volume=" + volume,
            "brightness=" + brightness,
            "bluetooth=" + (bluetoothOn ? "1" : "0"),
            "dockBrowser=" + (dockShowBrowser ? "1" : "0"),
            "dockMail=" + (dockShowMail ? "1" : "0"),
            "passwordHash=" + passwordHash,
            "passwordSalt=" + passwordSalt,
            "avatar=" + userAvatar,
            "pins=" + pinnedApps.join(","),
            "night=" + (nightLight ? "1" : "0"),
            "deskIconSize=" + deskIconSize,
            "deskAuto=" + (deskAutoArrange ? "1" : "0"),
            "deskGrid=" + (deskAlignGrid ? "1" : "0"),
            "deskShow=" + (deskShowIcons ? "1" : "0"),
            "deskSort=" + deskSortBy,
            "deskPos=" + (function () {
                var parts = []
                for (var pk in deskPositions) {
                    var p = deskPositions[pk]
                    if (p && typeof p.x === "number")
                        parts.push(String(pk).replace(/\|/g, "").replace(/>/g, "") + ">" + Math.round(p.x) + "," + Math.round(p.y))
                }
                return parts.join("|")
            })(),
            "wall=" + wallpaperIndex,
            "lockWall=" + lockWallpaperIndex,
            "desks=" + deskNames.join("|"),
            "deskIdx=" + deskIndex,
            "favs=" + fileFavorites.map(function (f) { return String(f.title).replace(/\|/g, " ").replace(/>/g, " ") + ">" + f.path }).join("|"),
            "bookmarks=" + browserBookmarks.map(function (b) { return String(b.title).replace(/\|/g, " ").replace(/>/g, " ") + ">" + b.url }).join("|"),
            "backupSchedule=" + backupSchedule,
            "backupLastRun=" + backupLastRun,
            "batterySaver=" + (batterySaver ? "1" : "0"),
            "autoLockMinutes=" + autoLockMinutes,
            "focusHoursOn=" + (focusHoursOn ? "1" : "0"),
            "focusStartHour=" + focusStartHour,
            "focusEndHour=" + focusEndHour,
            "uiScale=" + uiScale
        ].join("\n")
        // автозагрузка
        var st = []
        for (var si = 0; si < startupApps.length; ++si)
            st.push(startupApps[si].id + ":" + (startupApps[si].enabled ? "1" : "0"))
        cfg += "\nstartup=" + st.join(",")
        // лог запусков
        var al = []
        for (var ak in appLaunchLog)
            al.push(ak + ":" + appLaunchLog[ak])
        cfg += "\nlaunchLog=" + al.join(",")
        sys.writeFile("/var/lib/gtos/desktop.conf", cfg + "\n")
        // без sync на каждый сейв — иначе soft-GL мигает (иконки стола пропадают)
    }

    function loadDesktop() {
        var raw = sys.readFile("/var/lib/gtos/desktop.conf")
        if (!raw.length)
            return
        var migratedPwd = false
        var lines = raw.split("\n")
        for (var i = 0; i < lines.length; ++i) {
            var line = lines[i].trim()
            var eq = line.indexOf("=")
            if (eq < 1)
                continue
            var k = line.slice(0, eq)
            var v = line.slice(eq + 1)
            if (k === "theme") themeName = v
            else if (k === "opacity") windowOpacity = Math.max(0.55, Math.min(1, parseFloat(v) || 0.92))
            else if (k === "dockSize") dockSize = parseInt(v, 10) || 72
            else if (k === "dockEdge") dockEdge = v
            else if (k === "tileMode") tileMode = v
            else if (k === "volume") volume = Math.max(0, Math.min(1, parseFloat(v) || 0.7))
            else if (k === "brightness") brightness = Math.max(0.3, Math.min(1, parseFloat(v) || 0.88))
            else if (k === "bluetooth") bluetoothOn = v === "1"
            else if (k === "dockBrowser") dockShowBrowser = v !== "0"
            else if (k === "dockMail") dockShowMail = v !== "0"
            else if (k === "passwordHash") passwordHash = v
            else if (k === "passwordSalt" && v.length) passwordSalt = v
            else if (k === "password" && v.length) {
                // миграция со старого plaintext
                userPassword = v
                if (!passwordHash.length) {
                    passwordHash = hashPassword(v)
                    userPassword = ""
                    migratedPwd = true
                }
            }
            else if (k === "avatar" && v.length) userAvatar = v
            else if (k === "pins" && v.length) pinnedApps = v.split(",").filter(function (x) { return x.length })
            else if (k === "night") nightLight = v === "1"
            else if (k === "deskIconSize" && v.length) deskIconSize = v
            else if (k === "deskAuto") deskAutoArrange = v !== "0"
            else if (k === "deskGrid") deskAlignGrid = v !== "0"
            else if (k === "deskShow") deskShowIcons = v !== "0"
            else if (k === "deskSort" && v.length) deskSortBy = v
            else if (k === "deskPos" && v.length) {
                var posMap = {}
                var posParts = v.split("|")
                for (var dpi = 0; dpi < posParts.length; ++dpi) {
                    var dp = posParts[dpi]
                    var dg = dp.lastIndexOf(">")
                    if (dg < 1)
                        continue
                    var did = dp.slice(0, dg)
                    var xy = dp.slice(dg + 1).split(",")
                    if (xy.length >= 2)
                        posMap[did] = { x: parseInt(xy[0], 10) || 0, y: parseInt(xy[1], 10) || 0 }
                }
                deskPositions = posMap
            }
            else if (k === "favs" && v.length) {
                var favParts = v.split("|")
                var favOut = []
                for (var fi = 0; fi < favParts.length; ++fi) {
                    var fp = favParts[fi]
                    var fg = fp.indexOf(">")
                    if (fg > 0)
                        favOut.push({ title: fp.slice(0, fg), path: fp.slice(fg + 1) })
                }
                if (favOut.length)
                    fileFavorites = favOut
            }
            else if (k === "bookmarks" && v.length) {
                var bmParts = v.split("|")
                var bmOut = []
                for (var bi = 0; bi < bmParts.length; ++bi) {
                    var bp = bmParts[bi]
                    var bg = bp.indexOf(">")
                    if (bg > 0)
                        bmOut.push({ title: bp.slice(0, bg), url: bp.slice(bg + 1) })
                }
                if (bmOut.length)
                    browserBookmarks = bmOut
            }
            else if (k === "wall") { wallpaperIndex = parseInt(v, 10) || 0; refreshDeskWallpaper() }
            else if (k === "powerMode") powerMode = v || "balanced"
            else if (k === "lidClose") lidCloseAction = v || "lock"
            else if (k === "lockWall") lockWallpaperIndex = parseInt(v, 10) || 1
            else if (k === "desks" && v.length) {
                var dn = v.split("|").filter(function (x) { return x.length })
                if (dn.length)
                    deskNames = dn
            }
            else if (k === "deskIdx")
                deskIndex = Math.max(0, parseInt(v, 10) || 0)
            else if (k === "startup" && v.length) {
                var parts = v.split(",")
                var list = startupApps.slice()
                for (var pi = 0; pi < parts.length; ++pi) {
                    var pair = parts[pi].split(":")
                    if (pair.length < 2) continue
                    for (var li = 0; li < list.length; ++li)
                        if (list[li].id === pair[0])
                            list[li] = {
                                id: list[li].id, name: list[li].name, publisher: list[li].publisher,
                                impact: list[li].impact, enabled: pair[1] === "1", icon: list[li].icon
                            }
                }
                startupApps = list
            } else if (k === "launchLog" && v.length) {
                var map = {}
                var lp = v.split(",")
                for (var lj = 0; lj < lp.length; ++lj) {
                    var pr = lp[lj].split(":")
                    if (pr.length >= 2)
                        map[pr[0]] = parseInt(pr[1], 10) || 0
                }
                appLaunchLog = map
            } else if (k === "backupSchedule") {
                backupSchedule = (v === "daily" || v === "weekly") ? v : "off"
                backupNextHint = backupSchedule === "daily" ? "каждый день в ~03:00"
                             : (backupSchedule === "weekly" ? "каждое воскресенье" : "не задано")
            } else if (k === "backupLastRun") backupLastRun = v
            else if (k === "batterySaver") {
                batterySaver = v === "1"
                if (batterySaver)
                    brightness = Math.min(brightness, 0.55)
            } else if (k === "autoLockMinutes") autoLockMinutes = Math.max(0, parseInt(v, 10) || 0)
            else if (k === "focusHoursOn") focusHoursOn = v === "1"
            else if (k === "focusStartHour") focusStartHour = Math.max(0, Math.min(23, parseInt(v, 10) || 22))
            else if (k === "focusEndHour") focusEndHour = Math.max(0, Math.min(23, parseInt(v, 10) || 8))
            else if (k === "uiScale") {
                var us = parseFloat(v)
                if (us === 1 || us === 1.25 || us === 1.5 || us === 2)
                    uiScale = us
            }
        }
        var scaleFile = sys.readFile("/var/lib/gtos/ui-scale").trim()
        if (scaleFile.length) {
            var sf = parseFloat(scaleFile)
            if (sf === 1 || sf === 1.25 || sf === 1.5 || sf === 2)
                uiScale = sf
        }
        refreshDeskIcons()
        applySystemVolume()
        if (migratedPwd)
            saveDesktop()
    }

    function refreshNetwork(forceIp) {
        // Без ping. IP через shell — только по запросу или если ещё не знаем.
        persistOk = sys.readFile("/var/lib/gtos/persist-ready").trim().length > 0
            || sys.readFile("/proc/mounts").indexOf(" /data ") >= 0
            || sys.readFile("/proc/mounts").indexOf(" /home ") >= 0
        refreshWifiSignal()
        var needIp = forceIp === true || !netIp.length || netIp === "нет адреса" || netIp === "—"
        if (needIp) {
            var ip = ""
            if (typeof sys.runTimeout === "function")
                ip = sys.runTimeout("ip -4 -o addr show scope global 2>/dev/null | awk '{print $4; exit}'", 800).trim()
            else
                ip = sys.run("ip -4 -o addr show scope global 2>/dev/null | awk '{print $4; exit}'").trim()
            if (ip === "таймаут")
                ip = ""
            netIp = ip.length ? ip : "нет адреса"
        }
        if (netIp.length && netIp !== "нет адреса") {
            if (netLink === "wifi")
                netStatus = "Wi‑Fi " + wifiSignal + "% · " + netIp
            else if (netLink === "eth")
                netStatus = "Кабель · " + netIp
            else
                netStatus = "Онлайн · " + netIp
        } else {
            netStatus = "Офлайн — проверьте сетевой кабель или Wi‑Fi"
        }
    }

    function openCtxMenuAt(item, mx, my, items, source) {
