    function openCtxFlyout(kind, itemY) {
        if (!kind || kind.length === 0) {
            ctxFlyout = ""
            return
        }
        ctxFlyout = kind
        ctxFlyoutAnchorY = itemY
    }

    function runCtxAction(action) {
        if (!action || action === "sep")
            return
        if (action === "view" || action === "sort" || action === "create"
                || action === "openwith" || action === "openwithdir" || action === "sendto")
            return
        closeCtxMenu()
        if (action === "open") {
            for (var i = 0; i < fileEntries.length; ++i)
                if (fileEntries[i].name === selectedName) { enterFile(fileEntries[i]); return }
        } else if (action === "archive:open") {
            openArchiveManager(ctxTargetPath)
        } else if (action === "archive:extract") {
            archivePath = ctxTargetPath; archiveExtract()
        } else if (action === "archive:pack") {
            archivePath = ctxTargetPath; openArchiveManager(ctxTargetPath)
        } else if (action === "font:open") {
            openFontManager(ctxTargetPath)
        } else if (action === "refreshfiles") {
            filesRefresh()
        } else if (action === "copy") filesCopySelected()
        else if (action === "cut") filesCutSelected()
        else if (action === "paste") {
            if (ctxMenuSource === "files")
                filesPaste()
            else
                deskPaste()
        }
        else if (action === "del") filesDeleteSelected()
        else if (action === "newdir") filesNew("dir")
        else if (action === "editfile" || action === "editnotesfile") {
            if (ctxTargetPath.length) {
                launch("notes", "Блокнот")
                openNote(ctxTargetPath)
            }
        }
        else if (action === "favpath") {
            if (ctxTargetPath.length)
                toggleFileFavorite(ctxTargetPath, selectedName || ctxTargetPath.slice(ctxTargetPath.lastIndexOf("/") + 1))
        }
        else if (action === "copypathfile") {
            if (ctxTargetPath.length) {
                pushClipboard(ctxTargetPath)
                notify("Буфер обмена", "Путь скопирован", "ok")
            }
        }
        else if (action === "sharefile") {
            if (ctxTargetPath.length) {
                pushClipboard(ctxTargetPath)
                notify("Поделиться", "Путь скопирован — можно вставить куда угодно", "ok")
            }
        }
        else if (action === "shortcutfile") {
            if (ctxTargetPath.length) {
                var sn = selectedName || "ярлык"
                var sp = deskPath() + "/" + sn + ".desktop"
                sys.writeFile(sp, "[Desktop Entry]\nType=Link\nName=" + sn + "\nURL=file://" + ctxTargetPath + "\n")
                refreshDeskIcons()
                notify("Ярлык", "Ярлык создан на рабочем столе", "ok")
            }
        }
        else if (action === "renamefile") {
            if (ctxTargetPath.length)
                openRenameDialog(ctxTargetPath, selectedName)
        }
