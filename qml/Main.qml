                        // hero
                        Item {
                            width: parent.width
                            height: 168
                            Canvas {
                                id: wxHeroIcon
                                anchors.right: parent.right
                                anchors.rightMargin: 22
                                anchors.verticalCenter: parent.verticalCenter
                                width: 96; height: 96
                                onPaint: {
                                    var ctx = getContext("2d")
                                    ctx.reset()
                                    var c = root.weatherCode
                                    if (c === 0 || c <= 3) {
                                        ctx.fillStyle = "#fde047"
                                        ctx.beginPath(); ctx.arc(62, 34, 22, 0, Math.PI * 2); ctx.fill()
                                        ctx.strokeStyle = "#facc15"; ctx.lineWidth = 3; ctx.lineCap = "round"
                                        for (var a = 0; a < 8; ++a) {
                                            var ang = a * Math.PI / 4
                                            ctx.beginPath()
                                            ctx.moveTo(62 + Math.cos(ang) * 28, 34 + Math.sin(ang) * 28)
                                            ctx.lineTo(62 + Math.cos(ang) * 38, 34 + Math.sin(ang) * 38)
                                            ctx.stroke()
                                        }
                                    }
                                    if (c !== 0) {
                                        ctx.fillStyle = "#f8fafc"
                                        ctx.beginPath()
                                        ctx.arc(28, 58, 16, 0, Math.PI * 2)
                                        ctx.arc(48, 50, 20, 0, Math.PI * 2)
                                        ctx.arc(70, 58, 14, 0, Math.PI * 2)
                                        ctx.rect(28, 58, 42, 16)
                                        ctx.fill()
                                    }
                                    if (c >= 51 && c <= 86) {
                                        ctx.strokeStyle = c >= 71 ? "#e2e8f0" : "#38bdf8"
                                        ctx.lineWidth = 2.5
                                        ctx.beginPath()
                                        ctx.moveTo(34, 78); ctx.lineTo(28, 92)
                                        ctx.moveTo(50, 78); ctx.lineTo(44, 92)
                                        ctx.moveTo(66, 78); ctx.lineTo(60, 92)
                                        ctx.stroke()
                                    }
                                }
