    function refreshNetworkDetails() {
        refreshNetwork(true)
        var ip = netIp
        netIfaceDetail = (netLink === "wifi" ? "Wi‑Fi" : (netLink === "eth" ? "Ethernet" : "Нет связи"))
            + (ip && ip !== "нет адреса" ? (" · " + ip) : "")
        if (typeof sys.runTimeout === "function") {
            netGwText = sys.runTimeout("ip route 2>/dev/null | awk '/default/{print $3; exit}'", 800).trim() || "—"
            netDnsText = sys.runTimeout("awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null", 600).trim() || "—"
            var rx = sys.runTimeout("cat /sys/class/net/eth0/statistics/rx_bytes 2>/dev/null", 400).trim()
            var tx = sys.runTimeout("cat /sys/class/net/eth0/statistics/tx_bytes 2>/dev/null", 400).trim()
            netRxKb = Math.max(0, Math.round((parseInt(rx, 10) || 0) / 1024))
            netTxKb = Math.max(0, Math.round((parseInt(tx, 10) || 0) / 1024))
        } else {
            netGwText = "—"; netDnsText = "—"
        }
        var saved = []
        var nets = loadWifiNetworks()
        for (var wi = 0; wi < nets.length; ++wi) {
            if (nets[wi] && nets[wi].ssid)
                saved.push({ name: nets[wi].ssid, kind: "wifi" })
        }
        if (!saved.length) {
            var raw = sys.readFile("/var/lib/gtos/wifi-saved").trim()
            if (raw.length) {
                var lines = raw.split("\n")
                for (var i = 0; i < lines.length; ++i)
                    if (lines[i].trim().length)
                        saved.push({ name: lines[i].trim(), kind: "wifi" })
            }
        }
        if (!saved.length)
            saved.push({ name: "QEMU user NAT (eth0)", kind: "ethernet" })
        netSavedLinks = saved
    }
    function runNetworkDiag() {
        netDiagText = "Проверка…"
        var out = ""
        if (typeof sys.runTimeout === "function") {
            out = sys.runTimeout(
                "echo 'iface:'; ip -br link 2>/dev/null | head -n 6; "
                + "echo 'addr:'; ip -4 -br addr 2>/dev/null | head -n 6; "
                + "echo 'route:'; ip route 2>/dev/null | head -n 4; "
                + "echo 'dns:'; cat /etc/resolv.conf 2>/dev/null | head -n 4",
                2500
            ).trim()
        }
        netDiagText = out.length ? out : "Не удалось собрать диагностику"
        notify("Сеть", "Диагностика обновлена", "wifi")
    }
    function archiveCreate() {
        var src = String(archivePath || "").trim()
        if (!src.length) { notify("Архивы", "Укажите путь", "info"); return }
        var base = src.replace(/\/$/, "")
        var leaf = base.slice(base.lastIndexOf("/") + 1) || "archive"
        var destDir = base.lastIndexOf("/") >= 0 ? base.slice(0, base.lastIndexOf("/")) : "."
        var cmd = ""
        var dest = ""
        if (archiveFormat === "zip") {
            dest = destDir + "/" + leaf + ".zip"
            cmd = "command -v zip >/dev/null && zip -r " + shQuote(dest) + " " + shQuote(src)
                + " || (cd " + shQuote(destDir) + " && tar -cf - " + shQuote(leaf) + " | gzip > " + shQuote(leaf + ".zip") + ")"
        } else if (archiveFormat === "tar") {
            dest = destDir + "/" + leaf + ".tar"
            cmd = "tar -cf " + shQuote(dest) + " -C " + shQuote(destDir) + " " + shQuote(leaf)
        } else if (archiveFormat === "gzip") {
            dest = destDir + "/" + leaf + ".tar.gz"
            cmd = "tar -czf " + shQuote(dest) + " -C " + shQuote(destDir) + " " + shQuote(leaf)
        } else {
            dest = destDir + "/" + leaf + ".7z"
            cmd = "command -v 7z >/dev/null && 7z a " + shQuote(dest) + " " + shQuote(src)
                + " || tar -czf " + shQuote(destDir + "/" + leaf + ".tar.gz") + " -C " + shQuote(destDir) + " " + shQuote(leaf)
        }
        archiveStatus = "Создание…"
        var log = (typeof sys.runTimeout === "function" ? sys.runTimeout(cmd + "; echo EXIT:$?", 8000) : sys.run(cmd + "; echo EXIT:$?")).trim()
        archiveLog = log.slice(-400)
        archiveStatus = "Готово: " + dest
        notify("GT Archive Manager", "Архив создан", "ok")
        if (filesPath === destDir || filesPath === "thispc")
            filesRefresh()
    }
    function archiveExtract() {
        var src = String(archivePath || "").trim()
        if (!src.length) { notify("Архивы", "Укажите архив", "info"); return }
        var destDir = src.lastIndexOf("/") >= 0 ? src.slice(0, src.lastIndexOf("/")) : "."
        var low = src.toLowerCase()
        var cmd = ""
        if (low.indexOf(".zip") > 0)
            cmd = "mkdir -p " + shQuote(destDir) + "; command -v unzip >/dev/null && unzip -o " + shQuote(src) + " -d " + shQuote(destDir)
                + " || tar -xf " + shQuote(src) + " -C " + shQuote(destDir)
        else if (low.indexOf(".7z") > 0)
            cmd = "command -v 7z >/dev/null && 7z x -y -o" + shQuote(destDir) + " " + shQuote(src)
                + " || tar -xf " + shQuote(src) + " -C " + shQuote(destDir)
        else
            cmd = "tar -xf " + shQuote(src) + " -C " + shQuote(destDir)
        archiveStatus = "Распаковка…"
        var log = (typeof sys.runTimeout === "function" ? sys.runTimeout(cmd + "; echo EXIT:$?", 8000) : sys.run(cmd + "; echo EXIT:$?")).trim()
        archiveLog = log.slice(-400)
        archiveStatus = "Распаковано в " + destDir
        notify("GT Archive Manager", "Архив распакован", "ok")
        loadFiles(destDir)
    }
