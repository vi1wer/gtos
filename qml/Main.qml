    function refreshBattery() {
        // Без shell: прямой readFile — иначе таймер панели убивает UI
        var cap = sys.readFile("/sys/class/power_supply/BAT0/capacity").trim()
        if (!cap.length)
            cap = sys.readFile("/sys/class/power_supply/BAT1/capacity").trim()
        var n = parseInt(cap, 10)
        if (isNaN(n) || !cap.length) {
            batteryPresent = false
            batteryPct = -1
            batteryCharging = false
            return
        }
        batteryPresent = true
        batteryPct = Math.max(0, Math.min(100, n))
        var st = sys.readFile("/sys/class/power_supply/BAT0/status").trim()
        if (!st.length)
            st = sys.readFile("/sys/class/power_supply/BAT1/status").trim()
        batteryCharging = (st === "Charging" || st === "Full" || st === "Not charging")
    }

    function refreshWifiSignal() {
        // Только /proc и /sys — без iw/awk через shell на каждом тике
        var raw = sys.readFile("/proc/net/wireless")
        if (raw.length) {
            var lines = raw.split("\n")
            for (var i = 0; i < lines.length; ++i) {
                if (i < 2)
                    continue
                var line = lines[i].replace(/\./g, " ").replace(/:/g, " ").trim()
                if (!line.length)
                    continue
                var parts = line.split(/\s+/).filter(function (x) { return x.length })
                var q = parts.length >= 3 ? parseInt(parts[2], 10) : NaN
                if (!isNaN(q)) {
                    wifiSignal = Math.max(0, Math.min(100, Math.round(q * 100 / 70)))
                    netLink = "wifi"
                    return
                }
            }
        }
        var eth = sys.readFile("/sys/class/net/eth0/operstate").trim()
        if (!eth.length)
            eth = sys.readFile("/sys/class/net/enp0s3/operstate").trim()
        var hasIp = netIp.length && netIp !== "—" && netIp !== "нет адреса"
        if (eth === "up" || hasIp) {
            netLink = "eth"
            wifiSignal = 100
        } else {
            netLink = "none"
            wifiSignal = -1
        }
    }

    function shellQuote(s) {
        return "'" + String(s).replace(/'/g, "'\\''") + "'"
    }

    function wifiIfaceName() {
        var iface = sys.run("cat /var/lib/gtos/wifi-iface 2>/dev/null").trim()
        if (!iface.length)
            iface = sys.run("ls /sys/class/net 2>/dev/null | awk '/^wl/{print; exit}'").trim()
        wifiIface = iface
        return iface
    }

    function scanWifiNetworks() {
        var iface = wifiIfaceName()
        wifiPassSsid = ""
        wifiPass = ""
        if (!iface.length) {
            wifiNets = []
            wifiOn = false
            wifiScanMsg = "Адаптер Wi‑Fi не найден"
            return
        }
        var oper = sys.run("cat /sys/class/net/" + iface + "/operstate 2>/dev/null").trim()
        wifiOn = oper !== "down"
        if (!wifiOn) {
            wifiNets = []
            wifiScanMsg = "Wi‑Fi выключен"
            return
        }
        wifiScanMsg = "Поиск сетей…"
        var cur = sys.run("iwconfig " + iface + " 2>/dev/null | awk -F'\"' '/ESSID/{print $2; exit}'").trim()
        wifiSsid = cur
        var raw = sys.run("iwlist " + iface + " scan 2>/dev/null")
        var nets = []
        var seen = {}
        var ssid = ""
        var lock = false
        var qual = 0
        var have = false
        function pushNet() {
            if (!have || !ssid.length || seen[ssid])
                return
            seen[ssid] = true
            nets.push({ ssid: ssid, lock: lock, qual: qual, on: ssid === cur && cur.length > 0 })
        }
        var lines = raw.split("\n")
        for (var i = 0; i < lines.length; ++i) {
            var line = lines[i]
            if (line.indexOf("Cell ") >= 0) {
                pushNet()
                ssid = ""
                lock = false
                qual = 0
                have = true
            }
            var eq = line.indexOf("ESSID:")
            if (eq >= 0) {
                var q1 = line.indexOf("\"", eq)
                var q2 = line.lastIndexOf("\"")
                if (q1 >= 0 && q2 > q1)
                    ssid = line.substring(q1 + 1, q2)
            }
            if (line.indexOf("Encryption key:on") >= 0)
                lock = true
            if (line.indexOf("Encryption key:off") >= 0)
                lock = false
            var qi = line.indexOf("Quality=")
            if (qi >= 0) {
                var rest = line.substring(qi + 8)
                var sl = rest.split("/")
                var a = parseInt(sl[0], 10)
                var b = parseInt((sl[1] || "").split(" ")[0], 10)
                if (!isNaN(a) && !isNaN(b) && b > 0)
                    qual = Math.max(0, Math.min(100, Math.round(a * 100 / b)))
            }
        }
        pushNet()
        nets.sort(function (a, b) { return (b.on ? 1 : 0) - (a.on ? 1 : 0) || b.qual - a.qual })
        wifiNets = nets
        wifiScanMsg = nets.length ? "" : "Сети не найдены"
    }

    function setWifiEnabled(on) {
        var iface = wifiIfaceName()
        if (!iface.length) {
            notify("Wi‑Fi", "Адаптер не найден", "info")
            wifiOn = false
            return
        }
        sys.run("ip link set " + iface + (on ? " up" : " down") + " 2>/dev/null")
        wifiOn = on
        if (on)
            scanWifiNetworks()
        else {
            wifiNets = []
            wifiScanMsg = "Wi‑Fi выключен"
        }
    }

    function saveWifiNetwork(ssid, pass) {
        ssid = String(ssid || "").trim()
        if (!ssid.length)
            return
        sys.run("mkdir -p /var/lib/gtos")
        var list = []
        var raw = sys.readFile("/var/lib/gtos/wifi-networks.json").trim()
        if (raw.length) {
            try {
                var parsed = JSON.parse(raw)
                if (Array.isArray(parsed))
                    list = parsed
            } catch (e) { list = [] }
        }
        var out = []
        out.push({ ssid: ssid, pass: String(pass || ""), last: Date.now() })
        for (var i = 0; i < list.length; ++i) {
            if (!list[i] || list[i].ssid === ssid)
                continue
            out.push(list[i])
        }
        if (out.length > 12)
            out = out.slice(0, 12)
        sys.writeFile("/var/lib/gtos/wifi-networks.json", JSON.stringify(out))
        // плоский список для UI «сохранённые»
        var names = []
        for (var j = 0; j < out.length; ++j)
            names.push(out[j].ssid)
        sys.writeFile("/var/lib/gtos/wifi-saved", names.join("\n") + (names.length ? "\n" : ""))
    }

    function loadWifiNetworks() {
        var raw = sys.readFile("/var/lib/gtos/wifi-networks.json").trim()
        if (!raw.length)
            return []
        try {
            var parsed = JSON.parse(raw)
            return Array.isArray(parsed) ? parsed : []
        } catch (e) {
            return []
        }
    }

    function writePersistentWpa(ssid, pass) {
        sys.run("mkdir -p /var/lib/gtos")
        if (pass && pass.length) {
            sys.run("wpa_passphrase " + shellQuote(ssid) + " " + shellQuote(pass)
                    + " > /var/lib/gtos/wpa_supplicant.conf 2>/tmp/wpa-gen.log")
        } else {
            sys.writeFile("/var/lib/gtos/wpa_supplicant.conf",
                "ctrl_interface=/var/run/wpa_supplicant\nnetwork={\n"
                + "\tssid=\"" + String(ssid).replace(/"/g, "\\\"") + "\"\n"
                + "\tkey_mgmt=NONE\n}\n")
        }
        // зеркало для сессии
        sys.run("cp -f /var/lib/gtos/wpa_supplicant.conf /tmp/gtos-wpa.conf 2>/dev/null || true")
    }

    function connectWifi(ssid, pass) {
        var iface = wifiIfaceName()
        if (!iface.length || !ssid.length)
            return
        wifiScanMsg = "Подключение к «" + ssid + "»…"
        var q = shellQuote(ssid)
        saveWifiNetwork(ssid, pass || "")
        writePersistentWpa(ssid, pass || "")
        if (pass && pass.length) {
            sys.run("killall wpa_supplicant 2>/dev/null; ip link set " + iface + " up"
                    + "; wpa_supplicant -B -i " + iface + " -c /var/lib/gtos/wpa_supplicant.conf >/tmp/wpa.log 2>&1"
                    + "; sleep 2; udhcpc -i " + iface + " -n -q -t 5 >/tmp/dhcp-wifi.log 2>&1")
        } else {
            sys.run("killall wpa_supplicant 2>/dev/null; ip link set " + iface + " up"
                    + "; iwconfig " + iface + " essid " + q + " 2>/dev/null"
                    + "; udhcpc -i " + iface + " -n -q -t 5 >/tmp/dhcp-wifi.log 2>&1")
        }
        refreshNetwork()
        scanWifiNetworks()
        refreshNetworkDetails()
        notify("Сеть", wifiSsid.length ? ("Подключено к «" + wifiSsid + "» · сеть сохранена") : netStatus, "wifi")
    }

    function autoConnectWifi() {
        var list = loadWifiNetworks()
        if (!list.length)
            return
        var iface = wifiIfaceName()
        if (!iface.length)
            return
        // уже есть адрес — не трогаем
        if (netIp.length && netIp !== "нет адреса" && netIp !== "—")
            return
        if (sys.run("test -f /var/lib/gtos/wpa_supplicant.conf && echo yes").trim() === "yes") {
            sys.run("killall wpa_supplicant 2>/dev/null; ip link set " + iface + " up"
                    + "; wpa_supplicant -B -i " + iface + " -c /var/lib/gtos/wpa_supplicant.conf >/tmp/wpa-auto.log 2>&1"
                    + "; sleep 2; udhcpc -i " + iface + " -n -q -t 4 >/tmp/dhcp-wifi-auto.log 2>&1")
            refreshNetwork()
            return
        }
        var n = list[0]
        if (n && n.ssid)
            connectWifi(n.ssid, n.pass || "")
    }

    function windowDesk(i) {
        var d = windows.get(i).desk
        if (d === undefined || d === null || d === "")
            return 0
        return Math.max(0, parseInt(d, 10) || 0)
    }

    function deskWindowCount(di) {
        var n = 0
        for (var i = 0; i < windows.count; ++i) {
            if (windowDesk(i) === di)
                n++
        }
        return n
    }

    function applyDesktopVisibility() {
        showDesktopActive = false
        for (var i = 0; i < windows.count; ++i)
            windows.setProperty(i, "hidden", windowDesk(i) !== deskIndex)
        refreshDeskIcons()
    }

    function addWorkspace() {
        if (deskNames.length >= 8) {
            notify("Рабочие пространства", "Достигнут лимит из 8 столов", "info")
            return
        }
        var names = deskNames.slice()
        names.push("Стол " + (names.length + 1))
        deskNames = names
        switchDesktop(deskNames.length - 1)
        saveDesktop()
    }

    function renameWorkspace(di, name) {
        if (di < 0 || di >= deskNames.length)
            return
        var n = String(name || "").trim()
        if (!n.length)
            return
        var names = deskNames.slice()
        names[di] = n
        deskNames = names
        saveDesktop()
    }

    function removeWorkspace(di) {
        if (deskNames.length <= 1) {
            notify("Рабочие пространства", "Нельзя удалить единственный стол", "info")
            return
        }
        if (di < 0 || di >= deskNames.length)
            return
        var fallback = di > 0 ? di - 1 : 0
        for (var i = 0; i < windows.count; ++i) {
            var d = windowDesk(i)
            if (d === di)
                windows.setProperty(i, "desk", fallback)
            else if (d > di)
                windows.setProperty(i, "desk", d - 1)
        }
        var names = deskNames.slice()
        names.splice(di, 1)
        deskNames = names
        if (deskIndex >= deskNames.length)
            deskIndex = deskNames.length - 1
        else if (deskIndex > di)
            deskIndex = deskIndex - 1
        else if (deskIndex === di)
            deskIndex = Math.min(di, deskNames.length - 1)
        applyDesktopVisibility()
        saveDesktop()
        notify("Рабочие пространства", "Стол удалён", "ok")
    }

    function moveActiveToDesktop(di) {
        if (di < 0 || di >= deskNames.length)
            return
        var idx = activeWindowIndex()
        if (idx < 0) {
            notify("Рабочие пространства", "Нет активного окна", "info")
            return
        }
        windows.setProperty(idx, "desk", di)
        windows.setProperty(idx, "hidden", di !== deskIndex)
        notify("Рабочие пространства", "Окно → «" + deskNames[di] + "»", "ok")
        saveDesktop()
    }

