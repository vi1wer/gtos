            width: 18; height: 18
            Canvas {
                anchors.fill: parent
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    ctx.strokeStyle = qg.stroke
                    ctx.fillStyle = qg.stroke
                    ctx.lineWidth = 1.7
                    ctx.lineCap = "round"
                    ctx.lineJoin = "round"
                    var n = qg.name
                    function S(fn) { ctx.beginPath(); fn(); ctx.stroke() }
                    if (n === "wifi") {
                        S(function () {
                            ctx.arc(9, 14, 1.2, 0, Math.PI * 2)
                            ctx.moveTo(4.5, 11); ctx.arc(9, 14, 5.2, -2.4, -0.74, false)
                            ctx.moveTo(2.2, 8.2); ctx.arc(9, 14, 8.4, -2.45, -0.69, false)
                        })
                        ctx.beginPath(); ctx.arc(9, 14, 1.2, 0, Math.PI * 2); ctx.fill()
                    } else if (n === "bt") {
                        S(function () {
                            ctx.moveTo(7, 3); ctx.lineTo(12, 8); ctx.lineTo(7, 13); ctx.lineTo(7, 3)
                            ctx.moveTo(7, 13); ctx.lineTo(12, 8); ctx.lineTo(7, 3)
                            ctx.moveTo(4, 6); ctx.lineTo(7, 8.5); ctx.moveTo(4, 12); ctx.lineTo(7, 9.5)
                        })
                    } else if (n === "dnd") {
                        S(function () {
                            ctx.arc(9, 8, 5.2, 0, Math.PI * 2)
                            ctx.moveTo(5.2, 8); ctx.lineTo(12.8, 8)
                        })
                    } else if (n === "night") {
                        S(function () {
                            ctx.arc(10, 9, 5.5, 0.55, 5.2, false)
                            ctx.quadraticCurveTo(6, 4, 10, 3.2)
                        })
                    } else if (n === "vol") {
                        S(function () {
                            ctx.moveTo(2, 6); ctx.lineTo(5, 6); ctx.lineTo(9, 3); ctx.lineTo(9, 15); ctx.lineTo(5, 12); ctx.lineTo(2, 12); ctx.closePath()
                            ctx.moveTo(12, 6.5); ctx.arc(9, 9, 4.2, -0.7, 0.7, false)
                            ctx.moveTo(14.2, 4.8); ctx.arc(9, 9, 6.5, -0.85, 0.85, false)
                        })
                    } else if (n === "sun") {
                        S(function () {
                            ctx.arc(9, 9, 3.2, 0, Math.PI * 2)
                            for (var i = 0; i < 8; ++i) {
                                var a = i * Math.PI / 4
                                ctx.moveTo(9 + Math.cos(a) * 5.2, 9 + Math.sin(a) * 5.2)
                                ctx.lineTo(9 + Math.cos(a) * 7.4, 9 + Math.sin(a) * 7.4)
                            }
                        })
                    } else if (n === "back") {
                        S(function () { ctx.moveTo(11, 3); ctx.lineTo(5, 9); ctx.lineTo(11, 15) })
                    } else if (n === "lock") {
                        S(function () {
                            ctx.rect(4, 8, 10, 8)
                            ctx.moveTo(6, 8); ctx.lineTo(6, 6); ctx.arc(9, 6, 3, Math.PI, 0, false); ctx.lineTo(12, 8)
                        })
                    } else if (n === "clip") {
                        S(function () {
                            ctx.rect(5, 4, 8, 11)
