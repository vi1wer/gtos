    function snapWindow(winObj, index) {
        if (tileMode === "float")
            return
        var cx = winObj.x + winObj.width / 2
        var cy = winObj.y + 20
        var top = 46
        var usableH = root.height - top - (dockEdge === "bottom" ? dockSize + 24 : 8)
        var usableW = root.width
        if (tileMode === "tile") {
            var n = 0
            for (var i = 0; i < windows.count; ++i)
                if (!windows.get(i).hidden && !windows.get(i).maxed)
                    n++
            if (n < 1) n = 1
            var col = index % Math.min(n, 3)
            var cols = Math.min(n, 3)
            var w = usableW / cols
            winObj.x = col * w
            winObj.y = top
            winObj.width = w
            winObj.height = usableH
            windows.setProperty(index, "w", w)
            windows.setProperty(index, "h", usableH)
            windows.setProperty(index, "maxed", false)
            return
        }
        // snap
        if (winObj.x < 24) {
            winObj.x = 0
            winObj.y = top
            winObj.width = usableW / 2
            winObj.height = usableH
            windows.setProperty(index, "w", usableW / 2)
            windows.setProperty(index, "h", usableH)
        } else if (winObj.x + winObj.width > root.width - 24) {
            winObj.x = usableW / 2
            winObj.y = top
            winObj.width = usableW / 2
            winObj.height = usableH
            windows.setProperty(index, "w", usableW / 2)
            windows.setProperty(index, "h", usableH)
        } else if (cy < top + 12) {
            windows.setProperty(index, "maxed", true)
        }
    }

