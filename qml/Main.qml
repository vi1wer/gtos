    readonly property var months: ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]

    readonly property var weekdaysShort: ["вс", "пн", "вт", "ср", "чт", "пт", "сб"]
    readonly property var monthsShort: ["янв", "фев", "мар", "апр", "мая", "июн", "июл", "авг", "сен", "окт", "ноя", "дек"]

    function dateLine() {
        return now.getDate() + " " + months[now.getMonth()] + "  " + now.getFullYear() + " года"
    }

    function clockCaption() {
        return weekdaysShort[now.getDay()] + " " + now.getDate() + " " + monthsShort[now.getMonth()]
    }

    function matches(name) {
        return query.length === 0 || name.toLowerCase().indexOf(query.toLowerCase()) !== -1
    }

    property var recent: []

    function fileKind(path) {
        var n = path.toLowerCase()
        if (n.endsWith(".jpg") || n.endsWith(".jpeg") || n.endsWith(".png") || n.endsWith(".webp"))
            return "image"
        if (n.endsWith(".sh") || n.endsWith(".conf"))
            return "note"
        return "doc"
    }

    function whenText(epoch) {
        var d = new Date(epoch * 1000)
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
        var that = new Date(d.getFullYear(), d.getMonth(), d.getDate())
        var diff = Math.round((today.getTime() - that.getTime()) / 86400000)
        var hm = Qt.formatTime(d, "HH:mm")
        if (diff === 0)
            return "Сегодня, " + hm
        if (diff === 1)
            return "Вчера, " + hm
        return d.getDate() + " " + months[d.getMonth()] + ", " + hm
    }

    function loadRecent() {
        var raw = sys.run("find /usr/share/gtos /etc /root -type f ! -name '*.qmlc' ! -name '*.jsc' ! -name '.*' ! -path '*/.*/*' ! -path '*/cache/*' 2>/dev/null | head -n 80 | while read -r f; do stat -c '%Y %n' \"$f\"; done | sort -nr | head -n 3")
        var lines = raw.split("\n")
        var items = []
        for (var i = 0; i < lines.length; ++i) {
            var line = lines[i].trim()
            var sp = line.indexOf(" ")
            if (sp < 1)
                continue
            var epoch = parseInt(line.slice(0, sp), 10)
            var path = line.slice(sp + 1)
            if (!path.length || isNaN(epoch))
                continue
            var name = path.slice(path.lastIndexOf("/") + 1)
            var kind = fileKind(path)
            var group = kind === "image" ? "Изображения" : "Документы"
            items.push({ name: name, path: path, kind: kind, meta: group + "  ·  " + whenText(epoch) })
        }
        recent = items
    }

    function openRecent(path) {
        var slash = path.lastIndexOf("/")
        cwd = slash <= 0 ? "/" : path.slice(0, slash)
        fileView = sys.readFile(path)
        launch("files", "Файлы")
    }

    function openSettingsSection(sec) {
        settingsSection = sec || "home"
        if (sec === "updates")
            updateStatus = "GT/OS " + osVersion + " · " + updateStatus
        launch("settings", "Параметры")
        // Тяжёлые опросы — после открытия окна, иначе весь UI встаёт
        if (sec === "storage")
            settingsHeavySoon.kind = "storage"
        else if (sec === "about")
            settingsHeavySoon.kind = "about"
        else if (sec === "security")
            settingsHeavySoon.kind = "security"
        else if (sec === "power")
            settingsHeavySoon.kind = "power"
        else
            settingsHeavySoon.kind = ""
        if (settingsHeavySoon.kind.length)
            settingsHeavySoon.restart()
    }

    function openControlTab(tab) {
        controlTab = tab || "devices"
        launch("control", "Контрольный центр")
        if (tab === "recovery")
            recoveryRefreshSoon.restart()
        else
            controlRefreshSoon.restart()
    }

    property string _settingsHeavyKind: ""
    Timer {
        id: settingsHeavySoon
        property string kind: ""
        interval: 80
        repeat: false
        onTriggered: {
            if (kind === "storage")
                root.refreshStorageMap()
            else if (kind === "about")
                root.refreshAboutInfo(true)
            else if (kind === "security")
                root.refreshSecurityAudit()
            else if (kind === "power")
                root.refreshPowerInfo()
            kind = ""
        }
    }

    function launch(appId, title) {
        startOpen = false
        if (appId === "trash") {
            launch("files", "Файлы")
            loadFiles(trashDir())
            return
        }
        // Обновления / Storage / Приватность живут внутри Параметров
        if (appId === "updates") { openSettingsSection("updates"); return }
        if (appId === "storage") { openSettingsSection("storage"); return }
        if (appId === "privacy") { openSettingsSection("privacy"); return }
        if (appId === "security") { openSettingsSection("security"); return }
        if (appId === "power") { openSettingsSection("power"); return }
        if (appId === "recovery") { openControlTab("recovery"); return }
        for (var i = 0; i < windows.count; ++i) {
            if (windows.get(i).appId === appId) {
                windows.setProperty(i, "desk", deskIndex)
                windows.setProperty(i, "hidden", false)
                windows.setProperty(i, "z", ++zseq)
                showDesktopActive = false
                if (appId === "settings" && title === "Параметры")
                    windows.setProperty(i, "z", zseq)
                if (appId === "control")
                    controlRefreshSoon.restart()
                if (appId === "recovery")
                    recoveryRefreshSoon.restart()
                return
            }
        }
        var ww = 720, hh = 480
        if (appId === "files") { ww = 1120; hh = 720 }
        else if (appId === "settings") { ww = 1180; hh = 760 }
        else if (appId === "store") { ww = 1120; hh = 720 }
        else if (appId === "notes") { ww = 860; hh = 580 }
        else if (appId === "photos") {
            ww = 1100; hh = 740
            refreshPhotosLibrary()
            if (!viewerPath.length)
                photosMode = "library"
        }
        else if (appId === "weather") {
            ww = 920; hh = 640
            loadWeatherCities()
            refreshWeather()
        }
        else if (appId === "docs") {
            ww = 980; hh = 720
            if (docsPath.length)
                renderDocsPage()
        }
        else if (appId === "monitor") { ww = 1080; hh = 720 }
        else if (appId === "control") { ww = 1180; hh = 760 }
        else if (appId === "recovery") { ww = 980; hh = 640 }
        else if (appId === "power") { ww = 980; hh = 640 }
        else if (appId === "archive") { ww = 860; hh = 520 }
        else if (appId === "fonts") { ww = 920; hh = 560 }
        else if (appId === "term") { ww = 920; hh = 560 }
        else if (appId === "browser") { ww = 980; hh = 640 }
        else if (appId === "mail") { ww = 820; hh = 560 }
        else if (appId === "calc") { ww = 340; hh = 460 }
        else if (appId === "cal") { ww = 720; hh = 560 }
        else if (appId === "draw") { ww = 900; hh = 600 }
        else if (appId === "music") { ww = 980; hh = 640 }
        else if (appId === "video") { ww = 720; hh = 420 }
        else if (appId === "install") { ww = 960; hh = 640 }
        windows.append({
            appId: appId,
            title: title,
            wx: 280 + windows.count * 28,
            wy: 72 + windows.count * 24,
            z: ++zseq,
            w: ww,
            h: hh,
            maxed: false,
            hidden: false,
            desk: deskIndex,
            rw: 0,
            rh: 0,
            rx: 0,
            ry: 0
        })
        if (appId === "music")
            scanMusicLibrary()
        if (appId === "files") {
            fileBack = []
            fileFwd = []
            fileTabs = [{ title: "Главная", path: "/home/" + currentUser }]
            fileTab = 0
            loadFiles("/home/" + currentUser)
        }
        if (appId === "notes") {
            if (!noteTabs.length)
                openNote(notePath)
            else {
                notePath = noteTabs[noteTabIndex].path
                noteText = noteTabs[noteTabIndex].text
            }
        }
        trackAppLaunch(appId)
        if (appId === "monitor")
            Qt.callLater(function () { root.refreshTaskMgr() })
        if (appId === "control")
            controlRefreshSoon.restart()
        if (appId === "recovery")
            recoveryRefreshSoon.restart()
        if (appId === "browser")
            browserBody = "<p>Введите адрес сайта и нажмите <b>Открыть</b>. Страница откроется как обычный текст с разметкой.</p>"
        if (appId === "mail" && !mailBody.length)
            mailBody = "Здравствуйте,\n\n"
        if (appId === "install")
            Qt.callLater(function () { root.refreshInstallDisks() })
