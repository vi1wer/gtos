    function noteBaseName(path) {
        if (!path || !path.length)
            return "Текстовый документ"
        var i = path.lastIndexOf("/")
        return i >= 0 ? path.slice(i + 1) : path
    }

    function syncNoteTabFromEditor() {
        if (!noteTabs.length || noteTabIndex < 0 || noteTabIndex >= noteTabs.length)
            return
        var tabs = noteTabs.slice()
        var t = tabs[noteTabIndex]
        tabs[noteTabIndex] = {
            id: t.id, title: noteBaseName(notePath), path: notePath,
            text: noteText, dirty: t.dirty === true || false
        }
        noteTabs = tabs
    }

    function markNoteDirty() {
        if (!noteTabs.length || noteTabIndex < 0 || noteTabIndex >= noteTabs.length)
            return
        var tabs = noteTabs.slice()
        var t = tabs[noteTabIndex]
        if (t.dirty)
            return
        tabs[noteTabIndex] = {
            id: t.id, title: t.title, path: t.path, text: noteText, dirty: true
        }
        noteTabs = tabs
    }

    function openNote(path) {
        var p = path && path.length ? path : ("/home/" + currentUser + "/Документы/заметка.txt")
        var body = sys.readFile(p)
        if (!body.length)
            body = ""
        // reuse existing tab with same path
        for (var i = 0; i < noteTabs.length; ++i) {
            if (noteTabs[i].path === p) {
                syncNoteTabFromEditor()
                noteTabIndex = i
                notePath = noteTabs[i].path
                noteText = noteTabs[i].text
                return
            }
        }
        syncNoteTabFromEditor()
        var tabs = noteTabs.slice()
        tabs.push({
            id: noteSeq++,
            title: noteBaseName(p),
            path: p,
            text: body,
            dirty: false
        })
        noteTabs = tabs
        noteTabIndex = tabs.length - 1
        notePath = p
        noteText = body
    }

    function newNoteTab() {
        syncNoteTabFromEditor()
        var p = "/home/" + currentUser + "/Документы/документ_" + noteSeq + ".txt"
        var tabs = noteTabs.slice()
        tabs.push({
            id: noteSeq++,
            title: "Текстовый документ",
            path: p,
            text: "",
            dirty: true
        })
        noteTabs = tabs
        noteTabIndex = tabs.length - 1
        notePath = p
        noteText = ""
    }

    function switchNoteTab(idx) {
        if (idx < 0 || idx >= noteTabs.length || idx === noteTabIndex)
            return
        syncNoteTabFromEditor()
        noteTabIndex = idx
        notePath = noteTabs[idx].path
        noteText = noteTabs[idx].text
    }

    function closeNoteTab(idx) {
        if (idx < 0 || idx >= noteTabs.length)
            return
        if (noteTabs.length === 1) {
            noteTabs = []
            noteTabIndex = 0
            notePath = "/home/" + currentUser + "/Документы/заметка.txt"
            noteText = ""
            newNoteTab()
            return
        }
        var tabs = noteTabs.slice()
        tabs.splice(idx, 1)
        noteTabs = tabs
        if (noteTabIndex >= tabs.length)
            noteTabIndex = tabs.length - 1
        else if (idx < noteTabIndex)
            noteTabIndex = noteTabIndex - 1
        notePath = noteTabs[noteTabIndex].path
        noteText = noteTabs[noteTabIndex].text
    }

    function saveNote() {
        if (!notePath.length)
            notePath = "/home/" + currentUser + "/Документы/заметка.txt"
        if (sys.writeFile(notePath, noteText)) {
            var tabs = noteTabs.slice()
            if (noteTabIndex >= 0 && noteTabIndex < tabs.length) {
                var t = tabs[noteTabIndex]
                tabs[noteTabIndex] = {
                    id: t.id, title: noteBaseName(notePath), path: notePath,
                    text: noteText, dirty: false
                }
                noteTabs = tabs
            }
            notify("Блокнот", "Сохранено: " + noteBaseName(notePath), "ok")
        } else {
            notify("Блокнот", "Не удалось сохранить", "info")
        }
    }

    function saveNoteAs() {
        var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd_HHmm")
        notePath = "/home/" + currentUser + "/Документы/документ_" + stamp + ".txt"
        saveNote()
    }

