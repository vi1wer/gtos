                                rowSpacing: 14
                                columnSpacing: 8
                                Repeater {
                                    model: root.frequentLauncherApps()
                                    delegate: Item {
                                        width: (rightCol.width - 24) / 4
                                        height: 96
                                        scale: freqH.containsMouse ? 1.06 : 1
                                        Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                                        Column {
                                            anchors.horizontalCenter: parent.horizontalCenter
                                            spacing: 8
                                            DeskIconArt {
                                                width: 44; height: 44
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                kind: modelData.kind
                                                appId: modelData.id || ""
                                            }
                                            Text {
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                width: parent.parent.width - 8
                                                horizontalAlignment: Text.AlignHCenter
                                                text: modelData.name
                                                color: freqH.containsMouse ? "#ffffff" : "#d5dde3"
                                                font.pixelSize: 11
                                                font.family: root.uiFont
                                                elide: Text.ElideRight
                                            }
                                        }
                                        MouseArea {
                                            id: freqH; anchors.fill: parent; hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: root.launchFromStart(modelData)
                                        }
                                        Rectangle {
                                            visible: freqH.containsMouse
                                            anchors.fill: parent
                                            anchors.margins: 2
                                            radius: 12
                                            color: Qt.rgba(0.23, 0.88, 0.51, 0.14)
                                            z: -1
                                        }
                                    }
                                }
                            }

                            Text {
                                topPadding: 6
                                text: "Недавно установленное"
                                color: "#ffffff"
                                font.pixelSize: 15
                                font.family: root.uiFontBold
                            }
                            Grid {
                                width: parent.width
                                columns: 4
                                rowSpacing: 14
                                columnSpacing: 8
                                Repeater {
                                    model: root.recentInstalledApps()
                                    delegate: Item {
                                        width: (rightCol.width - 24) / 4
                                        height: 96
                                        Column {
                                            anchors.horizontalCenter: parent.horizontalCenter
                                            spacing: 8
                                            DeskIconArt {
                                                width: 44; height: 44
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                kind: modelData.kind
                                                appId: modelData.id || ""
                                            }
                                            Text {
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                width: parent.parent.width - 8
                                                horizontalAlignment: Text.AlignHCenter
                                                text: modelData.name
                                                color: "#e8eef2"
                                                font.pixelSize: 11
                                                font.family: root.uiFont
                                                elide: Text.ElideRight
                                            }
                                        }
                                        MouseArea {
                                            anchors.fill: parent
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: root.launchFromStart(modelData)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // низ: питание · поиск · развернуть (только Rectangle, без Canvas/эмодзи)
            Item {
                width: parent.width
                height: 48
                z: 5
                // питание
                Item {
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    width: 40; height: 40
                    Rectangle {
                        anchors.fill: parent
                        radius: 12
                        color: launcher.powerMenu || powH.containsMouse ? "#7f1d1d" : "#1a2420"
                        border.width: 1
                        border.color: launcher.powerMenu || powH.containsMouse ? "#fecaca66" : "#2a3a34"
                        Behavior on color { ColorAnimation { duration: 120 } }
                        // иконка питания из фигур
                        Item {
                            anchors.centerIn: parent
                            width: 16; height: 16
                            readonly property color ink: launcher.powerMenu || powH.containsMouse ? "#fecaca" : "#e8eef2"
                            Rectangle {
                                anchors.horizontalCenter: parent.horizontalCenter
                                anchors.bottom: parent.bottom
                                width: 14; height: 14; radius: 7
                                color: "transparent"
                                border.width: 2
                                border.color: parent.ink
                            }
                            Rectangle {
                                anchors.horizontalCenter: parent.horizontalCenter
                                y: 0
                                width: 2; height: 7; radius: 1
                                color: parent.ink
                            }
                        }
                        MouseArea {
                            id: powH; anchors.fill: parent; hoverEnabled: true
                            onClicked: launcher.powerMenu = !launcher.powerMenu
                        }
                    }
                    Rectangle {
                        visible: launcher.powerMenu
                        anchors.bottom: parent.top
                        anchors.bottomMargin: 8
                        anchors.left: parent.left
                        width: 180; height: 92; radius: 12; z: 20
                        color: "#121a18"; border.color: "#2a3a34"; border.width: 1
                        Column {
                            anchors.fill: parent; anchors.margins: 6; spacing: 4
                            Rectangle {
                                width: parent.width; height: 36; radius: 8
                                color: pReb.containsMouse ? "#3be18222" : "transparent"
                                Text { anchors.left: parent.left; anchors.leftMargin: 12; anchors.verticalCenter: parent.verticalCenter; text: "Перезагрузка"; color: "#e8eef2"; font.pixelSize: 13; font.family: root.uiFont }
                                MouseArea { id: pReb; anchors.fill: parent; hoverEnabled: true; onClicked: { launcher.powerMenu = false; root.startOpen = false; root.powerAction("reboot") } }
                            }
                            Rectangle {
                                width: parent.width; height: 36; radius: 8
                                color: pOff.containsMouse ? "#7f1d1d" : "transparent"
                                Text { anchors.left: parent.left; anchors.leftMargin: 12; anchors.verticalCenter: parent.verticalCenter; text: "Выключить"; color: "#fecaca"; font.pixelSize: 13; font.family: root.uiFont }
                                MouseArea { id: pOff; anchors.fill: parent; hoverEnabled: true; onClicked: { launcher.powerMenu = false; root.startOpen = false; root.powerAction("off") } }
                            }
                        }
                    }
                }

                // поиск по центру
                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.verticalCenter: parent.verticalCenter
                    width: Math.min(420, parent.width - 160)
                    height: 40
                    radius: 20
                    color: "#0c1412"
                    border.width: 1
                    border.color: search.activeFocus ? root.accentColor : "#2a3a34"
                    Item {
                        anchors.left: parent.left; anchors.leftMargin: 14
                        anchors.verticalCenter: parent.verticalCenter
                        width: 14; height: 14
                        Rectangle {
                            x: 0; y: 0; width: 9; height: 9; radius: 4.5
                            color: "transparent"; border.width: 1.5; border.color: "#8b98a3"
                        }
                        Rectangle {
                            x: 8; y: 8; width: 5; height: 1.5; radius: 1
                            rotation: 45; color: "#8b98a3"
                        }
                    }
                    TextInput {
                        id: search
                        anchors.fill: parent
                        anchors.leftMargin: 38
                        anchors.rightMargin: 14
                        verticalAlignment: Text.AlignVCenter
                        color: "#f4f7f8"
                        font.pixelSize: 14
                        font.family: root.uiFont
                        clip: true
                        selectByMouse: true
                        text: root.query
                        onTextChanged: root.query = text
                        Keys.onPressed: function (e) {
                            var ch = root.mapLangKey(e)
                            if (ch !== null) { insert(ch); e.accepted = true }
                        }
                        Keys.onReturnPressed: {
                            var list = root.filteredLauncherApps()
                            if (list.length)
                                root.launchFromStart(list[0])
                        }
                        Keys.onEscapePressed: root.startOpen = false
                    }
                    Text {
                        anchors.left: parent.left; anchors.leftMargin: 38
                        anchors.verticalCenter: parent.verticalCenter
                        text: "Поиск"
                        color: "#6b7785"; font.pixelSize: 14; font.family: root.uiFont
                        visible: search.text.length === 0 && !search.activeFocus
                    }
                }

                // полноэкранный режим пуска
                Rectangle {
                    anchors.right: parent.right
                    anchors.verticalCenter: parent.verticalCenter
                    width: 40; height: 40; radius: 12
                    color: expH.containsMouse ? Qt.rgba(0.23, 0.88, 0.51, 0.16) : "#1a2420"
                    border.width: 1
                    border.color: "#2a3a34"
                    Behavior on color { ColorAnimation { duration: 120 } }
                    Item {
                        anchors.centerIn: parent
                        width: 16; height: 16
                        // внешний угол
                        Rectangle {
                            visible: !launcher.fullscreenMode
                            x: 0; y: 0; width: 10; height: 10
                            color: "transparent"; border.width: 1.5; border.color: "#e8eef2"; radius: 1
                        }
                        Rectangle {
                            visible: !launcher.fullscreenMode
                            x: 6; y: 6; width: 10; height: 10
                            color: "#1a2420"; border.width: 1.5; border.color: "#e8eef2"; radius: 1
                        }
                        // свёрнутый вид
                        Rectangle {
                            visible: launcher.fullscreenMode
                            x: 3; y: 3; width: 10; height: 10
                            color: "transparent"; border.width: 1.5; border.color: "#e8eef2"; radius: 1
                        }
                        Rectangle {
                            visible: launcher.fullscreenMode
                            x: 0; y: 0; width: 5; height: 1.5; color: "#e8eef2"
                        }
                        Rectangle {
                            visible: launcher.fullscreenMode
                            x: 0; y: 0; width: 1.5; height: 5; color: "#e8eef2"
                        }
                    }
                    MouseArea {
                        id: expH; anchors.fill: parent; hoverEnabled: true
                        onClicked: {
                            launcher.fullscreenMode = !launcher.fullscreenMode
                            if (launcher.fullscreenMode) {
                                launcher.width = Math.min(root.width - 80, 1100)
                                launcher.height = Math.min(root.height - root.dockSize - 80, 720)
                            } else {
                                launcher.width = 920
                                launcher.height = 620
                            }
                        }
                    }
                }
            }
        }
    }

    MouseArea {
        z: 210
        anchors.fill: parent
        visible: root.startOpen
        onClicked: root.startOpen = false
    }


    Text { id: appsLabel; visible: false; text: "Приложения"; font.family: root.uiFont; font.pixelSize: 14; font.bold: true }

    Repeater {
        model: windows
        delegate: Rectangle {
            id: win
            // окна ниже пуска (220) и дока (200): zseq нормализуем в raiseWindowZ
            z: 15 + Math.min(model.z, 160)
            visible: !model.hidden || appear > 0.04
            width: model.w
            height: model.h
            property real appear: 0
            property bool closing: false
            property bool dragging: false
            property bool resizing: false
            property bool animGeom: !dragging && !resizing && !closing
            property bool modelHidden: model.hidden
            // Фото/медиа — всегда непрозрачные, иначе сквозь окно просвечивает зелёный стол
            property bool mediaOpaque: model.appId === "photos" || model.appId === "video" || model.appId === "music" || model.appId === "vlc" || model.appId === "docs"
            // Медиа-окна: никогда не умножаем на appear — иначе фото/PDF зеленеют сквозь стол
            opacity: win.mediaOpaque ? 1.0 : (root.windowOpacity * appear)
            scale: win.mediaOpaque ? 1.0 : (0.88 + 0.12 * appear)
            transformOrigin: Item.Center
            Behavior on appear { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
            Behavior on x { enabled: win.animGeom; NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            Behavior on y { enabled: win.animGeom; NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            Behavior on width { enabled: win.animGeom; NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            Behavior on height { enabled: win.animGeom; NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            // Win11-like rounding without MultiEffect/layer (those freeze under QEMU soft GL)
            property real cornerRadius: model.maxed ? 0 : 12
            radius: cornerRadius
            Behavior on radius { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
            color: win.mediaOpaque ? "#000000" : "#202020"
            border.width: model.maxed ? 0 : 1
            border.color: win.isActive ? root.accentColor : "#3a3a3a"
            Behavior on border.color { ColorAnimation { duration: 180 } }
            clip: false
            property bool isActive: {
                var topZ = -1
                for (var i = 0; i < windows.count; ++i) {
                    var w = windows.get(i)
                    if (!w.hidden && w.z > topZ)
                        topZ = w.z
                }
                return model.z === topZ
            }
            Connections {
                target: root
                function onSnapNonceChanged() {
                    if (index === root.snapTargetIndex) {
                        win.x = model.wx
                        win.y = model.wy
                    }
                }
            }
            onModelHiddenChanged: {
                if (modelHidden)
                    appear = 0
                else if (!closing) {
                    appear = 0
                    showAppearTimer.restart()
                }
            }
            Timer {
                id: showAppearTimer
                interval: 16
                onTriggered: appear = 1
            }
            Timer {
                id: closeAnimTimer
                interval: 200
                onTriggered: windows.remove(index)
            }
            function requestClose() {
                if (closing)
                    return
                closing = true
                appear = 0
                closeAnimTimer.restart()
            }
            Component.onCompleted: {
                x = model.wx
                y = model.wy
                appear = 1
            }

            states: State {
                name: "maxed"
                when: model.maxed
                PropertyChanges {
                    target: win
                    x: 0
                    y: 46
                    width: root.width
                    height: root.height - 46
                    radius: 0
                    border.width: 0
                }
            }
            transitions: Transition {
                NumberAnimation {
                    properties: "x,y,width,height,radius"
                    duration: 300
                    easing.type: Easing.OutCubic
                }
            }

            function toggleMax() {
                if (model.maxed) {
                    windows.setProperty(index, "maxed", false)
                    windows.setProperty(index, "w", model.rw || model.w)
                    windows.setProperty(index, "h", model.rh || model.h)
                    x = model.rx
                    y = model.ry
                    width = model.rw || model.w
                    height = model.rh || model.h
                } else {
                    windows.setProperty(index, "rw", width)
                    windows.setProperty(index, "rh", height)
                    windows.setProperty(index, "rx", x)
                    windows.setProperty(index, "ry", y)
                    windows.setProperty(index, "maxed", true)
                }
                windows.setProperty(index, "z", ++root.zseq)
            }

            function appIconColor() {
                if (model.appId === "term") return "#1f6a3c"
                if (model.appId === "files") return "#3d6b4a"
                if (model.appId === "browser") return "#2f6fed"
                if (model.appId === "settings") return "#4a5560"
                if (model.appId === "store") return "#2563eb"
                if (model.appId === "notes") return "#c9a227"
                if (model.appId === "mail") return "#5b8fa8"
                return "#3be182"
            }

            // Windows 11 title bar — 32px, rounded top corners
            Rectangle {
                id: titleBar
                width: parent.width
                height: 32
                topLeftRadius: win.cornerRadius
                topRightRadius: win.cornerRadius
                bottomLeftRadius: 0
                bottomRightRadius: 0
                color: win.isActive ? "#2d2d2d" : "#202020"
                Behavior on color { ColorAnimation { duration: 160 } }

                // icon — компактнее текста заголовка
                Item {
                    id: winIcon
                    x: 10
                    width: 16
                    height: 16
                    anchors.verticalCenter: parent.verticalCenter
                    opacity: win.isActive ? 1 : 0.55
                    clip: true
                    Behavior on opacity { NumberAnimation { duration: 160 } }
                    DeskIconArt {
                        anchors.centerIn: parent
                        width: 14
                        height: 14
                        kind: root.winIconKind(model.appId)
                        appId: model.appId
                    }
                    MouseArea {
                        anchors.fill: parent
                        onDoubleClicked: win.requestClose()
                        onClicked: windows.setProperty(index, "z", ++root.zseq)
                    }
                }

                // caption title
                Text {
                    anchors.left: winIcon.right
                    anchors.leftMargin: 12
                    anchors.right: winControls.left
                    anchors.rightMargin: 8
                    anchors.verticalCenter: parent.verticalCenter
                    text: model.title
                    color: win.isActive ? "#ffffff" : "#a0a0a0"
                    Behavior on color { ColorAnimation { duration: 160 } }
                    font.pixelSize: 12
                    font.family: root.uiFont
                    elide: Text.ElideRight
                }

                // system caption buttons — full-bleed, flush right
                Row {
                    id: winControls
                    anchors.right: parent.right
                    anchors.top: parent.top
                    height: parent.height
                    spacing: 0

                    // minimize
                    Rectangle {
                        width: 46
                        height: 32
                        color: minMouse.containsMouse ? "#3a3a3a" : "transparent"
                        // ChromeMinimize glyph
                        Item {
                            anchors.centerIn: parent
                            width: 10
                            height: 10
                            Rectangle {
                                anchors.horizontalCenter: parent.horizontalCenter
                                anchors.verticalCenter: parent.verticalCenter
                                width: 10
                                height: 1
                                color: win.isActive ? "#ffffff" : "#a0a0a0"
                            }
                        }
                        MouseArea {
                            id: minMouse
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: windows.setProperty(index, "hidden", true)
                        }
                        Behavior on color { ColorAnimation { duration: 100 } }
                    }

                    // maximize / restore
                    Rectangle {
                        width: 46
                        height: 32
                        color: maxMouse.containsMouse ? "#3a3a3a" : "transparent"
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Item {
                            anchors.centerIn: parent
                            width: 10
                            height: 10
                            // maximize
                            Rectangle {
                                visible: !model.maxed
                                anchors.fill: parent
                                radius: 1
                                color: "transparent"
                                border.width: 1
                                border.color: win.isActive ? "#ffffff" : "#a0a0a0"
                            }
                            // restore (two overlapping rects)
                            Item {
                                visible: model.maxed
                                anchors.fill: parent
                                Rectangle {
                                    x: 2; y: 0; width: 8; height: 8; radius: 1
                                    color: "transparent"
                                    border.width: 1
                                    border.color: win.isActive ? "#ffffff" : "#a0a0a0"
                                }
                                Rectangle {
                                    x: 0; y: 2; width: 8; height: 8; radius: 1
                                    color: titleBar.color
                                    border.width: 1
                                    border.color: win.isActive ? "#ffffff" : "#a0a0a0"
                                }
                            }
                        }
                        MouseArea {
                            id: maxMouse
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: win.toggleMax()
                            onPressAndHold: {
                                root.snapTargetIndex = index
                                root.snapLayoutOpen = true
                            }
                        }
                        // Snap Layouts flyout (зажмите кнопку развёртывания)
                        Rectangle {
                            id: snapFly
                            visible: (root.snapLayoutOpen && root.snapTargetIndex === index) || opacity > 0.02
                            opacity: (root.snapLayoutOpen && root.snapTargetIndex === index) ? 1 : 0
                            scale: (root.snapLayoutOpen && root.snapTargetIndex === index) ? 1 : 0.92
                            transformOrigin: Item.TopRight
                            Behavior on opacity { NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
                            Behavior on scale { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }
                            anchors.right: parent.right
                            anchors.top: parent.bottom
                            anchors.topMargin: 6
                            width: 220
                            height: 118
                            radius: 12
                            color: "#121a20"
                            border.color: "#2a3842"
                            border.width: 1
                            z: 50
                            Column {
                                anchors.fill: parent; anchors.margins: 10; spacing: 8
                                Text { text: "Snap Layouts"; color: "#e8eef2"; font.pixelSize: 11; font.bold: true }
                                Row {
                                    spacing: 6
                                    Repeater {
                                        model: [
                                            { id: "left", label: "◧" },
                                            { id: "right", label: "◨" },
                                            { id: "tl", label: "⌜" },
                                            { id: "tr", label: "⌝" },
                                            { id: "bl", label: "⌞" },
                                            { id: "br", label: "⌟" }
                                        ]
                                        delegate: Rectangle {
                                            width: 30; height: 28; radius: 6; color: "#1c262e"
                                            Text { anchors.centerIn: parent; text: modelData.label; color: "#c5d0d8"; font.pixelSize: 14 }
                                            MouseArea { anchors.fill: parent; onClicked: root.applySnapLayout(modelData.id) }
                                        }
                                    }
                                }
                                Row {
                                    spacing: 6
                                    Repeater {
                                        model: [
                                            { id: "thirdL", label: "▎" },
                                            { id: "thirdC", label: "▌" },
                                            { id: "thirdR", label: "▐" },
                                            { id: "max", label: "▣" }
                                        ]
                                        delegate: Rectangle {
                                            width: 44; height: 28; radius: 6; color: "#1c262e"
                                            Text { anchors.centerIn: parent; text: modelData.label; color: "#c5d0d8"; font.pixelSize: 13 }
                                            MouseArea { anchors.fill: parent; onClicked: root.applySnapLayout(modelData.id) }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // close — Windows red #C42B1C, follows window top-right round
                    Rectangle {
                        width: 46
                        height: 32
                        topRightRadius: win.cornerRadius
                        color: closeMouse.containsMouse ? "#c42b1c" : "transparent"
                        Behavior on color { ColorAnimation { duration: 100 } }
                        Item {
                            anchors.centerIn: parent
                            width: 10
                            height: 10
                            Rectangle {
                                width: 12; height: 1; rotation: 45
                                anchors.centerIn: parent
                                color: closeMouse.containsMouse ? "#ffffff" : (win.isActive ? "#ffffff" : "#a0a0a0")
                            }
                            Rectangle {
                                width: 12; height: 1; rotation: -45
                                anchors.centerIn: parent
                                color: closeMouse.containsMouse ? "#ffffff" : (win.isActive ? "#ffffff" : "#a0a0a0")
                            }
                        }
                        MouseArea {
                            id: closeMouse
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: win.requestClose()
                        }
                    }
                }

                // drag region (empty title bar space)
                MouseArea {
                    anchors.left: parent.left
                    anchors.right: winControls.left
                    height: parent.height
                    enabled: !model.maxed
                    drag.target: win
                    drag.minimumX: 0
                    drag.maximumX: Math.max(0, root.width - win.width)
                    drag.minimumY: 46
                    drag.maximumY: Math.max(46, root.height - 80)
                    onPressed: {
                        win.dragging = true
                        windows.setProperty(index, "z", ++root.zseq)
                    }
                    onDoubleClicked: win.toggleMax()
                    onReleased: {
                        win.dragging = false
                        root.snapWindow(win, index)
                    }
                    onCanceled: win.dragging = false
                }
            }

            // content area fills under title — Windows client, rounded bottom
            Rectangle {
                id: clientBg
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: titleBar.bottom
                anchors.bottom: parent.bottom
                topLeftRadius: 0
                topRightRadius: 0
                bottomLeftRadius: win.cornerRadius
                bottomRightRadius: win.cornerRadius
                color: win.mediaOpaque ? "#000000" : "#0e1519"
                z: 0
            }

            Item {
                anchors.top: titleBar.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: parent.bottom
                anchors.margins: root.isChromeApp(model.appId) ? 0 : 14
                anchors.topMargin: root.isChromeApp(model.appId) ? 0 : 14
                z: 1

                MouseArea {
                    anchors.fill: parent
                    z: -1
                    onPressed: windows.setProperty(index, "z", ++root.zseq)
                }

                Loader {
                    anchors.fill: parent
                    asynchronous: true
                    sourceComponent: root.componentForApp(model.appId)
                    onLoaded: if (item) item.appTitle = model.title
                    Rectangle {
                        anchors.fill: parent
                        visible: parent.status === Loader.Loading
                        color: root.isChromeApp(model.appId) ? "#202020" : "transparent"
                        Text {
                            anchors.centerIn: parent
                            visible: parent.visible
                            text: "Загрузка…"
                            color: "#6b7785"
                            font.pixelSize: 13
                            font.family: root.uiFont
                        }
                    }
                }
            }

            // resize edges (Windows-like)
            MouseArea {
                anchors.right: parent.right
                anchors.top: titleBar.bottom
                anchors.bottom: parent.bottom
                width: 6
                cursorShape: Qt.SizeHorCursor
                enabled: !model.maxed
                property real sx: 0
                property real sw: 0
                onPressed: { win.resizing = true; sx = mouse.x; sw = win.width; windows.setProperty(index, "z", ++root.zseq) }
                onReleased: win.resizing = false
                onCanceled: win.resizing = false
                onPositionChanged: {
                    if (!pressed) return
                    var nw = Math.max(320, sw + (mouse.x - sx))
                    win.width = nw
                    windows.setProperty(index, "w", nw)
                }
            }
            MouseArea {
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: parent.bottom
                height: 6
                cursorShape: Qt.SizeVerCursor
                enabled: !model.maxed
                property real sy: 0
                property real sh: 0
                onPressed: { win.resizing = true; sy = mouse.y; sh = win.height; windows.setProperty(index, "z", ++root.zseq) }
                onReleased: win.resizing = false
                onCanceled: win.resizing = false
                onPositionChanged: {
                    if (!pressed) return
                    var nh = Math.max(200, sh + (mouse.y - sy))
                    win.height = nh
                    windows.setProperty(index, "h", nh)
                }
            }
        }
    }

    Rectangle {
        id: dock
        z: 200
        anchors.horizontalCenter: root.dockEdge === "bottom" || root.dockEdge === "top" ? parent.horizontalCenter : undefined
        anchors.verticalCenter: root.dockEdge === "left" || root.dockEdge === "right" ? parent.verticalCenter : undefined
        anchors.bottom: root.dockEdge === "bottom" ? parent.bottom : undefined
        anchors.top: root.dockEdge === "top" ? parent.top : undefined
        anchors.left: root.dockEdge === "left" ? parent.left : undefined
        anchors.right: root.dockEdge === "right" ? parent.right : undefined
        anchors.bottomMargin: root.dockEdge === "bottom" ? 16 : 0
        anchors.topMargin: root.dockEdge === "top" ? 54 : 0
        anchors.leftMargin: root.dockEdge === "left" ? 16 : 0
        anchors.rightMargin: root.dockEdge === "right" ? 16 : 0
        width: root.dockEdge === "left" || root.dockEdge === "right" ? root.dockSize : dockRow.width + 28
        height: root.dockEdge === "left" || root.dockEdge === "right" ? dockRow.height + 28 : root.dockSize
        radius: 20
        color: "#1a2126"
        border.width: 1
        border.color: "#2c3840"
        opacity: root.dockReady ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 420; easing.type: Easing.OutCubic } }
        transform: Translate {
            y: root.dockReady || root.dockEdge !== "bottom" ? 0 : 120
            Behavior on y { NumberAnimation { duration: 560; easing.type: Easing.OutCubic } }
        }

        Timer {
            interval: 180
            running: true
            onTriggered: root.dockReady = true
        }

        // Умный док — рекомендация
        Rectangle {
            visible: root.dockSuggestVisible || opacity > 0.02
            opacity: root.dockSuggestVisible ? 1 : 0
            scale: root.dockSuggestVisible ? 1 : 0.96
            Behavior on opacity { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
            Behavior on scale { NumberAnimation { duration: 280; easing.type: Easing.OutBack } }
            transform: Translate {
                y: root.dockSuggestVisible ? 0 : 14
                Behavior on y { NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }
            }
            anchors.bottom: parent.top
            anchors.bottomMargin: 14
            anchors.horizontalCenter: parent.horizontalCenter
            width: Math.min(440, root.width - 48)
            height: 88
            radius: 18
            z: 60
            color: "#0e1816"
            border.width: 1
            border.color: "#2a4a3c"
            Rectangle {
                anchors.left: parent.left
                width: 4; height: parent.height
                color: root.accentColor
                radius: 2
            }
            Row {
                anchors.fill: parent
                anchors.leftMargin: 18
                anchors.rightMargin: 14
                spacing: 14
                DeskIconArt {
                    width: 40; height: 40
                    anchors.verticalCenter: parent.verticalCenter
                    kind: root.winIconKind(root.dockSuggestApp)
                    appId: root.dockSuggestApp
                }
                Column {
                    anchors.verticalCenter: parent.verticalCenter
                    width: parent.width - 220
                    spacing: 4
                    Text {
                        text: "Умный док"
                        color: root.accentColor
                        font.pixelSize: 11
                        font.family: root.uiFontBold
                    }
                    Text {
                        width: parent.width
                        text: root.dockSuggest
                        color: "#e8eef2"
                        font.pixelSize: 12
                        font.family: root.uiFont
                        wrapMode: Text.Wrap
                        maximumLineCount: 2
                        elide: Text.ElideRight
                    }
                }
                Row {
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 8
                    Rectangle {
                        width: 108; height: 34; radius: 10; color: root.accentColor
                        Text { anchors.centerIn: parent; text: "Закрепить"; color: "#06210f"; font.family: root.uiFontBold; font.pixelSize: 12 }
                        MouseArea { anchors.fill: parent; onClicked: root.acceptDockSuggest() }
                    }
                    Rectangle {
                        width: 36; height: 34; radius: 10; color: "#1a2420"
                        Text { anchors.centerIn: parent; text: "×"; color: "#9aa7b2"; font.pixelSize: 16 }
                        MouseArea { anchors.fill: parent; onClicked: root.dismissDockSuggest() }
                    }
                }
            }
        }

        Flow {
            id: dockRow
            anchors.centerIn: parent
            spacing: 8
            flow: root.dockEdge === "left" || root.dockEdge === "right" ? Flow.TopToBottom : Flow.LeftToRight
            width: root.dockEdge === "left" || root.dockEdge === "right" ? root.dockSize - 20 : undefined

            Item {
                id: startBtnWrap
                width: Math.max(40, root.dockSize - 24)
                height: Math.max(40, root.dockSize - 24)
                Rectangle {
                    id: startBtn
                    anchors.fill: parent
                    radius: 14
                    color: root.startOpen || startHover.containsMouse ? "#1a2a24" : "#141c1a"
                    border.width: 1
                    border.color: root.startOpen ? root.accentColor : "#2a3a34"
                    property real pressScale: 1
                    scale: (startHover.containsMouse ? 1.14 : 1) * pressScale
                    transformOrigin: Item.Bottom
                    Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                    Behavior on color { ColorAnimation { duration: 140 } }
                    Behavior on border.color { ColorAnimation { duration: 140 } }
                    SequentialAnimation {
                        id: startPulse
                        NumberAnimation { target: startBtn; property: "pressScale"; to: 0.88; duration: 70 }
                        NumberAnimation { target: startBtn; property: "pressScale"; to: 1.08; duration: 120; easing.type: Easing.OutBack }
                        NumberAnimation { target: startBtn; property: "pressScale"; to: 1; duration: 100 }
                    }
                    // клевер акцентным цветом
                    CloverMark {
                        anchors.centerIn: parent
                        width: parent.width * 0.72
                        height: parent.height * 0.72
                        ink: root.accentColor
                    }
                    MouseArea {
                        id: startHover
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            startPulse.restart()
                            root.startOpen = !root.startOpen
                        }
                    }
                }
                Rectangle {
                    visible: startHover.containsMouse
                    anchors.bottom: parent.top
                    anchors.bottomMargin: 10
                    anchors.horizontalCenter: parent.horizontalCenter
                    z: 80
                    width: startTip.implicitWidth + 16
                    height: 26
                    radius: 8
                    color: "#121a18"
                    border.width: 1
                    border.color: "#2a3a34"
                    Text {
                        id: startTip
                        anchors.centerIn: parent
                        text: "Меню Пуск"
                        color: "#e8eef2"
                        font.pixelSize: 11
                        font.family: root.uiFont
                    }
                }
            }

            Repeater {
                model: root.dockAppList()
                delegate: Item {
                    width: 46; height: 50
                    visible: (modelData !== "browser" || root.dockShowBrowser) && (modelData !== "mail" || root.dockShowMail)
                    opacity: 1
                    scale: 1
                    DockButton {
                        kind: root.winIconKind(modelData)
                        appId: modelData
                        tip: root.appTitleOf(modelData)
                        anchors.horizontalCenter: parent.horizontalCenter
                        onClicked: root.focusOrToggleApp(modelData)
                    }
                    Rectangle {
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        width: root.isAppActive(modelData) ? 18 : 6
                        height: 3
                        radius: 1.5
                        visible: root.isAppRunning(modelData)
                        opacity: root.isAppRunning(modelData) ? 1 : 0
                        color: root.isAppActive(modelData) ? root.accentColor : "#8b98a3"
                        Behavior on width { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                        Behavior on color { ColorAnimation { duration: 160 } }
                        Behavior on opacity { NumberAnimation { duration: 160 } }
                    }
                    MouseArea {
                        anchors.fill: parent
                        acceptedButtons: Qt.RightButton
                        onClicked: root.openCtxMenuAt(this, mouse.x, mouse.y, root.dockCtxItems(modelData), "dock")
                    }
                }
            }
            Item {
                width: 40; height: 40
                Rectangle {
                    anchors.fill: parent
                    radius: 10
                    color: deskBtn.containsMouse || root.workspacesOpen ? "#1e2a28" : "transparent"
                    scale: deskBtn.containsMouse || root.workspacesOpen ? 1.1 : 1
                    Behavior on color { ColorAnimation { duration: 120 } }
                    Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                    // SVG-like: сетка виртуальных столов 2×2
                    Canvas {
                        id: deskWsIcon
                        anchors.centerIn: parent
                        width: 22; height: 22
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var on = deskBtn.containsMouse || root.workspacesOpen
                            var ink = on ? "#ffffff" : "#e8eef2"
                            ctx.strokeStyle = ink
                            ctx.lineWidth = 1.5
                            ctx.lineJoin = "round"
                            function box(x, y, active) {
                                if (active) {
                                    ctx.globalAlpha = 0.85
                                    ctx.fillStyle = "#3be182"
                                    ctx.fillRect(x, y, 8, 8)
                                    ctx.globalAlpha = 1
                                }
                                ctx.strokeRect(x + 0.5, y + 0.5, 7, 7)
                            }
                            box(2, 2, root.deskIndex === 0)
                            box(12, 2, root.deskIndex === 1)
                            box(2, 12, root.deskIndex === 2)
                            box(12, 12, root.deskIndex >= 3)
                        }
                        Connections {
                            target: root
                            function onWorkspacesOpenChanged() { deskWsIcon.requestPaint() }
                            function onDeskIndexChanged() { deskWsIcon.requestPaint() }
                        }
                    }
                    MouseArea {
                        id: deskBtn; anchors.fill: parent; hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.workspacesOpen = !root.workspacesOpen
                            if (root.workspacesOpen) {
                                root.quickOpen = false
                                root.notifyCenterOpen = false
                                root.calendarOpen = false
                                root.startOpen = false
                            } else {
                                root.wsRenameIndex = -1
                            }
                            deskWsIcon.requestPaint()
                        }
                        onContainsMouseChanged: deskWsIcon.requestPaint()
                    }
                }
                Rectangle {
                    visible: deskBtn.containsMouse
                    anchors.bottom: parent.top
                    anchors.bottomMargin: 10
                    anchors.horizontalCenter: parent.horizontalCenter
                    z: 80
                    width: deskTip.implicitWidth + 16
                    height: 26
                    radius: 8
                    color: "#121a18"
                    border.width: 1
                    border.color: "#2a3a34"
                    Text {
                        id: deskTip
                        anchors.centerIn: parent
                        text: "Рабочие пространства"
                        color: "#e8eef2"
                        font.pixelSize: 11
                        font.family: root.uiFont
                    }
                }
            }

            // Свернуть все окна / показать рабочий стол
            Item {
                width: 40; height: 40
                Rectangle {
                    anchors.fill: parent
                    radius: 10
                    color: showDeskBtn.containsMouse || root.showDesktopActive ? "#1e2a28" : "transparent"
                    scale: showDeskBtn.containsMouse || root.showDesktopActive ? 1.1 : 1
                    Behavior on color { ColorAnimation { duration: 120 } }
                    Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                    Canvas {
                        id: showDeskIcon
                        anchors.centerIn: parent
                        width: 22; height: 22
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var on = showDeskBtn.containsMouse || root.showDesktopActive
                            var ink = on ? "#3be182" : "#e8eef2"
                            ctx.strokeStyle = ink
                            ctx.fillStyle = on ? "rgba(59,225,130,0.2)" : "rgba(0,0,0,0)"
                            ctx.lineWidth = 1.6
                            ctx.fillRect(3, 3, 12, 10)
                            ctx.strokeRect(3.5, 3.5, 11, 9)
                            ctx.beginPath()
                            ctx.moveTo(3, 6.5); ctx.lineTo(14.5, 6.5); ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(8, 14); ctx.lineTo(18, 14); ctx.lineTo(18, 8); ctx.stroke()
                            ctx.lineWidth = 2
                            ctx.beginPath()
                            ctx.moveTo(2, 18); ctx.lineTo(20, 18); ctx.stroke()
                        }
                        Connections {
                            target: root
                            function onShowDesktopActiveChanged() { showDeskIcon.requestPaint() }
                        }
                    }
                    MouseArea {
                        id: showDeskBtn
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.markUserActivity()
                            root.workspacesOpen = false
                            root.toggleShowDesktop()
                            showDeskIcon.requestPaint()
                        }
                        onContainsMouseChanged: showDeskIcon.requestPaint()
                    }
                }
                Rectangle {
                    visible: showDeskBtn.containsMouse
                    anchors.bottom: parent.top
                    anchors.bottomMargin: 10
                    anchors.horizontalCenter: parent.horizontalCenter
                    z: 80
                    width: showDeskTip.implicitWidth + 16
                    height: 26
                    radius: 8
                    color: "#121a18"
                    border.width: 1
                    border.color: "#2a3a34"
                    Text {
                        id: showDeskTip
                        anchors.centerIn: parent
                        text: root.showDesktopActive ? "Показать окна" : "Свернуть все окна"
                        color: "#e8eef2"
                        font.pixelSize: 11
                        font.family: root.uiFont
                    }
                }
            }

            // Индикатор незавершённых загрузок и операций
            Item {
                width: 40; height: 40
                visible: root.pendingOpsCount() > 0 || root.opsFlyoutOpen
                Rectangle {
                    anchors.fill: parent
                    radius: 10
                    color: opsBtn.containsMouse || root.opsFlyoutOpen ? "#1e2a28" : "transparent"
                    scale: opsBtn.containsMouse || root.opsFlyoutOpen ? 1.1 : 1
                    Behavior on color { ColorAnimation { duration: 120 } }
                    Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }
                    Canvas {
                        id: opsIcon
                        anchors.centerIn: parent
                        width: 20; height: 20
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var on = opsBtn.containsMouse || root.opsFlyoutOpen
                            var ink = on ? "#3be182" : "#e8eef2"
                            ctx.strokeStyle = ink
                            ctx.lineWidth = 1.7
                            ctx.beginPath()
                            ctx.arc(10, 10, 7.2, -Math.PI * 0.5, Math.PI * 1.1, false)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(10, 5.5); ctx.lineTo(10, 10.5); ctx.lineTo(13.2, 12.2)
                            ctx.stroke()
                        }
                        Connections {
                            target: root
                            function onOpsFlyoutOpenChanged() { opsIcon.requestPaint() }
                            function onPendingOpsChanged() { opsIcon.requestPaint() }
                        }
                    }
                    Rectangle {
                        visible: root.pendingOpsCount() > 0
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.margins: 4
                        width: Math.max(14, opsCountLab.implicitWidth + 6)
                        height: 14
                        radius: 7
                        color: root.accentColor
                        Text {
                            id: opsCountLab
                            anchors.centerIn: parent
                            text: "" + root.pendingOpsCount()
                            color: "#06210f"
                            font.pixelSize: 9
                            font.bold: true
                            font.family: root.uiFontBold
                        }
                    }
                    MouseArea {
                        id: opsBtn
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.markUserActivity()
                            root.opsFlyoutOpen = !root.opsFlyoutOpen
                            if (root.opsFlyoutOpen) {
                                root.startOpen = false
                                root.quickOpen = false
                                root.notifyCenterOpen = false
                            }
                            opsIcon.requestPaint()
                        }
                        onContainsMouseChanged: opsIcon.requestPaint()
                    }
                }
                Rectangle {
                    visible: opsBtn.containsMouse && !root.opsFlyoutOpen
                    anchors.bottom: parent.top
                    anchors.bottomMargin: 10
                    anchors.horizontalCenter: parent.horizontalCenter
                    z: 80
                    width: opsTip.implicitWidth + 16
                    height: 26
                    radius: 8
                    color: "#121a18"
                    border.width: 1
                    border.color: "#2a3a34"
                    Text {
                        id: opsTip
                        anchors.centerIn: parent
                        text: "Операции · " + root.pendingOpsCount()
                        color: "#e8eef2"
                        font.pixelSize: 11
                        font.family: root.uiFont
                    }
                }
            }
        }

        // Всплывающий список операций над доком
        Rectangle {
            id: opsFlyout
            visible: root.opsFlyoutOpen || opacity > 0.02
            opacity: root.opsFlyoutOpen ? 1 : 0
            scale: root.opsFlyoutOpen ? 1 : 0.94
            Behavior on opacity { NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
            Behavior on scale { NumberAnimation { duration: 180; easing.type: Easing.OutBack } }
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.top
            anchors.bottomMargin: 12
            width: 320
            height: Math.min(280, 56 + root.pendingOpsCount() * 58)
            radius: 14
            color: "#121a18"
            border.width: 1
            border.color: "#2a3a34"
            z: 90
            Column {
                anchors.fill: parent
                anchors.margins: 12
                spacing: 8
                Text {
                    text: root.pendingOpsCount() ? "Активные операции" : "Нет активных операций"
                    color: "#e8eef2"
                    font.pixelSize: 13
                    font.family: root.uiFontBold
                }
                Repeater {
                    model: root.pendingOps
                    delegate: Rectangle {
                        width: parent.width
                        height: 50
                        radius: 10
                        color: "#1a2420"
                        Column {
                            anchors.fill: parent
                            anchors.margins: 10
                            spacing: 6
                            Row {
                                width: parent.width
                                spacing: 8
                                Text {
                                    width: parent.width - 48
                                    text: modelData.title
                                    color: "#f4f7f8"
                                    font.pixelSize: 12
                                    font.family: root.uiFontBold
                                    elide: Text.ElideRight
                                }
                                Text {
                                    text: Math.round(modelData.pct || 0) + "%"
                                    color: root.accentColor
                                    font.pixelSize: 11
                                    font.family: root.uiFont
                                }
                            }
                            Rectangle {
                                width: parent.width
                                height: 4
                                radius: 2
                                color: "#243038"
                                Rectangle {
                                    width: parent.width * Math.max(0, Math.min(1, (modelData.pct || 0) / 100))
                                    height: parent.height
                                    radius: 2
                                    color: root.accentColor
                                }
                            }
                            Text {
                                width: parent.width
                                text: modelData.detail || ""
                                color: "#8b98a3"
                                font.pixelSize: 10
                                font.family: root.uiFont
                                elide: Text.ElideRight
                            }
                        }
                    }
                }
            }
        }
    }

    MouseArea {
        z: 204
        anchors.fill: parent
        visible: root.langMenuOpen
        onClicked: root.langMenuOpen = false
    }

    Shortcut {
        sequence: "Meta+Space"
        onActivated: {
            root.inputLang = root.inputLang === "ru" ? "en" : "ru"
            root.applyInputLang()
            root.notify("Клавиатура", root.inputLang === "ru" ? "РУС Русский" : "ENG Английский (США)", "ok")
        }
    }

    // курсоры Win11: системные формы Qt (стрелка / рука / I‑beam / resize)
    // не рисуем свой оверлей — иначе ломается смена вида при наведении

// тосты
    Column {
        z: 90
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.topMargin: 58
        anchors.rightMargin: 16
        spacing: 10
        width: 344
        visible: !root.notifyCenterOpen
        Repeater {
            model: root.notifications
            delegate: Item {
                id: toastWrap
                width: 344
                height: toastCard.height

                // мягкая тень под карточкой
                Rectangle {
                    anchors.fill: toastCard
                    anchors.margins: -1
                    anchors.topMargin: 3
                    radius: 16
                    color: "#66000000"
                    z: -1
                }

                Rectangle {
                    id: toastCard
                    width: 344
                    height: Math.max(70, bodyCol.height + 32)
                    radius: 16
                    color: "#e612181c"
                    border.width: 1
                    border.color: "#33ffffff"
                    clip: true
                    opacity: 0
                    scale: 0.96
                    transformOrigin: Item.Right
                    transform: Translate {
                        id: toastSlide
                        x: 36
                        Behavior on x { NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }
                    }
                    Component.onCompleted: {
                        opacity = 1
                        scale = 1
                        toastSlide.x = 0
                    }
                    Behavior on opacity { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
                    Behavior on scale { NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }

                    // лёгкий верхний блик вместо жёсткой полосы
                    Rectangle {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        height: 40
                        gradient: Gradient {
                            GradientStop {
                                position: 0.0
                                color: modelData.kind === "wifi"
                                       ? "#332563eb"
                                       : (modelData.kind === "ok" ? "#263be182" : "#2294a3b8")
                            }
                            GradientStop { position: 1.0; color: "#0012181c" }
                        }
                    }

                    Row {
                        anchors.fill: parent
                        anchors.leftMargin: 14
                        anchors.rightMargin: 10
                        anchors.topMargin: 14
                        anchors.bottomMargin: 14
                        spacing: 12
                        Rectangle {
                            width: 38; height: 38; radius: 12
                            anchors.verticalCenter: parent.verticalCenter
                            color: modelData.kind === "wifi" ? "#1a2744"
                                 : (modelData.kind === "ok" ? "#143028" : "#22282e")
                            border.width: 1
                            border.color: modelData.kind === "wifi" ? "#334a7ab8"
                                        : (modelData.kind === "ok" ? "#333be182" : "#334b5563")
                            Text {
                                anchors.centerIn: parent
                                text: modelData.kind === "wifi" ? "⌁" : (modelData.kind === "ok" ? "✓" : "i")
                                color: modelData.kind === "wifi" ? "#93c5fd"
                                     : (modelData.kind === "ok" ? root.accentColor : "#cbd5e1")
                                font.pixelSize: 15; font.bold: true
                            }
                        }
                        Column {
                            id: bodyCol
                            width: parent.width - 92
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 3
                            Text {
                                text: modelData.title
                                color: "#f4f7f8"; font.pixelSize: 13; font.family: root.uiFontBold
                                width: parent.width; elide: Text.ElideRight
                            }
                            Text {
                                text: modelData.body
                                color: "#9aa7b2"; font.pixelSize: 12
                                font.family: root.uiFont; width: parent.width; wrapMode: Text.Wrap
                            }
                        }
                        Rectangle {
                            width: 26; height: 26; radius: 8
                            anchors.verticalCenter: parent.verticalCenter
                            color: xh.containsMouse ? "#28ffffff" : "transparent"
                            Text { anchors.centerIn: parent; text: "×"; color: xh.containsMouse ? "#e8eef2" : "#6b7785"; font.pixelSize: 14 }
                            MouseArea {
                                id: xh; anchors.fill: parent; hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.dismissNotify(modelData.id)
                            }
                        }
                    }
                    MouseArea {
                        anchors.fill: parent
                        anchors.rightMargin: 36
                        onClicked: root.notifyCenterOpen = true
                    }
                }
            }
        }
    }

    // центр уведомлений
    Rectangle {
        z: 95
        anchors.fill: parent
        gradient: Gradient {
            GradientStop { position: 0.0; color: root.notifyCenterOpen ? "#99000000" : "#00000000" }
            GradientStop { position: 1.0; color: root.notifyCenterOpen ? "#cc000000" : "#00000000" }
        }
        opacity: root.notifyCenterOpen ? 1 : 0
        visible: root.notifyCenterOpen || opacity > 0.01
        Behavior on opacity { NumberAnimation { duration: 240; easing.type: Easing.OutCubic } }
        MouseArea {
            anchors.fill: parent
            enabled: root.notifyCenterOpen
            onClicked: root.notifyCenterOpen = false
        }
    }
    Item {
        id: notifyCurtain
        z: 96
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.rightMargin: 14
        anchors.topMargin: 56
        anchors.bottomMargin: root.dockSize + 24
        width: 392
        visible: root.notifyCenterOpen || curtainSlide.x < width
        opacity: root.notifyCenterOpen ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
        transform: Translate {
            id: curtainSlide
            x: root.notifyCenterOpen ? 0 : 440
            Behavior on x { NumberAnimation { duration: 340; easing.type: Easing.OutCubic } }
        }

        // тень под панелью (не вылезает зелёной полосой)
        Rectangle {
            anchors.fill: parent
            anchors.topMargin: 6
            anchors.leftMargin: 4
            anchors.rightMargin: -2
            radius: 22
            color: "#55000000"
            z: -1
        }

        Rectangle {
            anchors.fill: parent
            radius: 20
            color: "#e610161a"
            border.width: 1
            border.color: "#28ffffff"
            clip: true

            // мягкий верхний блик — без жёсткой accent-полосы (она рвала скругление)
            Rectangle {
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                height: 96
                gradient: Gradient {
                    GradientStop {
                        position: 0.0
                        color: Qt.rgba(root.accentColor.r, root.accentColor.g, root.accentColor.b, 0.12)
                    }
                    GradientStop { position: 1.0; color: "#0010161a" }
                }
            }

            // шапка
            Row {
                id: nHead
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.leftMargin: 18
                anchors.rightMargin: 14
                anchors.topMargin: 16
                spacing: 12
                Rectangle {
                    width: 40; height: 40; radius: 12
                    color: "#1a2622"
                    border.width: 1
                    border.color: "#333be182"
                    Text {
                        anchors.centerIn: parent
                        text: "◈"
                        color: root.accentColor
                        font.pixelSize: 16
                    }
                }
                Column {
                    anchors.verticalCenter: parent.verticalCenter
                    width: parent.width - 160
                    spacing: 2
                    Text {
                        text: "Уведомления"
                        color: "#f4f7f8"
                        font.pixelSize: 17
                        font.family: root.uiFontBold
                    }
                    Text {
                        text: root.notifyHistory.length === 0
                              ? "Пока тихо"
                              : (root.notifications.length
                                 ? (root.notifications.length + " новых · " + root.notifyHistory.length + " всего")
                                 : (root.notifyHistory.length + " в истории"))
                        color: "#8b98a3"
                        font.pixelSize: 12
                        font.family: root.uiFont
                    }
                }
                Item { width: 4; height: 1 }
                Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 88; height: 32; radius: 10
                    color: cl.containsMouse ? "#28ffffff" : "#14ffffff"
                    border.width: 1
                    border.color: cl.containsMouse ? "#40ffffff" : "#22ffffff"
                    opacity: root.notifyHistory.length ? 1 : 0.4
                    Text {
                        anchors.centerIn: parent
                        text: "Очистить"
                        color: "#d7e0e6"
                        font.pixelSize: 12
                        font.family: root.uiFont
                    }
                    MouseArea {
                        id: cl
                        anchors.fill: parent
                        hoverEnabled: true
                        enabled: root.notifyHistory.length > 0
                        cursorShape: Qt.PointingHandCursor
                        onClicked: root.clearNotifyHistory()
                    }
                }
            }

            Flickable {
                id: nFlick
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: nHead.bottom
                anchors.bottom: parent.bottom
                anchors.leftMargin: 14
                anchors.rightMargin: 14
                anchors.topMargin: 16
                anchors.bottomMargin: 14
                clip: true
                contentHeight: Math.max(height, nCol.height)
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: nCol
                    width: parent.width
                    spacing: 10

                    // погодный виджет
                    Rectangle {
                        width: parent.width
                        height: 108
                        radius: 18
                        clip: true
                        gradient: Gradient {
                            GradientStop { position: 0.0; color: root.weatherSkyTop(root.weatherCode) }
                            GradientStop { position: 1.0; color: root.weatherSkyBottom(root.weatherCode) }
                        }
                        Rectangle {
                            anchors.fill: parent
                            gradient: Gradient {
                                GradientStop { position: 0.0; color: "#33000000" }
                                GradientStop { position: 1.0; color: "#66000000" }
                            }
                        }
                        // декоративное солнце / облако
                        Canvas {
                            id: wxWidIcon
                            anchors.right: parent.right
                            anchors.rightMargin: 14
                            anchors.verticalCenter: parent.verticalCenter
                            width: 56; height: 56
                            onPaint: {
                                var ctx = getContext("2d")
                                ctx.reset()
                                var c = root.weatherCode
                                if (c === 0 || c <= 3) {
                                    ctx.fillStyle = "#fde047"
                                    ctx.beginPath(); ctx.arc(34, 20, 12, 0, Math.PI * 2); ctx.fill()
                                }
                                if (c !== 0) {
                                    ctx.fillStyle = "#f8fafc"
                                    ctx.beginPath()
                                    ctx.arc(18, 34, 10, 0, Math.PI * 2)
                                    ctx.arc(30, 30, 12, 0, Math.PI * 2)
                                    ctx.arc(42, 34, 9, 0, Math.PI * 2)
                                    ctx.rect(18, 34, 24, 10)
                                    ctx.fill()
                                }
                                if (c >= 51 && c <= 86) {
                                    ctx.strokeStyle = "#7dd3fc"
                                    ctx.lineWidth = 2
                                    ctx.beginPath()
                                    ctx.moveTo(22, 46); ctx.lineTo(18, 54)
                                    ctx.moveTo(32, 46); ctx.lineTo(28, 54)
                                    ctx.moveTo(42, 46); ctx.lineTo(38, 54)
                                    ctx.stroke()
                                }
                            }
                            Connections {
                                target: root
                                function onWeatherCodeChanged() { wxWidIcon.requestPaint() }
                            }
                            Component.onCompleted: requestPaint()
                        }
                        Column {
                            anchors.left: parent.left
                            anchors.right: parent.right
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.leftMargin: 16
                            anchors.rightMargin: 80
                            spacing: 4
                            Text {
                                text: root.weatherCity.split(",")[0]
                                color: "#e0f2fe"
                                font.pixelSize: 12
                                font.family: root.uiFont
                                opacity: 0.9
                            }
                            Row {
                                spacing: 10
                                Text {
                                    text: root.weatherTemp
                                    color: "#ffffff"
                                    font.pixelSize: 28
                                    font.family: root.uiFontBold
                                }
                                Text {
                                    anchors.bottom: parent.bottom
                                    anchors.bottomMargin: 4
                                    text: root.weatherCodeShort(root.weatherCode)
                                    color: "#f0f9ff"
                                    font.pixelSize: 14
                                    font.family: root.uiFont
                                    width: Math.max(40, parent.parent.width - 90)
                                    elide: Text.ElideRight
                                }
                            }
                            Row {
                                spacing: 14
                                Row {
                                    spacing: 5
                                    Canvas {
                                        width: 12; height: 12
                                        onPaint: {
                                            var ctx = getContext("2d")
                                            ctx.reset()
                                            ctx.fillStyle = "#bae6fd"
                                            ctx.beginPath()
                                            ctx.moveTo(6, 1)
                                            ctx.bezierCurveTo(10, 5, 11, 8, 6, 12)
                                            ctx.bezierCurveTo(1, 8, 2, 5, 6, 1)
                                            ctx.fill()
                                        }
                                        Component.onCompleted: requestPaint()
                                    }
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: root.weatherHumidity
                                        color: "#e0f2fe"
                                        font.pixelSize: 11
                                        font.family: root.uiFont
                                    }
                                }
                                Row {
                                    spacing: 5
                                    Canvas {
                                        width: 14; height: 12
                                        onPaint: {
                                            var ctx = getContext("2d")
                                            ctx.reset()
                                            ctx.strokeStyle = "#bae6fd"
                                            ctx.lineWidth = 1.5
                                            ctx.lineCap = "round"
                                            ctx.beginPath()
                                            ctx.moveTo(1, 3); ctx.lineTo(11, 3)
                                            ctx.moveTo(1, 6); ctx.lineTo(13, 6)
                                            ctx.moveTo(1, 9); ctx.lineTo(10, 9)
                                            ctx.stroke()
                                        }
                                        Component.onCompleted: requestPaint()
                                    }
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: root.weatherWind
                                        color: "#e0f2fe"
                                        font.pixelSize: 11
                                        font.family: root.uiFont
                                    }
                                }
                            }
                        }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                root.notifyCenterOpen = false
                                root.launch("weather", "Погода")
                            }
                        }
                    }

                    // пусто
                    Item {
                        width: parent.width
                        height: Math.max(120, nFlick.height - 120)
                        visible: root.notifyHistory.length === 0
                        Column {
                            anchors.centerIn: parent
                            spacing: 14
                            width: parent.width - 24
                            Rectangle {
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: 64; height: 64; radius: 20
                                color: "#16201c"
                                border.width: 1
                                border.color: "#2a3a34"
                                Text {
                                    anchors.centerIn: parent
                                    text: "✦"
                                    color: root.accentColor
                                    font.pixelSize: 26
                                }
                            }
                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                text: "Всё спокойно"
                                color: "#e8eef2"
                                font.pixelSize: 16
                                font.family: root.uiFontBold
                            }
                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                text: "Новые сообщения о системе, сети и приложениях появятся здесь"
                                color: "#7e8b96"
                                font.pixelSize: 13
                                font.family: root.uiFont
                            }
                        }
                    }

                    Text {
                        visible: root.notifications.length > 0
                        text: "Сейчас"
                        color: root.accentColor
                        font.pixelSize: 11
                        font.family: root.uiFontBold
                        leftPadding: 4
                        topPadding: 2
                        bottomPadding: 2
                    }
                    Repeater {
                        model: root.notifications
                        delegate: NotifyCard
                    }

                    Text {
                        visible: root.notifyHistory.length > 0
                        text: root.notifications.length > 0 ? "Ранее" : "Недавние"
                        color: "#6b7785"
                        font.pixelSize: 11
                        font.family: root.uiFontBold
                        leftPadding: 4
                        topPadding: root.notifications.length > 0 ? 8 : 2
                        bottomPadding: 2
                    }
                    Repeater {
                        model: {
                            // история без дублей «сейчас»
                            var live = {}
                            for (var i = 0; i < root.notifications.length; ++i)
                                live[root.notifications[i].id] = true
                            var out = []
                            for (var j = 0; j < root.notifyHistory.length; ++j) {
                                if (!live[root.notifyHistory[j].id])
                                    out.push(root.notifyHistory[j])
                            }
                            return out
                        }
                        delegate: NotifyCard
                    }

                    Item {
                        visible: root.notifyHistory.length > 0
                        width: parent.width
                        height: 36
                        Text {
                            anchors.centerIn: parent
                            text: "Нажмите карточку, чтобы убрать из ленты"
                            color: "#4b5560"
                            font.pixelSize: 11
                            font.family: root.uiFont
                        }
                    }
                }

                component NotifyCard: Rectangle {
                    width: nCol.width
                    height: Math.max(72, cardInner.height + 26)
                    radius: 14
                    color: cardH.containsMouse ? "#1c2428" : "#161c20"
                    border.width: 1
                    border.color: cardH.containsMouse ? "#30ffffff" : "#18ffffff"
                    clip: true
                    opacity: 0
                    scale: 0.98
                    Component.onCompleted: { opacity = 1; scale = 1 }
                    Behavior on opacity { NumberAnimation { duration: 200 + index * 30; easing.type: Easing.OutCubic } }
                    Behavior on scale { NumberAnimation { duration: 240 + index * 28; easing.type: Easing.OutCubic } }
                    Behavior on color { ColorAnimation { duration: 120 } }

                    Rectangle {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        height: 36
                        gradient: Gradient {
                            GradientStop {
                                position: 0.0
                                color: modelData.kind === "wifi" ? "#222563eb"
                                     : (modelData.kind === "ok" ? "#1a3be182" : "#1894a3b8")
                            }
                            GradientStop { position: 1.0; color: "#00161c20" }
                        }
                    }

                    Row {
                        id: cardInner
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: parent.top
                        anchors.leftMargin: 14
                        anchors.rightMargin: 10
                        anchors.topMargin: 12
                        spacing: 12

                        Rectangle {
                            width: 36; height: 36; radius: 11
                            anchors.verticalCenter: parent.verticalCenter
                            color: modelData.kind === "wifi" ? "#1a2744"
                                 : (modelData.kind === "ok" ? "#143028" : "#22282e")
                            border.width: 1
                            border.color: modelData.kind === "wifi" ? "#334a7ab8"
                                        : (modelData.kind === "ok" ? "#333be182" : "#334b5563")
                            Text {
                                anchors.centerIn: parent
                                text: modelData.kind === "wifi" ? "⌁"
                                    : (modelData.kind === "ok" ? "✓" : "i")
                                color: modelData.kind === "wifi" ? "#93c5fd"
                                     : (modelData.kind === "ok" ? root.accentColor : "#cbd5e1")
                                font.pixelSize: 14
                                font.bold: true
                            }
                        }
                        Column {
                            width: parent.width - 92
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 3
                            Row {
                                width: parent.width
                                spacing: 8
                                Text {
                                    width: parent.width - 48
                                    text: modelData.title
                                    color: "#f4f7f8"
                                    font.pixelSize: 13
                                    font.family: root.uiFontBold
                                    elide: Text.ElideRight
                                }
                                Text {
                                    text: modelData.time || ""
                                    color: "#6b7785"
                                    font.pixelSize: 11
                                    font.family: root.uiFont
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }
                            Text {
                                width: parent.width
                                text: modelData.body
                                color: "#9aa7b2"
                                font.pixelSize: 12
                                font.family: root.uiFont
                                wrapMode: Text.Wrap
                            }
                        }
                        Rectangle {
                            width: 26; height: 26; radius: 8
                            anchors.verticalCenter: parent.verticalCenter
                            color: xCard.containsMouse ? "#28ffffff" : "transparent"
                            Text {
                                anchors.centerIn: parent
                                text: "×"
                                color: xCard.containsMouse ? "#e8eef2" : "#6b7785"
                                font.pixelSize: 14
                            }
                            MouseArea {
                                id: xCard
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    root.dismissNotify(modelData.id)
                                    var h = []
                                    for (var i = 0; i < root.notifyHistory.length; ++i)
                                        if (root.notifyHistory[i].id !== modelData.id)
                                            h.push(root.notifyHistory[i])
                                    root.notifyHistory = h
                                }
                            }
                        }
                    }
                    MouseArea {
                        id: cardH
                        anchors.fill: parent
                        anchors.rightMargin: 36
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            root.dismissNotify(modelData.id)
                            var h = []
                            for (var i = 0; i < root.notifyHistory.length; ++i)
                                if (root.notifyHistory[i].id !== modelData.id)
                                    h.push(root.notifyHistory[i])
                            root.notifyHistory = h
                        }
                    }
                }
            }
        }
    }


    // Первый вход — создание пользователя (если аккаунта ещё нет)
    Rectangle {
        z: 985
        anchors.fill: parent
        visible: root.setupOpen && !root.booting
        color: "#070b10"

        Image {
            anchors.fill: parent
            source: "file:///usr/share/gtos/wallpaper.jpg"
            fillMode: Image.PreserveAspectCrop
            opacity: 0.28
        }
        Rectangle {
            anchors.fill: parent
            gradient: Gradient {
                GradientStop { position: 0.0; color: "#cc071018" }
                GradientStop { position: 1.0; color: "#f002060a" }
            }
        }

        Rectangle {
            width: Math.min(560, parent.width - 48)
            height: Math.min(640, parent.height - 40)
            radius: 20
            anchors.centerIn: parent
            color: "#e6121a22"
            border.width: 1
            border.color: "#33ffffff"
            clip: true

            Column {
                anchors.centerIn: parent
                width: parent.width - 72
                spacing: 12

                Rectangle {
                    width: 56; height: 56; radius: 14
                    anchors.horizontalCenter: parent.horizontalCenter
                    gradient: Gradient {
                        GradientStop { position: 0; color: "#3be182" }
                        GradientStop { position: 1; color: "#1a9e5a" }
                    }
                    Text {
                        anchors.centerIn: parent
                        text: "GT"; color: "#04140a"
                        font.pixelSize: 20; font.bold: true; font.family: root.uiFont
                    }
                }
                Text {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    text: root.setupStep === 0 ? "Создание пользователя"
                        : (root.setupStep === 1 ? "Язык и раскладка"
                        : (root.setupStep === 2 ? "Сеть" : "Почти готово"))
                    color: "#f4f7f8"
                    font.pixelSize: 24; font.bold: true; font.family: root.uiFont
                }
                Text {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    text: "Шаг " + (root.setupStep + 1) + " из 4 · GT/OS " + root.osVersion
                    color: "#6b7785"; font.pixelSize: 12
                }
                Text {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    text: root.setupStep === 0
                          ? "Укажите имя и при желании пароль — данные сохранятся на постоянном томе."
                          : (root.setupStep === 1
                             ? "Выберите раскладку клавиатуры. Позже смените через Win+Пробел."
                             : (root.setupStep === 2
                                ? "Подключите сеть: Ethernet поднимается сам, Wi‑Fi — из быстрых настроек."
                                : "Включите бэкапы по желанию. Обновления можно проверить сразу после входа."))
                    color: "#9aa7b2"
                    font.pixelSize: 13; font.family: root.uiFont
                }

                // step 0 — account
                Column {
                    width: parent.width
                    spacing: 10
                    visible: root.setupStep === 0
                    Text { text: "Отображаемое имя"; color: "#7a8a98"; font.pixelSize: 12 }
                    Rectangle {
                        width: parent.width; height: 46; radius: 12
                        color: "#0c1216"; border.width: 1; border.color: "#2a3842"
                        TextInput {
                            id: setupNameField
                            anchors.fill: parent; anchors.margins: 12
                            color: "#f4f7f8"; font.pixelSize: 16; font.family: root.uiFont
                            text: root.setupName
                            onTextChanged: root.setupName = text
                            selectByMouse: true
                            Text {
                                anchors.fill: parent; verticalAlignment: Text.AlignVCenter
                                visible: !setupNameField.text.length
                                text: "Например, Misha"; color: "#556270"; font.pixelSize: 15
                            }
                        }
                    }
                    Text { text: "Пароль (необязательно)"; color: "#7a8a98"; font.pixelSize: 12 }
                    Rectangle {
                        width: parent.width; height: 46; radius: 12
                        color: "#0c1216"; border.width: 1; border.color: "#2a3842"
                        TextInput {
                            id: setupPwdField
                            anchors.fill: parent; anchors.margins: 12
                            color: "#f4f7f8"; font.pixelSize: 16; echoMode: TextInput.Password
                            text: root.setupPassword
                            onTextChanged: root.setupPassword = text
                        }
                    }
                    Rectangle {
                        width: parent.width; height: 46; radius: 12
                        color: "#0c1216"; border.width: 1; border.color: "#2a3842"
                        TextInput {
                            id: setupPwd2Field
                            anchors.fill: parent; anchors.margins: 12
                            color: "#f4f7f8"; font.pixelSize: 16; echoMode: TextInput.Password
                            text: root.setupPassword2
                            onTextChanged: root.setupPassword2 = text
                            Keys.onReturnPressed: root.finishSetup()
                        }
                    }
                }

                // step 1 — language
                Column {
                    width: parent.width
                    spacing: 8
                    visible: root.setupStep === 1
                    Repeater {
                        model: [
                            { id: "ru", title: "Русский", sub: "РУС" },
                            { id: "en", title: "English (US)", sub: "ENG" }
                        ]
                        delegate: Rectangle {
                            width: parent.width; height: 52; radius: 12
                            color: root.inputLang === modelData.id ? "#1a2a24" : "#0c1216"
                            border.width: 1
                            border.color: root.inputLang === modelData.id ? root.accentColor : "#2a3842"
                            Column {
                                anchors.left: parent.left; anchors.leftMargin: 14
                                anchors.verticalCenter: parent.verticalCenter; spacing: 2
                                Text { text: modelData.title; color: "#fff"; font.pixelSize: 14; font.bold: true }
                                Text { text: modelData.sub; color: "#8b98a3"; font.pixelSize: 11 }
                            }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: { root.inputLang = modelData.id; root.applyInputLang() }
                            }
                        }
                    }
                }

                // step 2 — network
                Column {
                    width: parent.width
                    spacing: 10
                    visible: root.setupStep === 2
                    Text {
                        width: parent.width; wrapMode: Text.WordWrap
                        text: root.netStatus
                        color: "#e8eef2"; font.pixelSize: 13
                    }
                    Row {
                        spacing: 8
                        Rectangle {
                            width: 160; height: 36; radius: 10; color: "#1a2a24"
                            Text { anchors.centerIn: parent; text: "Обновить сеть"; color: root.accentColor; font.pixelSize: 12; font.bold: true }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: { root.refreshNetwork(true); root.autoConnectWifi(); root.scanWifiNetworks() }
                            }
                        }
                        Rectangle {
                            width: 160; height: 36; radius: 10; color: "#1a2a24"
