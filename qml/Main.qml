    function unlockSession() {
        if (hasSessionPassword() && !verifySessionPassword(lockInput)) {
            lockError = "Неверный пароль"
            lockInput = ""
            lockShake = true
            lockShakeTimer.restart()
            return
        }
        lockUnlocking = true
        lockUnlockTimer.restart()
    }

    function finishUnlock() {
        locked = false
        lockReveal = false
        lockUnlocking = false
        lockInput = ""
        lockError = ""
