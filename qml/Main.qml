                                anchors.topMargin: 40
                                onPaint: {
                                    var ctx = getContext("2d")
                                    ctx.clearRect(0, 0, width, height)
                                    var data = root.memHistory
                                    ctx.fillStyle = "#1a1a1a"
                                    ctx.fillRect(0, 0, width, height)
                                    if (!data.length) return
                                    ctx.beginPath()
                                    for (var i = 0; i < data.length; ++i) {
                                        var x = (i / Math.max(1, data.length - 1)) * width
                                        var y = height - (data[i] / 100) * height
                                        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y)
                                    }
                                    ctx.strokeStyle = "#60a5fa"
                                    ctx.lineWidth = 2
                                    ctx.stroke()
                                    ctx.lineTo(width, height); ctx.lineTo(0, height); ctx.closePath()
                                    ctx.fillStyle = "#60a5fa28"
                                    ctx.fill()
                                }
                                Connections {
                                    target: root
                                    function onMemHistoryChanged() { memGraph.requestPaint() }
                                    function onMemPctChanged() { memGraph.requestPaint() }
                                }
                            }
                        }
                        Text {
                            text: "Сеть: " + root.netStatus
                            color: "#9aa7b2"
                            font.pixelSize: 13
                        }
                    }
                }

                // Startup
                Flickable {
                    visible: root.taskMgrTab === "startup"
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: tmTop.bottom
                    anchors.bottom: parent.bottom
                    anchors.margins: 16
                    clip: true
                    contentHeight: stCol.height
                    Column {
                        id: stCol
                        width: parent.width
                        spacing: 8
                        Text {
                            width: parent.width
                            text: "Программы, которые открываются вместе с GT/OS"
                            color: "#9aa7b2"
                            font.pixelSize: 13
                            wrapMode: Text.WordWrap
                            bottomPadding: 6
                        }
                        Repeater {
                            model: root.startupApps
