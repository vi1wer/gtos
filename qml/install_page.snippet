    Component {
        id: installPage
        Item {
            property string appTitle: ""
            Rectangle {
                anchors.fill: parent
                color: "#f3f3f3"
                Column {
                    anchors.fill: parent
                    anchors.margins: 24
                    spacing: 14
                    Text { text: root.installLang === "en" ? "Install GT/OS 1.1" : "Установка GT/OS 1.1"; color: "#0078d4"; font.pixelSize: 22; font.bold: true; font.family: "DejaVu Sans" }
                    Text {
                        width: parent.width; wrapMode: Text.Wrap; color: "#605e5c"; font.pixelSize: 13
                        text: root.installLang === "en"
                              ? "Graphical installer: language, disk, user account, bootloader."
                              : "Графический установщик: язык, разметка диска, пользователь и загрузчик."
                    }
                    Row {
                        spacing: 8
                        Repeater {
                            model: root.installLang === "en"
                                   ? ["Language", "Disk", "User", "Confirm", "Install", "Done"]
                                   : ["Язык", "Диск", "Пользователь", "Подтверждение", "Установка", "Готово"]
                            delegate: Rectangle {
                                width: stepLab.implicitWidth + 16; height: 26; radius: 13
                                color: root.installStep === index ? "#0078d4" : (root.installStep > index ? "#cce8ff" : "#ffffff")
                                border.color: "#d0d0d0"; border.width: root.installStep === index ? 0 : 1
                                Text {
                                    id: stepLab; anchors.centerIn: parent; text: (index + 1) + ". " + modelData
                                    color: root.installStep === index ? "#ffffff" : "#1a1a1a"; font.pixelSize: 11
                                }
                            }
                        }
                    }
                    Column {
                        visible: root.installStep === 0
                        spacing: 10; width: parent.width
                        Text { text: "Язык / Language"; color: "#1a1a1a"; font.pixelSize: 14; font.bold: true }
                        Row {
                            spacing: 10
                            Rectangle {
                                width: 140; height: 40; radius: 6
                                color: root.installLang === "ru" ? "#cce8ff" : "#ffffff"; border.color: "#0078d4"; border.width: 1
                                Text { anchors.centerIn: parent; text: "Русский"; color: "#1a1a1a" }
                                MouseArea { anchors.fill: parent; onClicked: root.installLang = "ru" }
                            }
                            Rectangle {
                                width: 140; height: 40; radius: 6
                                color: root.installLang === "en" ? "#cce8ff" : "#ffffff"; border.color: "#0078d4"; border.width: 1
                                Text { anchors.centerIn: parent; text: "English"; color: "#1a1a1a" }
                                MouseArea { anchors.fill: parent; onClicked: root.installLang = "en" }
                            }
                        }
                    }
                    Column {
                        visible: root.installStep === 1
                        spacing: 10; width: parent.width
                        Text {
                            text: root.installLang === "en" ? "Select target disk (will be erased)" : "Выберите диск (данные будут удалены)"
                            color: "#1a1a1a"; font.pixelSize: 14; font.bold: true; width: parent.width; wrapMode: Text.Wrap
                        }
                        Rectangle {
                            width: 160; height: 32; radius: 4; color: "#ffffff"; border.color: "#d0d0d0"
                            Text { anchors.centerIn: parent; text: root.installLang === "en" ? "Refresh disks" : "Обновить список"; color: "#0078d4"; font.pixelSize: 12 }
                            MouseArea { anchors.fill: parent; onClicked: root.refreshInstallDisks() }
                        }
                        Repeater {
                            model: root.installDisks
                            delegate: Rectangle {
                                width: parent.parent.width; height: 40; radius: 6
                                color: root.installDisk === modelData.id ? "#cce8ff" : "#ffffff"
                                border.color: "#d0d0d0"; border.width: 1
                                Text { anchors.left: parent.left; anchors.leftMargin: 12; anchors.verticalCenter: parent.verticalCenter; text: modelData.label; color: "#1a1a1a"; font.pixelSize: 13 }
                                MouseArea { anchors.fill: parent; onClicked: root.installDisk = modelData.id }
                            }
                        }
                        Text {
                            visible: root.installDisks.length === 0
                            text: root.installLang === "en" ? "No disks found." : "Диски не найдены. Подключите целевой диск."
                            color: "#a4262c"; font.pixelSize: 12; width: parent.width; wrapMode: Text.Wrap
                        }
                    }
                    Column {
                        visible: root.installStep === 2
                        spacing: 10; width: parent.width
                        Text { text: root.installLang === "en" ? "Create user" : "Создание пользователя"; color: "#1a1a1a"; font.pixelSize: 14; font.bold: true }
                        Row {
                            spacing: 8
                            Text { width: 120; text: root.installLang === "en" ? "Full name" : "Полное имя"; color: "#605e5c"; anchors.verticalCenter: parent.verticalCenter }
                            Rectangle {
                                width: 280; height: 34; radius: 4; color: "#ffffff"; border.color: "#8a8886"
                                TextInput { anchors.fill: parent; anchors.margins: 8; color: "#1a1a1a"; text: root.installFullName; onTextChanged: root.installFullName = text; selectByMouse: true }
                            }
                        }
                        Row {
                            spacing: 8
                            Text { width: 120; text: root.installLang === "en" ? "Username" : "Логин"; color: "#605e5c"; anchors.verticalCenter: parent.verticalCenter }
                            Rectangle {
                                width: 280; height: 34; radius: 4; color: "#ffffff"; border.color: "#8a8886"
                                TextInput { anchors.fill: parent; anchors.margins: 8; color: "#1a1a1a"; text: root.installUser; onTextChanged: root.installUser = text.toLowerCase().replace(/[^a-z0-9_]/g, ""); selectByMouse: true }
                            }
                        }
                    }
                    Column {
                        visible: root.installStep === 3
                        spacing: 8; width: parent.width
                        Text { text: root.installLang === "en" ? "Confirm" : "Подтверждение"; color: "#1a1a1a"; font.pixelSize: 14; font.bold: true }
                        Text {
                            width: parent.width; wrapMode: Text.Wrap; color: "#1a1a1a"; font.pixelSize: 13
                            text: (root.installLang === "en" ? "Disk: " : "Диск: ") + "/dev/" + root.installDisk
                                  + "\n" + (root.installLang === "en" ? "User: " : "Пользователь: ") + root.installFullName + " (" + root.installUser + ")"
                                  + "\n" + (root.installLang === "en" ? "Bootloader: GRUB/syslinux config" : "Загрузчик: GRUB / syslinux.cfg")
                                  + "\n\n" + (root.installLang === "en" ? "All data on the disk will be erased." : "Все данные на выбранном диске будут удалены.")
                        }
                    }
                    Column {
                        visible: root.installStep >= 4
                        spacing: 8; width: parent.width
                        Text {
                            text: root.installStep === 5
                                  ? (root.installLang === "en" ? "Installation finished" : "Установка завершена")
                                  : (root.installLang === "en" ? "Installing…" : "Идёт установка…")
                            color: "#1a1a1a"; font.pixelSize: 14; font.bold: true
                        }
                        Rectangle {
                            width: parent.width; height: 180; radius: 6; color: "#1e1e1e"
                            Flickable {
                                anchors.fill: parent; anchors.margins: 8; contentHeight: logT.paintedHeight; clip: true
                                Text { id: logT; width: parent.width; text: root.installLog; color: "#d4d4d4"; font.family: "DejaVu Sans Mono"; font.pixelSize: 11; wrapMode: Text.Wrap }
                            }
                        }
                        Text {
                            visible: root.installStep === 5
                            width: parent.width; wrapMode: Text.Wrap; color: "#107c10"; font.pixelSize: 13
                            text: root.installLang === "en"
                                  ? "Remove the USB stick and reboot from the hard disk."
                                  : "Извлеките флешку и перезагрузите ПК с жёсткого диска."
                        }
                    }
                    Item { width: 1; height: 8 }
                    Row {
                        spacing: 10
                        Rectangle {
                            visible: root.installStep > 0 && root.installStep < 4
                            width: 110; height: 36; radius: 4; color: "#ffffff"; border.color: "#8a8886"
                            Text { anchors.centerIn: parent; text: root.installLang === "en" ? "Back" : "Назад"; color: "#1a1a1a" }
                            MouseArea { anchors.fill: parent; onClicked: root.installStep = Math.max(0, root.installStep - 1) }
                        }
                        Rectangle {
                            visible: root.installStep < 3
                            width: 140; height: 36; radius: 4; color: "#0078d4"
                            Text { anchors.centerIn: parent; text: root.installLang === "en" ? "Next" : "Далее"; color: "#ffffff"; font.bold: true }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: {
                                    if (root.installStep === 1) root.refreshInstallDisks()
                                    root.installStep = Math.min(3, root.installStep + 1)
                                }
                            }
                        }
                        Rectangle {
                            visible: root.installStep === 3 && !root.installBusy
                            width: 180; height: 36; radius: 4; color: "#a4262c"
                            Text { anchors.centerIn: parent; text: root.installLang === "en" ? "Install now" : "Установить"; color: "#ffffff"; font.bold: true }
                            MouseArea {
                                anchors.fill: parent
                                onClicked: { root.installStep = 4; root.runInstaller() }
                            }
                        }
                        Rectangle {
                            visible: root.installStep === 5
                            width: 160; height: 36; radius: 4; color: "#0078d4"
                            Text { anchors.centerIn: parent; text: root.installLang === "en" ? "Reboot" : "Перезагрузка"; color: "#ffffff"; font.bold: true }
                            MouseArea { anchors.fill: parent; onClicked: root.powerAction("reboot") }
                        }
                    }
                }
            }
            Component.onCompleted: root.refreshInstallDisks()
        }
    }

